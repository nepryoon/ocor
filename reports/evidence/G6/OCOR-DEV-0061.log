{"command": "captured artifact: exact evidence builder", "exit_code": 0, "label": "evidence-builder-script", "output": "\"\"\"Build the OCOR-DEV-0061 candidate evidence from raw logs (no hand-entered counts).\n\nUsage: build_evidence.py <repo> <code_commit>\nCounts come only from archived JUnit XML and campaign results.  The G6 manifest\nis created (first G6 record) or updated surgically for OCOR-DEV-0061 only.\nAdapted by Claude Code (Anthropic) from the sealed OCOR-DEV-0059 repair1 builder.\n\"\"\"\nimport ast\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nrepo, code_commit = Path(sys.argv[1]), sys.argv[2]\nD = Path.home() / \".ocor-codex/ocor-dev-0061\"\nQ = D / \"q\"\nTASK = \"OCOR-DEV-0061\"\nG6 = repo / \"reports/evidence/G6\"\nMODULE = \"ocor-runtime/tests/conformance/fgm/test_fgm_01_10.py\"\nFIXTURE_MODULES = [\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0051.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_0052.py\",\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0053.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_0054.py\",\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0055.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_0057.py\",\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0059.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_rem_0023.py\",\n]\nRUNTIME_MODULES = [f\"ocor-runtime/src/ocor_runtime/memory/{n}.py\" for n in (\n    \"model\", \"stores\", \"embeddings\", \"retrieval\", \"consolidation\", \"lifecycle\", \"context\", \"operations\")]\nINPUT_PATHS = [MODULE, *FIXTURE_MODULES, *RUNTIME_MODULES]\n\n\ndef sha(b: bytes) -> str:\n    return hashlib.sha256(b).hexdigest()\n\n\ndef git(*a: str) -> str:\n    return subprocess.check_output([\"git\", *a], cwd=repo, text=True).strip()\n\n\nSECRETS = {n: v for n, v in (line.split(\"=\", 1) for line in (repo / \".ocor/bootstrap.env\").read_text().splitlines() if \"=\" in line)\n           if n.startswith((\"OCOR_LOCAL_\", \"OCOR_SPIRE_JOIN\")) and len(v) >= 8}\nredactions: dict[str, int] = {}\nraw_lines: list[str] = []\nsource_digests: dict[str, str] = {}\nidentity_redactions: dict[str, int] = {}\n\n\ndef redact(b: bytes) -> bytes:\n    t = b.decode(\"utf-8\", errors=\"replace\")\n    for n, v in SECRETS.items():\n        c = t.count(v)\n        if c:\n            redactions[n] = redactions.get(n, 0) + c\n            t = t.replace(v, f\"<redacted:{n}>\")\n    return t.encode()\n\n\ndef add_raw(label: str, command: str, exit_code: int, data: bytes) -> str:\n    source_digests[label] = sha(data)\n    if label.endswith(\"junit\"):\n        root = ET.fromstring(data)\n        total = 0\n        for case in root.iter(\"testcase\"):\n            name = case.get(\"name\", \"\")\n            if \"[\" in name:\n                case.set(\"name\", name.split(\"[\", 1)[0] + \"[sha256:\" + sha(name.encode()) + \"]\")\n                total += 1\n        data = ET.tostring(root, encoding=\"utf-8\")\n        identity_redactions[label] = total\n    data = redact(data)\n    raw_lines.append(json.dumps({\"label\": label, \"command\": command, \"exit_code\": exit_code, \"sha256\": sha(data),\n                                 \"output\": data.decode()}, sort_keys=True, ensure_ascii=False))\n    return sha(data)\n\n\ndef junit_cases(text: str) -> list[tuple[str, str]]:\n    out = []\n    for case in ET.fromstring(text).iter(\"testcase\"):\n        o = \"PASS\"\n        for ch in case:\n            if ch.tag in (\"failure\", \"error\"):\n                o = \"FAIL\"\n            elif ch.tag == \"skipped\":\n                o = \"SKIPPED\"\n        out.append((case.get(\"name\", \"\"), o))\n    return out\n\n\ndef junit_counts(text: str) -> dict[str, int]:\n    root = ET.fromstring(text)\n    suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"],\n            \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\n\ndef shown(c: list[str]) -> str:\n    return \" \".join(c).replace(str(repo), \"<worktree>\").replace(str(Path.home()), \"~\")\n\n\ncommands: list[dict] = []\nobservations: list[dict] = []\nfor row in json.loads((Q / \"commands.json\").read_text()):\n    data = (Q / f\"{row['label']}.log\").read_bytes()\n    cmd = shown(row[\"command\"])\n    if row.get(\"environment\"):\n        cmd = f\"{row['environment']} {cmd}\"\n    digest = add_raw(row[\"label\"], cmd, row[\"exit_code\"], data)\n    entry = {\"label\": row[\"label\"], \"command\": cmd, \"exit_code\": row[\"exit_code\"], \"raw_sha256\": digest, \"status\": row[\"status\"],\n             \"duration_seconds\": row[\"duration_seconds\"], \"head_sha\": row[\"head_sha\"]}\n    if row.get(\"restored_tracked_rewrites\"):\n        entry[\"restored_tracked_rewrites\"] = row[\"restored_tracked_rewrites\"]\n    if \"result\" in row:\n        r = row[\"result\"]\n        entry[\"result\"] = {\"passed\": r[\"passed\"], \"failed\": r[\"failed\"] + r[\"errors\"], \"skipped\": r[\"skipped\"], \"not_executed\": 0}\n    commands.append(entry)\n\nARTIFACTS = [\n    (\"full-suite-junit\", D / \"full/runtime_junit_post_approval.xml\", \"JUnit XML (parameterized names published as SHA256) of the governed serial full suite (scripts/run_qualifying_campaign.py --repository . --expected-head <code commit>)\"),\n    (\"full-suite-campaign-result\", D / \"full/campaign_result.json\", \"run_qualifying_campaign.py result (75-min limit, stack guard, required modules)\"),\n    (\"exact-junit-union\", Q / \"exact-junit-union.json\", \"unsharded full JUnit exact multiset match with pytest --collect-only on the same HEAD: no missing/duplicate/extra/skipped test\"),\n    (\"full-kind-teardown\", D / \"full/kind-teardown-observations.json\", \"repository kind v2 guard: destroy/remover proof and rejection observations\"),\n    (\"task-junit\", Q / \"task-3.xml\", \"JUnit XML of task-run-3 (third of three consecutive live runs of the FGM module)\"),\n    (\"validation-command-junit\", Q / \"task-validation-command-project.xml\", \"JUnit XML of the backlog validation command scoped to the runtime project\"),\n    (\"reports-portfolio-junit\", Q / \"reports-portfolio.xml\", \"JUnit XML of the reports/tests portfolio\"),\n    (\"mutation-probe-result\", Q / \"mutation-probe.json\", \"one mutant per FGM identifier removes the runtime control its case relies on, in a git-archive scratch of the code commit; M0 baseline 0 failed; each mutant must fail the FGM module\"),\n    (\"mutation-probe-script\", D / \"mutation_probe.py\", \"exact mutation harness, archived for reproduction\"),\n    (\"stack-summary\", Q / \"stack-summary.json\", \"ocor-bootstrap services running, no OOM, zero restarts, before the task runs\"),\n    (\"toolchain-lock-match\", Q / \"toolchain.json\", \"infra/toolchain.lock.json tools matched by version and sha256 on the campaign PATH\"),\n    (\"session-teardown-result\", Q / \"teardown.json\", \"final documented bootstrap teardown: zero owned containers/volumes/networks\"),\n    (\"evidence-builder-script\", D / \"build_evidence.py\", \"exact evidence builder\"),\n    (\"gate-runner-script\", D / \"gates.py\", \"exact clean-shell gate runner\"),\n]\nfor label, path, note in ARTIFACTS:\n    data = path.read_bytes()\n    digest = add_raw(label, f\"captured artifact: {note}\", 0, data)\n    entry = {\"label\": label, \"command\": f\"captured artifact: {note}\", \"raw_sha256\": digest, \"status\": \"PASS\", \"exit_code\": 0}\n    if path.suffix == \".xml\":\n        entry[\"result\"] = junit_counts(data.decode())\n        if entry[\"result\"][\"failed\"] or entry[\"result\"][\"skipped\"]:\n            entry[\"status\"] = \"FAIL\"\n    if label == \"full-suite-campaign-result\":\n        res = json.loads(data)\n        if res.get(\"status\") != \"PASS\" or res.get(\"candidate_head\") != code_commit or any(res[\"counts\"][k] for k in (\"errors\", \"failures\", \"skipped\")):\n            entry[\"status\"] = \"FAIL\"\n        entry[\"result\"] = {\"passed\": res[\"counts\"][\"tests\"], \"failed\": res[\"counts\"][\"errors\"] + res[\"counts\"][\"failures\"],\n                           \"skipped\": res[\"counts\"][\"skipped\"], \"not_executed\": 0}\n        if res.get(\"duration_seconds\", 0) > 3600:\n            observations.append({\"label\": \"full-suite-duration\", \"raw_sha256\": digest,\n                                 \"note\": f\"governed full suite PASS in {res['duration_seconds']:.2f}s, above the 3600s notification threshold and below the unchanged 4500s limit; registered as an occurrence per REM-0033-LOCAL-FULL-DURATION (2026-10-25) point 4, no new decision request (not within 5 minutes of the limit); no limit, test or timeout changed.\"})\n    if label == \"exact-junit-union\" and json.loads(data).get(\"status\") != \"PASS\":\n        entry[\"status\"] = \"FAIL\"\n    if label == \"mutation-probe-result\":\n        probe = json.loads(data)\n        survivors = probe[\"survivors\"]\n        entry[\"result\"] = {\"mutants\": len(probe[\"mutants\"]), \"killed\": len(probe[\"mutants\"]) - len(survivors),\n                           \"failed\": len(survivors)}\n        if survivors or probe[\"M0-baseline\"][\"exit_code\"] != 0:\n            entry[\"status\"] = \"FAIL\"\n    if label == \"session-teardown-result\" and json.loads(data).get(\"status\") != \"PASS\":\n        entry[\"status\"] = \"FAIL\"\n    commands.append(entry)\n\nred = D / \"red-absent.log\"\nred_digest = add_raw(\"tdd-red-module-absent\", \"RED before the module existed (git archive of origin/main 607ed958899c): <worktree>/ocor-runtime/.venv/bin/python -m pytest -q -p no:cacheprovider ocor-runtime/tests/conformance/fgm/test_fgm_01_10.py\", 4, red.read_bytes())\nfor name in (\"red-first-live.log\",):\n    path = D / name\n    if path.exists():\n        observations.append({\"label\": \"diagnostic-\" + name, \"note\": \"Diagnostic first live run of the draft module; never qualifying, no counts transferred\",\n                             \"raw_sha256\": add_raw(\"diagnostic-\" + name, \"diagnostic run (never current PASS)\", 1, path.read_bytes())})\nattempt0 = D / \"attempts/attempt0-host-toolchain/full-suite.log\"\nobservations.append({\"label\": \"diagnostic-attempt0-host-toolchain\", \"note\": \"NOT_EXECUTED, never counted: a first full-suite start on the same code commit used host tools that do not match infra/toolchain.lock.json (uv 0.13.5, docker CLI 29.9.2, node 22) and lacked the locked kind/helm/kubectl; the implementer interrupted it with SIGINT before any result, tore the stack down and re-bootstrapped with the locked toolchain; the qualifying campaign is the later complete run\",\n                     \"raw_sha256\": add_raw(\"diagnostic-attempt0-host-toolchain\", \"interrupted non-qualifying start (never PASS or FAIL)\", 1, attempt0.read_bytes())})\npm = (D / \"power-monitor.log\").read_bytes()\npm_lines = pm.decode().splitlines()\noff = [line.split()[0] for line in pm_lines if \" ac=0 \" in line]\nobservations.append({\"label\": \"full-suite-power-monitor\", \"raw_sha256\": add_raw(\"full-suite-power-monitor\", \"per-minute mains/battery/load samples during the qualifying full suite\", 0, pm),\n                     \"note\": f\"context only, not a gate: mains online in {len(pm_lines) - len(off)} of {len(pm_lines)} per-minute samples; on battery at {', '.join(off) or 'none'} (battery not critical, >= 20%); the qualifying full suite PASS 3202/3202 in its archived campaign result.\"})\nA1 = D / \"attempts/attempt1-host-battery-critical\"\nfor label, path, note in [\n    (\"diagnostic-attempt1-campaign-result\", A1 / \"full/campaign_result.json\", \"first locked-toolchain full suite: 75-minute limit reached at 3060/3202 cases with 0 failures/errors/skips\"),\n    (\"diagnostic-attempt1-campaign-log\", A1 / \"full-suite.log\", \"run_qualifying_campaign.py log of the first locked-toolchain full suite\"),\n    (\"diagnostic-attempt1-junit\", A1 / \"full/runtime_junit_post_approval.xml\", \"partial JUnit of the first locked-toolchain full suite (per-case times used for the timing analysis)\"),\n    (\"diagnostic-attempt1-analysis\", A1 / \"attempt1-analysis.json\", \"per-module timing against the same-host REM-0031 reference and the UPower battery history: critical battery 07:40-07:57Z explains the 1.9-8.4x slowdown of the live memory modules\"),\n    (\"diagnostic-attempt1-power-supply\", A1 / \"power-supply-now.txt\", \"power supply state read after the attempt (mains online, battery charging from 7%)\"),\n]:\n    observations.append({\"label\": label, \"note\": \"NOT_EXECUTED (infrastructure interruption: host on critical battery), never counted as PASS or FAIL; the qualifying campaign is the complete repeat on mains power. \" + note,\n                         \"raw_sha256\": add_raw(label, f\"diagnostic artifact: {note}\", 1 if label.endswith(\"result\") else 0, path.read_bytes())})\nraw = (\"\\n\".join(raw_lines) + \"\\n\").encode()\n\n# Requirement results: one entry per (FGM, requirement) binding declared in the module.\ntree = ast.parse(subprocess.check_output([\"git\", \"show\", f\"{code_commit}:{MODULE}\"], cwd=repo))\ncampaign = next(n for n in tree.body if isinstance(n, ast.AnnAssign) and getattr(n.target, \"id\", \"\") == \"CAMPAIGN\")\nbindings = ast.literal_eval(campaign.value)\nfunctions = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name.startswith(\"test_\")}\nlive = {k for k, n in functions.items() if [a.arg for a in n.args.args] == [\"campaign\"]}\nstructural = sorted(set(functions) - live)\ntask_cases = junit_cases((Q / \"task-3.xml\").read_text())\noutcome = {re.sub(r\"\\[.*\", \"\", n): o for n, o in task_cases}\nassert set(outcome) == set(functions), (sorted(set(outcome) ^ set(functions)))\nrequirement_results = []\nfor fgm, (scenario, oracle, reqs) in bindings.items():\n    number = fgm.split(\"-\")[1]\n    tests = sorted(n for n in functions if n.startswith(f\"test_fgm_{number}_\"))\n    assert len(tests) == 2 and all(t in live for t in tests), (fgm, tests)\n    res = {\"passed\": sum(outcome[t] == \"PASS\" for t in tests), \"failed\": sum(outcome[t] == \"FAIL\" for t in tests),\n           \"skipped\": sum(outcome[t] == \"SKIPPED\" for t in tests), \"not_executed\": 0}\n    for req in reqs:\n        requirement_results.append({\n            \"case_id\": f\"{TASK}-{fgm}-{req}\", \"fgm_id\": fgm, \"requirement_id\": req,\n            \"lld_v1_1_section_7_2\": {\"scenario\": scenario, \"oracle\": oracle},\n            \"positive_test\": next(t for t in tests if \"_positive_\" in t), \"negative_test\": next(t for t in tests if \"_negative_\" in t),\n            \"real_backend_tests\": tests, \"required_backend\": \"real memory metadata/content/full-text/vector stack: PostgreSQL 16, Qdrant 1.15.1, OpenBao 2.6.2 transit\",\n            \"result\": res, \"status\": \"PASS\" if res[\"passed\"] == 2 and not res[\"failed\"] and not res[\"skipped\"] else \"FAIL\",\n        })\n\ninputs = {\"inputs_tree\": git(\"rev-parse\", f\"{code_commit}:inputs\")}\nfor p in INPUT_PATHS:\n    inputs[p] = sha(subprocess.check_output([\"git\", \"show\", f\"{code_commit}:{p}\"], cwd=repo))\nmeta = json.loads((D / \"evidence_meta.json\").read_text())\nrecord = {\n    \"schema_version\": \"1.0\", \"task_id\": TASK, \"repair_cycle\": meta[\"repair_cycle\"],\n    \"status\": \"CANDIDATE_AWAITING_INDEPENDENT_VERIFICATION\", \"result\": \"PASS\",\n    \"commit\": code_commit, \"created_at\": datetime.now(UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n    \"environment\": meta[\"environment\"], \"inputs\": inputs,\n    \"inputs_tree_definition\": \"git rev-parse <commit>:inputs (tree della directory inputs/ immutabile)\",\n    \"raw_output_format\": \"JSONL: una riga per comando/artefatto con label, command, exit_code, sha256 dei byte UTF-8 archiviati e output integrale; le credenziali locali generate (valori di .ocor/bootstrap.env) sono sostituite prima dell'archiviazione e dell'hash; DSN mostrato come <local generated credential>\",\n    \"raw_output_redactions\": redactions, \"raw_output_sha256\": sha(raw), \"commands\": commands,\n    \"parameterized_case_identity_publication\": {\"authority\": \"REM-0019-SEALED-SYNTHETIC-SECRET-SCANNER (2026-10-15)\", \"method\": \"All parametrized JUnit testcase names retain the test function name and replace the full parameterized identity by SHA256; only publication changes, original counts and local exact JUnit union unchanged\", \"redacted_identity_counts\": identity_redactions, \"acquired_source_sha256_before_publication_redaction\": source_digests},\n    \"backend_classification\": \"AST: a test whose only parameter is the campaign fixture (real PostgreSQL 16, Qdrant 1.15.1 and OpenBao 2.6.2) is a real_backend test; every FGM positive and negative case is one; the two structural tests take no fixture and are never counted as FGM results\",\n    \"structural_tests\": structural,\n    \"requirement_results\": requirement_results, \"observations\": observations,\n    \"tdd\": dict(meta[\"tdd\"], red_raw_sha256=red_digest),\n    \"sealed_dependencies\": meta[\"sealed_dependencies\"], \"session_teardown\": json.loads((Q / \"teardown.json\").read_text()),\n    \"design\": meta[\"design\"], \"normative_interpretations\": meta[\"normative_interpretations\"],\n    \"residual_risks\": meta[\"residual_risks\"], \"requirement_coverage_note\": meta[\"requirement_coverage_note\"],\n    \"rollback_procedure_verified\": meta[\"rollback\"], \"roles\": meta[\"roles\"], \"reproducible_check\": meta[\"reproducible_check\"],\n    \"claims\": {\"E1\": 0, \"E2\": 0, \"PoC_GO\": \"NO-GO\", \"Production_readiness\": \"NO_GO\", \"runtime_conformance\": \"NOT_ESTABLISHED\"},\n}\nif any(c[\"status\"] != \"PASS\" for c in commands) or any(r[\"status\"] != \"PASS\" for r in requirement_results):\n    record[\"result\"] = \"FAIL\"\nev = (json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\").encode()\nG6.mkdir(parents=True, exist_ok=True)\n(G6 / f\"{TASK}.json\").write_bytes(ev)\n(G6 / f\"{TASK}.log\").write_bytes(raw)\nmp = G6 / \"MANIFEST.json\"\nm = json.loads(mp.read_text()) if mp.exists() else {\"artifacts\": [], \"created_at\": datetime.now(UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\"), \"gate\": \"G6\", \"requirement_results\": [], \"schema_version\": \"1.0\"}\nm[\"artifacts\"] = [a for a in m[\"artifacts\"] if a[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")] + [\n    {\"path\": f\"{TASK}.json\", \"sha256\": sha(ev), \"task_id\": TASK}, {\"path\": f\"{TASK}.log\", \"sha256\": sha(raw), \"task_id\": f\"{TASK}-RAW\"}]\nm[\"requirement_results\"] = [r for r in m[\"requirement_results\"] if r[\"task_id\"] != TASK] + [\n    {\"case_id\": r[\"case_id\"], \"evidence_path\": f\"{TASK}.json\", \"fgm_id\": r[\"fgm_id\"], \"raw_output_path\": f\"{TASK}.log\",\n     \"raw_output_sha256\": sha(raw), \"requirement_id\": r[\"requirement_id\"], \"status\": r[\"status\"], \"task_id\": TASK,\n     \"tests\": r[\"real_backend_tests\"]} for r in requirement_results]\nmp.write_text(json.dumps(m, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({\"result\": record[\"result\"], \"cases\": len(task_cases), \"requirement_results\": len(requirement_results),\n                  \"raw_sha256\": sha(raw), \"evidence_sha256\": sha(ev)}))\n", "sha256": "2c67899efb3b8c1ff86b3cc2bc0007f3db89a065ae36efa7538c7c422700bacc"}
{"command": "captured artifact: exact clean-shell gate runner", "exit_code": 0, "label": "gate-runner-script", "output": "\"\"\"Run the OCOR-DEV-0061 local gates from a clean environment and record each one.\n\nUsage: gates.py <phase>   (phase: post-campaign)\nWrites ~/.ocor-codex/ocor-dev-0061/q/<label>.log and appends to q/commands.json.\nTracked files rewritten by validators (reports/verify_report.json,\nreports/planning/*) are restored after each command and reported.\n\"\"\"\nimport json\nimport subprocess\nimport sys\nimport time\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0061\")\nD = Path.home() / \".ocor-codex/ocor-dev-0061\"\nQ = D / \"q\"\nQ.mkdir(exist_ok=True)\nPY = str(R / \"ocor-runtime/.venv/bin/python\")\nPATH = (D / \"locked-path\").read_text().strip()\nDSN = (D / \".dsn\").read_text().strip()\nBASE_ENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\nLIVE_ENV = {**BASE_ENV, \"OCOR_LIVE_POSTGRES_DSN\": DSN, \"OCOR_BOOTSTRAP_ENV\": str(R / \".ocor/bootstrap.env\")}\nMODULE = \"ocor-runtime/tests/conformance/fgm/test_fgm_01_10.py\"\nREPORTS = [\n    \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_backlog_generator_reality_parity.py\",\n    \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_evidence_input_drift.py\",\n    \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_qualifying_campaign_guard.py\",\n    \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_kind_teardown_observation.py\",\n    \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_rem0034_secret_registry.py\",\n    \"reports/tests/test_rem0023_consumer_fixture_scope.py\", \"reports/tests/test_rem0031_consumer_registry_scope.py\",\n]\nBRANCH = \"task/OCOR-DEV-0061-fgm-01-10-campaign\"\nGATES = [\n    (\"inputs\", [\"sha256sum\", \"-c\", \"inputs/normative/SHA256SUMS\"], BASE_ENV, None),\n    (\"sync-lint\", [\"uv\", \"sync\", \"--project\", \"ocor-runtime\", \"--frozen\", \"--extra\", \"test\", \"--extra\", \"lint\"], BASE_ENV, None),\n    (\"harness\", [PY, \"scripts/verify.py\", \"--json\"], BASE_ENV, None),\n    (\"drift\", [PY, \"scripts/validate_evidence_input_drift.py\"], BASE_ENV, None),\n    (\"ruff\", [\"ruff\", \"check\", \".\"], BASE_ENV, None),\n    (\"mypy\", [PY, \"-m\", \"mypy\"], BASE_ENV, None),\n    (\"language\", [PY, \"scripts/validate_language_policy.py\"], BASE_ENV, None),\n    (\"rccad\", [PY, \"scripts/validate_rccad.py\", \"--base-ref\", \"origin/main\"], BASE_ENV, None),\n    (\"scope\", [PY, \"scripts/validate_ocor_change_scope.py\", \"--base\", \"origin/main\", \"--branch\", BRANCH], BASE_ENV, None),\n    (\"plan\", [PY, \"scripts/validate_ocor_development_plan.py\", \"--base-ref\", \"HEAD\", \"--authorized-extension\"], BASE_ENV, None),\n    (\"reports-portfolio\", [PY, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-rs\", *REPORTS, f\"--junitxml={Q}/reports-portfolio.xml\"], BASE_ENV, \"reports-portfolio.xml\"),\n    *[(f\"task-run-{i}\", [PY, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-rs\", f\"--junitxml={Q}/task-{i}.xml\", MODULE], LIVE_ENV, f\"task-{i}.xml\") for i in (1, 2, 3)],\n    (\"task-validation-command-project\", [\"uv\", \"run\", \"--project\", \"ocor-runtime\", \"--frozen\", \"--extra\", \"test\", \"--extra\", \"lint\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-rs\", f\"--junitxml={Q}/task-validation-command-project.xml\", MODULE], LIVE_ENV, \"task-validation-command-project.xml\"),\n]\nRESTORE = [\"reports/verify_report.json\", \"reports/planning/OCOR_PLANNING_VALIDATION_REPORT.md\", \"reports/planning/OCOR_PLAN_RUN_STATE.json\"]\n\n\ndef junit(path: Path) -> dict:\n    import xml.etree.ElementTree as ET\n    root = ET.parse(path).getroot()\n    suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"], \"errors\": t[\"errors\"], \"skipped\": t[\"skipped\"]}\n\n\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=R, text=True).strip()\npath = Q / \"commands.json\"\nrows = json.loads(path.read_text()) if path.exists() else []\nonly = set(sys.argv[2:])\nfor label, cmd, env, xml in GATES:\n    if only and label not in only:\n        continue\n    started = datetime.now(UTC).isoformat()\n    t0 = time.monotonic()\n    p = subprocess.run(cmd, cwd=R, env=env, capture_output=True)\n    duration = round(time.monotonic() - t0, 3)\n    (Q / f\"{label}.log\").write_bytes(p.stdout + p.stderr)\n    dirty = subprocess.run([\"git\", \"status\", \"--porcelain\", \"--\", *RESTORE], cwd=R, capture_output=True, text=True).stdout.strip()\n    if dirty:\n        subprocess.run([\"git\", \"checkout\", \"--\", *RESTORE], cwd=R, check=True)\n    row = {\"label\": label, \"command\": cmd, \"exit_code\": p.returncode, \"duration_seconds\": duration, \"head_sha\": head,\n           \"started_at\": started, \"status\": \"PASS\" if p.returncode == 0 else \"FAIL\",\n           \"environment\": \"OCOR_LIVE_POSTGRES_DSN=<local generated credential>\" if env is LIVE_ENV else None,\n           \"restored_tracked_rewrites\": dirty.splitlines() if dirty else []}\n    if xml:\n        row[\"result\"] = junit(Q / xml)\n        if row[\"result\"][\"failed\"] or row[\"result\"][\"errors\"] or row[\"result\"][\"skipped\"]:\n            row[\"status\"] = \"FAIL\"\n    rows = [r for r in rows if r[\"label\"] != label] + [row]\n    path.write_text(json.dumps(rows, indent=2, sort_keys=True) + \"\\n\")\n    print(f\"[{row['status']}] {label} exit={p.returncode} {duration}s {row.get('result', '')}\", flush=True)\nfinal = subprocess.run([\"git\", \"status\", \"--porcelain\"], cwd=R, capture_output=True, text=True).stdout\nprint(\"worktree status after gates:\", repr(final))\n", "sha256": "c990bad1c736ec121c1298ea5e3c5211bbbd3f78bcd3395eb365d18d29ff06ee"}
