{"command": "captured artifact: exact mutation harness, archived for reproduction", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-0061 mutation probe (Claude Code/Anthropic).\n\nEach mutant removes exactly one runtime control that an FGM-01..10 case relies\non, in a git-archive scratch tree of the frozen code commit (the worktree is\nnever mutated), then runs the whole FGM module on the live stack from a clean\nshell.  An unmutated baseline (M0) must pass with 0 failures; a mutant counts as\nkilled only if the module fails.  Run only outside a full campaign.\nUsage: mutation_probe.py <code_commit> <output.json>\n\"\"\"\nimport hashlib\nimport json\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0061\")\nD = Path.home() / \".ocor-codex/ocor-dev-0061\"\nPY = str(R / \"ocor-runtime/.venv/bin/python\")\nMODULE = \"ocor-runtime/tests/conformance/fgm/test_fgm_01_10.py\"\nSRC = \"ocor-runtime/src/ocor_runtime\"\nM = {\n    \"fgm01-capability-matrix-unchecked\": (\"FGM-01\", f\"{SRC}/memory/model.py\",\n        \"    if not CAPABILITY_MATRIX.get((kind, scope), False):\\n\", \"    if False:\\n\"),\n    \"fgm02-prohibited-content-class-allowed\": (\"FGM-02\", f\"{SRC}/memory/model.py\",\n        \"        if content_class in PROHIBITED_CONTENT_CLASSES:\\n\", \"        if False:\\n\"),\n    \"fgm03-consolidation-provenance-unguarded\": (\"FGM-03\", f\"{SRC}/memory/consolidation.py\",\n        \"        if item.source_kind is SourceKind.MEMORY_CONSOLIDATION:\\n            return \\\"CONSOLIDATION_PROVENANCE_UNREGISTERED\\\"\\n\",\n        \"        if False:\\n            return \\\"CONSOLIDATION_PROVENANCE_UNREGISTERED\\\"\\n\"),\n    \"fgm04-binding-mismatch-ignored\": (\"FGM-04\", f\"{SRC}/kernel/governed_context.py\",\n        \"        if candidate != binding.expected:\\n\", \"        if False:\\n\"),\n    \"fgm05-scope-owner-binding-unchecked\": (\"FGM-05\", f\"{SRC}/memory/retrieval.py\",\n        \"            if value not in authorization.scope_bindings.get(name, frozenset()):\\n                return False\\n\",\n        \"            if False:\\n                return False\\n\"),\n    \"fgm06-unpinned-embedding-model-resolved\": (\"FGM-06\", f\"{SRC}/memory/embeddings.py\",\n        \"        entry = self._models.get(profile.representation_version)\\n        if entry is None:\\n\",\n        \"        entry = self._models.get(profile.representation_version)\\n        if entry is None and not self._models:\\n\"),\n    \"fgm07-representation-marking-dominance-ignored\": (\"FGM-07\", f\"{SRC}/memory/embeddings.py\",\n        \"        if not dominated:\\n            raise denied\\n\", \"        if False:\\n            raise denied\\n\"),\n    \"fgm08-taint-laundering-allowed\": (\"FGM-08\", f\"{SRC}/memory/model.py\",\n        \"        missing = sorted(required - set(item.taint_labels))\\n        if missing:\\n\",\n        \"        missing = sorted(required - set(item.taint_labels))\\n        if False:\\n\"),\n    \"fgm09-version-gap-allowed\": (\"FGM-09\", f\"{SRC}/memory/model.py\",\n        \"        if item.memory_version != latest + 1:\\n            raise MemoryAdmissionError(\\n                \\\"MEMORY_VERSION_NOT_FOUND\\\",\\n\",\n        \"        if False:\\n            raise MemoryAdmissionError(\\n                \\\"MEMORY_VERSION_NOT_FOUND\\\",\\n\"),\n    \"fgm10-revoked-item-reopenable\": (\"FGM-10\", f\"{SRC}/memory/lifecycle.py\",\n        \"        S.REVOKED: frozenset({S.LEGAL_HOLD, S.DELETION_PENDING}),\\n\",\n        \"        S.REVOKED: frozenset({S.ACTIVE, S.LEGAL_HOLD, S.DELETION_PENDING}),\\n\"),\n}\ncommit, out = sys.argv[1], Path(sys.argv[2])\ndsn = (D / \".dsn\").read_text().strip()\nenv = {\"HOME\": str(Path.home()), \"PATH\": (D / \"locked-path\").read_text().strip(),\n       \"OCOR_LIVE_POSTGRES_DSN\": dsn, \"OCOR_BOOTSTRAP_ENV\": str(R / \".ocor/bootstrap.env\")}\nscratch = Path(tempfile.mkdtemp(prefix=\"mutation-\", dir=str(D)))\narchive = subprocess.run([\"git\", \"archive\", commit], cwd=R, check=True, capture_output=True).stdout\nsubprocess.run([\"tar\", \"-x\", \"-C\", str(scratch)], input=archive, check=True)\n\n\ndef run(label: str) -> dict:\n    p = subprocess.run([PY, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", MODULE], cwd=scratch, env=env,\n                       capture_output=True, text=True, timeout=900)\n    tail = p.stdout.strip().splitlines()[-1] if p.stdout.strip() else p.stderr[-300:]\n    failed = [line.split(\" \")[1].split(\"::\")[1] for line in p.stdout.splitlines() if line.startswith((\"FAILED \", \"ERROR \"))]\n    return {\"exit_code\": p.returncode, \"summary\": tail, \"failed_tests\": failed}\n\n\nresults = {\"commit\": commit, \"module\": MODULE, \"python\": PY}\nresults[\"M0-baseline\"] = run(\"M0\")\nassert results[\"M0-baseline\"][\"exit_code\"] == 0, results[\"M0-baseline\"]\nmutants = {}\nfor name, (fgm, rel, a, b) in M.items():\n    path = scratch / rel\n    original = path.read_text()\n    assert hashlib.sha256(original.encode()).hexdigest() == hashlib.sha256(\n        subprocess.check_output([\"git\", \"show\", f\"{commit}:{rel}\"], cwd=R)).hexdigest(), name\n    assert original.count(a) == 1, (name, original.count(a))\n    path.write_text(original.replace(a, b))\n    try:\n        outcome = run(name)\n    finally:\n        path.write_text(original)\n    killed_by = sorted({t for t in outcome[\"failed_tests\"] if t.startswith(f\"test_fgm_{fgm[-2:]}_\")})\n    mutants[name] = {\"fgm\": fgm, \"file\": rel, \"killed\": outcome[\"exit_code\"] != 0, \"killed_by_own_fgm_case\": killed_by, **outcome}\n    print(name, mutants[name][\"killed\"], killed_by, outcome[\"summary\"], flush=True)\nresults[\"mutants\"] = mutants\nresults[\"survivors\"] = sorted(n for n, v in mutants.items() if not v[\"killed\"])\nout.write_text(json.dumps(results, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({\"survivors\": results[\"survivors\"], \"mutants\": len(mutants)}))\n", "sha256": "e6a5722d267521f753a1bf75e0c212c233694913d838be3bad0ef9bdfaa4b13a"}
