{"command": "captured observation: run.progress", "exit_code": 0, "label": "run.progress", "output": "2026-11-07T10:28:57Z start head=de79d986d7f336e9ebc70413364b5f66c00ee4c5\n2026-11-07T10:28:57Z phase A\n2026-11-07T10:29:45Z backend images snapshot 15 containers\n2026-11-07T10:29:45Z phase A3\n2026-11-07T10:32:29Z phase B\n2026-11-07T10:32:31Z credentials archived in old-credentials-A\n2026-11-07T10:32:31Z phase B2 (serial full suite) MemTotal:=64199668 MemAvailable:=52840456 \n2026-11-07T11:45:47Z credentials archived in old-credentials-B2\n2026-11-07T11:45:47Z phase C MemTotal:=64199668 MemAvailable:=52693904 \n2026-11-07T12:11:52Z C rc=0\n", "sha256": "85f2e8141c3632f3bdca48987b5819393b70c562818df770c86d99ba90534038"}
{"command": "captured artifact: ~/.ocor-codex/rem-0056-q/run.sh", "exit_code": 0, "label": "script-run.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0056 (LOCAL-SUITE-FOUR-LANES): qualification campaign at the candidate head\n# (phases A, A3, B on the host stack; B2 the serial full suite of the equivalence proof on a fresh host stack;\n# then phase C: the four-lane full suite with the versioned orchestrator, memory admission at start).\nset -u\nD=$HOME/.ocor-codex/rem-0056-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0056\nPY=$R/ocor-runtime/.venv/bin/python\nEXP=$1\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\nMP=\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nstep \"start head=$(git rev-parse HEAD)\"\ntest \"$(git rev-parse HEAD)\" = $EXP || { step \"FAIL head\"; exit 5; }\ntest -z \"$(git status --porcelain --untracked-files=no)\" || { step \"FAIL tracked changes\"; exit 6; }\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL stale credentials in worktree\"; exit 3; }\ntest ! -e $D/q || { step \"FAIL q exists\"; exit 4; }\nmkdir -p $D/q\narchive(){ mkdir $D/$1 || { step \"FAIL archive target exists\"; exit 4; }\n  for f in .ocor/bootstrap.env .ocor/spire .ocor/ci-resources.yaml; do test -e $f && mv $f $D/$1/; done\n  test ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials not archived\"; exit 3; }\n  step \"credentials archived in $1\"; }\nstep \"phase A\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py A >> $D/run.out 2>&1 || { step \"FAIL phase A\"; exit 1; }\ndocker ps --filter label=com.docker.compose.project=ocor-bootstrap -q | xargs docker inspect | python3 -c '\nimport json,sys\nout={c[\"Name\"].lstrip(\"/\"):{\"image_id\":c[\"Image\"],\"image_ref\":c[\"Config\"][\"Image\"],\"oom_killed\":c[\"State\"][\"OOMKilled\"],\"restart_count\":c[\"RestartCount\"],\"status\":c[\"State\"][\"Status\"]} for c in json.load(sys.stdin)}\nprint(json.dumps(out,indent=2,sort_keys=True))' > $D/backend_images.json && step \"backend images snapshot $(python3 -c \"import json;print(len(json.load(open('$D/backend_images.json'))))\") containers\"\nfor ph in A3 B; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\narchive old-credentials-A\nstep \"phase B2 (serial full suite) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\n( while true; do echo \"$(date -u +%s) $(awk '/^MemTotal|^MemAvailable/{printf \"%s \", $2}' /proc/meminfo) $(cut -d' ' -f1 /proc/loadavg)\" >> $D/mem-serial.log; sleep 5; done ) &\nMP=$!\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py B2 >> $D/run.out 2>&1; rc=$?\nkill $MP 2>/dev/null; MP=\n[ $rc = 0 ] || { step \"FAIL phase B2 rc=$rc\"; exit 1; }\narchive old-credentials-B2\nstep \"phase C $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\nrm -f $D/mem-lanes.stop; $HOME/.ocor-codex/rem-0056/iter2/memsample.sh $D/mem-lanes.log $D/mem-lanes.stop &\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\ntouch $D/mem-lanes.stop\nstep \"C rc=$rc\"\nexit $rc\n", "sha256": "10a3964ea70047d80272c27d5c233928a4e893413f0bc936f989cc927d4297e3"}
{"command": "captured artifact: ~/.ocor-codex/rem-0056-q/qualify_run.py", "exit_code": 0, "label": "script-qualify_run.py", "output": "\"\"\"OCOR-DEV-REM-0056 (LOCAL-SUITE-FOUR-LANES) campaign (adapted from the REM-0055 campaign) from a clean shell.\n\nUsage: qualify_run.py <phase>. Each command's combined output goes to q/<label>.log;\nq/commands.jsonl gets label, command, cwd, exit code, duration, raw sha256, junit counts.\nStops at the first failure (fail-closed); tracked files are never edited.\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0056\")\nD = Path.home() / \".ocor-codex/rem-0056-q\"; Q = D / \"q\"; Q.mkdir(exist_ok=True)\nPATH = (D / \"locked-path\").read_text().strip()\nPY = \"ocor-runtime/.venv/bin/python\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\n\ndef live_env():\n    env_file = R / \".ocor/bootstrap.env\"\n    vals = dict(l.split(\"=\", 1) for l in env_file.read_text().splitlines() if \"=\" in l)\n    return {**ENV, \"OCOR_BOOTSTRAP_ENV\": str(env_file),\n            \"OCOR_LIVE_POSTGRES_DSN\": f\"postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor\"}\n\ndef junit(path):\n    root = ET.parse(path).getroot(); suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\ndef pytest(label, *targets, cwd=\".\"):\n    x = Q / f\"{label}.xml\"\n    return (label, [str(R / PY), \"-m\", \"pytest\", *targets, \"-p\", \"no:cacheprovider\", \"-q\", \"-rfEs\", \"--tb=short\", f\"--junitxml={x}\"], cwd, x)\n\n# the unit's guard (the lane orchestrator, backend-free) with the guards it imports: exactly the task modules of the sealed REM-0037 record\nTASK = [\"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_qualifying_campaign_guard.py\"]\n# regression-only requalifications, tests unchanged: 0005, 0050, 0082 (plan validator allowlist); OCOR-DEV-REM-0037 (orchestrator and its\n# guard among the inputs of its sealed record) is backed by TASK and by the four-lane campaign of phase C\nREGRESSION = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0005\", \"0050\", \"0082\")]\nREPORTS = [\"reports/tests/test_bootstrap_lock_validation.py\", \"reports/tests/test_autonomous_tooling_policy.py\", \"reports/tests/test_reset_teardown_residue.py\", \"reports/tests/test_evidence_input_drift.py\", \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_qualifying_campaign_guard.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_rem0034_secret_registry.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_backlog_generator_reality_parity.py\"]\nTOOLS = str(Path.home() / \".ocor-codex/impl-env/rem-0056/bin\")\n\nPHASES = {\n \"A\": [\n  (\"stack-absent-initial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"bootstrap\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"verify-manifest-only\", [PY, \"scripts/verify_external_services.py\", \"--manifest-only\"], \".\", None),\n  (\"verify-typed-execute\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"bootstrap-check\", [PY, \"scripts/bootstrap_development_environment.py\", \"--check\"], \".\", None),\n ],\n \"A3\": [\n  (\"preflight\", [PY, \"scripts/preflight_environment.py\"], \".\", None),\n  *[pytest(f\"task-rem0056-run{i}\", \"-rP\", *TASK) for i in (1, 2, 3)],\n  pytest(\"regression\", \"-rP\", *REGRESSION),\n  (\"evidence-job-g0\", [PY, \"ocor-runtime/tools/evidence_manifest.py\", \"validate\", \"--task\", \"OCOR-DEV-0004\", \"--non-skipped\", \"--manifest\", \"reports/evidence/G0/MANIFEST.json\"], \".\", None),\n  pytest(\"reports-portfolio\", *REPORTS),\n  (\"lane-plan\", [PY, \"scripts/run_local_lane_campaign.py\", \"--plan\"], \".\", None),\n ],\n \"B\": [\n  (\"teardown-after-a\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  (\"stack-absent-after-a\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n \"B2\": [\n  (\"credentials-fresh\", [\"sh\", \"-c\", \"test ! -e .ocor/bootstrap.env && test ! -e .ocor/spire && echo no worktree-local credential file\"], \".\", None),\n  (\"bootstrap-serial\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"serial-full\", [PY, \"scripts/run_qualifying_campaign.py\", \"--execute\", \"--repository\", \".\", \"--expected-head\", \"HEADSHA\", \"--output-dir\", str(Q / \"serial\")], \".\", None),\n  (\"teardown-after-serial\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  (\"stack-absent-after-serial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n \"C\": [\n  (\"host-stack-absent-before-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"four-lane-full\", [PY, \"scripts/run_local_lane_campaign.py\", \"--execute\", str(D / \"lanes\"), \"--expected-head\", \"HEADSHA\", \"--tool-bin\", TOOLS], \".\", None),\n  (\"host-stack-absent-after-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n}\n\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=R, text=True).strip()\nfor label, cmd, cwd, xml in PHASES[sys.argv[1]]:\n    if cmd[0] == PY: cmd = [str(R / PY), *cmd[1:]]\n    cmd = [head if c == \"HEADSHA\" else c for c in cmd]\n    env = live_env() if (R / \".ocor/bootstrap.env\").exists() else ENV\n    t0 = time.monotonic(); started = datetime.now(UTC).isoformat()\n    with open(Q / f\"{label}.log\", \"w\") as log:\n        rc = subprocess.run(cmd, cwd=R / cwd, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=6000).returncode\n    rec = {\"label\": label, \"command\": \" \".join(c.replace(str(R) + \"/\", \"\") for c in cmd), \"cwd\": cwd, \"exit_code\": rc,\n           \"duration_seconds\": round(time.monotonic() - t0, 3), \"started_at\": started, \"head_sha\": head,\n           \"raw_sha256\": hashlib.sha256((Q / f\"{label}.log\").read_bytes()).hexdigest(), \"status\": \"PASS\" if rc == 0 else \"FAIL\"}\n    if xml and Path(xml).exists():\n        rec[\"result\"] = junit(xml); rec[\"junit_raw_sha256\"] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if rec[\"result\"][\"skipped\"] or rec[\"result\"][\"failed\"]: rec[\"status\"] = \"FAIL\"\n    with open(Q / \"commands.jsonl\", \"a\") as f: f.write(json.dumps(rec, sort_keys=True) + \"\\n\")\n    print(label, rec[\"status\"], rec[\"duration_seconds\"], rec.get(\"result\", \"\"), flush=True)\n    if rec[\"status\"] != \"PASS\": sys.exit(1)\n    if subprocess.run([\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\"], cwd=R, capture_output=True, text=True).stdout.strip():\n        print(\"TRACKED TREE CHANGED after\", label); sys.exit(2)\n", "sha256": "caac52ab9069913d4c9e7a02d80bde52a258788ce9f34bf2eb5ffeb447f54934"}
{"command": "captured artifact: ~/.ocor-codex/rem-0056/iter2/memsample.sh", "exit_code": 0, "label": "script-memsample.sh", "output": "#!/bin/bash\n# Samples every 5 s until the stop file exists: epoch, MemAvailable (kB), 1-min load, and for each lane sandbox\n# name:memory.current:memory.peak:anon:shmem (bytes; anon and shmem from memory.stat, without reclaimable page cache).\nOUT=$1; STOP=$2\nwhile [ ! -e \"$STOP\" ]; do\n  t=$(date +%s); m=$(awk '/MemAvailable/{print $2}' /proc/meminfo); l=$(cut -d' ' -f1 /proc/loadavg)\n  lanes=\"\"\n  for c in $(docker ps -q --filter label=org.ocor.local-lane 2>/dev/null); do\n    n=$(docker inspect -f '{{.Name}}' $c | tr -d /); id=$(docker inspect -f '{{.Id}}' $c)\n    f=/sys/fs/cgroup/system.slice/docker-$id.scope\n    cur=$(cat $f/memory.current 2>/dev/null); pk=$(cat $f/memory.peak 2>/dev/null)\n    an=$(awk '$1==\"anon\"{print $2}' $f/memory.stat 2>/dev/null); sh=$(awk '$1==\"shmem\"{print $2}' $f/memory.stat 2>/dev/null)\n    lanes=\"$lanes $n:$cur:$pk:$an:$sh\"\n  done\n  echo \"$t $m $l$lanes\" >> \"$OUT\"\n  sleep 5\ndone\n", "sha256": "3ce411df9bd9984be5a759ae8e2676a019de28ef10001bfdff60feb807f994a3"}
{"command": "captured artifact: ~/.ocor-codex/rem-0056/iter2/ratelimit.py", "exit_code": 0, "label": "script-ratelimit.py", "output": "\"\"\"Docker Hub pull quota of this host's address (HEAD on the rate-limit preview repository; a HEAD consumes no pull).\"\"\"\nimport json, sys, urllib.error, urllib.request\nfrom datetime import UTC, datetime\ntok = json.load(urllib.request.urlopen(\"https://auth.docker.io/token?service=registry.docker.io&scope=repository:ratelimitpreview/test:pull\", timeout=20))[\"token\"]\nreq = urllib.request.Request(\"https://registry-1.docker.io/v2/ratelimitpreview/test/manifests/latest\", method=\"HEAD\", headers={\"Authorization\": f\"Bearer {tok}\"})\ntry:\n    h, code = urllib.request.urlopen(req, timeout=20).headers, 200\nexcept urllib.error.HTTPError as exc:\n    h, code = exc.headers, exc.code\nprint(json.dumps({\"at\": datetime.now(UTC).isoformat(), \"http\": code, \"limit\": h.get(\"ratelimit-limit\"), \"remaining\": h.get(\"ratelimit-remaining\")}, sort_keys=True))\n", "sha256": "873678663953c9c25c359e37641466a01e8c064441a843bf04221cd91c3cee85"}
