{"command": "captured artifact: ~/.ocor-codex/rem-0056/rg.sh", "exit_code": 0, "label": "script-rg.sh", "output": "#!/bin/bash\n# Backend-free RED/GREEN of the lane guard; fingerprint = sha256 of sorted \"case outcome\" lines.\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT\"\necho \"head=$(git rev-parse HEAD) diff_sha256=$(git diff HEAD | sha256sum | cut -c1-64)\" > \"$OUT.log\"\nenv -i HOME=$HOME PATH=$(cat $HOME/.ocor-codex/rem-0056/locked-path) ocor-runtime/.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "822e0f125e4c78c54256e951adf2ed81268503e7c5ae2c3a80db7986632d0227"}
