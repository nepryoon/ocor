oot_composes_only_a_canonical_path_fenced_on_its_emergency_stop\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_composed_emergency_stop_cancels_the_action_before_the_send\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_composed_break_glass_never_overrides_the_composed_stop_and_is_audited\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_denied_authority_ends_the_action_denied_and_it_is_never_resumed\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_non_risk_bearing_action_is_denied_at_the_control_check\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_missing_approval_leaves_the_action_pending_and_the_approval_resumes_it\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_rejected_decision_ends_the_action_decision_rejected\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_material_drift_invalidates_the_action_before_the_send\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_transient_dispatch_condition_keeps_the_action_at_the_pre_dispatch_check\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_confirmed_action_is_not_traced_again\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_an_outcome_is_assessed_only_for_a_confirmed_action_with_new_evidence\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_an_unavailable_trace_stops_the_action_before_any_effect\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_a_promotion_traverses_the_c6_states_in_canonical_order\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_audited_trace_refuses_a_context_that_overrides_the_transition_or_is_not_text[None]\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_audited_trace_refuses_a_context_that_overrides_the_transition_or_is_not_text[context1]\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_audited_trace_refuses_a_context_that_overrides_the_transition_or_is_not_text[context2]\",\n    \"tests/tasks/test_ocor_dev_rem_0053.py::test_the_audited_trace_refuses_a_context_that_overrides_the_transition_or_