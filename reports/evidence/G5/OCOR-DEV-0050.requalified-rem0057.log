elf = TerminusDBScenarioOverlayStore(url='http://127.0.0.1:6363', database='ocor_c7_rem0057_5de550656924')\nbranch = ScenarioBranch(scenario_id='urn:ocor:scenario:rem0057:ab5f143366', run_id='run-2', compartments=('urn:ocor:compartment...4kishdvfbpra6j5cy41auouj', scenario_branch='scenario/f7149ea52053bf6c641237378ca5e800b2e8fd4c4e08c8a8a15e9849472c13fd')\nrevision = 5\n\n    def read_at(self, branch: ScenarioBranch, revision: int) -> OverlayView:\n        if isinstance(revision, bool) or not isinstance(revision, int) or revision < 0:\n            raise ScenarioOverlayError(\"REVISION_INVALID\", \"a revision is a non-negative integer\")\n        _, deltas = self._read_overlay(branch)\n        if revision > len(deltas):\n>           raise ScenarioOverlayError(\"REVISION_NOT_FOUND\", f\"the overlay has {len(deltas)} revisions\")\nE           ocor_runtime.c7.scenario_overlay.ScenarioOverlayError: REVISION_NOT_FOUND: the overlay has 1 revisions\n\nsrc/ocor_runtime/c7/adapters/terminusdb_overlay.py:523: ScenarioOverlayError\n=========================== short test summary info ============================\nFAILED tests/tasks/test_ocor_dev_rem_0057_jobs.py::test_ncr_c7_004_conforms_overdue_jobs_without_a_runner_expire_and_free_the_quota\nFAILED tests/tasks/test_ocor_dev_rem_0057_jobs.py::test_ncr_c7_004_conforms_an_unreadable_hypothesis_fails_the_job_and_releases_its_resources\n2 failed, 79 deselected in 1.90s\nexit=1\n", "sha256": "f4156035d485169776099bc3fcae958ecdeebf0987936690e7e681a12f7c3b11"}
