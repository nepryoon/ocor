{"command": "captured artifact: ~/.ocor-codex/rem-0057-q/qualify_run.py", "exit_code": 0, "label": "script-qualify_run.py", "output": "\"\"\"OCOR-DEV-REM-0057 (NCP-U09, C7 causal runtime) campaign (adapted from the REM-0056 campaign) from a clean shell.\n\nUsage: qualify_run.py <phase>. Each command's combined output goes to q/<label>.log;\nq/commands.jsonl gets label, command, cwd, exit code, duration, raw sha256, junit counts.\nStops at the first failure (fail-closed); tracked files are never edited.\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0057\")\nD = Path.home() / \".ocor-codex/rem-0057-q\"; Q = D / \"q\"; Q.mkdir(exist_ok=True)\nPATH = (D / \"locked-path\").read_text().strip()\nPY = \"ocor-runtime/.venv/bin/python\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\n\ndef live_env():\n    env_file = R / \".ocor/bootstrap.env\"\n    vals = dict(l.split(\"=\", 1) for l in env_file.read_text().splitlines() if \"=\" in l)\n    return {**ENV, \"OCOR_BOOTSTRAP_ENV\": str(env_file),\n            \"OCOR_LIVE_POSTGRES_DSN\": f\"postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor\"}\n\ndef junit(path):\n    root = ET.parse(path).getroot(); suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\ndef pytest(label, *targets, cwd=\".\"):\n    x = Q / f\"{label}.xml\"\n    return (label, [str(R / PY), \"-m\", \"pytest\", *targets, \"-p\", \"no:cacheprovider\", \"-q\", \"-rfEs\", \"--tb=short\", f\"--junitxml={x}\"], cwd, x)\n\n# the unit modules (C7 causal runtime, scenario runs, the job ledger on the live PostgreSQL, TerminusDB overlay and SeaweedFS\n# sealed results) with the register, REM-0046 and runtime evidence validator suites\nTASK = [\"ocor-runtime/tests/tasks/test_ocor_dev_rem_0057.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_rem_0057_jobs.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_runtime_evidence_validator.py\"]\n# regression-only requalification whose tests the unit realigned and adapted (no bindable requirement, NCP-UNBINDABLE-REQUALIFICATIONS): 0045\nREQUALIFIED = [\"ocor-runtime/tests/tasks/test_ocor_dev_0045.py\"]\n# the other consumers of the unit inventory: the REM-0040 sealed-result and REM-0041 overlay modules (realigned and adapted, live SeaweedFS and TerminusDB)\nCONSUMERS = [\"ocor-runtime/tests/tasks/test_ocor_dev_rem_0040.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_rem_0041_overlay.py\"]\n# regression-only requalifications with tests unchanged: 0005, 0050, 0082 (plan validator allowlist)\nREGRESSION = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0005\", \"0050\", \"0082\")]\nREPORTS = [\"reports/tests/test_bootstrap_lock_validation.py\", \"reports/tests/test_autonomous_tooling_policy.py\", \"reports/tests/test_reset_teardown_residue.py\", \"reports/tests/test_evidence_input_drift.py\", \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_qualifying_campaign_guard.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_rem0034_secret_registry.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_backlog_generator_reality_parity.py\"]\nTOOLS = str(Path.home() / \".ocor-codex/impl-env/rem-0057/bin\")\n\nPHASES = {\n \"A\": [\n  (\"stack-absent-initial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"bootstrap\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"verify-manifest-only\", [PY, \"scripts/verify_external_services.py\", \"--manifest-only\"], \".\", None),\n  (\"verify-typed-execute\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"bootstrap-check\", [PY, \"scripts/bootstrap_development_environment.py\", \"--check\"], \".\", None),\n ],\n \"A3\": [\n  (\"preflight\", [PY, \"scripts/preflight_environment.py\"], \".\", None),\n  *[pytest(f\"task-rem0057-run{i}\", \"-rP\", *TASK) for i in (1, 2, 3)],\n  pytest(\"requalified-modules\", \"-rP\", *REQUALIFIED),\n  pytest(\"consumers\", \"-rP\", *CONSUMERS),\n  pytest(\"regression\", \"-rP\", *REGRESSION),\n  (\"evidence-job-g0\", [PY, \"ocor-runtime/tools/evidence_manifest.py\", \"validate\", \"--task\", \"OCOR-DEV-0004\", \"--non-skipped\", \"--manifest\", \"reports/evidence/G0/MANIFEST.json\"], \".\", None),\n  pytest(\"reports-portfolio\", *REPORTS),\n  (\"lane-plan\", [PY, \"scripts/run_local_lane_campaign.py\", \"--plan\"], \".\", None),\n ],\n \"B\": [\n  (\"teardown-after-a\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  (\"stack-absent-after-a\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n \"C\": [\n  (\"host-stack-absent-before-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"four-lane-full\", [PY, \"scripts/run_local_lane_campaign.py\", \"--execute\", str(D / \"lanes\"), \"--expected-head\", \"HEADSHA\", \"--tool-bin\", TOOLS], \".\", None),\n  (\"host-stack-absent-after-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n}\n\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=R, text=True).strip()\nfor label, cmd, cwd, xml in PHASES[sys.argv[1]]:\n    if cmd[0] == PY: cmd = [str(R / PY), *cmd[1:]]\n    cmd = [head if c == \"HEADSHA\" else c for c in cmd]\n    env = live_env() if (R / \".ocor/bootstrap.env\").exists() else ENV\n    t0 = time.monotonic(); started = datetime.now(UTC).isoformat()\n    with open(Q / f\"{label}.log\", \"w\") as log:\n        rc = subprocess.run(cmd, cwd=R / cwd, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=6000).returncode\n    rec = {\"label\": label, \"command\": \" \".join(c.replace(str(R) + \"/\", \"\") for c in cmd), \"cwd\": cwd, \"exit_code\": rc,\n           \"duration_seconds\": round(time.monotonic() - t0, 3), \"started_at\": started, \"head_sha\": head,\n           \"raw_sha256\": hashlib.sha256((Q / f\"{label}.log\").read_bytes()).hexdigest(), \"status\": \"PASS\" if rc == 0 else \"FAIL\"}\n    if xml and Path(xml).exists():\n        rec[\"result\"] = junit(xml); rec[\"junit_raw_sha256\"] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if rec[\"result\"][\"skipped\"] or rec[\"result\"][\"failed\"]: rec[\"status\"] = \"FAIL\"\n    with open(Q / \"commands.jsonl\", \"a\") as f: f.write(json.dumps(rec, sort_keys=True) + \"\\n\")\n    print(label, rec[\"status\"], rec[\"duration_seconds\"], rec.get(\"result\", \"\"), flush=True)\n    if rec[\"status\"] != \"PASS\": sys.exit(1)\n    if subprocess.run([\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\"], cwd=R, capture_output=True, text=True).stdout.strip():\n        print(\"TRACKED TREE CHANGED after\", label); sys.exit(2)\n", "sha256": "f6a9400d569555a8654a77b0f90e1921f8b1987a157326d6ed0485b4c2fde4d3"}
{"command": "captured artifact: ~/.ocor-codex/rem-0057-q/run.sh", "exit_code": 0, "label": "script-run.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0057 (NCP-U09): qualification campaign at the unit head\n# (phases A, A3, B on the host stack; then phase C: the full suite with the versioned four-lane orchestrator, memory admission at start).\nset -u\nD=$HOME/.ocor-codex/rem-0057-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0057\nPY=$R/ocor-runtime/.venv/bin/python\nEXP=$1\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\nMP=\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nstep \"start head=$(git rev-parse HEAD)\"\ntest \"$(git rev-parse HEAD)\" = $EXP || { step \"FAIL head\"; exit 5; }\ntest -z \"$(git status --porcelain --untracked-files=no)\" || { step \"FAIL tracked changes\"; exit 6; }\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL stale credentials in worktree\"; exit 3; }\ntest ! -e $D/q || { step \"FAIL q exists\"; exit 4; }\nmkdir -p $D/q\narchive(){ mkdir $D/$1 || { step \"FAIL archive target exists\"; exit 4; }\n  for f in .ocor/bootstrap.env .ocor/spire .ocor/ci-resources.yaml; do test -e $f && mv $f $D/$1/; done\n  test ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials not archived\"; exit 3; }\n  step \"credentials archived in $1\"; }\nstep \"phase A\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py A >> $D/run.out 2>&1 || { step \"FAIL phase A\"; exit 1; }\ndocker ps --filter label=com.docker.compose.project=ocor-bootstrap -q | xargs docker inspect | python3 -c '\nimport json,sys\nout={c[\"Name\"].lstrip(\"/\"):{\"image_id\":c[\"Image\"],\"image_ref\":c[\"Config\"][\"Image\"],\"oom_killed\":c[\"State\"][\"OOMKilled\"],\"restart_count\":c[\"RestartCount\"],\"status\":c[\"State\"][\"Status\"]} for c in json.load(sys.stdin)}\nprint(json.dumps(out,indent=2,sort_keys=True))' > $D/backend_images.json && step \"backend images snapshot $(python3 -c \"import json;print(len(json.load(open('$D/backend_images.json'))))\") containers\"\nfor ph in A3 B; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\narchive old-credentials-A\nstep \"phase C $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\nrm -f $D/mem-lanes.stop; $HOME/.ocor-codex/rem-0056/iter2/memsample.sh $D/mem-lanes.log $D/mem-lanes.stop &\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\ntouch $D/mem-lanes.stop\nstep \"C rc=$rc\"\nexit $rc\n", "sha256": "98a6823b9f51b34a10e404c0e0aa775cef0426ea15720fcfde239b0a671ca763"}
{"command": "captured artifact: ~/.ocor-codex/rem-0056/iter2/memsample.sh", "exit_code": 0, "label": "script-memsample.sh", "output": "#!/bin/bash\n# Samples every 5 s until the stop file exists: epoch, MemAvailable (kB), 1-min load, and for each lane sandbox\n# name:memory.current:memory.peak:anon:shmem (bytes; anon and shmem from memory.stat, without reclaimable page cache).\nOUT=$1; STOP=$2\nwhile [ ! -e \"$STOP\" ]; do\n  t=$(date +%s); m=$(awk '/MemAvailable/{print $2}' /proc/meminfo); l=$(cut -d' ' -f1 /proc/loadavg)\n  lanes=\"\"\n  for c in $(docker ps -q --filter label=org.ocor.local-lane 2>/dev/null); do\n    n=$(docker inspect -f '{{.Name}}' $c | tr -d /); id=$(docker inspect -f '{{.Id}}' $c)\n    f=/sys/fs/cgroup/system.slice/docker-$id.scope\n    cur=$(cat $f/memory.current 2>/dev/null); pk=$(cat $f/memory.peak 2>/dev/null)\n    an=$(awk '$1==\"anon\"{print $2}' $f/memory.stat 2>/dev/null); sh=$(awk '$1==\"shmem\"{print $2}' $f/memory.stat 2>/dev/null)\n    lanes=\"$lanes $n:$cur:$pk:$an:$sh\"\n  done\n  echo \"$t $m $l$lanes\" >> \"$OUT\"\n  sleep 5\ndone\n", "sha256": "3ce411df9bd9984be5a759ae8e2676a019de28ef10001bfdff60feb807f994a3"}
