{"command": "mutation probe mutation_probe.py (outside Git)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-REM-0045 mutation probe of the single current proof (outside Git).\n\nUsage: mutation_probe.py <code_commit> <python>. Creates a detached scratch worktree at the code\ncommit under /tmp, applies each mutant to reports/tests/test_kind_teardown_observation.py by an\nexact single replacement, runs the guard module (in-process cases only: fake Docker, git show) and\nrestores the file. A mutant is killed only if it has failures beyond the unmutated baseline M0.\n\"\"\"\nimport json, re, subprocess, sys\nfrom pathlib import Path\n\nSRC = Path(\"/home/luca/projects/ocor-detailed-design\")\ncommit, py = sys.argv[1], sys.argv[2]\nW = Path(f\"/tmp/rem0045-mutation-{commit[:12]}\")\nif W.exists():\n    subprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"remove\", \"--force\", str(W)], check=True)\nsubprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"add\", \"-q\", \"--detach\", str(W), commit], check=True)\nF = W / \"reports/tests/test_kind_teardown_observation.py\"\noriginal = F.read_text()\nMUTANTS = {\n    \"M0\": (\"unmutated\", None, None),\n    \"M1\": (\"current proof disabled (early return)\", \"    overrides = overrides or {}\\n\\n    def current(path):\",\n           \"    overrides = overrides or {}\\n    return {'baseline': GUARD_BASELINE, 'byte_identical_sha256': {}, 'observer_constants': [], 'probe_timeouts': []}\\n\\n    def current(path):\"),\n    \"M2\": (\"supervisor compared by AST (option 2 of the decision request)\", \"        if data != baseline_bytes(path):\",\n           \"        if (ast.dump(ast.parse(data)) if path == CAMPAIGN_PATH and data else data) != (ast.dump(ast.parse(baseline_bytes(path))) if path == CAMPAIGN_PATH and data else baseline_bytes(path)):\"),\n    \"M3\": (\"workflow set unchecked\", \"    if sorted(present) != expected:\", \"    if False:\"),\n    \"M4\": (\"observer constants unchecked\", \"    if observer_constants(observer) != observer_constants(baseline_text(OBSERVER_PATH)):\", \"    if False:\"),\n    \"M5\": (\"probe timeouts unchecked\", \"    if timeouts != {'10'}:\", \"    if False:\"),\n    \"M6\": (\"supervisor excluded from the byte identity\", \"    for path in expected + [CAMPAIGN_PATH]:\", \"    for path in expected:\"),\n}\nout = {\"commit\": commit, \"file\": \"reports/tests/test_kind_teardown_observation.py\", \"mutants\": {}}\nfor key, (label, old, new) in MUTANTS.items():\n    if old is not None:\n        assert original.count(old) == 1, (key, original.count(old))\n        F.write_text(original.replace(old, new, 1))\n    r = subprocess.run([py, \"-B\", \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"--tb=no\", \"-rf\", \"reports/tests/test_kind_teardown_observation.py\"],\n                       cwd=W, capture_output=True, text=True)\n    F.write_text(original)\n    summary = r.stdout.strip().splitlines()[-1]\n    failed = int(m.group(1)) if (m := re.search(r\"(\\d+) failed\", summary)) else 0\n    subfailed = len([l for l in r.stdout.splitlines() if l.startswith(\"SUBFAILED\")])\n    out[\"mutants\"][key] = {\"label\": label, \"exit_code\": r.returncode, \"summary\": summary, \"failed\": failed, \"subtests_failed\": subfailed,\n                           \"failing\": sorted(l for l in r.stdout.splitlines() if l.startswith((\"FAILED\", \"SUBFAILED\")))}\n    print(key, label, \"->\", summary, flush=True)\nbase = out[\"mutants\"][\"M0\"]\nassert base[\"exit_code\"] == 0 and base[\"failed\"] == 0, base\nfor key, m in out[\"mutants\"].items():\n    if key != \"M0\":\n        m[\"killed\"] = m[\"failed\"] + m[\"subtests_failed\"] > 0\nout[\"all_killed\"] = all(m.get(\"killed\", True) for m in out[\"mutants\"].values())\nout[\"restored_clean\"] = subprocess.run([\"git\", \"status\", \"--porcelain\"], cwd=W, capture_output=True, text=True).stdout == \"\"\nsubprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"remove\", \"--force\", str(W)], check=True)\nprint(json.dumps(out, indent=2, sort_keys=True))\n", "sha256": "5213c506ee9b27526447f2e55af273fab5e6d9f5fc3e26fb29860c6ff8512c79"}
