{"command": "captured artifact: exact local campaign driver: frozen extras, unchanged repository full harness and limits", "exit_code": 0, "label": "qualifying-local-driver", "output": "\"\"\"OCOR-DEV-0057 qualifying campaign (Claude Code, Anthropic; reserve implementer).\n\nOne stack, sequential: preflight (toolchain lock, inputs, harness, drift, reset,\nbootstrap, bounded Fuseki profile, sync, init, fixtures, SVID, typed health),\ntask file x3 + backlog validation command, reports/tests portfolio, then the\ngoverned full suite through scripts/run_qualifying_campaign.py (75-min limit).\nEvery step: verbatim redacted log, exit code, duration, sha256. Fail-closed.\n\"\"\"\nimport hashlib, json, os, re, shutil, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nD = Path(__file__).parent\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0057')\nPY = R / 'ocor-runtime/.venv/bin/python'\nenv = os.environ.copy()\nenv.update(PATH='/home/luca/.ocor-codex/rem0019-escalation-20261020/isolated-git/usr/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:/home/luca/.local/bin:' + env['PATH'],\n           GIT_PAGER='cat', PAGER='cat', GH_PROMPT_DISABLED='1', GIT_EDITOR='true', PYTHONHASHSEED='0', TZ='UTC')\nfor k in list(env):\n    if k.startswith('OCOR_'):\n        env.pop(k, None)\nsecret = R / '.ocor/bootstrap.env'\nvalues: dict[str, str] = {}\nrows: list[dict] = []\nphase = sys.argv[1] if len(sys.argv) > 1 else 'all'\nif (D / 'commands.json').exists():\n    rows = json.loads((D / 'commands.json').read_text())\n\n\ndef load_values() -> None:\n    values.clear()\n    values.update(dict(l.split('=', 1) for l in secret.read_text().splitlines() if '=' in l))\n\n\ndef redact(text: str) -> str:\n    for k, v in values.items():\n        if ('PASSWORD' in k or 'TOKEN' in k) and len(v) > 7:\n            text = text.replace(v, '<REDACTED_LOCAL_CREDENTIAL>')\n    return text\n\n\ndef dump(p: Path, d: object) -> None:\n    p.write_text(json.dumps(d, indent=2, sort_keys=True) + '\\n')\n\n\ndef inventory() -> dict:\n    return {k: sorted(subprocess.check_output(c, text=True, timeout=60, env=env).split()) for k, c in [\n        ('containers', ['docker', 'ps', '-a', '--format', '{{.Names}}']), ('volumes', ['docker', 'volume', 'ls', '-q']),\n        ('networks', ['docker', 'network', 'ls', '--format', '{{.Name}}'])]}\n\n\ndef junit(path: Path) -> dict:\n    root = ET.parse(path).getroot()\n    suites = [root] if root.tag == 'testsuite' else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in ('tests', 'failures', 'errors', 'skipped')}\n    return {'passed': t['tests'] - t['failures'] - t['errors'] - t['skipped'], 'failed': t['failures'], 'errors': t['errors'],\n            'skipped': t['skipped'], 'not_executed': 0, 'tests': t['tests']}\n\n\ndef run(label, c, limit=600, fatal=True, xml=None, live=False, cwd=R):\n    e = dict(env)\n    if live:\n        e.update(values)\n        e['OCOR_BOOTSTRAP_ENV'] = str(secret)\n        e['OCOR_LIVE_POSTGRES_DSN'] = 'postgresql://ocor:' + values['OCOR_LOCAL_POSTGRES_PASSWORD'] + '@127.0.0.1:55433/ocor'\n    t = time.monotonic()\n    started = datetime.now(UTC).isoformat()\n    try:\n        r = subprocess.run(c, cwd=cwd, env=e, capture_output=True, text=True, timeout=limit)\n        rc, out = r.returncode, r.stdout + r.stderr\n    except subprocess.TimeoutExpired as exc:\n        rc = 124\n        out = (exc.stdout or b'').decode(errors='replace') if isinstance(exc.stdout, bytes) else (exc.stdout or '')\n        out += f'\\nTIMEOUT after {limit}s\\n'\n    out = redact(out)\n    p = D / (label + '.log')\n    p.write_text(out)\n    p.chmod(0o600)\n    row = {'label': label, 'command': c, 'exit_code': rc, 'started_at': started, 'duration_seconds': round(time.monotonic() - t, 3),\n           'raw_sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'head_sha': head, 'status': 'PASS' if rc == 0 else 'FAIL'}\n    if live:\n        row['environment'] = 'OCOR_LIVE_POSTGRES_DSN=<local generated credential>'\n    if xml is not None and Path(xml).exists():\n        row['result'] = junit(Path(xml))\n        row['junit_sha256'] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if row['result']['skipped'] or row['result']['failed'] or row['result']['errors']:\n            row['status'] = 'FAIL'\n    rows.append(row)\n    dump(D / 'commands.json', rows)\n    print(label, row['status'], rc, flush=True)\n    if fatal and row['status'] != 'PASS':\n        raise SystemExit(f'ABORT at {label}')\n    return out\n\n\ndef portfolio_files() -> list[str]:\n    return ['reports/tests/test_generate_contracts_reference_resolution.py', 'reports/tests/test_backlog_generator_reality_parity.py',\n            'reports/tests/test_runtime_evidence_validator.py', 'reports/tests/test_evidence_input_drift.py',\n            'reports/tests/test_language_migration_benchmark_harness.py', 'reports/tests/test_qualifying_campaign_guard.py',\n            'reports/tests/test_fuseki_archive_acquisition.py', 'reports/tests/test_kind_teardown_observation.py',\n            'reports/tests/test_ci_fuseki_archive.py', 'reports/tests/test_rem0034_secret_registry.py',\n            'reports/tests/test_rem0023_consumer_fixture_scope.py']\n\n\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\nassert not subprocess.check_output(['git', 'status', '--porcelain'], cwd=R, text=True, env=env).strip(), 'dirty worktree'\nif phase == 'devstack':\n    # Development-only stack bring-up (never evidence): rows go to a separate file.\n    D = D.parent / 'dev'\n    rows = []\nif phase in ('all', 'preflight', 'devstack'):\n    if secret.exists():\n        load_values()\n    dump(D / 'resources-before.json', inventory())\n    lock = json.loads((R / 'infra/toolchain.lock.json').read_text())\n    tools = []\n    for x in lock['tools']:\n        if x['provider'] == 'container':\n            props = json.loads(subprocess.check_output(['docker', 'image', 'inspect', x['container_image']], text=True, env=env, timeout=30))[0]\n            java = next(v.split('=', 1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env'] + '='))\n            assert java.removeprefix('jdk-') == x['version'] and x['container_image'] in props['RepoDigests']\n            tools.append({'id': x['id'], 'version': java, 'version_match': True, 'digest_match': True})\n            continue\n        p = PY if x['id'] == 'python' else Path(shutil.which(x['command'], path=env['PATH']))\n        v = subprocess.check_output([str(p), *x['version_args']], text=True, env=env, stderr=subprocess.STDOUT, timeout=30).strip()\n        digest = hashlib.sha256(p.read_bytes()).hexdigest()\n        row = {'id': x['id'], 'path': str(p), 'version': v, 'version_match': bool(re.search(x['version_pattern'], v)), 'sha256': digest, 'digest_match': digest == x['integrity']}\n        tools.append(row)\n        assert row['version_match'] and row['digest_match'], x['id']\n    dump(D / 'toolchain.json', {'tools': tools})\n    try:\n        run('inputs', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS'])\n        run('verify', [str(PY), 'scripts/verify.py', '--json'])\n        run('baseline-drift', [str(PY), 'scripts/validate_evidence_input_drift.py'])\n        run('reset', [str(PY), 'scripts/reset_test_environment.py', '--execute'], fatal=phase != 'devstack')\n        run('bootstrap', [str(PY), 'scripts/bootstrap_development_environment.py', '--execute', '--timeout', '600'], 700)\n        load_values()\n        sys.path.insert(0, str(R / 'scripts'))\n        from bootstrap_ci_environment import ci_resources\n        profile = ci_resources(R)\n        run('bounded-fuseki-profile', ['docker', 'compose', '--env-file', str(secret), '-f', 'deploy/bootstrap/compose.yaml', '-f', str(profile), 'up', '--detach', '--no-build', '--wait', '--wait-timeout', '120', 'fuseki'], 180)\n        actual = run('bounded-fuseki-process', ['docker', 'top', 'ocor-bootstrap-fuseki-1', '-eo', 'pid,args'])\n        assert '-Xms128m -Xmx1G' in actual and '-Xmx4G' not in actual\n        run('sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n        run('initialize', [str(PY), 'deploy/bootstrap/init/initialize_services.py', '--env-file', str(secret)])\n        run('fixtures', [str(PY), 'deploy/bootstrap/fixtures/load_fixtures.py', '--env-file', str(secret)])\n        run('svid', [str(PY), str(Path(__file__).parent / 'register_control_plane.py')])\n        health = json.loads(run('typed-health', [str(PY), 'scripts/verify_external_services.py', '--execute', '--typed']))\n        assert health['status'] == 'PASS'\n        ids = subprocess.check_output(['docker', 'ps', '-aq', '--filter', 'label=com.docker.compose.project=ocor-bootstrap'], text=True, env=env, timeout=30).split()\n        assert len(ids) == 11\n        props = json.loads(subprocess.check_output(['docker', 'inspect', *ids], text=True, env=env, timeout=30))\n        summary = [{'name': c['Name'], 'image_id': c['Image'], 'running': c['State']['Running'], 'oom': c['State']['OOMKilled'], 'restarts': c['RestartCount']} for c in props]\n        assert all(c['running'] and not c['oom'] and c['restarts'] == 0 for c in summary)\n        dump(D / 'stack-summary.json', summary)\n    finally:\n        subprocess.run(['git', 'restore', 'reports/verify_report.json'], cwd=R, check=True)\nif phase in ('all', 'task'):\n    load_values()\n    before = inventory()\n    for n in (1, 2, 3):\n        x = D / f'task-{n}.xml'\n        run(f'task-run-{n}', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', 'ocor-runtime/tests/tasks/test_ocor_dev_0057.py'], 45 * 60, xml=x, live=True)\nif phase in ('all', 'task', 'task2'):\n    load_values()\n    if phase == 'task2':\n        before = inventory()\n    x = D / 'task-validation-command-project.xml'\n    run('task-validation-command-project', ['uv', 'run', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', 'ocor-runtime/tests/tasks/test_ocor_dev_0057.py'], 45 * 60, xml=x, live=True)\n    x = D / 'regression-0052.xml'\n    run('regression-0052', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', 'ocor-runtime/tests/tasks/test_ocor_dev_0052.py'], 45 * 60, xml=x, live=True)\n    after = inventory()\n    delta = {k: sorted(set(after[k]) - set(before[k])) for k in before}\n    dump(D / 'task-resource-delta.json', delta)\n    assert not any(delta.values()), delta\n    run('sdk-ci', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'ci'], 900)\n    run('sdk-build', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'run', 'build'], 900)\n    x = D / 'reports-portfolio.xml'\n    portfolio = portfolio_files()\n    _unused = ['reports/tests/test_generate_contracts_reference_resolution.py', 'reports/tests/test_backlog_generator_reality_parity.py',\n                 'reports/tests/test_runtime_evidence_validator.py', 'reports/tests/test_evidence_input_drift.py',\n                 'reports/tests/test_language_migration_benchmark_harness.py', 'reports/tests/test_qualifying_campaign_guard.py',\n                 'reports/tests/test_fuseki_archive_acquisition.py', 'reports/tests/test_kind_teardown_observation.py',\n                 'reports/tests/test_ci_fuseki_archive.py', 'reports/tests/test_rem0034_secret_registry.py',\n                 'reports/tests/test_rem0023_consumer_fixture_scope.py']\n    run('reports-portfolio', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', *portfolio, f'--junitxml={x}'], 1200, xml=x)\n    subprocess.run(['git', 'checkout', '--', 'reports/'], cwd=R, check=True)\nif phase == 'portfolio2':\n    load_values()\n    run('sdk-ci', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'ci'], 900)\n    run('sdk-build', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'run', 'build'], 900)\n    x = D / 'reports-portfolio-sdk.xml'\n    run('reports-portfolio-sdk', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', *portfolio_files(), f'--junitxml={x}'], 1200, xml=x)\n    subprocess.run(['git', 'checkout', '--', 'reports/'], cwd=R, check=True)\nif phase in ('all', 'task2', 'full', 'portfolio2'):\n    load_values()\n    run('full-reset', [str(PY), 'scripts/reset_test_environment.py', '--execute'])\n    run('full-bootstrap', [str(PY), 'scripts/bootstrap_development_environment.py', '--execute', '--timeout', '600'], 700)\n    run('full-sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n    run('full-mypy-ready', [str(PY), '-c', 'import mypy.version; print(mypy.version.__version__)'])\n    load_values()\n    sys.path.insert(0, str(R / 'scripts'))\n    from bootstrap_ci_environment import ci_resources\n    profile = ci_resources(R)\n    run('full-bounded-fuseki', ['docker', 'compose', '--env-file', str(secret), '-f', 'deploy/bootstrap/compose.yaml', '-f', str(profile), 'up', '--detach', '--no-build', '--wait', '--wait-timeout', '120', 'fuseki'], 180)\n    run('full-initialize', [str(PY), 'deploy/bootstrap/init/initialize_services.py', '--env-file', str(secret)])\n    run('full-fixtures', [str(PY), 'deploy/bootstrap/fixtures/load_fixtures.py', '--env-file', str(secret)])\n    run('full-svid', [str(PY), str(Path(__file__).parent / 'register_control_plane.py')])\n    health = json.loads(run('full-health', [str(PY), 'scripts/verify_external_services.py', '--execute', '--typed']))\n    assert health['status'] == 'PASS'\n    dump(D / 'resources-before-full.json', inventory())\n    run('full-suite', [str(PY), 'scripts/run_qualifying_campaign.py', '--execute', '--repository', '.', '--expected-head', head, '--output-dir', str(D / 'full')], 4650, live=True)\n    dump(D / 'resources-after-full.json', inventory())\nif phase == 'gates':\n    load_values()\n    run('ruff', ['ruff', 'check', '.'])\n    run('mypy', [str(PY), '-m', 'mypy', '--strict'])\n    run('harness', [str(PY), 'scripts/verify.py', '--json'])\n    subprocess.run(['git', 'restore', 'reports/verify_report.json'], cwd=R, check=True)\n    run('plan', [str(PY), 'scripts/validate_ocor_development_plan.py', '--base-ref', 'HEAD', '--authorized-extension'])\n    subprocess.run(['git', 'checkout', '--', 'reports/planning/'], cwd=R, check=True)\n    run('rccad', [str(PY), 'scripts/validate_rccad.py', '--base-ref', 'origin/main'])\n    run('language', [str(PY), 'scripts/validate_language_policy.py'])\n    run('drift', [str(PY), 'scripts/validate_evidence_input_drift.py'])\n    run('scope', [str(PY), 'scripts/validate_ocor_change_scope.py', '--base', 'origin/main', '--branch', 'task/OCOR-DEV-0057-context-assembly-receipts'])\n    run('inputs-final', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS'])\nprint('DONE', flush=True)\n", "sha256": "b4ea09f8c430854a04e7aa5f371682567c6149c04cf72ba175bcb6a626d12f1f"}
