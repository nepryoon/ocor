{"command": "captured artifact: mutated scratch source and tests byte-identical to the final code commit", "exit_code": 0, "label": "mutation-inputs", "output": "{\n  \"commit\": \"24a8ec2ac5f90774a8bca5c2e08a32cebc92be95\",\n  \"files\": {\n    \"ocor-runtime/src/ocor_runtime/memory/context.py\": {\n      \"commit_blob_sha256\": \"453fc2c400228453496a6b8cb1fb42b753a31cd27a13c3e3194d7302f899c84e\",\n      \"equal\": true,\n      \"scratch_sha256\": \"453fc2c400228453496a6b8cb1fb42b753a31cd27a13c3e3194d7302f899c84e\"\n    },\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0051.py\": {\n      \"commit_blob_sha256\": \"904f8b52b5a6b3727e1be2b941448367d8cb6000c8b11b3444141eb049c925f2\",\n      \"equal\": true,\n      \"scratch_sha256\": \"904f8b52b5a6b3727e1be2b941448367d8cb6000c8b11b3444141eb049c925f2\"\n    },\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0052.py\": {\n      \"commit_blob_sha256\": \"dec77625fe883e3410ad19403b348fb0dff4afd89bb82bae4e80f1cae62b71cd\",\n      \"equal\": true,\n      \"scratch_sha256\": \"dec77625fe883e3410ad19403b348fb0dff4afd89bb82bae4e80f1cae62b71cd\"\n    },\n    \"ocor-runtime/tests/tasks/test_ocor_dev_0057.py\": {\n      \"commit_blob_sha256\": \"c13533fb84972014dc498f0e8500abe7975ca2db31e5cce1cb7132d008925904\",\n      \"equal\": true,\n      \"scratch_sha256\": \"c13533fb84972014dc498f0e8500abe7975ca2db31e5cce1cb7132d008925904\"\n    }\n  }\n}\n", "sha256": "6b5203f708d9c113a8e3b25d78cdb9b1c59019ab51ebf5b1712d610d7902e94e"}
{"command": "captured artifact: exact mutation harness, archived for reproduction", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-0057 mutation probe (Claude Code, Anthropic).\n\nMutates memory/context.py on a git-archive scratch tree of the code commit\n(pyproject pythonpath=src resolves to the scratch tree) and runs the\ndeterministic (non-live) cases; every mutant must be killed by an assertion\nor expected-exception failure, never by a collection/import error.\n\"\"\"\nimport hashlib, json, os, subprocess, sys\nfrom pathlib import Path\nr = Path.home() / '.ocor-codex/ocor-dev-0057/mutscratch'\np = r / 'ocor-runtime/src/ocor_runtime/memory/context.py'\npy = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0057/ocor-runtime/.venv/bin/python')\nd = Path.home() / '.ocor-codex/ocor-dev-0057/mutation'\noriginal = p.read_text()\nI12 = ' ' * 12\nmutants = {\n 'skip-final-revalidation': ('        for entry, candidate in zip(selected, read, strict=True):\\n            self._require_unchanged(plan, entry, candidate)\\n', ''),\n 'skip-post-read-checks': (I12 + '# A stop or revocation during the read leaves nothing behind.\\n' + I12 + 'self._search.require_stop_epoch(plan)\\n' + I12 + 'self._require_unchanged(plan, entry, candidate)\\n', ''),\n 'skip-content-digest': ('            if not hmac.compare_digest(payload_digest, entry.content_digest):', '            if False:'),\n 'redaction-not-applied': ('            parts.append(profile.redaction_marker.format(reason_code=span.reason_code))', '            parts.append(text[span.start : span.end])'),\n 'truncation-not-prefix': ('            fits = not truncated and len(context) + len(block) <= parsed.max_context_bytes', '            fits = len(context) + len(block) <= parsed.max_context_bytes'),\n 'replay-skip-core-compare': ('            if not hmac.compare_digest(canonical_digest(built.core), str(replay_digest)):', '            if False:'),\n 'replay-skip-query-check': ('                query_digest != core.get(\"query_digest\")', '                False'),\n 'replay-skip-budget-check': ('                or parsed.max_context_bytes != core.get(\"max_context_bytes\")', ''),\n 'replay-skip-receipt-digest': ('                and canonical_digest(body) == audit_ref\\n', ''),\n 'replay-skip-gcs-check': ('            if core.get(\"governed_context_digest\") != parsed.gcs_digest:', '            if False:'),\n 'swallow-audit-failure': ('        except Exception as exc:  # noqa: BLE001 -- no audit, no context\\n            raise MemoryContextError(\\n                \"CONTROL_PLANE_UNAVAILABLE\", \"AUDIT_UNAVAILABLE\", \"context audit failed closed\"\\n            ) from exc\\n        return audit_ref', '        except Exception:  # noqa: BLE001\\n            pass\\n        return audit_ref'),\n 'skip-bundle-check': ('        if decision.policy_bundle_digest != context.policy_bundle_digest:', '        if False:'),\n 'skip-overlap-check': ('            if span.start < previous_end:', '            if False:'),\n 'include-denied-items': ('            if not decision.permitted:\\n', '            if False:\\n'),\n 'skip-search-context-check': ('            search_request.get(\"governed_context_digest\") != claimed\\n            or search_request.get(\"governed_context\") != raw_context\\n', '            False\\n'),\n 'no-denial-audit': ('            self._audit.record(MappingProxyType({**event, \"audit_ref\": canonical_digest(event)}))', '            pass'),\n 'skip-header-budget': ('        if len(header) > parsed.max_context_bytes:', '        if False:'),\n 'policy-decisions-in-core': ('            \"candidates\": [entry.to_mapping() for entry in selected],', '            \"candidates\": [entry.to_mapping() for entry in selected],\\n            \"decisions\": list(decisions),'),\n 'escape-free-rendering': ('                    \"data\": \"\".join(parts),\\n                }\\n            )\\n            + b\"\\\\n\"', '                    \"data\": \"\",\\n                }\\n            )[:-1]\\n            + b\\',\"data\":\"\\' + \"\".join(parts).encode() + b\\'\"}\\\\n\\''),\n}\nresults = {}\ntry:\n    for name, (old, new) in mutants.items():\n        assert original.count(old) == 1, (name, original.count(old))\n        p.write_text(original.replace(old, new))\n        res = subprocess.run([str(py), '-m', 'pytest', '-q', '-x', '-p', 'no:cacheprovider', 'tests/tasks/test_ocor_dev_0057.py', '-k', 'not live'],\n                             cwd=r / 'ocor-runtime', env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, capture_output=True, text=True, timeout=300)\n        raw = res.stdout + res.stderr\n        (d / f'mutant-{name}.log').write_text(raw)\n        killed = res.returncode == 1 and ('AssertionError' in raw or 'DID NOT RAISE' in raw or 'FAILED' in raw) and 'ERROR collecting' not in raw\n        results[name] = {'killed': killed, 'exit_code': res.returncode, 'raw_sha256': hashlib.sha256(raw.encode()).hexdigest(), 'summary': raw.strip().splitlines()[-1]}\n        print(name, results[name], flush=True)\nfinally:\n    p.write_text(original)\n(d / 'mutation-probe.json').write_text(json.dumps(results, indent=2, sort_keys=True) + '\\n')\nsys.exit(0 if all(v['killed'] for v in results.values()) else 1)\n", "sha256": "e22ffe521800af5054b573525d3c9a01126fd542ac1306f6fbe3058a3387e1c1"}
