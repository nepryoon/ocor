_call_deadline_must_be_positive_and_within_the_containment_target[deadline0]\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_the_call_deadline_must_be_positive_and_within_the_containment_target[deadline1]\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_the_call_deadline_must_be_positive_and_within_the_containment_target[deadline2]\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_issued_before_a_stop_is_refused_after_the_dual_control_reset\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_records_the_epoch_of_the_trusted_controller\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_bound_authority_issues_no_lease_while_the_stop_is_active\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_not_bound_to_a_stop_epoch_is_refused\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_an_authority_bound_to_one_controller_cannot_be_rebound_to_another\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_an_unauthorized_second_tool_is_refused_before_any_effect\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_revoked_during_the_expression_refuses_the_next_tool\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_issued_before_a_stop_cannot_delegate_after_the_reset\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_pre_stop_lease_cannot_delegate_with_a_backdated_issuance_after_the_reset\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_lease_of_the_current_epoch_still_delegates\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_command_fenced_before_the_stop_is_refused_even_with_a_fresh_lease\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_parent_bound_to_no_epoch_cannot_delegate_after_a_stop_and_reset\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_parent_bound_to_no_epoch_cannot_delegate_even_without_a_stop\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_a_child_of_a_parent_of_the_current_epoch_runs_its_tool\",\n    \"tests/tasks/test_ocor_dev_rem_0027.py::test_the_