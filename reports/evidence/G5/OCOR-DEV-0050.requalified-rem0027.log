{"command": "captured artifact: source of the mutation probe (mutant table)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-REM-0027 (repair 1) mutation probe: each mutant of the C8/C6 sources must be killed by test_ocor_dev_rem_0027.py.\n\nRuns in a separate detached worktree at the campaign commit; restores the file after each mutant and verifies\nthe restored blobs equal HEAD. Usage: mutation_probe.py <worktree> <log_dir>\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nfrom pathlib import Path\n\nW = Path(sys.argv[1]); L = Path(sys.argv[2]); L.mkdir(parents=True, exist_ok=True)\nSRC = W / \"ocor-runtime/src/ocor_runtime\"\nTR, CAP = \"c8/tool_runtime.py\", \"c6_capabilities.py\"\nMUTANTS = {\n    \"M1-no-fence-at-tool-dispatch\": (TR, \"        self._authorize_tool(lease_id, name, subject=subject, at=at)\\n        self._fence(fenced_epoch)\\n\",\n                                     \"        self._authorize_tool(lease_id, name, subject=subject, at=at)\\n\"),\n    \"M2-caller-epoch-trusted\": (TR, \"        if stop_epoch != lease_epoch:\\n\", \"        if False:\\n\"),\n    \"M3-unbound-lease-accepted\": (TR, '        if lease_epoch is None:\\n            raise ToolRuntimeError(\"STOP_BOUND_DENIED\", \"capability lease is not bound to an emergency-stop epoch\")\\n',\n                                  \"        if lease_epoch is None:\\n            lease_epoch = stop_epoch\\n\"),\n    \"M4-no-preflight-of-called-tools\": (TR, \"        for called in self._called_tools(expression):\\n\", \"        for called in ():\\n\"),\n    \"M5-no-reauthorization-at-dispatch\": (TR, \"        self._authorize_tool(lease_id, name, subject=subject, at=at)\\n        self._fence(fenced_epoch)\\n\",\n                                          \"        self._fence(fenced_epoch)\\n\"),\n    \"M6-supervision-ignores-stop\": (TR, \"        while not worker.done.wait(_SUPERVISION_INTERVAL_SECONDS):\\n            if _stop_accepted(self._stop, fenced_epoch):\\n\",\n                                    \"        while not worker.done.wait(_SUPERVISION_INTERVAL_SECONDS):\\n            if False:\\n\"),\n    \"M7-supervision-ignores-deadline\": (TR, \"            if time.monotonic() >= deadline:\\n\", \"            if False:\\n\"),\n    \"M8-deadline-cancel-not-signalled\": (TR, \"    return call.cancelled.is_set() or _stop_accepted(call.stop, call.fenced_epoch)\\n\",\n                                         \"    return _stop_accepted(call.stop, call.fenced_epoch)\\n\"),\n    \"M9-stop-during-completed-call-ignored\": (TR, \"        if _stop_accepted(self._stop, fenced_epoch):\\n            raise ToolRuntimeError(\\n                \\\"STOP_BOUND_DENIED\\\",\\n                f\\\"emergency stop accepted while tool {name!r} was running; its outcome\",\n                                              \"        if False:\\n            raise ToolRuntimeError(\\n                \\\"STOP_BOUND_DENIED\\\",\\n                f\\\"emergency stop accepted while tool {name!r} was running; its outcome\"),\n    \"M10-deadline-upper-bound-dropped\": (TR, \"not timedelta(0) < tool_call_deadline <= CONTAINMENT_TARGET\", \"not timedelta(0) < tool_call_deadline\"),\n    \"M11-issuance-not-guarded\": (CAP, \"            stop.guard_dispatch(fenced_epoch=epoch)\\n\", \"            stop.epoch\\n\"),\n    \"M12-rebinding-allowed\": (CAP, \"            elif self._stop is not stop:\\n\", \"            elif False:\\n\"),\n    \"M13-lease-not-bound-to-epoch\": (CAP, \"            stop_epoch=stop_epoch,\\n        )\", \"            stop_epoch=None,\\n        )\"),\n    \"M14-delegation-epoch-unchecked\": (CAP, \"        if parent.stop_epoch is not None and child.stop_epoch != parent.stop_epoch:\\n\", \"        if False:\\n\"),\n    # repair 1 (verdict OCOR-DEV-REM-0027-f48452c64777-0)\n    \"M15-VF001-no-preemption\": (TR, \"            worker.preempt()\\n\", \"            worker.done.is_set()\\n\"),\n    \"M16-VF001-preemption-catchable-as-Exception\": (TR, \"class ToolPreempted(BaseException):\\n\", \"class ToolPreempted(Exception):\\n\"),\n    \"M17-VF002-epochless-parent-delegates\": (CAP, \"        if child.stop_epoch is not None and parent.stop_epoch is None:\\n\", \"        if False:\\n\"),\n    \"M18-VF003-authorize-not-stop-fenced\": (CAP, \"            self._require_current_stop_epoch(authoritative)\\n\", \"\"),\n    \"M19-VF003-ledger-not-swept\": (CAP, \"        if current == self._swept_epoch:\\n            return\\n\", \"        return\\n\"),\n    \"M20-VF003-revoked-at-not-the-stop\": (CAP, \"revoked_at=max(accepted_at, lease.issued_at)\", \"revoked_at=lease.issued_at\"),\n    \"M21-VF003-stop-denial-reported-as-capability\": (TR, '        except StopEpochDenied as error:\\n            raise ToolRuntimeError(\"STOP_BOUND_DENIED\", str(error)) from error\\n', \"\"),\n    \"M22-VF003-stop-denial-at-dispatch-as-capability\": (TR, \"        except StopEpochDenied as error:\\n            raise ToolRuntimeError(\\\"STOP_BOUND_DENIED\\\", f\\\"tool {name!r} is fenced\", \"        except KeyError as error:\\n            raise ToolRuntimeError(\\\"STOP_BOUND_DENIED\\\", f\\\"tool {name!r} is fenced\"),\n}\nFILES = {TR, CAP}\nORIG = {name: (SRC / name).read_text() for name in FILES}\nresults = []\nfor name, (fname, old, new) in MUTANTS.items():\n    F = SRC / fname\n    assert ORIG[fname].count(old) == 1, name\n    F.write_text(ORIG[fname].replace(old, new, 1))\n    started = time.time()\n    try:\n        p = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-x\",\n                            \"tests/tasks/test_ocor_dev_rem_0027.py\"], cwd=W / \"ocor-runtime\", capture_output=True, text=True, timeout=900)\n        rc, out = p.returncode, p.stdout + p.stderr\n    finally:\n        F.write_text(ORIG[fname])\n    (L / f\"mutant-{name}.log\").write_text(out)\n    killed = rc != 0\n    results.append({\"mutant\": name, \"file\": f\"ocor-runtime/src/ocor_runtime/{fname}\", \"replacement\": {\"from\": old, \"to\": new},\n                    \"pytest_exit\": rc, \"killed\": killed, \"log\": f\"mutant-{name}.log\",\n                    \"log_sha256\": hashlib.sha256(out.encode()).hexdigest(), \"duration_seconds\": round(time.time() - started, 1)})\n    print(name, \"KILLED\" if killed else \"SURVIVED\", flush=True)\nrestored = {}\nfor fname in FILES:\n    blob = subprocess.check_output([\"git\", \"hash-object\", str(SRC / fname)], text=True).strip()\n    head = subprocess.check_output([\"git\", \"rev-parse\", f\"HEAD:ocor-runtime/src/ocor_runtime/{fname}\"], cwd=W, text=True).strip()\n    restored[fname] = blob == head\nstatus = subprocess.check_output([\"git\", \"status\", \"--porcelain\"], cwd=W, text=True)\nsummary = {\"head\": subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=W, text=True).strip(), \"results\": results,\n           \"killed\": sum(r[\"killed\"] for r in results), \"total\": len(results), \"restored_blob_equals_head\": all(restored.values()),\n           \"restored_by_file\": restored, \"worktree_clean_after\": status == \"\"}\n(L / \"mutation-probe.json\").write_text(json.dumps(summary, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({k: summary[k] for k in (\"killed\", \"total\", \"restored_blob_equals_head\", \"worktree_clean_after\")}))\n", "sha256": "75728cc2dc27f439d7715787064b4ba8967e7fff7df491e5bfbc31679880b74c"}
