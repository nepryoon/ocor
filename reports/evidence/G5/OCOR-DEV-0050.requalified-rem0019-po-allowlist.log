{"command": "Captured raw artifact preflight.py", "exit_code": 0, "label": "script-preflight", "output": "import sys\nimport hashlib,json,os,re,shutil,subprocess,time\nfrom pathlib import Path\nD=Path(__file__).parent\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-po-allowlist')\nPY=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019/ocor-runtime/.venv/bin/python')\nenv=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')\nrows=[]\ndef dump(p,d):p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\\n')\ndef inventory():\n return {k:sorted(subprocess.check_output(c,text=True,timeout=30,env=env).splitlines()) for k,c in [('containers',['docker','ps','-aq']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','-q'])]}\ndef run(label,c,limit=600):\n t=time.monotonic();r=subprocess.run(c,cwd=R,env=env,capture_output=True,text=True,timeout=limit)\n out=r.stdout+r.stderr\n for k,v in values.items():\n  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:out=out.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n p=D/(label+'.log');p.write_text(out);p.chmod(0o600)\n row={'label':label,'command':c,'exit_code':r.returncode,'duration_seconds':round(time.monotonic()-t,3),'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest()};rows.append(row);dump(D/'preflight-commands.json',rows);print(label,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(label+' failed; inspect redacted log')\n return out\nvalues=dict(l.split('=',1) for l in Path('/home/luca/projects/ocor-detailed-design/.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\nfor k in values:env.pop(k,None)\nsecret=R/'.ocor/bootstrap.env';spire=R/'.ocor/spire';spire.mkdir(parents=True,exist_ok=True)\nsubprocess.run(['openssl','req','-x509','-newkey','rsa:3072','-nodes','-keyout',str(spire/'ca.key'),'-out',str(spire/'ca.crt'),'-days','2','-subj','/C=IT/O=OCOR Test/CN=OCOR SPIRE Test CA'],capture_output=True,check=True,timeout=30)\n(spire/'ca.key').chmod(0o600)\nvalues['OCOR_SPIRE_BOOTSTRAP_DIR']=str(spire);values['OCOR_SPIRE_JOIN_TOKEN']='bootstrap-pending'\nsecret.write_text(''.join(k+'='+v+'\\n' for k,v in sorted(values.items())));secret.chmod(0o600)\ndump(D/'resources-before.json',inventory())\nlock=json.loads((R/'infra/toolchain.lock.json').read_text());tools=[]\nfor x in lock['tools']:\n if x['provider']=='container':\n  props=json.loads(subprocess.check_output(['docker','image','inspect',x['container_image']],text=True,env=env,timeout=30))[0]\n  java=next(v.split('=',1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env']+'='))\n  assert java.removeprefix('jdk-')==x['version'];tools.append({'id':x['id'],'version':java,'expected_version':x['version'],'version_match':True,'digest_match':x['container_image'] in props['RepoDigests']});continue\n p=PY if x['id']=='python' else Path(shutil.which(x['command'],path=env['PATH']))\n v=subprocess.check_output([str(p),*x['version_args']],text=True,env=env,stderr=subprocess.STDOUT,timeout=30).strip()\n digest=hashlib.sha256(p.read_bytes()).hexdigest(); row={'id':x['id'],'path':str(p),'version':v,'version_match':bool(re.search(x['version_pattern'],v)),'sha256':digest,'digest_match':digest==x['integrity']};tools.append(row);assert row['version_match'] and row['digest_match'],x['id']\ndump(D/'toolchain.json',{'tools':tools})\ntry:\n run('inputs',['sha256sum','-c','inputs/normative/SHA256SUMS'])\n run('verify',[str(PY),'scripts/verify.py','--json'])\n run('drift',[str(PY),'scripts/validate_evidence_input_drift.py'])\n run('reset',[str(PY),'scripts/reset_test_environment.py','--execute'])\n run('bootstrap',[str(PY),'scripts/bootstrap_development_environment.py','--execute','--timeout','600'],700)\n values=dict(l.split('=',1) for l in secret.read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(secret)\n sys.path.insert(0,'/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-rem-0017-ci-provision-spire/scripts')\n from bootstrap_ci_environment import ci_resources\n profile=ci_resources(R)\n run('bounded-fuseki-profile',['docker','compose','--env-file',str(secret),'-f','deploy/bootstrap/compose.yaml','-f',str(profile),'up','--detach','--no-build','--wait','--wait-timeout','120','fuseki'],180)\n actual=run('bounded-fuseki-process',['docker','top','ocor-bootstrap-fuseki-1','-eo','pid,args'])\n assert '-Xms128m -Xmx1G' in actual and '-Xmx4G' not in actual\n dump(D/'resource-profile.json',{'source_commit':'7d8e0fde9386ffc38a857eef50028a444155b9ed','recipe':'ci_resources','profile_sha256':hashlib.sha256(profile.read_bytes()).hexdigest(),'jvm_args':'-Xms128m -Xmx1G','cgroup_bytes':2147483648,'images_unchanged':True})\n run('sync-lint',['uv','sync','--project','ocor-runtime','--frozen','--extra','test','--extra','lint'])\n run('initialize',[str(PY),'deploy/bootstrap/init/initialize_services.py','--env-file',str(secret)])\n run('fixtures',[str(PY),'deploy/bootstrap/fixtures/load_fixtures.py','--env-file',str(secret)])\n pass  # No security-task test run in this offline diagnosis.\n health=json.loads(run('typed-health',[str(PY),'scripts/verify_external_services.py','--execute','--typed']))\n dump(D/'health.json',health)\n ids=subprocess.check_output(['docker','ps','-aq','--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True,env=env,timeout=30).split();assert len(ids)==11\n props=json.loads(subprocess.check_output(['docker','inspect',*ids],text=True,env=env,timeout=30))\n summary=[{'name':c['Name'],'image_id':c['Image'],'running':c['State']['Running'],'oom':c['State']['OOMKilled'],'restarts':c['RestartCount']} for c in props]\n assert all(c['running'] and not c['oom'] and c['restarts']==0 for c in summary);dump(D/'stack-summary.json',summary)\n dump(D/'preflight-result.json',{'status':'PASS','services':11,'toolchain_entries':len(tools)})\nexcept Exception as e:\n dump(D/'preflight-result.json',{'status':'FAIL','error':str(e)});raise\nfinally:\n run('restore-verify-report',['git','restore','reports/verify_report.json'])\n", "sha256": "bb8dd2b9d8590bce3fbb08ba1d32467db50cf3133280d6ed8341656f4892ea49"}
{"command": "Captured raw artifact campaign.py", "exit_code": 0, "label": "script-campaign", "output": "import hashlib, json, os, subprocess, time, sys\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nW=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-po-allowlist')\nD=Path(__file__).parent\nPY=str(W/'ocor-runtime/.venv/bin/python')\nENV=os.environ.copy();ENV.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+ENV['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')\nvalues=dict(l.split('=',1) for l in (W/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\nENV['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:<REDACTED_LOCAL_CREDENTIAL>@127.0.0.1:55433/ocor'\nsteps=json.loads((D/'evidence_steps.json').read_text())\ndef dump(p,x):p.write_text(json.dumps(x,indent=2,sort_keys=True)+'\\n')\ndef run(label,c,limit=300):\n t=time.monotonic()\n p=D/(label+'.log')\n with p.open('w') as f:\n  r=subprocess.run(c,cwd=W,env=ENV,stdout=f,stderr=subprocess.STDOUT,timeout=limit)\n out=p.read_text()\n for k,v in values.items():\n  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:out=out.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n p.write_text(out)\n row=dict(label=label,command=' '.join(c),status='PASS' if r.returncode==0 else 'FAIL',exit_code=r.returncode,log=p.name,duration_seconds=round(time.monotonic()-t,3),raw_sha256=hashlib.sha256(p.read_bytes()).hexdigest())\n steps.append(row);dump(D/'evidence_steps.json',steps);print(label,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(label+' failed')\ndef inv():return {k:sorted(subprocess.check_output(c,text=True,env=ENV,timeout=30).splitlines()) for k,c in [('containers',['docker','ps','-a','--format','{{.Names}}']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','--format','{{.Name}}'])]}\nroot=ET.parse(D/'full2/junit.xml').getroot();tests=list(root.iter('testcase'));assert all(not any(x.tag in ('failure','error','skipped') for x in t) for t in tests)\ncol=[x for x in (D/'full-collection.log').read_text().splitlines() if '::' in x and not x.startswith(' ')]\nids=['ocor-runtime/'+x.attrib['classname'].replace('.','/')+'.py::'+x.attrib['name'] for x in tests]\nassert len(set(ids))==len(ids) and sorted('ocor-runtime/'+i for i in col)==sorted(ids)\nresult=json.loads((D/'full2/result.json').read_text());assert result['status']=='PASS' and result['pytest_exit_code']==0 and result['stack_unchanged']\ndump(D/'full-union.json',dict(status='PASS',tests=len(ids),failed=0,errors=0,skipped=0,nodeids=ids,duration_seconds=result['duration_seconds']))\nrun('reports-ci-tests',[PY,'-m','pytest','-q','-rs','--junitxml='+str(D/'reports-junit.xml'),'reports/tests/test_generate_contracts_reference_resolution.py','reports/tests/test_backlog_generator_reality_parity.py','reports/tests/test_runtime_evidence_validator.py','reports/tests/test_evidence_input_drift.py','reports/tests/test_language_migration_benchmark_harness.py'],300)\nassert all(not any(x.tag in ('failure','error','skipped') for x in t) for t in ET.parse(D/'reports-junit.xml').getroot().iter('testcase'))\nrun('ruff',['ruff','check','.'])\nrun('mypy',[PY,'-m','mypy','--strict'])\ndump(D/'campaign-result.json',dict(status='PASS',task_tests=198,full_tests=len(ids),full_duration_seconds=result['duration_seconds'],zero_skip=True,full_resources_cleaned=True))\nprint('DONE',flush=True)\n", "sha256": "262f08d27bd48bc166d3f28f87919af1c8447dd7a38ae62d1789b19b9dd992b6"}
{"command": "Captured raw artifact full_suite.py", "exit_code": 0, "label": "script-full", "output": "\"\"\"Full-suite runner for OCOR-DEV-0050 with STACK-HYGIENE guards (75 min cap,\nstop at first restart/OOM of any ocor-bootstrap service).\"\"\"\nimport json, os, signal, subprocess, sys, time\nfrom pathlib import Path\nrepo = Path(sys.argv[1]); out = Path(sys.argv[2]); out.mkdir(parents=True, exist_ok=True)\nvalues = dict(l.split('=', 1) for l in (repo/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\nenv = dict(os.environ)\nenv['PATH'] = f\"{repo/'ocor-runtime/sdk/typescript/node_modules/.bin'}:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:\" + env['PATH']\nenv['OCOR_LIVE_POSTGRES_DSN'] = 'postgresql://ocor:' + values['OCOR_LOCAL_POSTGRES_PASSWORD'] + '@127.0.0.1:55433/ocor'\ndef stack():\n    ids = subprocess.check_output(['docker','ps','-a','--filter','label=com.docker.compose.project=ocor-bootstrap','-q'], text=True).split()\n    data = json.loads(subprocess.check_output(['docker','inspect',*ids], text=True))\n    # Deliberate bounded pauses by fault-injection tests are expected; a restart,\n    # OOM kill, exit or death of any service aborts the run (STACK-HYGIENE).\n    return {c['Name'].lstrip('/'): (c['RestartCount'], c['State']['Status'] if c['State']['Status'] in ('exited', 'dead', 'restarting', 'removing') else 'alive', c['State']['OOMKilled'], c['State']['StartedAt']) for c in data}\ninitial = stack(); assert len(initial) == 11 and all(v[1] == 'alive' for v in initial.values()), initial\njunit = out/'junit.xml'\ncmd = [str(repo/'ocor-runtime/.venv/bin/python'), '-m', 'pytest', '-v', f'--junitxml={junit}', 'tests/']\nstart = time.monotonic(); status = 'PASS'; reason = ''\nwith (out/'full.log').open('w') as log:\n    p = subprocess.Popen(cmd, cwd=repo/'ocor-runtime', stdout=log, stderr=subprocess.STDOUT, env=env, start_new_session=True)\n    while p.poll() is None:\n        time.sleep(10)\n        cur = stack()\n        if cur != initial:\n            status, reason = 'ABORTED', f'stack changed: {cur}'\n        elif time.monotonic() - start > 75*60:\n            status, reason = 'ABORTED', '75-minute cap reached'\n        if status != 'PASS':\n            subprocess.run(['docker','stats','--no-stream'], stdout=open(out/'docker-stats.log','w'))\n            os.killpg(p.pid, signal.SIGTERM); p.wait(); break\nrc = p.returncode\nif status == 'PASS' and rc != 0: status = 'FAIL'\nresult = {'status': status, 'reason': reason, 'pytest_exit_code': rc, 'duration_seconds': round(time.monotonic()-start,1), 'command': cmd[1:], 'stack_unchanged': stack() == initial}\n(out/'result.json').write_text(json.dumps(result, indent=2, sort_keys=True)+'\\n'); print(json.dumps(result))\n", "sha256": "05a0bace02c7f3e9e6505e0c607f88845d30f2e0481ec5c0496b94cafee2075b"}
{"command": "Captured raw artifact full_rerun.py", "exit_code": 0, "label": "script-resource-observation", "output": "\"\"\"Second guarded full-suite run with a live Docker events ownership recorder.\n\nUsage: full_rerun.py <worktree> <log_dir>\nAppends steps full-suite-recorded, full-resource-attribution, full-resource-cleanup\nto evidence_steps.json. Cleanup removes only volumes that are absent from the\npre-run inventory, have the anonymous label, are unmounted and whose creation was\nobserved by the recorder during this run; it then requires the inventory to equal\nthe pre-run inventory exactly.\n\"\"\"\nimport json, subprocess, sys, time\nfrom pathlib import Path\n\nW = Path(sys.argv[1]); L = Path(sys.argv[2]); PY = str(W / \"ocor-runtime/.venv/bin/python\")\nsteps = json.loads((L / \"evidence_steps.json\").read_text())\n\n\ndef save():\n    (L / \"evidence_steps.json\").write_text(json.dumps(steps, indent=2, sort_keys=True) + \"\\n\")\n\n\ndef inventory():\n    return {\n        \"containers\": sorted(subprocess.check_output([\"docker\", \"ps\", \"-a\", \"--format\", \"{{.Names}}\"], text=True).split()),\n        \"volumes\": sorted(subprocess.check_output([\"docker\", \"volume\", \"ls\", \"-q\"], text=True).split()),\n        \"networks\": sorted(subprocess.check_output([\"docker\", \"network\", \"ls\", \"--format\", \"{{.Name}}\"], text=True).split()),\n    }\n\n\nbefore = inventory()\n(L / \"inventory-before-full2.json\").write_text(json.dumps(before, indent=2, sort_keys=True) + \"\\n\")\nevents_path = L / \"full2-docker-events.jsonl\"\nrecorder = subprocess.Popen([\"docker\", \"events\", \"--format\", \"{{json .}}\"], stdout=events_path.open(\"wb\"), stderr=subprocess.DEVNULL)\ntime.sleep(1)\nstarted = time.time()\nwith (L / \"full-suite-recorded.log\").open(\"wb\") as log:\n    rc = subprocess.run([PY, str(L / \"full_suite.py\"), str(W), str(L / \"full2\")], cwd=W, stdout=log, stderr=subprocess.STDOUT, timeout=80 * 60).returncode\nimport xml.etree.ElementTree as ET\nroot = ET.parse(L / \"full2/junit.xml\").getroot()\nsuites = [root] if root.tag == \"testsuite\" else list(root)\nt = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\ncounts = {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0, \"tests\": t[\"tests\"]}\nsteps.append({\"label\": \"full-suite-recorded\", \"command\": f\"{PY} full_suite.py (guarded: 75-min cap, abort on restart/OOM/exit; docker events recorder running) -> OCOR_LIVE_POSTGRES_DSN=<local generated credential> {PY} -m pytest -v --junitxml=<log_dir>/full2/junit.xml tests/ (cwd ocor-runtime)\",\n              \"exit_code\": rc, \"log\": \"full-suite-recorded.log\", \"status\": \"PASS\" if rc == 0 and not counts[\"failed\"] and not counts[\"skipped\"] else \"FAIL\", \"counts\": counts, \"duration_seconds\": round(time.time() - started, 1)})\nsave()\ntime.sleep(2)\nrecorder.terminate(); recorder.wait()\nafter = inventory()\n(L / \"inventory-after-full2.json\").write_text(json.dumps(after, indent=2, sort_keys=True) + \"\\n\")\nevents = [json.loads(line) for line in events_path.read_text().splitlines() if line.strip()]\ncontainers = {}\nfor e in events:\n    if e.get(\"Type\") == \"container\" and e.get(\"Action\") == \"create\":\n        a = e[\"Actor\"][\"Attributes\"]\n        containers[e[\"Actor\"][\"ID\"]] = {\"name\": a.get(\"name\"), \"image\": a.get(\"image\")}\ncreated_volumes = {e[\"Actor\"][\"ID\"] for e in events if e.get(\"Type\") == \"volume\" and e.get(\"Action\") == \"create\"}\nmounts = {}\nfor e in events:\n    if e.get(\"Type\") == \"volume\" and e.get(\"Action\") == \"mount\":\n        mounts.setdefault(e[\"Actor\"][\"ID\"], set()).add(e[\"Actor\"][\"Attributes\"].get(\"container\"))\nadded = {k: sorted(set(after[k]) - set(before[k])) for k in after}\nremoved = {k: sorted(set(before[k]) - set(after[k])) for k in after}\nattribution = {}\nfor v in added[\"volumes\"]:\n    owners = [containers.get(c, {\"name\": None, \"image\": None}) | {\"id\": c} for c in sorted(mounts.get(v, set()))]\n    attribution[v] = {\"created_during_run\": v in created_volumes, \"mounted_by\": owners}\nowned_by_0051 = [v for v, a in attribution.items() if any((o.get(\"name\") or \"\").startswith((\"ocor-c5-backbone-\", \"ocor-test-0050-\")) for o in a[\"mounted_by\"])]\nreport = {\"added\": added, \"removed\": removed, \"attribution\": attribution,\n          \"images\": sorted({o.get(\"image\") or \"unknown\" for a in attribution.values() for o in a[\"mounted_by\"]}),\n          \"owned_by_memory_task_harnesses\": owned_by_0051, \"events_recorded\": len(events),\n          \"note\": \"Residual anonymous volumes of pre-existing suites are allocated to OCOR-DEV-REM-0018; the suites touched by this change set (0047 and REM-0027 in process, 0050 on the stack) alone leave none (task-teardown-delta).\"}\n(L / \"full-resource-attribution.log\").write_text(json.dumps(report, indent=2, sort_keys=True) + \"\\n\")\nunattributed = [v for v, a in attribution.items() if not a[\"created_during_run\"]]\nok = not owned_by_0051 and not unattributed and not added[\"containers\"] and not added[\"networks\"] and not any(removed.values())\nsteps.append({\"label\": \"full-resource-attribution\", \"command\": \"docker events recorder during full-suite-recorded: every residual resource attributed to the container that created/mounted it; none may belong to the C5 backbone (ocor-c5-backbone-*) or the 0050 harnesses run by this change set; no container/network residue; nothing pre-existing removed\",\n              \"exit_code\": 0 if ok else 1, \"log\": \"full-resource-attribution.log\", \"status\": \"PASS\" if ok else \"FAIL\"})\nsave()\nif not ok:\n    print(\"ATTRIBUTION FAIL\"); sys.exit(1)\ncleanup = {\"removed\": [], \"refused\": []}\nfor v in added[\"volumes\"]:\n    labels = json.loads(subprocess.check_output([\"docker\", \"volume\", \"inspect\", v], text=True))[0].get(\"Labels\") or {}\n    users = subprocess.check_output([\"docker\", \"ps\", \"-a\", \"--filter\", f\"volume={v}\", \"-q\"], text=True).split()\n    if \"com.docker.volume.anonymous\" in labels and not users and attribution[v][\"created_during_run\"]:\n        subprocess.run([\"docker\", \"volume\", \"rm\", v], check=True, capture_output=True)\n        cleanup[\"removed\"].append(v)\n    else:\n        cleanup[\"refused\"].append(v)\nfinal = inventory()\ncleanup[\"inventory_equals_pre_run\"] = final == before\n(L / \"inventory-after-cleanup2.json\").write_text(json.dumps(final, indent=2, sort_keys=True) + \"\\n\")\n(L / \"full-resource-cleanup.log\").write_text(json.dumps(cleanup, indent=2, sort_keys=True) + \"\\n\")\nok = cleanup[\"inventory_equals_pre_run\"] and not cleanup[\"refused\"]\nsteps.append({\"label\": \"full-resource-cleanup\", \"command\": \"remove exactly the run-created, anonymous, unmounted volumes attributed above (STACK-HYGIENE session cleanup); inventory must equal the pre-run inventory\",\n              \"exit_code\": 0 if ok else 1, \"log\": \"full-resource-cleanup.log\", \"status\": \"PASS\" if ok else \"FAIL\"})\nsave()\nprint(\"DONE\", ok)\n", "sha256": "32790d82aeb76abb73f0a182ba4b9b70ea8ceeea6de8a0208973d99b2cfee206"}
{"command": "Captured raw artifact build_evidence.py", "exit_code": 0, "label": "script-build-evidence", "output": "import hashlib,json,platform,re,subprocess,sys\nfrom datetime import UTC,datetime\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nW=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-po-allowlist');D=Path(__file__).parent\nBASE='fbdec1ea4ad36ce77d26a319e91958a139d9e8e3';BRANCH='governed/rem0019-po-decision-allowlist';CODE=subprocess.check_output(['git','rev-parse','HEAD'],cwd=W,text=True).strip()\nassert json.loads((D/'campaign-result.json').read_text())['status']=='PASS'\ndef dump(p,x):p.write_text(json.dumps(x,indent=2,sort_keys=True)+'\\n')\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef counts(p):\n ts=list(ET.parse(p).getroot().iter('testcase'));assert all(not any(x.tag in ('failure','error','skipped') for x in t) for t in ts)\n return dict(passed=len(ts),failed=0,skipped=0,not_executed=0)\nvalues=dict(l.split('=',1) for l in (W/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\ndef redact(s):\n for k,v in values.items():\n  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:s=s.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n return re.sub(r'postgresql://ocor:<REDACTED_LOCAL_CREDENTIAL>@\\s]+@','postgresql://ocor:<REDACTED_LOCAL_CREDENTIAL>@',s)\nraw=[];commands=[]\ndef add(label,command,p,rc=0,qual=True,extra=None):\n text=redact(p.read_text());digest=sha(text.encode());raw.append(dict(label=label,command=command,exit_code=rc,sha256=digest,output=text))\n if qual:\n  assert rc==0\n  row=dict(label=label,command=command,exit_code=rc,status='PASS',raw_sha256=digest)\n  if extra:row.update(extra)\n  commands.append(row)\n return digest\nfor row in json.loads((D/'preflight-commands.json').read_text()):\n if row['label']=='restore-verify-report':continue\n add('preflight-'+row['label'],' '.join(row['command']),D/(row['label']+'.log'),row['exit_code'])\nfor row in json.loads((D/'pre-evidence-gates.json').read_text()):\n add('gate-'+row['label'],' '.join(row['command']),D/('pre-evidence-'+row['label']+'.log'),row['exit_code'])\nfor row in json.loads((D/'evidence_steps.json').read_text()):\n extra={'duration_seconds':row['duration_seconds']}\n if row['label']=='0050-regression':extra['result']=counts(D/'0050-junit.xml')\n add(row['label'],row['command'],D/row['log'],row['exit_code'],extra=extra)\nfor label,path in [('0050-junit','0050-junit.xml'),('0050-union','0050-union.json'),('full-junit','full2/junit.xml'),('full-union','full-union.json'),('full-runner','full2/result.json'),('full-output','full2/full.log'),('reports-junit','reports-junit.xml'),('toolchain','toolchain.json'),('health','health.json'),('resource-profile','resource-profile.json'),('ast-proof','allowlist-ast-proof.json'),('task-before','task-before.json'),('task-after','task-after.json'),('full-attribution','full-resource-attribution.log'),('full-cleanup','full-resource-cleanup.log'),('session-teardown','session-teardown.json'),('campaign-commit-continuity','campaign-commit-continuity.json'),('session-resources-before','resources-before.json'),('session-resources-after','session-resources-after.json'),('script-preflight','preflight.py'),('script-campaign','campaign.py'),('script-full','full_suite.py'),('script-resource-observation','full_rerun.py'),('script-build-evidence','build_evidence.py'),('script-check-evidence','check_evidence.py'),('script-campaign-execution-version','campaign-v2.py.txt')]:\n add(label,'Captured raw artifact '+path,D/path,extra={'result':counts(D/path)} if path.endswith('.xml') else None)\nred_sha=add('plan-red','Planning validator before adding exact authorized paths (expected FAIL)',D/'plan-red.log',1,False)\nred_report_sha=add('plan-red-report','Report of expected FAIL: only the two new decision request paths',D/'plan-red-report.md',1,False)\nadd('harness-observation-correction','Prefix normalization of JUnit/collection identities; 0050 itself passed and full had not started',D/'harness-correction.json',0,False)\nadd('harness-v1-diagnostic','Original comparator failed; no test failure and no full run started',D/'campaign-v1.out',1,False)\nadd('harness-junit-properties-diagnostic','XML observer misclassified three properties nodes after green full run; observation-only correction',D/'campaign-v2.out',1,False)\nadd('harness-junit-properties-correction','Observation-only correction; explicit forbidden outcome tags',D/'harness-junit-properties-correction.json',0,False)\nold_path=W/'reports/evidence/G5/OCOR-DEV-0050.requalified-rem0026.json';old=json.loads(old_path.read_text())\nmodel='ocor-runtime/src/ocor_runtime/memory/model.py';tests='ocor-runtime/tests/tasks/test_ocor_dev_0050.py';validator='scripts/validate_ocor_development_plan.py'\nfor rel in (model,tests):assert sha((W/rel).read_bytes())==old['inputs'][rel]\ncase_rows=list(ET.parse(D/'0050-junit.xml').getroot().iter('testcase'));node=lambda t:'ocor-runtime/'+t.attrib['classname'].replace('.','/')+'.py::'+t.attrib['name']\nassert len(case_rows)==198\nresults=[];claimed=set()\nfor c in old['requirement_results']:\n wanted=set(c['tests']);matched=[t for t in case_rows if t.attrib['name'].split('[')[0] in wanted];assert wanted==set(t.attrib['name'].split('[')[0] for t in matched)\n r={k:v for k,v in c.items() if k not in ['result','status','test_case_sha256']};r.update(status='PASS',result=dict(passed=len(matched),failed=0,skipped=0,not_executed=0),test_case_sha256=[sha(node(t).encode()) for t in matched]);results.append(r);claimed.update(node(t) for t in matched)\nassert claimed==set(node(t) for t in case_rows)\nnow=datetime.now(UTC).isoformat();raw_bytes=('\\n'.join(json.dumps(x,sort_keys=True,ensure_ascii=False) for x in raw)+'\\n').encode()\nname='OCOR-DEV-0050.requalified-rem0019-po-allowlist';log=W/'reports/evidence/G5'/(name+'.log');log.write_bytes(raw_bytes)\nids=subprocess.check_output(['docker','ps','-aq','--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True)