{"command": "Captured raw artifact check_evidence.py", "exit_code": 0, "label": "script-check-evidence", "output": "import ast,hashlib,json,subprocess,sys\nfrom collections import Counter\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nW=Path(sys.argv[1]);HEAD=sys.argv[2]\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef git(*args):return subprocess.check_output(['git',*args],cwd=W,text=True).strip()\nassert git('rev-parse','HEAD')==HEAD\nBASE='fbdec1ea4ad36ce77d26a319e91958a139d9e8e3';name='OCOR-DEV-0050.requalified-rem0019-po-allowlist';p=W/'reports/evidence/G5'/(name+'.json');r=json.loads(p.read_text());raw=(W/'reports/evidence/G5'/(name+'.log')).read_bytes()\nassert sha(raw)==r['raw_output_sha256'];assert r['environment']['branch']==git('branch','--show-current')\nassert subprocess.run(['git','merge-base','--is-ancestor',r['commit'],HEAD],cwd=W).returncode==0\nassert git('rev-parse',HEAD+':inputs')==r['inputs']['inputs_tree']==git('rev-parse',r['commit']+':inputs')\nfor rel,digest in r['inputs'].items():\n if rel=='inputs_tree':continue\n assert sha((W/rel).read_bytes())==digest\n assert sha(subprocess.check_output(['git','show',r['commit']+':'+rel],cwd=W))==digest\nm=json.loads((W/'reports/evidence/G5/MANIFEST.json').read_text())\nfor a in m['artifacts']:\n if a['task_id'] in ['OCOR-DEV-0050','OCOR-DEV-0050-RAW']:assert sha((W/'reports/evidence/G5'/a['path']).read_bytes())==a['sha256']\nrows=[json.loads(line) for line in raw.splitlines()];by={row['label']:row for row in rows};assert len(by)==len(rows)\nfor row in rows:assert sha(row['output'].encode())==row['sha256']\nfor c in r['commands']:assert c['status']=='PASS' and c['exit_code']==0 and c['raw_sha256']==by[c['label']]['sha256']\ndef ids(label):\n ts=list(ET.fromstring(by[label]['output']).iter('testcase'));assert all(not any(x.tag in ('failure','error','skipped') for x in t) for t in ts)\n return ['ocor-runtime/'+t.attrib['classname'].replace('.','/')+'.py::'+t.attrib['name'] for t in ts]\nfor label,collect in [('0050-junit','0050-collection'),('full-junit','full-collection')]:\n actual=ids(label);expected=['ocor-runtime/'+x for x in by[collect]['output'].splitlines() if '::' in x and not x.startswith(' ')]\n assert Counter(actual)==Counter(expected) and len(set(actual))==len(actual)\nassert len(ids('0050-junit'))==198\nall_hashes={sha(x.encode()) for x in ids('0050-junit')};mapped=set()\nfor c in r['requirement_results']:\n assert set(c['test_case_sha256'])<=all_hashes\n assert c['result']['passed']==len(c['test_case_sha256']) and c['status']=='PASS'\n assert all(c['result'][k]==0 for k in ['failed','skipped','not_executed']);mapped.update(c['test_case_sha256'])\nassert mapped==all_hashes\nassert json.loads(by['full-runner']['output'])['status']=='PASS'\nassert json.loads(by['session-teardown']['output'])['inventory_equals_session_start']\nold=json.loads(subprocess.check_output(['git','show',BASE+':reports/evidence/G5/OCOR-DEV-0050.requalified-rem0026.json'],cwd=W,text=True));assert r['supersedes']==old['record_id']\nfor rel in ['ocor-runtime/src/ocor_runtime/memory/model.py','ocor-runtime/tests/tasks/test_ocor_dev_0050.py']:assert r['inputs'][rel]==old['inputs'][rel]\nallowed=['reports/development/decision_requests/REM-0019-KIND-TEARDOWN-OBSERVATION.md','reports/development/decision_requests/REM-0019-KIND-CONTAINERD-SEGV-RECURRENCE.md','reports/evidence/G5/'+name+'.json','reports/evidence/G5/'+name+'.log']\nnew=ast.parse((W/'scripts/validate_ocor_development_plan.py').read_text());old_ast=ast.parse(subprocess.check_output(['git','show',BASE+':scripts/validate_ocor_development_plan.py'],cwd=W,text=True));removed=[]\nfor x in ast.walk(new):\n if isinstance(x,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='extension_paths' for t in x.targets):\n  removed=[n.value for n in x.value.elts if isinstance(n,ast.Constant) and n.value in allowed];x.value.elts=[n for n in x.value.elts if not (isinstance(n,ast.Constant) and n.value in allowed)]\nassert sorted(removed)==sorted(allowed) and ast.dump(new)==ast.dump(old_ast)\nchanged=git('diff','--name-only',BASE,HEAD).splitlines()\nassert not any(p.startswith(('inputs/','ocor-runtime/src/','ocor-runtime/tests/')) for p in changed)\nfor rel in changed:\n if rel.startswith('reports/evidence/') and rel!='reports/evidence/G5/MANIFEST.json':assert rel in ['reports/evidence/G5/'+name+'.json','reports/evidence/G5/'+name+'.log']\nassert r['claims']['E1']==r['claims']['E2']==0\nprint(json.dumps({'status':'PASS','head_sha':HEAD,'source_commit':r['commit'],'raw_sha256':sha(raw),'task_tests':198,'full_tests':len(ids('full-junit')),'scope':'REGRESSION_ONLY','historical_seals_unchanged':True},sort_keys=True))\n", "sha256": "057faf7fcf38da132b8a757fb162a9e16110205684057d608fd611853bbd8132"}
{"command": "Captured raw artifact campaign-v2.py.txt", "exit_code": 0, "label": "script-campaign-execution-version", "output": "import hashlib, json, os, subprocess, time, sys\nfrom pathlib import Path\nimport xml.etree.ElementTree as ET\nW=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-po-allowlist')\nD=Path(__file__).parent\nPY=str(W/'ocor-runtime/.venv/bin/python')\nENV=os.environ.copy();ENV.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+ENV['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')\nvalues=dict(l.split('=',1) for l in (W/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\nENV['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:<REDACTED_LOCAL_CREDENTIAL>@127.0.0.1:55433/ocor'\nsteps=json.loads((D/'evidence_steps.json').read_text())\ndef dump(p,x):p.write_text(json.dumps(x,indent=2,sort_keys=True)+'\\n')\ndef run(label,c,limit=300):\n t=time.monotonic()\n p=D/(label+'.log')\n with p.open('w') as f:\n  r=subprocess.run(c,cwd=W,env=ENV,stdout=f,stderr=subprocess.STDOUT,timeout=limit)\n out=p.read_text()\n for k,v in values.items():\n  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:out=out.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n p.write_text(out)\n row=dict(label=label,command=' '.join(c),status='PASS' if r.returncode==0 else 'FAIL',exit_code=r.returncode,log=p.name,duration_seconds=round(time.monotonic()-t,3),raw_sha256=hashlib.sha256(p.read_bytes()).hexdigest())\n steps.append(row);dump(D/'evidence_steps.json',steps);print(label,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(label+' failed')\ndef inv():return {k:sorted(subprocess.check_output(c,text=True,env=ENV,timeout=30).splitlines()) for k,c in [('containers',['docker','ps','-a','--format','{{.Names}}']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','--format','{{.Name}}'])]}\nroot=ET.parse(D/'0050-junit.xml').getroot();tests=list(root.iter('testcase'));assert len(tests)==198;assert all(not list(t) for t in tests)\ncol=[x for x in (D/'0050-collection.log').read_text().splitlines() if '::' in x and not x.startswith(' ')]\nids=['ocor-runtime/'+x.attrib['classname'].replace('.','/')+'.py::'+x.attrib['name'] for x in tests]\nassert len(col)==len(ids) and sorted('ocor-runtime/'+i for i in col)==sorted(ids)\ndump(D/'0050-union.json',dict(status='PASS',tests=len(ids),failed=0,errors=0,skipped=0,nodeids=ids,nodeid_sha256=[hashlib.sha256(i.encode()).hexdigest() for i in ids]))\nafter=inv();dump(D/'task-after.json',after);assert after==json.loads((D/'task-before.json').read_text())\nrun('full-collection',[PY,'-m','pytest','--collect-only','-q','ocor-runtime/tests/'])\nrun('full-regression',[PY,str(D/'full_rerun.py'),str(W),str(D)],4800)\nroot=ET.parse(D/'full2/junit.xml').getroot();tests=list(root.iter('testcase'));assert all(not list(t) for t in tests)\ncol=[x for x in (D/'full-collection.log').read_text().splitlines() if '::' in x and not x.startswith(' ')]\nids=['ocor-runtime/'+x.attrib['classname'].replace('.','/')+'.py::'+x.attrib['name'] for x in tests]\nassert len(set(ids))==len(ids) and sorted('ocor-runtime/'+i for i in col)==sorted(ids)\nresult=json.loads((D/'full2/result.json').read_text());assert result['status']=='PASS' and result['pytest_exit_code']==0 and result['stack_unchanged']\ndump(D/'full-union.json',dict(status='PASS',tests=len(ids),failed=0,errors=0,skipped=0,nodeids=ids,duration_seconds=result['duration_seconds']))\nrun('reports-ci-tests',[PY,'-m','pytest','-q','-rs','--junitxml='+str(D/'reports-junit.xml'),'reports/tests/test_generate_contracts_reference_resolution.py','reports/tests/test_backlog_generator_reality_parity.py','reports/tests/test_runtime_evidence_validator.py','reports/tests/test_evidence_input_drift.py','reports/tests/test_language_migration_benchmark_harness.py'],300)\nassert all(not list(t) for t in ET.parse(D/'reports-junit.xml').getroot().iter('testcase'))\nrun('ruff',['ruff','check','.'])\nrun('mypy',[PY,'-m','mypy','--strict'])\ndump(D/'campaign-result.json',dict(status='PASS',task_tests=198,full_tests=len(ids),full_duration_seconds=result['duration_seconds'],zero_skip=True,full_resources_cleaned=True))\nprint('DONE',flush=True)\n", "sha256": "237496c79246f75e33d71e718f11b539bda1780af36481666e26d3a15832225f"}
