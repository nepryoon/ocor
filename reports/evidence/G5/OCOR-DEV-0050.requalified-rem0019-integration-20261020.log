"""REM-0019 cycle 3: reproducible RED / GREEN / mutation evidence for VF-001.

Each run happens in its own detached worktree under tdd/, whose only tool is a
.ocor/tools/bin/kind symlink to the official binary (the verifier layout). The
committed source is never mutated in place. Fingerprint convention (as recorded in
the RCCAD README): SHA256 of compact sorted JSON of [name, PASSED|FAILED, message|null]
for the six VF-001 cases.
"""
import hashlib, json, subprocess, sys, xml.etree.ElementTree as ET
from pathlib import Path

D = Path(__file__).resolve().parent / 'tdd'
R = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
MAIN = Path('/home/luca/projects/ocor-detailed-design')
PY = R / 'ocor-runtime/.venv/bin/python'
RED_HEAD, GREEN_HEAD = 'b557549', '3cf6e22a7e4cedbf55a32e1ef23dae4e2a6bbb44'
GUARD = 'reports/tests/test_qualifying_campaign_guard.py'
OBSERVATION = 'reports/tests/test_kind_teardown_observation.py'
OBSERVER = 'scripts/observe_kind_teardown.py'
VF001 = ['test_remover_launched_through_verifier_symlink_is_observed_in_the_pytest_group',
         'test_remover_launched_through_the_checkout_binary_is_observed_in_the_pytest_group',
         'test_symlink_to_a_different_binary_is_never_the_owned_remover',
         'test_relative_argv0_is_never_the_owned_remover',
         'test_remover_of_a_different_cluster_is_never_the_owned_remover',
         'test_remover_outside_the_pytest_process_group_is_never_the_owned_remover']
PROOFS = ['test_new_remover_predicate_accepts_a_superset_only_by_absolute_alias_of_the_same_binary',
          'test_observer_change_is_limited_to_the_argv_comparison_after_the_unchanged_exe_check',
          'test_kind_binary_compared_by_the_sampler_is_always_a_resolved_path']
FIXED = ("            if (args[1:] != ['delete', 'cluster', '--name', 'ocor-poc'] or not os.path.isabs(args[0])\n"
         "                    or Path(os.path.realpath(args[0])) != KIND_BINARY):\n")
EXE = "(folder / 'exe').resolve(strict=True) != KIND_BINARY"
MUTANTS = {
    'no_isabs': (FIXED, FIXED.replace(' or not os.path.isabs(args[0])', '')),
    'no_realpath': (FIXED, "            if (args[1:] != ['delete', 'cluster', '--name', 'ocor-poc'] or not os.path.isabs(args[0])):\n"),
    'no_exe_check': (EXE, 'False'),
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def cases(junit):
    rows = {}
    for case in ET.parse(junit).getroot().iter('testcase'):
        bad = next((case.find(k) for k in ('failure', 'error', 'skipped') if case.find(k) is not None), None)
        outcome = 'passed' if bad is None else {'failure': 'failed', 'error': 'error', 'skipped': 'skipped'}[bad.tag]
        rows[case.attrib['name']] = (outcome, '' if bad is None else bad.attrib.get('message', ''))
    return rows


def run(label, head, mutate=None):
    wt = D / label / 'wt'
    subprocess.run(['git', '-C', str(R), 'worktree', 'add', '--detach', str(wt), head], check=True, capture_output=True)
    try:
        tools = wt / '.ocor/tools/bin'
        tools.mkdir(parents=True)
        (tools / 'kind').symlink_to(MAIN / '.ocor/tools/bin/kind')
        mutation = None
        if mutate:
            old, new = mutate
            source = (wt / OBSERVER).read_text()
            assert source.count(old) == 1, label
            (wt / OBSERVER).write_text(source.replace(old, new))
            mutation = subprocess.run(['git', 'diff', '--', OBSERVER], cwd=wt, capture_output=True, text=True).stdout
        junit = D / label / 'junit.xml'
        log = D / label / 'pytest.log'
        with log.open('w') as out:
            code = subprocess.run([str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '--rootdir', str(wt),
                                   '--junitxml=' + str(junit), GUARD, OBSERVATION], cwd=wt, stdout=out,
                                  stderr=subprocess.STDOUT).returncode
        rows = cases(junit)
        counts = {k: sum(1 for o, _ in rows.values() if o == k) for k in ('passed', 'failed', 'error', 'skipped')}
        vf = sorted([n, 'PASSED' if rows[n][0] == 'passed' else 'FAILED', rows[n][1] or None] for n in VF001)
        result = {'label': label, 'head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=wt, text=True).strip(),
                  'observer_sha256': sha(wt / OBSERVER), 'mutation_diff': mutation, 'exit_code': code,
                  'counts': counts, 'summary_line': log.read_text().strip().splitlines()[-1],
                  'vf001_cases': {n: rows[n][0] for n in VF001},
                  'proof_cases': {n: rows[n][0] for n in PROOFS if n in rows},
                  'vf001_fingerprint_sha256': hashlib.sha256(json.dumps(vf, sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
                  'killed_by': sorted(n for n, (o, _) in rows.items() if o != 'passed'),
                  'junit_sha256': sha(junit), 'log_sha256': sha(log)}
        (D / label / 'result.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
        return result
    finally:
        subprocess.run(['git', '-C', str(R), 'worktree', 'remove', '--force', str(wt)], check=True)


def main():
    D.mkdir()
    results = [run('red', RED_HEAD), run('green', GREEN_HEAD)]
    results += [run('mutant-' + name, GREEN_HEAD, edit) for name, edit in MUTANTS.items()]
    red, green, *mutants = results
    summary = {
        'red': {'exit_code': red['exit_code'], 'counts': red['counts'], 'vf001_cases': red['vf001_cases'],
                'fingerprint_sha256': red['vf001_fingerprint_sha256'], 'head': red['head']},
        'green': {'exit_code': green['exit_code'], 'counts': green['counts'], 'vf001_cases': green['vf001_cases'],
                  'proof_cases': green['proof_cases'], 'fingerprint_sha256': green['vf001_fingerprint_sha256'],
                  'head': green['head']},
        'mutants': {m['label']: {'exit_code': m['exit_code'], 'killed_by': m['killed_by'], 'counts': m['counts']}
                    for m in mutants},
        'status': 'PASS' if (red['exit_code'] and red['vf001_cases'][VF001[0]] == 'failed'
                             and sum(red['counts'][k] for k in ('failed', 'error')) == 1
                             and green['exit_code'] == 0 and not green['killed_by']
                             and all(m['exit_code'] and m['killed_by'] for m in mutants)) else 'FAIL',
        'result_sha256': {r['label']: sha(D / r['label'] / 'result.json') for r in results},
    }
    (D / 'tdd-summary.json').write_text(json.dumps(summary, indent=2, sort_keys=True) + '\n')
    print(json.dumps(summary, indent=1))
    return 0 if summary['status'] == 'PASS' else 1


if __name__ == '__main__':
    sys.exit(main())

END_RAW_FILE tdd.py
