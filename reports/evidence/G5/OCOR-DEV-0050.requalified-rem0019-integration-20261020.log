    result = read(out / 'campaign_result.json')
    cases = clean_junit(out / 'runtime_junit_post_approval.xml')
    assert result['status'] == 'PASS' and result['candidate_head'] == SOURCE and by[label]['exit_code'] == 0
    assert result['counts'] == {'tests': len(cases), 'failures': 0, 'errors': 0, 'skipped': 0}
    assert by[label]['head_after'] == SOURCE
    obs = read(out / 'kind-teardown-observations.json')
    assert obs['rejections'] == [] and obs['bootstrap_recoveries'] == [] and obs['window_seconds'] == 30.0
    assert len(obs['removals']) >= 1 and all(r['status'] == 'OWNED_KIND_TEARDOWN_OBSERVED' for r in obs['removals'])
    times = [datetime.fromisoformat(p['started_at']).timestamp() for p in obs['probe_observations']]
    gaps = [b - a for a, b in zip(times, times[1:])]
    failed_probes = [p['command'][:2] for p in obs['probe_observations'] if p['returncode']]
    removal_ids = {r['node_id'] for r in obs['removals']}
    assert all(p['command'][2] in removal_ids for p in obs['probe_observations'] if p['returncode']), label
    contract = read(D / (label + '-contract.json'))
    observations[label] = {
        'removals': [{'status': r['status'], 'node_id': r['node_id'], 'since': r['since'], 'until': r['until'],
                      'window_seconds': r['window_seconds'], 'destroy_events': r['destroy_events'],
                      'failed_probe': r['failed_probe'],
                      'owned_remover': {**{k: v for k, v in r['owned_remover'].items()},
                                        'argv0_is_symlink_path': r['owned_remover']['command'][0] != str(Path(r['owned_remover']['command'][0]).resolve())}}
                     for r in obs['removals']],
        'rejections': obs['rejections'], 'bootstrap_recoveries': obs['bootstrap_recoveries'],
        'probe_count': len(times), 'max_probe_gap_seconds': round(max(gaps), 3),
        'nonzero_probes_all_on_removed_node': len(failed_probes),
        'kind_tool': contract['kind_tool'], 'launch': {'command': contract['command'], 'cwd': contract['cwd'],
                                                        'setsid': contract['setsid']},
        'harness_sha256': contract['harness_sha256'],
    }
    rows = [json.loads(line) for line in (out / 'health-observer.jsonl').read_text().splitlines()]
    health[label] = {'events': [{k: r[k] for k in ['identity', 'name', 'classification', 'affects_test_outcome']}
                                for r in rows if r.get('kind') == 'unhealthy_classification'],
                     'status': read(out / 'health-observer-status.json'),
                     'private_journal_sha256': sha(out / 'health-observer.jsonl')}
    rawlog = (out / 'post_remediation_runtime.log').read_text()
    node = re.compile(r'(?m)^(\S*tests/[^\n]*::[^\n]*?)(?=\s+(?:PASSED|FAILED|SKIPPED|ERROR|XFAIL|XPASS)\b)')
    redacted, count = node.subn(lambda m: 'test_case_sha256=' + hashlib.sha256(m.group(1).encode()).hexdigest(), rawlog)
    assert count == len(cases), (label, count, len(cases))
    (D / (label + '-published.log')).write_text(redacted)
    write(D / (label + '-log-transform.json'), {
        'private_raw_sha256': sha(out / 'post_remediation_runtime.log'), 'published_raw_sha256': sha(D / (label + '-published.log')),
        'transformed_case_lines': count, 'transform_source_sha256': sha(Path(__file__)),
        'algorithm': 'Replace complete pytest node ID before outcome with test_case_sha256=SHA256(exact UTF-8 node ID). All other text byte-preserved; private original retained locally.'})
    digests[label] = {'count': len(cases), 'case_sha256': case_digests(cases), 'private_junit_sha256': sha(out / 'runtime_junit_post_approval.xml')}
    fulls[label] = result
