"""REM-0019 cycle 3: emit the two unsealed candidate records (integration + 0050 regression).

Follows the repair2 emitter: the rejected candidate records are replaced in place and
pinned by commit/sha in previous_candidate; raw files are bundled verbatim except the
full pytest node identities, replaced by their exact digest. Every bootstrap.env
value is asserted absent from the bundle (fail-closed).
"""
from pathlib import Path
from datetime import UTC, datetime
import copy, hashlib, json, os, platform, re, subprocess, xml.etree.ElementTree as ET

D = Path(__file__).resolve().parent
R = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
SOURCE = '3cf6e22a7e4cedbf55a32e1ef23dae4e2a6bbb44'
