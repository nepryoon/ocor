RAW_FILE cycle3.py SHA256 c76ea0a2e48411d2fdbe0daa0570be469dc3bdb4feb8d510bb0f64fbda1d3e5d
"""REM-0019 cycle 3 qualification driver (Claude Code, PO-supervised session).

Sequence, fail-closed, no retries: preflight -> 0050 regression -> full (local
layout) -> preflight -> full (verifier layout: detached worktree outside the
checkout with .ocor/tools/bin/* symlinks, launched as the verifier did with
`setsid uv run ... --repository <wt>`) -> teardown. Each campaign is gated on
TCP 8080 held only by the ocor-bootstrap Keycloak mapping and MemAvailable >= 6 GiB.
Campaign supervisor, limits (75 min), cadence and selection are the repository's.
"""
import hashlib, json, os, subprocess, sys, time
from pathlib import Path

D = Path(__file__).resolve().parent
R = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
MAIN = Path('/home/luca/projects/ocor-detailed-design')
PY = R / 'ocor-runtime/.venv/bin/python'
UV = '/home/luca/.local/bin/uv'
TOOLCHAIN = '/home/luca/.ocor-codex/rem0019-escalation-20261020/isolated-git/usr/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'
VWT = D / 'verifier-layout/wt'
STATUS = D / 'status.json'
steps = []


def dump(path, data):
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + '\n')


def record(**row):
    row['at'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    steps.append(row)
    dump(STATUS, {'steps': steps})
    print(json.dumps(row), flush=True)


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def head(repo):
    return subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo, text=True).strip()


def clean(repo):
    return not subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=no'], cwd=repo, text=True)


def campaign_env(repo):
    env = os.environ.copy()
    for key in list(env):
        if key.startswith('OCOR_'):
            env.pop(key)
    env.update(PATH=TOOLCHAIN + env['PATH'], GIT_PAGER='cat', PAGER='cat', GH_PROMPT_DISABLED='1',
               GIT_EDITOR='true', PYTHONHASHSEED='0', TZ='UTC')
    secret = repo / '.ocor/bootstrap.env'
    values = dict(l.split('=', 1) for l in secret.read_text().splitlines() if '=' in l)
    env.update(values)
    env['OCOR_BOOTSTRAP_ENV'] = str(secret)
    env['OCOR_LIVE_POSTGRES_DSN'] = 'postgresql://ocor:' + values['OCOR_LOCAL_POSTGRES_PASSWORD'] + '@127.0.0.1:55433/ocor'
    return env


def guard(label):
    mem = next(int(l.split()[1]) for l in Path('/proc/meminfo').read_text().splitlines() if l.startswith('MemAvailable'))
    listeners = subprocess.run(['ss', '-ltnpH', 'sport = :8080'], capture_output=True, text=True).stdout.splitlines()
    mapping = subprocess.run(['docker', 'port', 'ocor-bootstrap-keycloak-1', '8080/tcp'], capture_output=True,
                             text=True).stdout.split()
    foreign = [l for l in listeners if 'users:' in l and 'docker-proxy' not in l]
    ok = mem >= 6 * 1024 * 1024 and mapping == ['127.0.0.1:8080'] and not foreign and len(listeners) == 1
    row = {'step': 'guard-' + label, 'mem_available_kib': mem, 'port_8080_listeners': len(listeners),
           'port_8080_foreign': len(foreign), 'keycloak_mapping': mapping, 'status': 'PASS' if ok else 'FAIL'}
    record(**row)
    if not ok:
        raise SystemExit('guard failed before ' + label)


def preflight(label):
    out = D / label
    t = time.monotonic()
    with (D / (label + '-driver.log')).open('w') as log:
        r = subprocess.run([sys.executable, '-I', str(D / 'preflight.py'), str(out)], stdout=log,
                           stderr=subprocess.STDOUT, timeout=3600)
    record(step=label, exit_code=r.returncode, duration_seconds=round(time.monotonic() - t, 1),
           result=json.loads((out / 'preflight-result.json').read_text()) if (out / 'preflight-result.json').exists() else None)
    if r.returncode:
        raise SystemExit(label + ' failed')


def regression0050(source):
    out = D / 'regression0050'
    out.mkdir(exist_ok=True)
    cmd = [str(PY), '-m', 'pytest', '-q', 'ocor-runtime/tests/tasks/test_ocor_dev_0050.py',
           '--junitxml=' + str(out / 'regression0050.xml')]
    with (out / 'regression0050.log').open('w') as log:
        r = subprocess.run(cmd, cwd=R, env=campaign_env(R), stdout=log, stderr=subprocess.STDOUT, timeout=2700)
    record(step='regression0050', exit_code=r.returncode, source_head=source, command=cmd)
    if r.returncode or head(R) != source:
        raise SystemExit('0050 regression failed')


def full(label, repo, cmd, cwd, source, new_session):
    guard(label)
    out = D / label
    out.mkdir()
    cmd = [*cmd, '--execute', '--repository', str(repo), '--expected-head', source, '--output-dir', str(out)]
    contract = {'maximum_wait_seconds': 4620, 'command': cmd, 'cwd': str(cwd), 'source_head': source,
                'setsid': new_session, 'harness_sha256': {p: sha(repo / p) for p in
                ['scripts/run_qualifying_campaign.py', 'scripts/observe_kind_teardown.py',
                 'ocor-runtime/tests/tasks/test_ocor_dev_0049.py']},
                'kind_tool': {'path': str(repo / '.ocor/tools/bin/kind'),
                              'is_symlink': (repo / '.ocor/tools/bin/kind').is_symlink(),
                              'resolved': str((repo / '.ocor/tools/bin/kind').resolve())}
                if (repo / '.ocor/tools/bin/kind').exists() else {'path': None, 'walks_up_to': str(MAIN / '.ocor/tools/bin/kind')}}
    dump(D / (label + '-contract.json'), contract)
    t = time.monotonic()
    with (D / (label + '-driver.log')).open('w') as log:
        process = subprocess.Popen(cmd, cwd=cwd, env=campaign_env(repo), stdout=log, stderr=subprocess.STDOUT,
                                   stdin=subprocess.DEVNULL, start_new_session=new_session)
        try:
            code = process.wait(timeout=4620)
        except subprocess.TimeoutExpired:
            process.kill()
            code = 'DRIVER_TIMEOUT'
    result = json.loads((out / 'campaign_result.json').read_text()) if (out / 'campaign_result.json').exists() else None
    obs = json.loads((out / 'kind-teardown-observations.json').read_text()) if (out / 'kind-teardown-observations.json').exists() else {}
    record(step=label, exit_code=code, duration_seconds=round(time.monotonic() - t, 1), source_head=source,
           head_after=head(repo), result=result, removals=len(obs.get('removals', [])),
           rejections=[r.get('reason') for r in obs.get('rejections', [])],
           remover_argv0=[r.get('command', [None])[0] for r in obs.get('remover_observations', [])])
    if code != 0:
        raise SystemExit(label + ' failed')


def verifier_layout(source):
    VWT.parent.mkdir(exist_ok=True)
    subprocess.run(['git', '-C', str(R), 'worktree', 'add', '--detach', str(VWT), source], check=True)
    (VWT / '.ocor/tools/bin').mkdir(parents=True)
    for tool in ('kind', 'helm', 'kubectl'):
        (VWT / '.ocor/tools/bin' / tool).symlink_to(MAIN / '.ocor/tools/bin' / tool)
    secret = VWT / '.ocor/bootstrap.env'
    secret.write_bytes((R / '.ocor/bootstrap.env').read_bytes())
    secret.chmod(0o600)
    subprocess.run(['cp', '-a', str(R / '.ocor/spire'), str(VWT / '.ocor/spire')], check=True)
    ancestors = [str(p) for p in VWT.parents if (p / '.ocor/tools/bin/kind').exists()]
    record(step='verifier-layout', worktree=str(VWT), head=head(VWT), clean=clean(VWT),
           kind_symlink=os.readlink(VWT / '.ocor/tools/bin/kind'), ancestors_with_tools=ancestors)
    if head(VWT) != source or not clean(VWT) or ancestors:
        raise SystemExit('verifier layout invalid')


def teardown():
    with (D / 'teardown.log').open('w') as log:
        r = subprocess.run([str(PY), 'scripts/reset_test_environment.py', '--execute'], cwd=R,
                           env=campaign_env(R), stdout=log, stderr=subprocess.STDOUT, timeout=900)
    record(step='teardown-reset', exit_code=r.returncode)


def main():
    source = head(R)
    record(step='start', source_head=source, clean=clean(R))
    if not clean(R):
        raise SystemExit('dirty source')
    try:
        preflight('preflight-1')
        regression0050(source)
        full('full-local', R, [str(PY), 'scripts/run_qualifying_campaign.py'], R, source, new_session=False)
        preflight('preflight-2')
        verifier_layout(source)
        full('full-verifier-layout', VWT, [UV, 'run', '--project', 'ocor-runtime', '--frozen', '--extra', 'test',
             '--extra', 'lint', 'python', 'scripts/run_qualifying_campaign.py'], VWT, source, new_session=True)
        record(step='done', status='PASS')
    finally:
        teardown()
        subprocess.run(['git', '-C', str(R), 'restore', 'reports/verify_report.json'], capture_output=True)


if __name__ == '__main__':
    main()

END_RAW_FILE cycle3.py
