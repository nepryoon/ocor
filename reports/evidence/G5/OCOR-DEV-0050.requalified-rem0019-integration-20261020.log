SESSION_START = '2026-10-20T20:28:33+00:00'
FULLS = ['full-local', 'full-verifier-layout']


def read(p): return json.loads(p.read_text())
def write(p, x): p.write_text(json.dumps(x, indent=2, sort_keys=True) + '\n')
def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def git(*a): return subprocess.check_output(['git', *a], cwd=R, text=True).strip()
def clean_junit(p):
    cases = list(ET.parse(p).getroot().iter('testcase'))
    assert cases and all(not any(c.findall(k) for k in ['failure', 'error', 'skipped']) for c in cases), p
    return cases
def case_digests(cases):
    return sorted(hashlib.sha256(json.dumps([c.attrib.get('classname'), c.attrib['name']], ensure_ascii=False,
                                            separators=(',', ':')).encode()).hexdigest() for c in cases)


assert git('rev-parse', 'HEAD') == SOURCE and not git('status', '--porcelain')
status = read(D / 'status.json')['steps']
by = {s['step']: s for s in status}
assert by['start']['source_head'] == SOURCE and by['start']['clean'] and by['done']['status'] == 'PASS'
