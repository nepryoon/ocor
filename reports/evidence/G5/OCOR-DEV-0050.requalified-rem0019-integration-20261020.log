"""REM-0019 cycle 3 static gates on the clean tested source, one raw log per gate."""
import hashlib, json, subprocess, sys, time
from pathlib import Path

D = Path(__file__).resolve().parent / 'gates'
R = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
SOURCE = '3cf6e22a7e4cedbf55a32e1ef23dae4e2a6bbb44'
BASE = '3b5d9768b2d6f55ffa5c34fcfb7db28a3e8694fd'
PY = str(R / 'ocor-runtime/.venv/bin/python')
RUFF = '/home/luca/.local/share/uv/tools/ruff/bin/ruff'
TOOLCHAIN = '/home/luca/.ocor-codex/rem0019-escalation-20261020/isolated-git/usr/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'
GENERATED = ['reports/planning/OCOR_PLANNING_VALIDATION_REPORT.md', 'reports/planning/OCOR_PLAN_RUN_STATE.json',
             'reports/verify_report.json']
GATES = [
    ('inputs', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS']),
    ('inputs-diff', ['git', 'diff', '--exit-code', BASE, '--', 'inputs/']),
    ('ruff', [RUFF, 'check', '.']),
    ('mypy', [PY, '-m', 'mypy']),
    ('verify', [PY, 'scripts/verify.py', '--json']),
    ('drift', [PY, 'scripts/validate_evidence_input_drift.py', '--root', '.']),
    ('rccad', [PY, 'scripts/validate_rccad.py', '--base-ref', BASE]),
    ('scope', [PY, 'scripts/validate_ocor_change_scope.py']),
    ('plan', [PY, 'scripts/validate_ocor_development_plan.py', '--base-ref', BASE, '--authorized-extension']),
    ('language', [PY, 'scripts/validate_language_policy.py']),
]


def git(*args):
    return subprocess.check_output(['git', *args], cwd=R, text=True).strip()


def main():
    assert git('rev-parse', 'HEAD') == SOURCE and not git('status', '--porcelain')
    D.mkdir()
    env = {**__import__('os').environ}
    env['PATH'] = TOOLCHAIN + env['PATH']
    rows = []
    for label, cmd in GATES:
        log = D / (label + '.log')
        start = time.monotonic()
        with log.open('w') as out:
            code = subprocess.run(cmd, cwd=R, env=env, stdout=out, stderr=subprocess.STDOUT).returncode
        rows.append({'label': label, 'command': cmd, 'exit_code': code,
                     'duration_seconds': round(time.monotonic() - start, 3),
                     'raw_sha256': hashlib.sha256(log.read_bytes()).hexdigest()})
        # Validators that rewrite generated reports must leave the tested source byte-identical.
        subprocess.run(['git', 'checkout', '--', *GENERATED], cwd=R, check=True)
    assert git('rev-parse', 'HEAD') == SOURCE and not git('status', '--porcelain')
    (D / 'gates.json').write_text(json.dumps(rows, indent=2, sort_keys=True) + '\n')
    print(json.dumps([[r['label'], r['exit_code']] for r in rows]))
    return 0 if all(r['exit_code'] == 0 for r in rows) else 1


if __name__ == '__main__':
    sys.exit(main())

