RAW_FILE check_manifest.py SHA256 e915e98911e5a378cb727dcc9208ac77209e5b52dc7934428bf6c9922663d57b
import hashlib,json,sys
from pathlib import Path
root=Path(sys.argv[1])
m=json.loads((root/'reports/evidence/G5/MANIFEST.json').read_text())
rows=[r for r in m['requirement_results'] if r['task_id']=='OCOR-DEV-0050']
assert len(rows)==12
errors=[]
for row in rows:
 path=root/'reports/evidence/G5'/row['evidence_path']
 record=json.loads(path.read_text())
 matching=[r for r in record['requirement_results'] if r['case_id']==row['case_id'] and r['requirement_id']==row['requirement_id'] and r['status']==row['status']]
 if len(matching)!=1: errors.append({'case_id_sha256':hashlib.sha256(row['case_id'].encode()).hexdigest(),'reason':'MANIFEST_CASE_NOT_IN_RECORD'})
 raw=root/'reports/evidence/G5'/row['raw_output_path']
 assert raw.is_file()
 assert record['raw_output_sha256']==hashlib.sha256(raw.read_bytes()).hexdigest()
print(json.dumps({'status':'FAIL' if errors else 'PASS','checked_rows':len(rows),'findings':errors},indent=2,sort_keys=True))
sys.exit(bool(errors))

END_RAW_FILE check_manifest.py
