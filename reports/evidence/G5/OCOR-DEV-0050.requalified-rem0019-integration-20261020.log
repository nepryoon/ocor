# Session-owned resources: nothing created after the session start may remain.
def created_after(kind, fmt):
    ids = subprocess.check_output(['docker', kind, 'ls', '-q'] + (['-a'] if kind == 'container' else []), text=True).split()
    left = []
    for i in ids:
        stamp = subprocess.check_output(['docker', kind, 'inspect', '-f', fmt, i], text=True).strip()
        stamp = re.sub(r'^(\S+) (\S+) ([+-]\d{2})(\d{2}) \S+$', r'\1T\2\3:\4', stamp)
        if datetime.fromisoformat(re.sub(r'\.(\d{6})\d*', r'.\1', stamp.replace('Z', '+00:00'))) >= datetime.fromisoformat(SESSION_START):
            left.append(i)
    return len(ids), left
