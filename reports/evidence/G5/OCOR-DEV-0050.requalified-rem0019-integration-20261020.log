RAW_FILE full.py SHA256 62b585af4e309d333830fcdc74d44d7edab91ad198c89cc231e50ddee9f7d4a4
import hashlib,json,os,subprocess,time
from pathlib import Path
D=Path(__file__).parent
R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
env=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true',PYTHONHASHSEED='0',TZ='UTC')
values=dict(l.split('=',1) for l in (R/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(R/'.ocor/bootstrap.env')
env['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:'+values['OCOR_LOCAL_POSTGRES_PASSWORD']+'@127.0.0.1:55433/ocor'
source=subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()
assert not subprocess.check_output(['git','status','--porcelain'],cwd=R,text=True)
cmd=[str(R/'ocor-runtime/.venv/bin/python'),'scripts/run_qualifying_campaign.py','--execute','--repository',str(R),'--expected-head',source,'--output-dir',str(D/'full')]
contract={'maximum_wait_seconds':4500,'poll_seconds':5,'status_poll_seconds':60,'stop_on_restart_or_oom':True,'command':cmd,'source_head':source,'harness_sha256':{p:hashlib.sha256((R/p).read_bytes()).hexdigest() for p in ['scripts/run_qualifying_campaign.py','scripts/observe_kind_teardown.py']}}
(D/'full-wait-contract.json').write_text(json.dumps(contract,indent=2,sort_keys=True)+'\n')
t=time.monotonic()
with (D/'full-driver.log').open('w') as f:
 r=subprocess.run(cmd,cwd=R,env=env,stdout=f,stderr=subprocess.STDOUT,timeout=4620)
(D/'full-exit.json').write_text(json.dumps({'command':cmd,'exit_code':r.returncode,'source_head_at_launch':source,'duration_seconds':time.monotonic()-t},indent=2,sort_keys=True)+'\n')
raise SystemExit(r.returncode)

END_RAW_FILE full.py
