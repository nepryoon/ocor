{"command": "captured artifact: source of the mutation probe (mutant table)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"Mutation probe: each mutant of the remediation must make the REM-0020/0052 suites fail.\"\"\"\nimport json, os, subprocess, sys\nfrom pathlib import Path\nW = Path(sys.argv[1]); out = Path(sys.argv[2])\nR = W / \"ocor-runtime/src/ocor_runtime/memory/retrieval.py\"\nS = W / \"ocor-runtime/src/ocor_runtime/memory/stores.py\"\nMUTANTS = {\n    \"no-predicate-scope\": (R, \"            with eligibility_scope(plan.predicate):\\n\", \"            if True:\\n\"),\n    \"structured-no-lazy-revalidation\": (R, \"            if not chosen.validated:\\n\", \"            if False:\\n\"),\n    \"hybrid-missing-factor-defaults-zero\": (R, \"        if query.mode is RetrievalMode.HYBRID:\\n            self._complete_hybrid(plan, merged)\\n\", \"        if False:\\n            self._complete_hybrid(plan, merged)\\n\"),\n    \"hybrid-lexical-not-normalised-on-union\": (R, \"                candidate.lexical = candidate.lexical / top if top > 0 else 0.0\\n\", \"                candidate.lexical = candidate.lexical\\n\"),\n    \"no-per-hit-stop-check\": (R, \"            # A stop or revocation during the read leaves no hit behind.\\n            self._require_stop_epoch(plan)\\n\", \"\\n\"),\n    \"no-pre-receipt-stop-check\": (R, \"        audit_ref = canonical_digest(receipt)\\n        self._require_stop_epoch(plan)\\n\", \"        audit_ref = canonical_digest(receipt)\\n\"),\n    \"no-pre-loop-stop-check\": (R, \"        self._require_stop_epoch(plan)\\n        query = plan.query\\n\", \"        query = plan.query\\n\"),\n    \"no-post-plan-denial-audit\": (R, \"            self._record_denial(\\n                query, context, gcs_digest, binding.binding_ref, exc, self._clock.now()\\n            )\\n\", \"            pass\\n\"),\n    \"structured-cap-reinstated\": (R, \"                candidates.append(\\n                    _Candidate(\\n\", \"                if len(candidates) >= 128:\\n                    raise MemoryRetrievalError('REPRESENTATION_NOT_READY', 'RETRIEVAL_BACKPRESSURE', 'cap')\\n                candidates.append(\\n                    _Candidate(\\n\"),\n    \"no-retire-after-commit\": (S, \"        self._retire_predecessors(committed.staged)\\n        return self._receipt(committed)\\n\", \"        return self._receipt(committed)\\n\"),\n    \"no-retire-on-replay\": (S, \"            self._retire_predecessors(stored.staged)\\n            return self._receipt(stored)\\n\", \"            return self._receipt(stored)\\n\"),\n    \"retire-only-new-layouts\": (S, \"            self._metadata.get(staged.memory_item_id, staged.memory_version - 1),\\n            StoredVersion(\", \"            None,\\n            StoredVersion(\"),\n    \"no-retire-on-reconcile\": (S, \"            self._retire_predecessors(staged)\\n            return _Outcome.COMPLETED\\n\", \"            return _Outcome.COMPLETED\\n\"),\n    \"lexical-lookup-ignores-scope\": (S, \"        where = _ELIGIBILITY.get()\\n        index = self._lexical\\n\", \"        where = None\\n        index = self._lexical\\n\"),\n    \"vector-lookup-ignores-scope\": (S, \"        where = _ELIGIBILITY.get()\\n        index = self._vector\\n\", \"        where = None\\n        index = self._vector\\n\"),\n    \"predicate-accepts-superseded\": (S, '                attributes[\"superseded\"] is not False\\n                or ', \"                \"),\n    \"predicate-ignores-validity\": (S, \"            if not valid_from <= self.valid_at_us < valid_until or expires_at <= self.now_us:\\n\", \"            if expires_at <= self.now_us:\\n\"),\n    \"unsupported-index-falls-back\": (S, \"    if not isinstance(index, EligibilityIndexPort):\\n        raise _not_ready(\", \"    if False:\\n        raise _not_ready(\"),\n    \"scores-skip-binding-check\": (S, \"                or registered != (pointer, VersionState.COMMITTED)\\n            ):\\n                raise _not_ready(\\\"POINTER_UNBOUND\\\"\", \"            ):\\n                raise _not_ready(\\\"POINTER_UNBOUND\\\"\"),\n}\noriginals = {R: R.read_text(), S: S.read_text()}\nresults = {}\ntry:\n    for name, (path, old, new) in MUTANTS.items():\n        assert originals[path].count(old) == 1, name\n        path.write_text(originals[path].replace(old, new))\n        r = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-x\", \"-p\", \"no:cacheprovider\",\n                            \"tests/tasks/test_ocor_dev_rem_0020.py\", \"tests/tasks/test_ocor_dev_0052.py\"],\n                           cwd=W / \"ocor-runtime\", capture_output=True, text=True, env=dict(os.environ), timeout=1800)\n        path.write_text(originals[path])\n        lines = r.stdout.strip().splitlines()\n        failed = [l for l in lines if l.startswith(\"FAILED\")]\n        results[name] = {\"file\": path.name, \"exit_code\": r.returncode, \"killed\": r.returncode != 0,\n                         \"summary\": lines[-1] if lines else r.stderr[-200:], \"first_failure\": failed[0] if failed else None}\n        print(name, results[name], flush=True)\nfinally:\n    for path, text in originals.items():\n        path.write_text(text)\nout.write_text(json.dumps(results, indent=2, sort_keys=True) + \"\\n\")\nprint(\"ALL_KILLED\" if all(v[\"killed\"] for v in results.values()) else \"SURVIVORS\")\n", "sha256": "deb0ba2b62d375a3b8a9768516742ce8930927ace4503e850a37d0d080ca74a6"}
