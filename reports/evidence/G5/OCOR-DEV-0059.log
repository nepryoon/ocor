{"command": "captured artifact: exact mutation harness, archived for reproduction", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-0059 mutation probe (Claude Code/Anthropic).\n\nEach mutant removes or weakens exactly one control of memory/operations.py in a\ngit-archive scratch tree of the frozen HEAD (the worktree is never mutated), then\nruns the whole task file on the live stack; it must fail. Usage:\n  mutation_probe.py <output.json>\n\"\"\"\nimport hashlib, json, os, shutil, subprocess, sys, tempfile\nfrom pathlib import Path\n\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0059')\nPY = str(R / 'ocor-runtime/.venv/bin/python')\nREL = 'ocor-runtime/src/ocor_runtime/memory/operations.py'\nM = {\n    'inventory-membership-ignored': ('if observed != expected:', 'if False:'),\n    'restore-stop-epoch-ignored': ('if self._epoch() != expected:', 'if False:'),\n    'restore-context-unbound': ('if body[\"governed_context_digest\"] != self._context.digest():', 'if False:'),\n    'signature-ignored': ('if verified is not True or digest is None:', 'if digest is None:'),\n    'stale-epoch-skipped': ('if (current.sequence < recorded.sequence', 'if False and (current.sequence < recorded.sequence'),\n    'extra-item-ignored': ('if not restored_ids <= set(recorded):', 'if False:'),\n    'stage-not-compared': ('or stored.staged.stage_digest != entry[\"stage_digest\"]', 'or False'),\n    'serve-post-check-dropped': ('                    self._check_epoch(epoch)\\n                    self._verify(body, obligations)\\n', '                    self._check_epoch(epoch)\\n'),\n    'capture-checkpoint-race': ('if self._checkpoint() != checkpoint:', 'if False:'),\n    'tombstone-epoch-unchecked': ('if record is None or record.item.deletion_epoch != tomb.deletion_epoch:', 'if False:'),\n    'pointer-epoch-unchecked': ('p.deletion_epoch for p in stored.staged.pointers] != [x[\"deletion_epoch\"] for x in representations]', '0] != [0]'),\n    'recovery-point-unchecked': ('if body[\"recovery_point_id\"] != self._point:', 'if False:'),\n    'manifest-epoch-newer': ('if tomb is not None and epoch is not None and tomb.deletion_epoch < epoch:', 'if False:'),\n    'version-digests-unchecked': ('or digests != entry[\"item_digests\"]', 'or False'),\n    'reconcile-skipped': ('reconciled = self._gate.reconcile()', 'reconciled = __import__(\"types\").SimpleNamespace(checkpoint=current, obligations=0)'),\n    'quota-not-enforced': ('        service._enforce_quota(replace(usage', '        (lambda *a: None)(replace(usage'),\n    'writer-unserialized': ('stack.enter_context(self._serialization.hold(plan.partition.digest))', 'pass'),\n    'writer-gcs-unbound': ('if (item.governed_context_digest != plan.context.digest()', 'if False and (item.governed_context_digest != plan.context.digest()'),\n    'writer-content-digest-unchecked': ('if not isinstance(payload, bytes) or \"urn:sha256:\" + hashlib.sha256(payload).hexdigest() != item.content_digest:', 'if not isinstance(payload, bytes):'),\n    'pressure-evicts-hold': ('            if item.lifecycle_status is LifecycleStatus.LEGAL_HOLD:\\n                held.append(item.memory_item_id)\\n            elif item.lifecycle_status in {LifecycleStatus.ACTIVE,', '            if False:\\n                held.append(item.memory_item_id)\\n            elif item.lifecycle_status in {LifecycleStatus.LEGAL_HOLD, LifecycleStatus.ACTIVE,'),\n    'monitor-foreign-partition': ('                raise _error(\"PARTITION_DENIED\")', '                pass'),\n}\nout = Path(sys.argv[1])\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\nscratch = Path(tempfile.mkdtemp(prefix='ocor-0059-mutation-', dir=str(Path.home() / '.ocor-codex/ocor-dev-0059/repair1')))\ntry:\n    archive = subprocess.run(['git', 'archive', head], cwd=R, check=True, capture_output=True).stdout\n    subprocess.run(['tar', '-x', '-C', str(scratch)], input=archive, check=True)\n    src = scratch / REL\n    original = src.read_text()\n    assert hashlib.sha256(original.encode()).hexdigest() == hashlib.sha256((R / REL).read_bytes()).hexdigest()\n    results = {}\n    for name, (a, b) in M.items():\n        assert original.count(a) == 1, (name, original.count(a))\n        src.write_text(original.replace(a, b))\n        p = subprocess.run([PY, '-m', 'pytest', '-q', '-x', '-p', 'no:cacheprovider', 'ocor-runtime/tests/tasks/test_ocor_dev_0059.py'],\n                           cwd=scratch, env=os.environ, capture_output=True, text=True, timeout=900)\n        tail = (p.stdout.strip().splitlines() or [''])[-1]\n        failing = next((l for l in p.stdout.splitlines() if l.startswith('FAILED')), '')\n        results[name] = {'killed': p.returncode != 0, 'equivalent': False, 'exit_code': p.returncode, 'summary': tail,\n                         'first_failure': failing, 'replacement_sha256': hashlib.sha256((a + '\\0' + b).encode()).hexdigest()}\n        print(name, p.returncode, tail, flush=True)\n    src.write_text(original)\n    p = subprocess.run([PY, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', 'ocor-runtime/tests/tasks/test_ocor_dev_0059.py'],\n                       cwd=scratch, env=os.environ, capture_output=True, text=True, timeout=900)\n    assert p.returncode == 0, 'unmutated baseline must pass'\n    print('baseline', (p.stdout.strip().splitlines() or [''])[-1], flush=True)\n    out.write_text(json.dumps(results, indent=2, sort_keys=True) + '\\n')\nfinally:\n    shutil.rmtree(scratch, ignore_errors=True)\n", "sha256": "0de9938219feaf430e14f5d0f3409e62804206462a95a3b8bfaaa0de21035fee"}
{"command": "captured artifact: exact local campaign driver: frozen extras, bootstrap_ci_environment.py, unchanged repository full harness and limits", "exit_code": 0, "label": "qualifying-local-driver", "output": "\"\"\"OCOR-DEV-0059 qualification (implementers Codex/OpenAI and Claude Code/Anthropic; driver adapted by Claude Code from the sealed 0058 repair2 driver).\n\nOne stack, sequential. Phases:\n  gates     toolchain lock, inputs, harness, drift, ruff, mypy strict, language, rccad, scope, plan\n  stack     teardown + scripts/bootstrap_ci_environment.py --execute (VERIFIER-ENV-STANDARD-BOOTSTRAP)\n  mutation  archived mutation probe of memory/operations.py on a git-archive scratch of the code commit\n  task      task file x3, backlog validation command (project form), SDK ci/build, reports portfolio\n  full      teardown + bootstrap_ci_environment.py --execute, governed full suite (75-min limit)\nEvery step: verbatim redacted log, exit code, duration, sha256. Fail-closed.\n\"\"\"\nimport hashlib, json, os, re, shutil, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nD = Path(__file__).parent\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0059')\nPY = R / 'ocor-runtime/.venv/bin/python'\nTASKFILE = 'ocor-runtime/tests/tasks/test_ocor_dev_0059.py'\nBRANCH = 'task/OCOR-DEV-0059-memory-operations'\nenv = os.environ.copy()\nenv.update(PATH='/home/luca/.ocor-codex/rem0019-escalation-20261020/isolated-git/usr/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:/home/luca/.local/bin:' + env['PATH'],\n           GIT_PAGER='cat', PAGER='cat', GH_PROMPT_DISABLED='1', GIT_EDITOR='true', PYTHONHASHSEED='0', TZ='UTC')\nfor k in list(env):\n    if k.startswith('OCOR_'):\n        env.pop(k, None)\nsecret = R / '.ocor/bootstrap.env'\nvalues: dict[str, str] = {}\nrows: list[dict] = []\nphases = sys.argv[1].split(',') if len(sys.argv) > 1 else ['gates', 'mutation', 'stack', 'task', 'full']\nif (D / 'commands.json').exists():\n    rows = json.loads((D / 'commands.json').read_text())\n\n\ndef load_values() -> None:\n    values.clear()\n    if secret.exists():\n        values.update(dict(l.split('=', 1) for l in secret.read_text().splitlines() if '=' in l))\n\n\ndef redact(text: str) -> str:\n    for k, v in values.items():\n        if ('PASSWORD' in k or 'TOKEN' in k) and len(v) > 7:\n            text = text.replace(v, '<REDACTED_LOCAL_CREDENTIAL>')\n    return text\n\n\ndef dump(p: Path, d: object) -> None:\n    p.write_text(json.dumps(d, indent=2, sort_keys=True) + '\\n')\n\n\ndef inventory() -> dict:\n    return {k: sorted(subprocess.check_output(c, text=True, timeout=60, env=env).split()) for k, c in [\n        ('containers', ['docker', 'ps', '-a', '--format', '{{.Names}}']), ('volumes', ['docker', 'volume', 'ls', '-q']),\n        ('networks', ['docker', 'network', 'ls', '--format', '{{.Name}}'])]}\n\n\ndef junit(path: Path) -> dict:\n    root = ET.parse(path).getroot()\n    suites = [root] if root.tag == 'testsuite' else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in ('tests', 'failures', 'errors', 'skipped')}\n    return {'passed': t['tests'] - t['failures'] - t['errors'] - t['skipped'], 'failed': t['failures'], 'errors': t['errors'],\n            'skipped': t['skipped'], 'not_executed': 0, 'tests': t['tests']}\n\n\ndef run(label, c, limit=600, fatal=True, xml=None, live=False, cwd=R):\n    e = dict(env)\n    if live:\n        e.update(values)\n        e['OCOR_BOOTSTRAP_ENV'] = str(secret)\n        e['OCOR_LIVE_POSTGRES_DSN'] = 'postgresql://ocor:' + values['OCOR_LOCAL_POSTGRES_PASSWORD'] + '@127.0.0.1:55433/ocor'\n    t = time.monotonic()\n    started = datetime.now(UTC).isoformat()\n    try:\n        r = subprocess.run(c, cwd=cwd, env=e, capture_output=True, text=True, timeout=limit)\n        rc, out = r.returncode, r.stdout + r.stderr\n    except subprocess.TimeoutExpired as exc:\n        rc = 124\n        out = (exc.stdout or b'').decode(errors='replace') if isinstance(exc.stdout, bytes) else (exc.stdout or '')\n        out += f'\\nTIMEOUT after {limit}s\\n'\n    load_values()\n    out = redact(out)\n    p = D / (label + '.log')\n    p.write_text(out)\n    p.chmod(0o600)\n    row = {'label': label, 'command': c, 'exit_code': rc, 'started_at': started, 'duration_seconds': round(time.monotonic() - t, 3),\n           'raw_sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'head_sha': head, 'status': 'PASS' if rc == 0 else 'FAIL'}\n    if live:\n        row['environment'] = 'OCOR_LIVE_POSTGRES_DSN=<local generated credential>'\n    if xml is not None and Path(xml).exists():\n        row['result'] = junit(Path(xml))\n        row['junit_sha256'] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if row['result']['skipped'] or row['result']['failed'] or row['result']['errors']:\n            row['status'] = 'FAIL'\n    rows[:] = [x for x in rows if x['label'] != label] + [row]\n    dump(D / 'commands.json', rows)\n    print(datetime.now(UTC).strftime('%H:%M:%S'), label, row['status'], rc, flush=True)\n    if fatal and row['status'] != 'PASS':\n        raise SystemExit(f'ABORT at {label}')\n    return out\n\n\ndef stack(prefix: str) -> None:\n    run(prefix + 'teardown', [str(PY), 'scripts/bootstrap_ci_environment.py', '--teardown', '--execute'], 300)\n    # The stack is gone (teardown residual PASS); its generated credential file is now\n    # dead and bootstrap_ci_environment.py requires a fresh one. The disposable CA stays.\n    run(prefix + 'retire-credentials', ['rm', '-f', '--', '.ocor/bootstrap.env'], 30)\n    assert not secret.exists()\n    out = run(prefix + 'bootstrap-ci', [str(PY), 'scripts/bootstrap_ci_environment.py', '--execute', '--timeout', '600'], 700)\n    load_values()\n    assert json.loads(out[out.index('{\\n'):])['status'] == 'PASS'\n    build_log = R / 'reports/tests/ci_fuseki_build.log'\n    if build_log.exists():\n        shutil.move(str(build_log), str(D / (prefix + 'ci_fuseki_build.log')))\n    ids = subprocess.check_output(['docker', 'ps', '-aq', '--filter', 'label=com.docker.compose.project=ocor-bootstrap'], text=True, env=env, timeout=30).split()\n    assert len(ids) == 11\n    props = json.loads(subprocess.check_output(['docker', 'inspect', *ids], text=True, env=env, timeout=30))\n    summary = [{'name': c['Name'], 'image_id': c['Image'], 'running': c['State']['Running'], 'oom': c['State']['OOMKilled'], 'restarts': c['RestartCount']} for c in props]\n    assert all(c['running'] and not c['oom'] and c['restarts'] == 0 for c in summary)\n    dump(D / (prefix + 'stack-summary.json'), summary)\n\n\ndef portfolio_files() -> list[str]:\n    return ['reports/tests/test_generate_contracts_reference_resolution.py', 'reports/tests/test_backlog_generator_reality_parity.py',\n            'reports/tests/test_runtime_evidence_validator.py', 'reports/tests/test_evidence_input_drift.py',\n            'reports/tests/test_language_migration_benchmark_harness.py', 'reports/tests/test_qualifying_campaign_guard.py',\n            'reports/tests/test_fuseki_archive_acquisition.py', 'reports/tests/test_kind_teardown_observation.py',\n            'reports/tests/test_ci_fuseki_archive.py', 'reports/tests/test_rem0034_secret_registry.py',\n            'reports/tests/test_rem0023_consumer_fixture_scope.py']\n\n\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\nassert not subprocess.check_output(['git', 'status', '--porcelain'], cwd=R, text=True, env=env).strip(), 'dirty worktree'\nload_values()\nif 'gates' in phases:\n    lock = json.loads((R / 'infra/toolchain.lock.json').read_text())\n    tools = []\n    for x in lock['tools']:\n        if x['provider'] == 'container':\n            props = json.loads(subprocess.check_output(['docker', 'image', 'inspect', x['container_image']], text=True, env=env, timeout=30))[0]\n            java = next(v.split('=', 1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env'] + '='))\n            assert java.removeprefix('jdk-') == x['version'] and x['container_image'] in props['RepoDigests']\n            tools.append({'id': x['id'], 'version': java, 'version_match': True, 'digest_match': True})\n            continue\n        p = PY if x['id'] == 'python' else Path(shutil.which(x['command'], path=env['PATH']))\n        v = subprocess.check_output([str(p), *x['version_args']], text=True, env=env, stderr=subprocess.STDOUT, timeout=30).strip()\n        digest = hashlib.sha256(p.read_bytes()).hexdigest()\n        row = {'id': x['id'], 'path': str(p), 'version': v, 'version_match': bool(re.search(x['version_pattern'], v)), 'sha256': digest, 'digest_match': digest == x['integrity']}\n        tools.append(row)\n        assert row['version_match'] and row['digest_match'], x['id']\n    dump(D / 'toolchain.json', {'tools': tools})\n    run('inputs', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS'])\n    run('sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n    run('harness', [str(PY), 'scripts/verify.py', '--json'])\n    subprocess.run(['git', 'restore', 'reports/verify_report.json'], cwd=R, check=True)\n    run('drift', [str(PY), 'scripts/validate_evidence_input_drift.py'])\n    run('ruff', ['ruff', 'check', '.'])\n    run('mypy', [str(PY), '-m', 'mypy'])\n    run('language', [str(PY), 'scripts/validate_language_policy.py'])\n    run('rccad', [str(PY), 'scripts/validate_rccad.py', '--base-ref', 'origin/main'])\n    run('scope', [str(PY), 'scripts/validate_ocor_change_scope.py', '--base', 'origin/main', '--branch', BRANCH])\n    run('plan', [str(PY), 'scripts/validate_ocor_development_plan.py', '--base-ref', 'HEAD', '--authorized-extension'])\n    subprocess.run(['git', 'checkout', '--', 'reports/planning/'], cwd=R, check=True)\nif 'stack' in phases:\n    stack('')\nif 'mutation' in phases:\n    run('preflight', [str(PY), 'scripts/preflight_environment.py', '--require-ready'], 60)\n    run('mutation-probe', [sys.executable, str(D / 'mutation_probe.py'), str(D / 'mutation-probe.json')], 1800, live=True)\n    assert all(v['killed'] or v.get('equivalent') for v in json.loads((D / 'mutation-probe.json').read_text()).values())\nif 'task' in phases:\n    before = inventory()\n    for n in (1, 2, 3):\n        x = D / f'task-{n}.xml'\n        run(f'task-run-{n}', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', TASKFILE], 45 * 60, xml=x, live=True)\n    x = D / 'task-validation-command-project.xml'\n    run('task-validation-command-project', ['uv', 'run', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', TASKFILE], 45 * 60, xml=x, live=True)\n    after = inventory()\n    delta = {k: sorted(set(after[k]) - set(before[k])) for k in before}\n    dump(D / 'task-resource-delta.json', delta)\n    assert not any(delta.values()), delta\n    run('sdk-ci', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'ci'], 900)\n    run('sdk-build', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'run', 'build'], 900)\n    x = D / 'reports-portfolio.xml'\n    run('reports-portfolio', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', *portfolio_files(), f'--junitxml={x}'], 1200, xml=x)\n    subprocess.run(['git', 'checkout', '--', 'reports/'], cwd=R, check=True)\nif 'full' in phases:\n    run('full-reset', [str(PY), 'scripts/reset_test_environment.py', '--execute'], 300)\n    stack('full-')\n    run('full-sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n    run('full-mypy-ready', [str(PY), '-c', 'import mypy.version; print(mypy.version.__version__)'])\n    dump(D / 'resources-before-full.json', inventory())\n    run('full-suite', [str(PY), 'scripts/run_qualifying_campaign.py', '--execute', '--repository', '.', '--expected-head', head, '--output-dir', str(D / 'full')], 4650, live=True)\n    dump(D / 'resources-after-full.json', inventory())\nprint('DONE', flush=True)\n", "sha256": "a0873bd433f8fc7e7e1d1b561fb9b593f6a4d1744cb8b6aa9fc4f2785147a1a8"}
