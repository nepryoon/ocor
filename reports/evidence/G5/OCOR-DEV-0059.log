{"command": "captured artifact: Executable AST preservation check; baseline and exact-head code read from Git; no test execution or selection changed", "exit_code": 0, "label": "test-preservation-checker", "output": "\"\"\"Assert that every pre-existing 0059 test is preserved (only constructor inputs may change).\"\"\"\nimport ast,hashlib,json,subprocess,sys\nfrom pathlib import Path\nr=Path(sys.argv[1]);head=sys.argv[2]\nrel='ocor-runtime/tests/tasks/test_ocor_dev_0059.py';base='e226fc7d127c3b660e2ea7c82864525577ecaf2d'\ndef show(ref):return subprocess.check_output(['git','show',ref+':'+rel],cwd=r)\na,b=show(base),show(head)\ndef tests(raw):return {n.name:n for n in ast.parse(raw).body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}\nx,y=tests(a),tests(b)\ndef obligations(n):return ([ast.dump(z) for z in ast.walk(n) if isinstance(z,ast.Assert)],[ast.dump(z) for z in n.decorator_list],[ast.dump(z) for z in ast.walk(n) if isinstance(z,ast.Call) and ast.unparse(z.func)=='pytest.raises'])\nassert not (set(x)-set(y))\nassert all(obligations(x[k])==obligations(y[k]) for k in x)\nclass WithoutNewConstructorInputs(ast.NodeTransformer):\n def visit_Call(self,node):\n  self.generic_visit(node)\n  if isinstance(node.func,ast.Name) and node.func.id=='MemoryRestoreGate':node.keywords=[k for k in node.keywords if k.arg not in {'stop','binding'}]\n  return node\nassert all(ast.dump(x[k])==ast.dump(WithoutNewConstructorInputs().visit(y[k])) for k in x)\nprint(json.dumps({'status':'PASS','base_sha':base,'head_sha':head,'base_test_blob_sha256':hashlib.sha256(a).hexdigest(),'current_test_blob_sha256':hashlib.sha256(b).hexdigest(),'original_test_functions':len(x),'new_test_functions':sorted(set(y)-set(x)),'assertions_decorators_pytest_raises':'AST identical for every original test','all_original_test_bodies':'AST identical after removing only the new stop/binding constructor keyword arguments; no cases or assertions removed'},indent=2,sort_keys=True))\n", "sha256": "07eda7132f773d41e6faf0c5956eb8d894d534ad0f4385031b3b75567385de23"}
{"command": "captured artifact: AST preservation of every original test, assertion, decorator and pytest.raises; only required restore constructor keywords added", "exit_code": 0, "label": "test-preservation", "output": "{\n  \"all_original_test_bodies\": \"AST identical after removing only the new stop/binding constructor keyword arguments; no cases or assertions removed\",\n  \"assertions_decorators_pytest_raises\": \"AST identical for every original test\",\n  \"base_sha\": \"e226fc7d127c3b660e2ea7c82864525577ecaf2d\",\n  \"base_test_blob_sha256\": \"29706a042b682961f6fe3fbab4aad8165496d9136ab40ee6ed493ec2094a5fd6\",\n  \"current_test_blob_sha256\": \"c707905d7753d932bab5fc14ad423f2715a6627673671b43aa1a505160dbf5c2\",\n  \"head_sha\": \"5abf97104498d54844a70035056f47a017dd82f7\",\n  \"new_test_functions\": [\n    \"test_live_inventory_disappearance_by_reclassification_is_refused\",\n    \"test_live_inventory_membership_race_never_completes\",\n    \"test_live_restore_rechecks_stop_around_materialisation\",\n    \"test_partition_inventory_compares_committed_head_membership\",\n    \"test_restore_reads_the_verified_context_and_preserves_nonzero_epoch\",\n    \"test_restore_requires_a_verified_context_at_composition\",\n    \"test_restore_stop_change_during_final_validation_or_audit_is_closed\",\n    \"test_restore_stop_denial_audit_outage_never_leaves_the_gate_open\",\n    \"test_signed_restore_manifest_must_match_the_trusted_context\",\n    \"test_unit_inventory_disappearance_by_reclassification_is_refused\",\n    \"test_unit_inventory_membership_race_never_completes\",\n    \"test_unit_restore_stop_authority_is_mandatory\",\n    \"test_unit_restore_stop_epoch_race_closes_without_a_response\"\n  ],\n  \"original_test_functions\": 51,\n  \"status\": \"PASS\"\n}\n", "sha256": "651c13542eac800b44d63b9e0160ed4ac4a018e10a2ea9ba50cfac09d3be0ab6"}
