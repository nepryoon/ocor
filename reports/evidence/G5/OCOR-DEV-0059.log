{"command": "captured artifact: exact evidence builder with explicit AST fixture classification", "exit_code": 0, "label": "evidence-builder-script", "output": "\"\"\"Build the OCOR-DEV-0059 candidate evidence from raw logs (no hand-entered counts).\n\nUsage: build_evidence.py <repo> <campaign_dir> <code_commit>\nCounts come only from JUnit XML archived with parameterized names replaced by SHA256 in the JSONL raw output.\nThe G5 manifest is updated surgically: existing entries are preserved, the\nOCOR-DEV-0059 entries are appended (or replaced on rebuild).\nAdapted by Claude Code (Anthropic) from the sealed OCOR-DEV-0058 repair2 builder.\n\"\"\"\nimport ast, hashlib, json, re, subprocess, sys\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nrepo, q, code_commit = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]\nH = Path.home() / \".ocor-codex\"\nTASK = \"OCOR-DEV-0059\"\nG5 = repo / \"reports/evidence/G5\"\nINPUT_PATHS = (\"ocor-runtime/src/ocor_runtime/memory/operations.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_0059.py\")\n\n\ndef sha(b: bytes) -> str:\n    return hashlib.sha256(b).hexdigest()\n\n\ndef git(*a: str) -> str:\n    return subprocess.check_output([\"git\", *a], cwd=repo, text=True).strip()\n\n\nSECRETS = {n: v for n, v in (l.split(\"=\", 1) for l in (repo / \".ocor/bootstrap.env\").read_text().splitlines() if \"=\" in l)\n           if n.startswith((\"OCOR_LOCAL_\", \"OCOR_SPIRE_JOIN\")) and len(v) >= 8}\nredactions: dict[str, int] = {}\nraw_lines: list[str] = []\nsource_digests: dict[str, str] = {}\nidentity_redactions: dict[str, int] = {}\n\n\ndef redact(b: bytes) -> bytes:\n    t = b.decode(\"utf-8\")\n    for n, v in SECRETS.items():\n        c = t.count(v)\n        if c:\n            redactions[n] = redactions.get(n, 0) + c\n            t = t.replace(v, f\"<redacted:{n}>\")\n    return t.encode()\n\n\ndef add_raw(label: str, command: str, exit_code: int, data: bytes) -> str:\n    source_digests[label] = sha(data)\n    if label.endswith(\"junit\"):\n        root = ET.fromstring(data)\n        total = 0\n        for case in root.iter(\"testcase\"):\n            name = case.get(\"name\", \"\")\n            if \"[\" in name:\n                case.set(\"name\", name.split(\"[\", 1)[0] + \"[sha256:\" + sha(name.encode()) + \"]\")\n                total += 1\n        data = ET.tostring(root, encoding=\"utf-8\")\n        identity_redactions[label] = total\n    data = redact(data)\n    raw_lines.append(json.dumps({\"label\": label, \"command\": command, \"exit_code\": exit_code, \"sha256\": sha(data), \"output\": data.decode()}, sort_keys=True, ensure_ascii=False))\n    return sha(data)\n\n\ndef junit_cases(text: str) -> list[tuple[str, str]]:\n    out = []\n    for case in ET.fromstring(text).iter(\"testcase\"):\n        o = \"PASS\"\n        for ch in case:\n            if ch.tag in (\"failure\", \"error\"):\n                o = \"FAIL\"\n            elif ch.tag == \"skipped\":\n                o = \"SKIPPED\"\n        out.append((case.get(\"name\", \"\"), o))\n    return out\n\n\ndef junit_counts(text: str) -> dict[str, int]:\n    root = ET.fromstring(text)\n    suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\n\ndef shown(c: list[str]) -> str:\n    return \" \".join(c).replace(str(repo), \"<worktree>\").replace(str(Path.home()), \"~\")\n\n\ncommands: list[dict] = []\nobservations: list[dict] = []\nfor row in json.loads((q / \"commands.json\").read_text()):\n    data = (q / f\"{row['label']}.log\").read_bytes()\n    cmd = shown(row[\"command\"]) if isinstance(row[\"command\"], list) else row[\"command\"]\n    if row.get(\"environment\"):\n        cmd = f\"{row['environment']} {cmd}\"\n    digest = add_raw(row[\"label\"], cmd, row[\"exit_code\"], data)\n    entry = {\"label\": row[\"label\"], \"command\": cmd, \"exit_code\": row[\"exit_code\"], \"raw_sha256\": digest, \"status\": row[\"status\"],\n             \"duration_seconds\": row[\"duration_seconds\"], \"head_sha\": row[\"head_sha\"]}\n    if \"result\" in row:\n        r = row[\"result\"]\n        entry[\"result\"] = {\"passed\": r[\"passed\"], \"failed\": r[\"failed\"] + r[\"errors\"], \"skipped\": r[\"skipped\"], \"not_executed\": 0}\n    commands.append(entry)\n\nARTIFACTS = [\n    (\"test-preservation-checker\", q / \"check_preservation.py\", \"Executable AST preservation check; baseline and exact-head code read from Git; no test execution or selection changed\"),\n    (\"test-preservation\", q / \"test-preservation.json\", \"AST preservation of every original test, assertion, decorator and pytest.raises; only required restore constructor keywords added\"),\n    (\"session-teardown-result\", q / \"teardown.json\", \"Final documented bootstrap teardown: fail-closed, zero owned containers/volumes/networks\"),\n    (\"qualification-tools-lock-match\", q / \"qualification-toolchain.json\", \"toolchain and Helm, kind and kubectl executable SHA256 match infra/toolchain.lock.json and qualification_tools.lock.json\"),\n    (\"evidence-builder-script\", q / \"build_evidence.py\", \"exact evidence builder with explicit AST fixture classification\"),\n    (\"evidence-checker-script\", q / \"check_evidence.py\", \"recomputes final HEAD digests, AST backend labels, raw/manifest/counts\"),\n    (\"exact-union-checker-script\", q / \"check_union.py\", \"exact JUnit multiset check against collection at the frozen code HEAD\"),\n    (\"wait-contract\", q / \"wait-contract.json\", \"bounded task/mutation/full/CI waits; unchanged limits\"),\n    (\"task-junit\", q / \"task-3.xml\", \"JUnit XML captured from task-run-3 (parameterized names published as SHA256) (third of three consecutive live runs)\"),\n    (\"validation-command-junit\", q / \"task-validation-command-project.xml\", \"JUnit XML of the backlog validation command scoped to the runtime project\"),\n    (\"reports-portfolio-junit\", q / \"reports-portfolio.xml\", \"JUnit XML of the reports/tests portfolio linked in CI (after SDK npm ci/build)\"),\n    (\"full-suite-junit\", q / \"full/runtime_junit_post_approval.xml\", \"JUnit XML (parameterized names published as SHA256) of the governed full suite (scripts/run_qualifying_campaign.py)\"),\n    (\"full-suite-campaign-result\", q / \"full/campaign_result.json\", \"run_qualifying_campaign.py result (75-min limit, stack guard, required modules)\"),\n    (\"toolchain-lock-match\", q / \"toolchain.json\", \"every infra/toolchain.lock.json tool matched by version and sha256 on the campaign PATH\"),\n    (\"exact-junit-union\", q / \"exact-junit-union.json\", \"unsharded full JUnit exact multiset match with pytest --collect-only on the same HEAD: no missing/duplicate/extra/skipped test\"),\n    (\"full-kind-teardown\", q / \"full/kind-teardown-observations.json\", \"repository kind v2 guard: destroy/remover proof and rejection observations\"),\n    (\"stack-summary\", q / \"stack-summary.json\", \"11 ocor-bootstrap services running, no OOM, zero restarts after bootstrap_ci_environment.py, before the task runs\"),\n    (\"full-stack-summary\", q / \"full-stack-summary.json\", \"11 ocor-bootstrap services running, no OOM, zero restarts after the second bootstrap_ci_environment.py, before the full suite\"),\n    (\"task-resource-delta\", q / \"task-resource-delta.json\", \"containers/volumes/networks added by the task runs (must be empty)\"),\n    (\"mutation-probe-result\", q / \"mutation-probe.json\", \"mutants of memory/operations.py on a git-archive scratch of the frozen code commit; each must fail the task file unless declared equivalent with its reason\"),\n    (\"mutation-probe-script\", q / \"mutation_probe.py\", \"exact mutation harness, archived for reproduction\"),\n    (\"qualifying-local-driver\", q / \"run.py\", \"exact local campaign driver: frozen extras, bootstrap_ci_environment.py, unchanged repository full harness and limits\"),\n]\nfor label, path, note in ARTIFACTS:\n    data = path.read_bytes()\n    digest = add_raw(label, f\"captured artifact: {note}\", 0, data)\n    entry = {\"label\": label, \"command\": f\"captured artifact: {note}\", \"raw_sha256\": digest, \"status\": \"PASS\", \"exit_code\": 0}\n    if path.suffix == \".xml\":\n        entry[\"result\"] = junit_counts(data.decode())\n        if entry[\"result\"][\"failed\"] or entry[\"result\"][\"skipped\"]:\n            entry[\"status\"] = \"FAIL\"\n    if label == \"full-suite-campaign-result\":\n        res = json.loads(data)\n        if res.get(\"status\") != \"PASS\" or res.get(\"candidate_head\") != code_commit or any(res[\"counts\"][k] for k in (\"errors\", \"failures\", \"skipped\")):\n            entry[\"status\"] = \"FAIL\"\n        entry[\"result\"] = {\"passed\": res[\"counts\"][\"tests\"], \"failed\": res[\"counts\"][\"errors\"] + res[\"counts\"][\"failures\"], \"skipped\": res[\"counts\"][\"skipped\"], \"not_executed\": 0}\n        if res.get(\"po_decision_required\"):\n            observations.append({\"label\": \"full-suite-duration\", \"raw_sha256\": digest,\n                                 \"note\": f\"governed full suite PASS in {res['duration_seconds']:.2f}s, above the 3600s PO notification threshold and below the unchanged 4500s limit; recorded as an occurrence for the open decision request REM-0033-LOCAL-FULL-DURATION (non-blocking, no limit, test or timeout changed).\"})\n    if label == \"task-resource-delta\" and any(json.loads(data).values()):\n        entry[\"status\"] = \"FAIL\"\n    if label == \"mutation-probe-result\":\n        probe = json.loads(data)\n        equivalent = sorted(n for n, v in probe.items() if not v[\"killed\"] and v[\"equivalent\"])\n        survivors = sorted(n for n, v in probe.items() if not v[\"killed\"] and not v[\"equivalent\"])\n        entry[\"result\"] = {\"mutants\": len(probe), \"killed\": len(probe) - len(survivors) - len(equivalent), \"equivalent_survivors\": equivalent, \"failed\": len(survivors)}\n        if survivors:\n            entry[\"status\"] = \"FAIL\"\n    commands.append(entry)\n\nREDS = [\n    (\"module-absent\", H / \"ocor-dev-0059/red.log\", 2, \"d8518d61ff9c1ee26ad4f9f1002e96793ac24c19ab02dc38ed0b6e6884460266\",\n     \"RED on 8e996eb (tests only, Codex, before operations.py): pytest -q ocor-runtime/tests/tasks/test_ocor_dev_0059.py -> collection ModuleNotFoundError\"),\n    (\"inventory-race\", H / \"ocor-dev-0059/red-inventory-race.log\", 1, \"298c68457002c5c36a427778d108472f31f0ef000fd24e77621fe92ce2ad9f0d\",\n     \"RED on 5b88f09 plus the head-change test (Codex): pytest -k head_change_during_inventory -> DID NOT RAISE MemoryOperationsError\"),\n    (\"quota-writer\", H / \"ocor-dev-0059-admission/red-writer.log\", 1, \"3863b9ba83d1a64314388271a350fa29ef463c7a65753c4916a60b76a0509adb\",\n     \"RED on 6ba786d (tests only, Codex): pytest -k quota_writer_missing_authorities -> ImportError MemoryQuotaWriter, 4 failed\"),\n    (\"backup-restore\", H / \"ocor-dev-0059-claude/red-backup-commit.log\", 1, \"c73a820e89448e3759239352c300c920d66ad8a939a81594a87eaf29a5042a92\",\n     \"RED on 5d6e33a (tests only, Claude Code): pytest -k 'backup or restore' -> ImportError MemoryBackupService/MemoryRestoreGate, 25 failed\"),\n]\nREDS.append((\"repair1-stop-inventory\", q / \"red-confirmed.log\", 1,\n    \"53fd1bda9764fc63630844e900876cc999b8d257ae65873a60ec31bcdd42edec\",\n    \"RED on 14619ce (tests only, Codex/OpenAI), before production repair: 17 failures; missing stop rejection/materialisation and unobserved concurrent committed head\"))\nred_digests = {}\nfor key, path, code, expected, note in REDS:\n    data = path.read_bytes()\n    assert sha(data) == expected, key\n    red_digests[key] = add_raw(\"tdd-red-\" + key, note, code, data)\nC = H / \"ocor-dev-0059-claude\"\nfor label, path, note in [\n    (\"diagnostic-mutation-narrow-selection\", C / \"mutation-narrow-selection.json\", \"DIAGNOSTIC, never counted: first probe with -k 'backup or restore or quota_writer'; two survivors only because the killing live tests were outside the selection\"),\n    (\"diagnostic-mutation-whole-file\", C / \"mutation.json\", \"DIAGNOSTIC, never counted: rerun of the same 13 mutants on the whole task file before the docstring-only edit of 7ba617d; all killed\"),\n    (\"diagnostic-qualification-attempt1-mutation\", H / \"ocor-dev-0059-claude/q/attempts/attempt1-writer-survivors/mutation-probe.json\", \"DIAGNOSTIC, never counted: first qualification probe on 7ba617d with 18 mutants; writer-gcs-unbound and writer-content-digest-unchecked survived; test strengthened in ea0193b and the whole qualification rerun on the new head\"),\n    (\"diagnostic-qualification-attempt1-diagnosis\", H / \"ocor-dev-0059-claude/q/attempts/attempt1-writer-survivors/diagnosis.json\", \"DIAGNOSTIC, never counted: diagnosis and action of the first qualification attempt\"),\n]:\n    observations.append({\"label\": label, \"note\": note, \"raw_sha256\": add_raw(label, f\"diagnostic artifact: {note}\", 0, path.read_bytes())})\nfor name in (\"red.log\", \"green-unit.log\", \"green-first.log\", \"green-second.log\", \"green-reclassification.log\"):\n    path = q / name\n    observations.append({\"label\": \"repair1-diagnostic-\" + name, \"note\": \"Diagnostic local fixture/probe run; never qualifying, no counts transferred; red-confirmed.log is the behavioral RED\", \"raw_sha256\": add_raw(\"repair1-diagnostic-\" + name, \"diagnostic run (never current PASS)\", 1, path.read_bytes())})\nprevious = H / \"verdicts/OCOR-DEV-0059-e226fc7d127c-0.json\"\nobservations.append({\"label\": \"historical-cycle0-verdict\", \"note\": \"Historical NO_GO; VF-001 and VF-002 addressed by repair1, independent re-verification pending; no counts transferred\", \"raw_sha256\": add_raw(\"historical-cycle0-verdict\", \"historical external verdict (never current PASS)\", 0, previous.read_bytes())})\nfor filename in (\"monitor.jsonl\",):\n    path = q / filename\n    if path.exists():\n        observations.append({\"label\": \"diagnostic-\" + filename, \"note\": \"Diagnostic monitoring only; no PASS/FAIL counts transferred\", \"raw_sha256\": add_raw(\"diagnostic-\" + filename, \"read-only stack observation\", 0, path.read_bytes())})\nraw = (\"\\n\".join(raw_lines) + \"\\n\").encode()\n\ntask_cases = junit_cases((q / \"task-3.xml\").read_text())\n\n\ndef names(*bases: str) -> str:\n    return r\"^(\" + \"|\".join(bases) + r\")(\\[|$)\"\n\n\nCASES = [\n    (\"QUOTA-ENFORCED-ON-REAL-ADMISSION-WITHOUT-DOWNGRADE\", \"NFR-033\",\n     names(\"test_configuration_limits_are_positive_integers\", \"test_configuration_retention_is_mandatory_positive_and_copied\",\n           \"test_each_configured_quota_has_a_positive_and_negative\", \"test_head_versions_count_once_and_deleted_items_do_not_free_tombstones\",\n           \"test_invalid_demand_never_silently_coerces_or_releases_quota\", \"test_partial_deletion_does_not_release_the_item_quota\",\n           \"test_a_head_change_during_inventory_refuses_a_stale_quota_or_monitor_result\", \"test_real_configured_quotas_do_not_delete_existing_content\",\n           \"test_quota_writer_rejects_the_actual_third_item_without_appending_or_indexing\", \"test_quota_writer_derives_demand_from_bytes_and_candidate_not_caller_counters\",\n           \"test_quota_writer_allows_exact_replay_and_correction_at_capacity\", \"test_quota_writer_missing_authorities_never_invoke_admission\",\n           \"test_quota_writer_cannot_bypass_binding_or_actual_demand\", \"test_real_two_quota_writers_share_the_same_serialization_boundary\",\n           \"test_real_serialization_lock_timeout_is_fail_closed\"),\n     \"The seven configured PoC limits are positive configuration values; quota checks count committed heads once and keep tombstoned/partially deleted items counted; real admission plus store commit on PostgreSQL 16, Qdrant and OpenBao derive demand from the actual payload and candidate, refuse the over-limit item, payload, embedding dimensions and index entries with an audited denial and no ledger entry, version or index entry, accept the exact boundary with every representation (no semantic downgrade), accept exact replay and same-item correction at capacity, and serialize two concurrent writers on a shared PostgreSQL advisory lock (exactly one committed, one ITEM_QUOTA_EXCEEDED); a lock timeout or a missing audit, policy, serialization or stop authority never reaches admission\"),\n    (\"PRESSURE-AND-RETENTION-PRESERVE-HOLDS-AND-TOMBSTONES\", \"FR-118\",\n     names(\"test_pressure_selects_deterministically_and_never_deletes_legal_hold\", \"test_retention_uses_first_creation_and_trusted_clock\",\n           \"test_unknown_retention_policy_is_not_permission_to_forget\", \"test_legal_hold_placed_during_pressure_policy_check_is_not_evicted\",\n           \"test_real_partition_pressure_preserves_hold_and_durable_tombstones\", \"test_real_audit_unavailable_refuses_pressure_before_deletion\",\n           \"test_real_retention_keeps_new_items_and_holds\"),\n     \"Quota pressure and retention select deterministically by due time and item id, never select or evict a legal hold (also when placed during the policy check), forget only through the 0055 deletion saga, keep durable tombstones, refuse unknown retention policies and an unavailable audit before any deletion, on the real memory stack and tombstone journal\"),\n    (\"BOUNDED-NON-INTERFERING-MONITORING-AND-FAIL-CLOSED-CONTROLS\", \"BR-003\",\n     names(\"test_unverified_binding_never_reaches_policy_or_inventory\", \"test_partition_cannot_escape_the_verified_context\",\n           \"test_policy_failure_is_audited_before_inventory\", \"test_audit_failure_never_returns_success\",\n           \"test_unauthorized_partition_does_not_influence_count_pressure_or_metric_labels\", \"test_real_unauthorized_partition_cannot_change_quota_decision\",\n           \"test_request_envelope_failures_are_audited\", \"test_changed_stop_state_cannot_return_success\", \"test_invalid_stop_epoch_is_not_an_admission\",\n           \"test_inventory_unavailable_is_never_zero_usage\"),\n     \"Monitoring, quota and pressure read only the authorised full isolation partition: unverified bindings and partitions outside the verified GCS never reach policy or inventory, an unauthorised partition cannot change counts, quota decisions, pressure or metric labels (fixed label set), policy/audit/stop/inventory failures and malformed envelopes fail closed with an audited denial and never return zero usage or success\"),\n    (\"BACKUP-MANIFEST-COMPLETE-SIGNED-AND-PARTITION-BOUND\", \"FR-118\",\n     names(\"test_backup_manifest_is_complete_canonical_and_signed\", \"test_backup_is_deterministic_for_an_unchanged_partition\",\n           \"test_backup_capture_fails_closed_without_a_manifest\", \"test_backup_never_captures_another_partition\",\n           \"test_live_restore_replays_tombstones_then_reopens_with_holds_and_epochs\", \"test_live_restore_preserves_a_legal_hold_recorded_in_the_manifest\"),\n     \"The backup manifest of the authorised partition is canonical, digest-only and signed (OpenBao transit in the live cases) and records memory metadata, content refs, representation versions, lifecycle and deletion epochs, the deletion journal checkpoint and per-version audit refs bound to the recovery point; binding, policy, checkpoint outage or race, signer failure, invalid recovery point, foreign partition and audit failure produce no manifest\"),\n    (\"RESTORE-REPLAYS-TOMBSTONES-AND-BLOCKS-STALE-EPOCH-OR-DRIFT\", \"FR-118\",\n     names(\"test_restore_refuses_an_invalid_manifest_even_if_signed\", \"test_restore_requires_an_exact_true_signature_verification\",\n           \"test_restore_components_require_exact_port_types\", \"test_unit_restore_opens_and_serves_an_unchanged_copy\",\n           \"test_unit_restore_faults_keep_materialisation_closed\", \"test_unit_restore_comparison_branches\",\n           \"test_unit_failed_materialisation_closes_the_restore\", \"test_live_unauthenticated_backup_never_purges_or_reopens\",\n           \"test_live_manifest_of_another_recovery_point_is_refused\", \"test_live_stale_deletion_epoch_blocks_materialisation_before_any_purge\",\n           \"test_live_projection_drift_blocks_materialisation\", \"test_live_drift_after_reopening_discards_the_response_and_closes\",\n           \"test_live_missing_journal_keeps_restore_closed\"),\n     \"On the real 0056 backup drill (PostgreSQL snapshot copy, Qdrant snapshot recovery, OpenBao attestation) restored memory stays closed until the manifest is authenticated, bound to the recovery point and not newer than the deletion authority, every tombstone is replayed through the 0056 gate and the restored projection equals the manifest; a deletion after the backup is never resurrected, a held item stays held, an unauthenticated or foreign manifest purges nothing, a stale deletion epoch is refused before any purge, projection drift (older restored version, extra item, drift during materialisation) and a missing journal keep or close the boundary\"),\n]\nrepair_ast = ast.parse((repo / INPUT_PATHS[1]).read_text())\nnew_tests = [n.name for n in repair_ast.body if isinstance(n, ast.FunctionDef)\n             and n.name.startswith(\"test_\") and n.lineno > 1157]\nCASES.append((\"REPAIR1-RESTORE-STOP-AND-INVENTORY-MEMBERSHIP\", \"FR-119\", names(*new_tests),\n    \"VF-001/VF-002: trusted verified GCS and live stop epoch on restore open/reconcile and around materialisation; \"\n    \"unavailable, invalid or changed epoch closes the gate and audits denial; stable nonzero epoch permits unchanged results. \"\n    \"Inventory rechecks the complete committed-head map, detects new/missing/reclassified heads and version changes, \"\n    \"while PENDING and historical rows do not create phantom usage. Unit controls and live PostgreSQL/Qdrant/OpenBao \"\n    \"positive/negative restore and partition races; authority fixtures remain explicit test ports.\"))\n\ntest_ast = ast.parse((repo / INPUT_PATHS[1]).read_text())\n# Inspect fixture dependencies; a word in a test name cannot prove a backend.\nfunctions = {n.name: n for n in test_ast.body if isinstance(n, ast.FunctionDef) and n.name.startswith(\"test_\")}\nbackend_tests = {k for k, n in functions.items() if any(a.arg == \"backends\" for a in n.args.args)}\nmixed_tests = {k for k in backend_tests if any(a.arg == \"live\" for a in functions[k].args.args)}\nrequirement_results, claimed = [], set()\nfor case_id, req, pattern, description in CASES:\n    matched = [(n, o) for n, o in task_cases if re.match(pattern, n)]\n    if not matched:\n        raise SystemExit(f\"no test matched {case_id}\")\n    claimed.update(n for n, _ in matched)\n    bases = sorted({re.sub(r\"\\[.*\", \"\", n) for n, _ in matched})\n    live = [b for b in bases if b in backend_tests - mixed_tests]\n    mixed = [b for b in bases if b in mixed_tests]\n    res = {\"passed\": sum(o == \"PASS\" for _, o in matched), \"failed\": sum(o == \"FAIL\" for _, o in matched), \"skipped\": sum(o == \"SKIPPED\" for _, o in matched), \"not_executed\": 0}\n    requirement_results.append({\"case_id\": f\"{TASK}-{case_id}\", \"requirement_id\": req, \"command\": description, \"tests\": bases,\n                                \"real_backend_tests\": live, \"mixed_unit_and_live_parametrized_tests\": mixed,\n                                \"unit_fixture_tests\": [b for b in bases if b not in backend_tests], \"result\": res,\n                                \"status\": \"PASS\" if res[\"failed\"] == res[\"skipped\"] == 0 and live else \"FAIL\"})\nunclaimed = sorted({n for n, _ in task_cases} - claimed)\nif unclaimed:\n    raise SystemExit(f\"unmapped tests: {unclaimed}\")\n\ninputs = {\"inputs_tree\": git(\"rev-parse\", f\"{code_commit}:inputs\")}\nfor p in INPUT_PATHS:\n    inputs[p] = sha(subprocess.check_output([\"git\", \"show\", f\"{code_commit}:{p}\"], cwd=repo))\nmeta = json.loads((q / \"evidence_meta.json\").read_text())\nrecord = {\n    \"schema_version\": \"1.0\", \"task_id\": TASK, \"repair_cycle\": 1,\n    \"status\": \"CANDIDATE_AWAITING_INDEPENDENT_VERIFICATION\", \"result\": \"PASS\",\n    \"commit\": code_commit, \"created_at\": datetime.now(UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n    \"environment\": meta[\"environment\"], \"inputs\": inputs,\n    \"inputs_tree_definition\": \"git rev-parse <commit>:inputs (tree della directory inputs/ immutabile)\",\n    \"raw_output_format\": \"JSONL: una riga per comando/artefatto con label, command, exit_code, sha256 dei byte UTF-8 archiviati e output integrale; le credenziali locali generate (valori di .ocor/bootstrap.env) sono sostituite prima dell'archiviazione e dell'hash; DSN mostrato come <local generated credential>\",\n    \"raw_output_redactions\": redactions, \"raw_output_sha256\": sha(raw), \"commands\": commands,\n    \"parameterized_case_identity_publication\": {\"authority\": \"REM-0019-SEALED-SYNTHETIC-SECRET-SCANNER (2026-10-15)\", \"method\": \"All parametrized JUnit testcase names retain the test function name and replace the full parameterized identity by SHA256; only publication changes, original counts and local exact JUnit union unchanged\", \"redacted_identity_counts\": identity_redactions, \"acquired_source_sha256_before_publication_redaction\": source_digests},\n    \"backend_classification\": \"AST: a test requesting the backends fixture is real_backend; bases parametrized by live in {False, True} request it for both instances but only [True] uses the real stack, so they are listed as mixed_unit_and_live_parametrized_tests and never counted as real_backend_tests; each case needs at least one pure real_backend test\",\n    \"requirement_results\": requirement_results, \"observations\": observations,\n    \"tdd\": dict(meta[\"tdd\"], red_raw_sha256=red_digests), \"sealed_dependencies\": meta[\"sealed_dependencies\"], \"session_teardown\": json.loads((q / \"teardown.json\").read_text()),\n    \"verification_history\": [meta[\"previous_verdict\"]], \"design\": meta[\"design\"], \"normative_interpretations\": meta[\"normative_interpretations\"],\n    \"residual_risks\": meta[\"residual_risks\"], \"requirement_coverage_note\": meta[\"requirement_coverage_note\"],\n    \"rollback_procedure_verified\": meta[\"rollback\"], \"roles\": meta[\"roles\"], \"reproducible_check\": meta[\"reproducible_check\"],\n    \"claims\": {\"E1\": 0, \"E2\": 0, \"PoC_GO\": \"NO-GO\", \"Production_readiness\": \"NO_GO\", \"runtime_conformance\": \"NOT_ESTABLISHED\"},\n}\nif any(c[\"status\"] != \"PASS\" for c in commands) or any(r[\"status\"] != \"PASS\" for r in requirement_results):\n    record[\"result\"] = \"FAIL\"\nev = (json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\").encode()\n(G5 / f\"{TASK}.json\").write_bytes(ev)\n(G5 / f\"{TASK}.log\").write_bytes(raw)\nmp = G5 / \"MANIFEST.json\"\nm = json.loads(mp.read_text())\nm[\"artifacts\"] = [a for a in m[\"artifacts\"] if a[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")] + [\n    {\"path\": f\"{TASK}.json\", \"sha256\": sha(ev), \"task_id\": TASK}, {\"path\": f\"{TASK}.log\", \"sha256\": sha(raw), \"task_id\": f\"{TASK}-RAW\"}]\nm[\"requirement_results\"] = [r for r in m[\"requirement_results\"] if r[\"task_id\"] != TASK] + [\n    {\"case_id\": r[\"case_id\"], \"command\": r[\"command\"], \"evidence_path\": f\"{TASK}.json\", \"raw_output_path\": f\"{TASK}.log\",\n     \"requirement_id\": r[\"requirement_id\"], \"status\": r[\"status\"], \"task_id\": TASK} for r in requirement_results]\nmp.write_text(json.dumps(m, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({\"result\": record[\"result\"], \"cases\": len(task_cases), \"requirement_results\": len(requirement_results), \"raw_sha256\": sha(raw), \"evidence_sha256\": sha(ev)}))\n", "sha256": "a4546e2a36f9dd4d7d088514181a84df1fd3dbd13833e08eca9608420c02f2e6"}
{"command": "captured artifact: recomputes final HEAD digests, AST backend labels, raw/manifest/counts", "exit_code": 0, "label": "evidence-checker-script", "output": "\"\"\"Recompute every derived field of the OCOR-DEV-0059 evidence (adapted by Claude Code from the sealed 0058 checker) from a repository HEAD.\n\nUsage: check_evidence.py <repo> <head>\nChecks: input file hashes and inputs tree at the recorded commit and at HEAD; the\ncommit is an ancestor of HEAD and the diff after it touches only evidence outputs;\nraw log hash and every JSONL entry hash; command/raw pairing; manifest hashes and\npreservation of the pre-existing G5 entries; per-case counts recomputed from the task\nJUnit stored verbatim in the raw log; full-suite counts; mutation probe all killed;\nruntime evidence validator.\n\"\"\"\n\nimport ast\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\nrepo, head = Path(sys.argv[1]), sys.argv[2]\nTASK = \"OCOR-DEV-0059\"\nBASE = \"5ea0713db2844e67de488e916466d6058adaeaf9\"  # origin/main merged into the task branch (a23375a)\n\n\ndef git(*args: str) -> str:\n    return subprocess.check_output([\"git\", *args], cwd=repo, text=True).strip()\n\n\ndef show(path: str, ref: str = head) -> bytes:\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], cwd=repo)\n\n\ndef sha(data: bytes) -> str:\n    return hashlib.sha256(data).hexdigest()\n\n\nerrors: list[str] = []\nrecord_bytes = show(f\"reports/evidence/G5/{TASK}.json\")\nrecord = json.loads(record_bytes)\nraw = show(f\"reports/evidence/G5/{TASK}.log\")\nmanifest = json.loads(show(\"reports/evidence/G5/MANIFEST.json\"))\ncommit = record[\"commit\"]\nif subprocess.run([\"git\", \"merge-base\", \"--is-ancestor\", commit, head], cwd=repo).returncode:\n    errors.append(\"commit is not an ancestor of head\")\nafter = git(\"diff\", \"--name-only\", commit, head).splitlines()\nallowed = {f\"reports/evidence/G5/{TASK}.json\", f\"reports/evidence/G5/{TASK}.log\", \"reports/evidence/G5/MANIFEST.json\"}\nif set(after) - allowed:\n    errors.append(f\"non-evidence changes after commit: {sorted(set(after) - allowed)}\")\nfor path, recorded in record[\"inputs\"].items():\n    for ref in (commit, head):\n        actual = git(\"rev-parse\", f\"{ref}:inputs\") if path == \"inputs_tree\" else sha(show(path, ref))\n        if actual != recorded:\n            errors.append(f\"input mismatch {path} at {ref}\")\nif sha(raw) != record[\"raw_output_sha256\"]:\n    errors.append(\"raw_output_sha256 mismatch\")\nentries = [json.loads(line) for line in raw.decode(\"utf-8\").splitlines()]\nfor entry in entries:\n    if sha(entry[\"output\"].encode(\"utf-8\")) != entry[\"sha256\"]:\n        errors.append(f\"raw entry self-hash mismatch {entry['label']}\")\nMARKERS = {\n    \"repair1-stop-inventory\": (\"DID NOT RAISE\", 12),\n    \"module-absent\": (\"No module named 'ocor_runtime.memory.operations'\", 1),\n    \"inventory-race\": (\"DID NOT RAISE\", 1),\n    \"quota-writer\": (\"cannot import name 'MemoryQuotaWriter'\", 4),\n    \"backup-restore\": (\"cannot import name 'MemoryBackupService'\", 1),\n}\nif set(record[\"tdd\"][\"red_raw_sha256\"]) != set(MARKERS):\n    errors.append(\"tdd red set mismatch\")\nfor key, digest in record[\"tdd\"][\"red_raw_sha256\"].items():\n    hit = [e for e in entries if e[\"label\"] == f\"tdd-red-{key}\"]\n    marker, minimum = MARKERS[key]\n    if len(hit) != 1 or hit[0][\"sha256\"] != digest or hit[0][\"output\"].count(marker) < minimum or hit[0][\"exit_code\"] == 0:\n        errors.append(f\"tdd {key} raw mismatch\")\nif record.get(\"repair_cycle\") != 1 or record[\"environment\"][\"branch\"] != \"task/OCOR-DEV-0059-memory-operations\":\n    errors.append(\"repair cycle or branch mismatch\")\nobserved = {o[\"label\"]: o for o in record[\"observations\"]}\nfor entry in entries:\n    if entry[\"label\"] in observed and entry[\"sha256\"] != observed[entry[\"label\"]][\"raw_sha256\"]:\n        errors.append(f\"observation raw mismatch {entry['label']}\")\nif any(o[\"raw_sha256\"] not in {e[\"sha256\"] for e in entries} for o in observed.values()):\n    errors.append(\"observation without raw entry\")\nentries = [e for e in entries if not e[\"label\"].startswith(\"tdd-\") and e[\"label\"] not in observed]\nby_label = {}\nfor entry, command in zip(entries, record[\"commands\"], strict=True):\n    if entry[\"sha256\"] != command[\"raw_sha256\"] or entry[\"label\"] != command[\"label\"] or entry[\"exit_code\"] != command[\"exit_code\"]:\n        errors.append(f\"command/raw mismatch {entry['label']}\")\n    by_label[entry[\"label\"]] = entry\nif any(c[\"status\"] != \"PASS\" for c in record[\"commands\"]):\n    errors.append(\"a command is not PASS\")\nartifacts = {a[\"task_id\"]: a for a in manifest[\"artifacts\"]}\nif artifacts[TASK][\"sha256\"] != sha(record_bytes) or artifacts[f\"{TASK}-RAW\"][\"sha256\"] != sha(raw):\n    errors.append(\"manifest artifact hash mismatch\")\nbase_manifest = json.loads(show(\"reports/evidence/G5/MANIFEST.json\", BASE))\nfor key in (\"artifacts\", \"requirement_results\"):\n    if [e for e in manifest[key] if e[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")] != [e for e in base_manifest[key] if e[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")]:\n        errors.append(f\"pre-existing manifest {key} not preserved\")\n\n\ndef outcomes(xml_text: str) -> dict[str, str]:\n    out = {}\n    for case in ET.fromstring(xml_text).iter(\"testcase\"):\n        bad = [c.tag for c in case if c.tag in (\"failure\", \"error\", \"skipped\")]\n        out[case.get(\"name\")] = \"PASS\" if not bad else bad[0].upper()\n    return out\n\n\ntree = ast.parse(show(\"ocor-runtime/tests/tasks/test_ocor_dev_0059.py\").decode())\nfunctions = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name.startswith(\"test_\")}\nbackend_tests = {k for k, n in functions.items() if any(a.arg == \"backends\" for a in n.args.args)}\nmixed_tests = {k for k in backend_tests if any(a.arg == \"live\" for a in functions[k].args.args)}\ntask = outcomes(by_label[\"task-junit\"][\"output\"])\nif not task or set(task.values()) != {\"PASS\"}:\n    errors.append(\"task junit not all PASS\")\nclaimed = set()\nfor result in record[\"requirement_results\"]:\n    if (set(result[\"real_backend_tests\"]) != set(result[\"tests\"]) & (backend_tests - mixed_tests)\n            or set(result[\"mixed_unit_and_live_parametrized_tests\"]) != set(result[\"tests\"]) & mixed_tests\n            or set(result[\"unit_fixture_tests\"]) != set(result[\"tests\"]) - backend_tests):\n        errors.append(\"AST backend classification mismatch \" + result[\"case_id\"])\n    names = [n for n in task if re.sub(r\"\\[.*\", \"\", n) in set(result[\"tests\"])]\n    claimed.update(names)\n    if sum(1 for n in names if task[n] == \"PASS\") != result[\"result\"][\"passed\"] or len(names) != result[\"result\"][\"passed\"] or not result[\"real_backend_tests\"]:\n        errors.append(f\"case count mismatch {result['case_id']}\")\nif claimed != set(task):\n    errors.append(\"task tests not fully mapped\")\nfor label in (\"task-run-1\", \"task-run-2\", \"task-run-3\", \"task-validation-command-project\"):\n    result = next(c for c in record[\"commands\"] if c[\"label\"] == label).get(\"result\")\n    if result != {\"passed\": len(task), \"failed\": 0, \"skipped\": 0, \"not_executed\": 0}:\n        errors.append(f\"{label} counts mismatch {result}\")\nfull = ET.fromstring(by_label[\"full-suite-junit\"][\"output\"])\nsuites = [full] if full.tag == \"testsuite\" else list(full)\ntotals = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\nfull_cmd = next(c for c in record[\"commands\"] if c[\"label\"] == \"full-suite-junit\")\nif full_cmd[\"result\"] != {\"passed\": totals[\"tests\"] - totals[\"failures\"] - totals[\"errors\"] - totals[\"skipped\"], \"failed\": totals[\"failures\"] + totals[\"errors\"], \"skipped\": totals[\"skipped\"], \"not_executed\": 0} or totals[\"failures\"] or totals[\"errors\"] or totals[\"skipped\"]:\n    errors.append(f\"full-suite counts mismatch {totals}\")\ncampaign = json.loads(by_label[\"full-suite-campaign-result\"][\"output\"])\nif campaign.get(\"status\") != \"PASS\" or campaign.get(\"candidate_head\") != commit or campaign[\"counts\"][\"tests\"] != totals[\"tests\"]:\n    errors.append(\"full-suite campaign not PASS on the commit\")\nprobe = json.loads(by_label[\"mutation-probe-result\"][\"output\"])\nequivalent = {n for n, v in probe.items() if v[\"equivalent\"] and v.get(\"equivalence_reason\")}\nif not probe or {n for n, v in probe.items() if not v[\"killed\"]} - equivalent:\n    errors.append(\"mutation survivor\")\nvalidator = subprocess.run([sys.executable, \"-c\", \"import subprocess,sys,tempfile,pathlib;\"\n    \"d=tempfile.mkdtemp();r=sys.argv[1];h=sys.argv[2];\"\n    \"[pathlib.Path(d,p).write_bytes(subprocess.check_output(['git','show',h+':reports/evidence/G5/'+p],cwd=r)) for p in ('MANIFEST.json','OCOR-DEV-0059.json','OCOR-DEV-0059.log')];\"\n    \"sys.exit(subprocess.run([sys.executable,r+'/scripts/validate_runtime_evidence.py','--task','OCOR-DEV-0059','--non-skipped','--manifest',d+'/MANIFEST.json']).returncode)\", str(repo), head])\nif validator.returncode:\n    errors.append(\"validate_runtime_evidence failed\")\nprint(json.dumps({\"head\": head, \"status\": \"FAIL\" if errors else \"PASS\", \"errors\": errors, \"full_suite\": totals, \"task_cases\": len(task), \"mutants\": len(probe)}, indent=2))\nsys.exit(1 if errors else 0)\n", "sha256": "f2322e210f2ea250477161c7aed17d14b573ab6f7e4ff5dbda3404558a6ac076"}
{"command": "captured artifact: exact JUnit multiset check against collection at the frozen code HEAD", "exit_code": 0, "label": "exact-union-checker-script", "output": "import collections,hashlib,json,sys\nfrom pathlib import Path\nr=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0059')\nsys.path.insert(0,str(r/'scripts'))\nimport run_qualifying_campaign as campaign\nq=Path(__file__).parent\ncollected=campaign.collect_nodeids(r/'ocor-runtime',['tests/'])\nwanted=collections.Counter(campaign.junit_identity(n) for n in collected)\nexecuted=collections.Counter(campaign.junit_cases(q/'full/runtime_junit_post_approval.xml'))\nassert wanted==executed,{'missing':len(wanted-executed),'extra':len(executed-wanted)}\nassert all(v==1 for v in executed.values()),'duplicate execution'\ncounts=campaign.check_junit(q/'full/runtime_junit_post_approval.xml')\nresult={'status':'PASS','collected':len(collected),'executed':sum(executed.values()),'missing':0,'extra':0,'duplicates':0,'counts':counts,'collected_sha256':campaign.collection_digest(collected),'executed_identity_digest':hashlib.sha256(json.dumps(sorted(executed)).encode()).hexdigest()}\n(q/'exact-junit-union.json').write_text(json.dumps(result,indent=2,sort_keys=True)+'\\n');print(json.dumps(result,sort_keys=True))\n", "sha256": "0e691a50281b97b624aeae935afde05c207e8359cb6faf726eae30c6442045e5"}
