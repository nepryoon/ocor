{"command": "captured artifact: source of the mutation probe (mutant table)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"Mutation probe: each mutant of the REM-0021 remediation must make the REM-0021/REM-0020/0052 suites fail.\"\"\"\nimport json, os, subprocess, sys\nfrom pathlib import Path\nW = Path(sys.argv[1]); out = Path(sys.argv[2])\nR = W / \"ocor-runtime/src/ocor_runtime/memory/retrieval.py\"\nPOST = \"            self._require_stop_epoch(plan)\\n            self._require_unchanged(plan, candidate)\\n\"\nSWEEP = \"        for candidate, _score, _factors in ranked:\\n            self._require_unchanged(plan, candidate)\\n\"\nMUTANTS = {\n    \"no-post-read-eligibility\": (POST, \"            self._require_stop_epoch(plan)\\n\"),\n    \"no-pre-receipt-eligibility-sweep\": (SWEEP, \"\"),\n    \"sweep-only-the-last-hit\": (SWEEP, \"        for candidate, _score, _factors in ranked[-1:]:\\n            self._require_unchanged(plan, candidate)\\n\"),\n    \"no-pre-read-eligibility\": (\"            # Re-check the exact version right before its content is read.\\n            self._require_unchanged(plan, candidate)\\n\", \"\"),\n    \"unchanged-check-accepts-an-ineligible-version\": (\"        if fresh is None or fresh.stored.staged.stage_digest != staged.stage_digest:\\n            raise MemoryRetrievalError(\\n                \\\"REPRESENTATION_NOT_READY\\\",\\n                \\\"CANDIDATE_CHANGED\\\",\\n                \\\"a ranked version changed before its hit was returned\\\",\", \"        if fresh is not None and fresh.stored.staged.stage_digest != staged.stage_digest:\\n            raise MemoryRetrievalError(\\n                \\\"REPRESENTATION_NOT_READY\\\",\\n                \\\"CANDIDATE_CHANGED\\\",\\n                \\\"a ranked version changed before its hit was returned\\\",\"),\n    \"changed-hit-dropped-silently\": (\"            raise MemoryRetrievalError(\\n                \\\"REPRESENTATION_NOT_READY\\\",\\n                \\\"CANDIDATE_CHANGED\\\",\\n                \\\"a ranked version changed before its hit was returned\\\",\\n            )\\n\", \"            return\\n\"),\n}\noriginal = R.read_text()\nresults = {}\ntry:\n    for name, (old, new) in MUTANTS.items():\n        assert original.count(old) == 1, name\n        R.write_text(original.replace(old, new))\n        r = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-x\", \"-p\", \"no:cacheprovider\",\n                            \"tests/tasks/test_ocor_dev_rem_0021.py\", \"tests/tasks/test_ocor_dev_rem_0020.py\", \"tests/tasks/test_ocor_dev_0052.py\"],\n                           cwd=W / \"ocor-runtime\", capture_output=True, text=True, env=dict(os.environ), timeout=1800)\n        R.write_text(original)\n        lines = r.stdout.strip().splitlines()\n        failed = [l for l in lines if l.startswith(\"FAILED\")]\n        results[name] = {\"file\": R.name, \"exit_code\": r.returncode, \"killed\": r.returncode != 0,\n                         \"summary\": lines[-1] if lines else r.stderr[-200:], \"first_failure\": failed[0] if failed else None}\n        print(name, results[name], flush=True)\nfinally:\n    R.write_text(original)\nout.write_text(json.dumps(results, indent=2, sort_keys=True) + \"\\n\")\nprint(\"ALL_KILLED\" if all(v[\"killed\"] for v in results.values()) else \"SURVIVORS\")\n", "sha256": "6c47d3bbb69d5e605db1bb26edbb7ebd635b46eb69801c4bb11ee1e76cf9d3a1"}
