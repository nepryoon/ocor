{"command": "captured artifact: ~/.ocor-codex/rem-0054-q/run.sh", "exit_code": 0, "label": "script-run.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0054 (NCP-U08): qualification campaign (two lanes, memory admission at start) at the candidate head.\nset -u\nD=$HOME/.ocor-codex/rem-0054-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0054\nPY=$R/ocor-runtime/.venv/bin/python\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nMP=\nstep \"start head=$(git rev-parse HEAD)\"\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL stale credentials in worktree\"; exit 3; }\nmkdir -p $D/q\nfor ph in A; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\ndocker ps --filter label=com.docker.compose.project=ocor-bootstrap -q | xargs docker inspect | python3 -c '\nimport json,sys\nout={c[\"Name\"].lstrip(\"/\"):{\"image_id\":c[\"Image\"],\"image_ref\":c[\"Config\"][\"Image\"],\"oom_killed\":c[\"State\"][\"OOMKilled\"],\"restart_count\":c[\"RestartCount\"],\"status\":c[\"State\"][\"Status\"]} for c in json.load(sys.stdin)}\nprint(json.dumps(out,indent=2,sort_keys=True))' > $D/backend_images.json && step \"backend images snapshot $(python3 -c \"import json;print(len(json.load(open('$D/backend_images.json'))))\") containers\"\nfor ph in A3 B; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\ntest ! -e $D/old-credentials-A || { step \"FAIL archive target exists\"; exit 4; }\nmkdir -p $D/old-credentials-A\nfor f in .ocor/bootstrap.env .ocor/spire; do test -e $f && mv $f $D/old-credentials-A/; done\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials not archived\"; exit 3; }\nstep \"credentials of phase A archived in old-credentials-A\"\nstep \"phase C power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\n( while true; do echo \"$(date -u +%s) $(awk '/^MemTotal|^MemAvailable/{printf \"%s \", $2}' /proc/meminfo)\" >> $D/mem-lanes.log; sleep 5; done ) &\nMP=$!\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\nkill $MP 2>/dev/null\nstep \"C rc=$rc power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity)\"\nexit $rc\n", "sha256": "eefb51a057e06087003d9299620ec20b2288f8809594e5393815fd75cddb6052"}
{"command": "captured artifact: ~/.ocor-codex/rem-0054-q/qualify_run.py", "exit_code": 0, "label": "script-qualify_run.py", "output": "\"\"\"OCOR-DEV-REM-0054 (NCP-U08) campaign (adapted from the REM-0053 campaign) from a clean shell.\n\nUsage: qualify_run.py <phase>. Each command's combined output goes to q/<label>.log;\nq/commands.jsonl gets label, command, cwd, exit code, duration, raw sha256, junit counts.\nStops at the first failure (fail-closed); tracked files are never edited.\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0054\")\nD = Path.home() / \".ocor-codex/rem-0054-q\"; Q = D / \"q\"; Q.mkdir(exist_ok=True)\nPATH = (D / \"locked-path\").read_text().strip()\nPY = \"ocor-runtime/.venv/bin/python\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\n\ndef live_env():\n    env_file = R / \".ocor/bootstrap.env\"\n    vals = dict(l.split(\"=\", 1) for l in env_file.read_text().splitlines() if \"=\" in l)\n    return {**ENV, \"OCOR_BOOTSTRAP_ENV\": str(env_file),\n            \"OCOR_LIVE_POSTGRES_DSN\": f\"postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor\"}\n\ndef junit(path):\n    root = ET.parse(path).getroot(); suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\ndef pytest(label, *targets, cwd=\".\"):\n    x = Q / f\"{label}.xml\"\n    return (label, [str(R / PY), \"-m\", \"pytest\", *targets, \"-p\", \"no:cacheprovider\", \"-q\", \"-rfEs\", \"--tb=short\", f\"--junitxml={x}\"], cwd, x)\n\nSVC_TESTS = [f\"deploy/bootstrap/services/{s}/{n}\" for s, n in ((\"typedb\", \"test_qualify.py\"), (\"openbao\", \"test_qualify.py\"), (\"spire\", \"test_qualify.py\"), (\"policy-identity\", \"test_security_services.py\"), (\"temporal\", \"test_qualify.py\"), (\"seaweedfs\", \"test_qualify.py\"))]\n# the unit module and the register/REM-0046/runtime evidence validator suites\nTASK = [\"ocor-runtime/tests/tasks/test_ocor_dev_rem_0054.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_runtime_evidence_validator.py\"]\n# regression-only requalifications whose tests the unit adapted (no bindable requirement, NCP-UNBINDABLE-REQUALIFICATIONS): 0030, 0034, 0035, 0044, 0047, 0048\nREQUALIFIED = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0030\", \"0034\", \"0035\", \"0044\", \"0047\", \"0048\")]\n# the other consumers of the unit inventory (iter5 module list without the requalified, regression and unit modules; the legacy-slice modules also run in the full suite)\nCONSUMERS = [\"ocor-runtime/tests/mission_thread/test_first_governed_slice.py\"] + [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0021\", \"0024\", \"0042\", \"0043\", \"0052\", \"0057\", \"0058\", \"rem_0024\", \"rem_0027\", \"rem_0028\", \"rem_0031\", \"rem_0039\", \"rem_0050\", \"rem_0053\", \"rem_0049\", \"0018\", \"0038\", \"0051\", \"rem_0010\", \"rem_0047\", \"rem_0048\", \"0053\", \"0054\", \"0055\", \"0059\", \"rem_0020\", \"rem_0021\", \"rem_0051\")] + [f\"ocor-runtime/tests/{n}\" for n in (\"acceptance_ev/test_ev_011_019_store_marking.py\", \"acceptance_ev/test_ev_029_035_fence_agent_e2e.py\", \"backend_assumptions/test_ba06_marking_lattice.py\", \"runtime/test_c7_emission_hardening.py\")]\n# regression-only requalifications with tests unchanged: 0009, 0014 (code input changed), 0005, 0050, 0082 (plan validator allowlist)\nREGRESSION = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0005\", \"0009\", \"0014\", \"0050\", \"0082\")]\nREPORTS = [\"reports/tests/test_bootstrap_lock_validation.py\", \"reports/tests/test_autonomous_tooling_policy.py\", \"reports/tests/test_reset_teardown_residue.py\", \"reports/tests/test_evidence_input_drift.py\", \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_qualifying_campaign_guard.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_rem0034_secret_registry.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_backlog_generator_reality_parity.py\"]\n\nPHASES = {\n \"A\": [\n  (\"stack-absent-initial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"bootstrap\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"verify-manifest-only\", [PY, \"scripts/verify_external_services.py\", \"--manifest-only\"], \".\", None),\n  (\"verify-legacy-scan\", [PY, \"scripts/verify_external_services.py\"], \".\", None),\n  (\"verify-typed-execute\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"qualify-temporal-fault\", [PY, \"deploy/bootstrap/services/temporal/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-seaweedfs-fault\", [PY, \"deploy/bootstrap/services/seaweedfs/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-typedb-fault\", [PY, \"deploy/bootstrap/services/typedb/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-openbao-fault\", [PY, \"deploy/bootstrap/services/openbao/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-spire\", [PY, \"deploy/bootstrap/services/spire/qualify.py\"], \".\", None),\n  (\"qualify-policy-identity\", [PY, \"deploy/bootstrap/services/policy-identity/qualify_security_services.py\", \"--check\"], \".\", None),\n  *[(f\"fault-inject-{s}\", [PY, \"scripts/fault_inject_test_environment.py\", s, \"pause\", \"--bounded\", \"--execute\", \"--timeout\", \"60\"], \".\", None)\n    for s in (\"terminusdb\", \"typedb\", \"fuseki\", \"opa\", \"keycloak\", \"openbao\", \"spire-agent\")],\n  (\"verify-typed-after-faults\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"reset\", [PY, \"scripts/reset_test_environment.py\", \"--reset\", \"--env-file\", \".ocor/bootstrap.env\", \"--execute\"], \".\", None),\n  (\"reset-idempotent\", [PY, \"scripts/reset_test_environment.py\", \"--reset\", \"--env-file\", \".ocor/bootstrap.env\", \"--execute\"], \".\", None),\n  (\"reinitialize\", [PY, \"deploy/bootstrap/init/initialize_services.py\", \"--env-file\", \".ocor/bootstrap.env\"], \".\", None),\n  (\"refixtures\", [PY, \"deploy/bootstrap/fixtures/load_fixtures.py\", \"--env-file\", \".ocor/bootstrap.env\"], \".\", None),\n  (\"verify-typed-after-reset\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"bootstrap-check\", [PY, \"scripts/bootstrap_development_environment.py\", \"--check\"], \".\", None),\n],\n \"A3\": [\n  pytest(\"service-contract-suites\", \"--import-mode=importlib\", *SVC_TESTS),\n  (\"preflight\", [PY, \"scripts/preflight_environment.py\"], \".\", None),\n  *[pytest(f\"task-rem0054-run{i}\", \"-rP\", *TASK) for i in (1, 2, 3)],\n  pytest(\"requalified-modules\", \"-rP\", *REQUALIFIED),\n  pytest(\"consumers\", \"-rP\", *CONSUMERS),\n  pytest(\"regression\", \"-rP\", *REGRESSION),\n  (\"evidence-job-g0\", [PY, \"ocor-runtime/tools/evidence_manifest.py\", \"validate\", \"--task\", \"OCOR-DEV-0004\", \"--non-skipped\", \"--manifest\", \"reports/evidence/G0/MANIFEST.json\"], \".\", None),\n  pytest(\"reports-portfolio\", *REPORTS),\n ],\n \"B\": [\n  (\"teardown-before-full\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  ],\n \"B2\": [\n  (\"credentials-fresh\", [\"sh\", \"-c\", \"test ! -e .ocor/bootstrap.env && test ! -e .ocor/spire && echo no worktree-local credential file\"], \".\", None),\n  (\"bootstrap-full\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"full\", [PY, \"scripts/run_qualifying_campaign.py\", \"--execute\", \"--repository\", \".\", \"--expected-head\", \"HEADSHA\", \"--output-dir\", str(Q / \"full\")], \".\", None),\n  (\"teardown-final\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  (\"stack-absent-final\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n \"C\": [\n  (\"host-stack-absent-before-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"two-lane-full\", [PY, \"scripts/run_local_lane_campaign.py\", \"--execute\", str(D / \"lanes\"), \"--expected-head\", \"HEADSHA\", \"--tool-bin\", str(Path.home() / \".ocor-codex/impl-env/rem-0054/bin\")], \".\", None),\n  (\"host-stack-absent-after-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n}\n\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=R, text=True).strip()\nfor label, cmd, cwd, xml in PHASES[sys.argv[1]]:\n    if cmd[0] == PY: cmd = [str(R / PY), *cmd[1:]]\n    cmd = [head if c == \"HEADSHA\" else c for c in cmd]\n    env = live_env() if (R / \".ocor/bootstrap.env\").exists() else ENV\n    t0 = time.monotonic(); started = datetime.now(UTC).isoformat()\n    with open(Q / f\"{label}.log\", \"w\") as log:\n        rc = subprocess.run(cmd, cwd=R / cwd, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=6000).returncode\n    rec = {\"label\": label, \"command\": \" \".join(c.replace(str(R) + \"/\", \"\") for c in cmd), \"cwd\": cwd, \"exit_code\": rc,\n           \"duration_seconds\": round(time.monotonic() - t0, 3), \"started_at\": started, \"head_sha\": head,\n           \"raw_sha256\": hashlib.sha256((Q / f\"{label}.log\").read_bytes()).hexdigest(), \"status\": \"PASS\" if rc == 0 else \"FAIL\"}\n    if xml and Path(xml).exists():\n        rec[\"result\"] = junit(xml); rec[\"junit_raw_sha256\"] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if rec[\"result\"][\"skipped\"] or rec[\"result\"][\"failed\"]: rec[\"status\"] = \"FAIL\"\n    with open(Q / \"commands.jsonl\", \"a\") as f: f.write(json.dumps(rec, sort_keys=True) + \"\\n\")\n    print(label, rec[\"status\"], rec[\"duration_seconds\"], rec.get(\"result\", \"\"), flush=True)\n    if rec[\"status\"] != \"PASS\": sys.exit(1)\n    if subprocess.run([\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\"], cwd=R, capture_output=True, text=True).stdout.strip():\n        print(\"TRACKED TREE CHANGED after\", label); sys.exit(2)\n", "sha256": "f9e4f25bec590388b20a587045b563fd3ae9d9292ed0ec9e6af1ca45ec1104c9"}
{"command": "captured artifact: ~/.ocor-codex/rem-0054-q/rerun_c.sh", "exit_code": 0, "label": "script-rerun_c.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0054: repetition 1 of the failed two-lane run (phase C) under QUALIFICATION-CAMPAIGN-INFRA-RERUN; same head, same qualify_run.py and run.sh (digests in attempts/a1-*/harness.sha256).\nset -u\nD=$HOME/.ocor-codex/rem-0054-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0054\nPY=$R/ocor-runtime/.venv/bin/python\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\nMP=\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nstep \"repetition 1 of phase C (attempt a1-two-lane-temporal-startup-race diagnostic) head=$(git rev-parse HEAD)\"\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials present\"; exit 3; }\ntest ! -e $D/lanes || { step \"FAIL lanes dir exists\"; exit 4; }\nstep \"phase C power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\n( while true; do echo \"$(date -u +%s) $(awk '/^MemTotal|^MemAvailable/{printf \"%s \", $2}' /proc/meminfo)\" >> $D/mem-lanes.log; sleep 5; done ) &\nMP=$!\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\nkill $MP 2>/dev/null\nstep \"C rc=$rc power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity)\"\nexit $rc\n", "sha256": "f91726b956d2b82eabd5ea12c6ef2cb612f544197c0b4982015f69f3df2363ad"}
{"command": "captured artifact: ~/.ocor-codex/rem-0054-q/run_serial.sh", "exit_code": 0, "label": "script-run_serial.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0054 (NCP-U08): serial full suite on the host stack (phase B2) under NCP-U08-LANE-TEMPORAL-READINESS (2026-11-06) option A1,\n# at the same code commit as phases A, A3, B (f22de614311f), from fresh credentials; same qualify_run.py (phase B2 unchanged since iteration 7).\nset -u\nD=$HOME/.ocor-codex/rem-0054-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0054\nPY=$R/ocor-runtime/.venv/bin/python\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\ntrap 'kill $PW 2>/dev/null' EXIT\nstep \"serial B2 (NCP-U08-LANE-TEMPORAL-READINESS A1) head=$(git rev-parse HEAD)\"\ntest \"$(git rev-parse HEAD)\" = f22de614311f3e8cd3453152e64adca963e07dfa || { step \"FAIL head\"; exit 5; }\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials present\"; exit 3; }\ntest ! -e $D/q/full || { step \"FAIL full dir exists\"; exit 4; }\nstep \"phase B2 power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py B2 >> $D/run.out 2>&1; rc=$?\nstep \"B2 rc=$rc power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity)\"\nexit $rc\n", "sha256": "7a3a6d0e8512122c181d144a5980096ff7325ddeecb77d7df46216d11bbf53f4"}
