{"command": "captured artifact: ~/.ocor-codex/rem-0059/redgreen.sh", "exit_code": 0, "label": "script-redgreen.sh", "output": "#!/bin/bash\n# RED/GREEN of OCOR-DEV-REM-0059. Fingerprint = sha256 of the sorted \"classname::name outcome\" lines of the JUnit XML.\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT/ocor-runtime\"\nexport PATH=$HOME/.ocor-codex/impl-env/rem-0059/bin:$WT/ocor-runtime/.venv/bin:/usr/local/bin:/usr/bin:/bin\n[ -f ~/.ocor-codex/rem-0059/dsn ] && export OCOR_LIVE_POSTGRES_DSN=$(cat ~/.ocor-codex/rem-0059/dsn)\n[ -f ~/.ocor-codex/rem-0059/dev.env ] && export OCOR_BOOTSTRAP_ENV=~/.ocor-codex/rem-0059/dev.env\necho \"head=$(git rev-parse HEAD) dirty=$(git status --porcelain | wc -l) docker=$(docker ps --format '{{.Names}}' | sort | tr '\\n' ' ')\" > \"$OUT.log\"\n.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "c71090d9ea13e8e6bd686874347b9a211258e82ebaf3cf9e54ec473d38f26198"}
