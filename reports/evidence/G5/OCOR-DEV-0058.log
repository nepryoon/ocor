{"command": "captured artifact: exact mutation harness, archived for reproduction", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"Mutation probe of memory/promotion.py for OCOR-DEV-0058 (in place on the frozen code commit, always restored).\n\nUsage: mutation_probe.py <output.json>   (environment: live stack variables from run.py)\nEach mutant removes or weakens one control; the task file must fail. A mutant that\nsurvives is accepted only when declared equivalent here with the exact reason.\n\"\"\"\nimport hashlib, json, os, subprocess, sys\nfrom pathlib import Path\n\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0058')\nF = R / 'ocor-runtime/src/ocor_runtime/memory/promotion.py'\nM = [\n (\"skip-commit-denial-audit\", '            self._record(\"commitMemoryPromotion.indeterminate\" if dispatched else \"commitMemoryPromotion.denied\",', '            (lambda *a, **k: None)(\"commitMemoryPromotion.indeterminate\" if dispatched else \"commitMemoryPromotion.denied\",'),\n (\"skip-final-human-gate\", \"        try:\\n            self._human_gate.validate(\", \"        try:\\n            pass\\n            if False: self._human_gate.validate(\"),\n (\"skip-proposal-digest\", 'body[\"proposal_audit_ref\"] != proposal_audit_ref or body[\"proposal_digest\"] != proposal.digest', 'body[\"proposal_audit_ref\"] != proposal_audit_ref'),\n (\"skip-promotion-bundle\", 'if decision.policy_bundle_digest != ctx.policy_bundle_digest:', 'if False:'),\n (\"skip-command-gcs\", 'or command.governed_context != verified.expected\\n', '\\n'),\n (\"skip-load-revalidation\", 'proposal = self._validate(item_id, raw, verified, expected_epoch=epoch)', 'proposal = MemoryPromotionProposal(**{**old, \"evidence_refs\": tuple(old[\"evidence_refs\"]), \"provenance_refs\": tuple(old[\"provenance_refs\"]), \"taint_labels\": tuple(old[\"taint_labels\"]), \"deadline\": parse_utc_timestamp(str(old[\"deadline\"]))})'),\n (\"authority-self-delegation\", 'binding.binding_ref, delegation, binding.expected)', 'binding.binding_ref, authority.delegation_ref, binding.expected)'),\n (\"skip-capability-pin\", 'if body[\"capability_id\"] != self._capability:', 'if False:'),\n (\"skip-receipt-verify\", '            receipt.verify(command)\\n', '\\n'),\n (\"skip-signature\", 'or self._verifier.verify(gate.payload, gate.signature) is not True', ''),\n (\"skip-decision-revocation\", 'if not start <= now < end or self._controls.revoked(command.decision_ref) is not False:', 'if not start <= now < end:'),\n (\"skip-proposal-stop-recheck\", '        if fresh.stop_epoch != plan.stop_epoch:\\n            raise _error(\"STOP_EPOCH_CHANGED\", \"STOP_EPOCH_MISMATCH\")\\n', ''),\n (\"skip-profile-registration\", '        if key not in self._profiles:\\n            raise _error(\"PROFILE_NOT_REGISTERED\", \"UNSUPPORTED_CAPABILITY\")\\n', ''),\n (\"skip-request-closed-schema\", 'or set(request) != REQUEST_FIELDS:', ':'),\n (\"skip-deny-audit\", '        except MemoryAdmissionError as exc:\\n            self._deny(\"proposeMemoryPromotion\", binding, operation, exc)\\n', '        except MemoryAdmissionError as exc:\\n'),\n (\"skip-intent-audit\", '            self._record(\"commitMemoryPromotion.intent\", verified,', '            (lambda *a, **k: None)(\"commitMemoryPromotion.intent\", verified,'),\n (\"skip-delegation-revocation\", '                     or self._controls.revoked(authority.delegation_ref) is not False),', '                     ),'),\n]\nEQUIVALENT = {\n    \"skip-command-gcs\": \"GovernedCanonicalCommitCommand.from_mapping already enforces digest(governed_context) == governed_context_digest, and the consumer requires that digest to equal the proposal digest, which load() revalidates under the same verified binding; the removed comparison is unreachable defence in depth.\",\n}\norig = F.read_text()\ndigest = hashlib.sha256(orig.encode()).hexdigest()\nout = {}\ntry:\n    for name, a, b in M:\n        assert orig.count(a) == 1, name\n        F.write_text(orig.replace(a, b))\n        p = subprocess.run([str(R / 'ocor-runtime/.venv/bin/python'), '-m', 'pytest', '-q', '-x', '-p', 'no:cacheprovider',\n                            'ocor-runtime/tests/tasks/test_ocor_dev_0058.py'], cwd=R, capture_output=True, text=True, env=os.environ, timeout=900)\n        first = [l for l in p.stdout.splitlines() if l.startswith(('FAILED', 'ERROR'))][:1]\n        out[name] = {\"exit_code\": p.returncode, \"killed\": p.returncode != 0, \"first_failure\": first,\n                     \"equivalent\": name in EQUIVALENT and p.returncode == 0, \"equivalence_reason\": EQUIVALENT.get(name)}\n        print(name, json.dumps(out[name]), flush=True)\nfinally:\n    F.write_text(orig)\nassert hashlib.sha256(F.read_bytes()).hexdigest() == digest\nPath(sys.argv[1]).write_text(json.dumps(out, indent=2, sort_keys=True) + \"\\n\")\n", "sha256": "2ee04561a5600945258db36ec2bb7926672baa192eb4bda67afc37d9bd862433"}
{"command": "captured artifact: exact local campaign driver: frozen extras, bootstrap_ci_environment.py, unchanged repository full harness and limits", "exit_code": 0, "label": "qualifying-local-driver", "output": "\"\"\"OCOR-DEV-0058 repair1 qualification (Codex/OpenAI; original Codex + Claude/Anthropic).\n\nOne stack, sequential. Phases:\n  gates     toolchain lock, inputs, harness, drift, ruff, mypy strict, language, rccad, scope, plan\n  stack     teardown + scripts/bootstrap_ci_environment.py --execute (VERIFIER-ENV-STANDARD-BOOTSTRAP)\n  mutation  archived mutation probe of memory/promotion.py on the code commit (in place, restored)\n  task      task file x3, backlog validation command (project form), SDK ci/build, reports portfolio\n  full      teardown + bootstrap_ci_environment.py --execute, governed full suite (75-min limit)\nEvery step: verbatim redacted log, exit code, duration, sha256. Fail-closed.\n\"\"\"\nimport hashlib, json, os, re, shutil, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nD = Path(__file__).parent\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0058')\nPY = R / 'ocor-runtime/.venv/bin/python'\nTASKFILE = 'ocor-runtime/tests/tasks/test_ocor_dev_0058.py'\nBRANCH = 'task/OCOR-DEV-0058-memory-promotion-c6-c3'\nenv = os.environ.copy()\nenv.update(PATH='/home/luca/.ocor-codex/rem0019-escalation-20261020/isolated-git/usr/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:/home/luca/.local/bin:' + env['PATH'],\n           GIT_PAGER='cat', PAGER='cat', GH_PROMPT_DISABLED='1', GIT_EDITOR='true', PYTHONHASHSEED='0', TZ='UTC')\nfor k in list(env):\n    if k.startswith('OCOR_'):\n        env.pop(k, None)\nsecret = R / '.ocor/bootstrap.env'\nvalues: dict[str, str] = {}\nrows: list[dict] = []\nphases = sys.argv[1].split(',') if len(sys.argv) > 1 else ['gates', 'mutation', 'stack', 'task', 'full']\nif (D / 'commands.json').exists():\n    rows = json.loads((D / 'commands.json').read_text())\n\n\ndef load_values() -> None:\n    values.clear()\n    if secret.exists():\n        values.update(dict(l.split('=', 1) for l in secret.read_text().splitlines() if '=' in l))\n\n\ndef redact(text: str) -> str:\n    for k, v in values.items():\n        if ('PASSWORD' in k or 'TOKEN' in k) and len(v) > 7:\n            text = text.replace(v, '<REDACTED_LOCAL_CREDENTIAL>')\n    return text\n\n\ndef dump(p: Path, d: object) -> None:\n    p.write_text(json.dumps(d, indent=2, sort_keys=True) + '\\n')\n\n\ndef inventory() -> dict:\n    return {k: sorted(subprocess.check_output(c, text=True, timeout=60, env=env).split()) for k, c in [\n        ('containers', ['docker', 'ps', '-a', '--format', '{{.Names}}']), ('volumes', ['docker', 'volume', 'ls', '-q']),\n        ('networks', ['docker', 'network', 'ls', '--format', '{{.Name}}'])]}\n\n\ndef junit(path: Path) -> dict:\n    root = ET.parse(path).getroot()\n    suites = [root] if root.tag == 'testsuite' else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in ('tests', 'failures', 'errors', 'skipped')}\n    return {'passed': t['tests'] - t['failures'] - t['errors'] - t['skipped'], 'failed': t['failures'], 'errors': t['errors'],\n            'skipped': t['skipped'], 'not_executed': 0, 'tests': t['tests']}\n\n\ndef run(label, c, limit=600, fatal=True, xml=None, live=False, cwd=R):\n    e = dict(env)\n    if live:\n        e.update(values)\n        e['OCOR_BOOTSTRAP_ENV'] = str(secret)\n        e['OCOR_LIVE_POSTGRES_DSN'] = 'postgresql://ocor:' + values['OCOR_LOCAL_POSTGRES_PASSWORD'] + '@127.0.0.1:55433/ocor'\n    t = time.monotonic()\n    started = datetime.now(UTC).isoformat()\n    try:\n        r = subprocess.run(c, cwd=cwd, env=e, capture_output=True, text=True, timeout=limit)\n        rc, out = r.returncode, r.stdout + r.stderr\n    except subprocess.TimeoutExpired as exc:\n        rc = 124\n        out = (exc.stdout or b'').decode(errors='replace') if isinstance(exc.stdout, bytes) else (exc.stdout or '')\n        out += f'\\nTIMEOUT after {limit}s\\n'\n    load_values()\n    out = redact(out)\n    p = D / (label + '.log')\n    p.write_text(out)\n    p.chmod(0o600)\n    row = {'label': label, 'command': c, 'exit_code': rc, 'started_at': started, 'duration_seconds': round(time.monotonic() - t, 3),\n           'raw_sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'head_sha': head, 'status': 'PASS' if rc == 0 else 'FAIL'}\n    if live:\n        row['environment'] = 'OCOR_LIVE_POSTGRES_DSN=<local generated credential>'\n    if xml is not None and Path(xml).exists():\n        row['result'] = junit(Path(xml))\n        row['junit_sha256'] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if row['result']['skipped'] or row['result']['failed'] or row['result']['errors']:\n            row['status'] = 'FAIL'\n    rows[:] = [x for x in rows if x['label'] != label] + [row]\n    dump(D / 'commands.json', rows)\n    print(datetime.now(UTC).strftime('%H:%M:%S'), label, row['status'], rc, flush=True)\n    if fatal and row['status'] != 'PASS':\n        raise SystemExit(f'ABORT at {label}')\n    return out\n\n\ndef stack(prefix: str) -> None:\n    run(prefix + 'teardown', [str(PY), 'scripts/bootstrap_ci_environment.py', '--teardown', '--execute'], 300)\n    # The stack is gone (teardown residual PASS); its generated credential file is now\n    # dead and bootstrap_ci_environment.py requires a fresh one. The disposable CA stays.\n    run(prefix + 'retire-credentials', ['rm', '-f', '--', '.ocor/bootstrap.env'], 30)\n    assert not secret.exists()\n    out = run(prefix + 'bootstrap-ci', [str(PY), 'scripts/bootstrap_ci_environment.py', '--execute', '--timeout', '600'], 700)\n    load_values()\n    assert json.loads(out[out.index('{\\n'):])['status'] == 'PASS'\n    build_log = R / 'reports/tests/ci_fuseki_build.log'\n    if build_log.exists():\n        shutil.move(str(build_log), str(D / (prefix + 'ci_fuseki_build.log')))\n    ids = subprocess.check_output(['docker', 'ps', '-aq', '--filter', 'label=com.docker.compose.project=ocor-bootstrap'], text=True, env=env, timeout=30).split()\n    assert len(ids) == 11\n    props = json.loads(subprocess.check_output(['docker', 'inspect', *ids], text=True, env=env, timeout=30))\n    summary = [{'name': c['Name'], 'image_id': c['Image'], 'running': c['State']['Running'], 'oom': c['State']['OOMKilled'], 'restarts': c['RestartCount']} for c in props]\n    assert all(c['running'] and not c['oom'] and c['restarts'] == 0 for c in summary)\n    dump(D / (prefix + 'stack-summary.json'), summary)\n\n\ndef portfolio_files() -> list[str]:\n    return ['reports/tests/test_generate_contracts_reference_resolution.py', 'reports/tests/test_backlog_generator_reality_parity.py',\n            'reports/tests/test_runtime_evidence_validator.py', 'reports/tests/test_evidence_input_drift.py',\n            'reports/tests/test_language_migration_benchmark_harness.py', 'reports/tests/test_qualifying_campaign_guard.py',\n            'reports/tests/test_fuseki_archive_acquisition.py', 'reports/tests/test_kind_teardown_observation.py',\n            'reports/tests/test_ci_fuseki_archive.py', 'reports/tests/test_rem0034_secret_registry.py',\n            'reports/tests/test_rem0023_consumer_fixture_scope.py']\n\n\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\nassert not subprocess.check_output(['git', 'status', '--porcelain'], cwd=R, text=True, env=env).strip(), 'dirty worktree'\nload_values()\nif 'gates' in phases:\n    lock = json.loads((R / 'infra/toolchain.lock.json').read_text())\n    tools = []\n    for x in lock['tools']:\n        if x['provider'] == 'container':\n            props = json.loads(subprocess.check_output(['docker', 'image', 'inspect', x['container_image']], text=True, env=env, timeout=30))[0]\n            java = next(v.split('=', 1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env'] + '='))\n            assert java.removeprefix('jdk-') == x['version'] and x['container_image'] in props['RepoDigests']\n            tools.append({'id': x['id'], 'version': java, 'version_match': True, 'digest_match': True})\n            continue\n        p = PY if x['id'] == 'python' else Path(shutil.which(x['command'], path=env['PATH']))\n        v = subprocess.check_output([str(p), *x['version_args']], text=True, env=env, stderr=subprocess.STDOUT, timeout=30).strip()\n        digest = hashlib.sha256(p.read_bytes()).hexdigest()\n        row = {'id': x['id'], 'path': str(p), 'version': v, 'version_match': bool(re.search(x['version_pattern'], v)), 'sha256': digest, 'digest_match': digest == x['integrity']}\n        tools.append(row)\n        assert row['version_match'] and row['digest_match'], x['id']\n    dump(D / 'toolchain.json', {'tools': tools})\n    run('inputs', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS'])\n    run('sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n    run('harness', [str(PY), 'scripts/verify.py', '--json'])\n    subprocess.run(['git', 'restore', 'reports/verify_report.json'], cwd=R, check=True)\n    run('drift', [str(PY), 'scripts/validate_evidence_input_drift.py'])\n    run('ruff', ['ruff', 'check', '.'])\n    run('mypy', [str(PY), '-m', 'mypy'])\n    run('language', [str(PY), 'scripts/validate_language_policy.py'])\n    run('rccad', [str(PY), 'scripts/validate_rccad.py', '--base-ref', 'origin/main'])\n    run('scope', [str(PY), 'scripts/validate_ocor_change_scope.py', '--base', 'origin/main', '--branch', BRANCH])\n    run('plan', [str(PY), 'scripts/validate_ocor_development_plan.py', '--base-ref', 'HEAD', '--authorized-extension'])\n    subprocess.run(['git', 'checkout', '--', 'reports/planning/'], cwd=R, check=True)\nif 'stack' in phases:\n    stack('')\nif 'mutation' in phases:\n    run('preflight', [str(PY), 'scripts/preflight_environment.py', '--require-ready'], 60)\n    run('mutation-probe', [sys.executable, str(D / 'mutation_probe.py'), str(D / 'mutation-probe.json')], 1800, live=True)\n    assert all(v['killed'] or v.get('equivalent') for v in json.loads((D / 'mutation-probe.json').read_text()).values())\nif 'task' in phases:\n    before = inventory()\n    for n in (1, 2, 3):\n        x = D / f'task-{n}.xml'\n        run(f'task-run-{n}', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', TASKFILE], 45 * 60, xml=x, live=True)\n    x = D / 'task-validation-command-project.xml'\n    run('task-validation-command-project', ['uv', 'run', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', f'--junitxml={x}', TASKFILE], 45 * 60, xml=x, live=True)\n    after = inventory()\n    delta = {k: sorted(set(after[k]) - set(before[k])) for k in before}\n    dump(D / 'task-resource-delta.json', delta)\n    assert not any(delta.values()), delta\n    run('sdk-ci', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'ci'], 900)\n    run('sdk-build', ['npm', '--prefix', 'ocor-runtime/sdk/typescript', 'run', 'build'], 900)\n    x = D / 'reports-portfolio.xml'\n    run('reports-portfolio', [str(PY), '-m', 'pytest', '-q', '-p', 'no:cacheprovider', '-rs', *portfolio_files(), f'--junitxml={x}'], 1200, xml=x)\n    subprocess.run(['git', 'checkout', '--', 'reports/'], cwd=R, check=True)\nif 'full' in phases:\n    run('full-reset', [str(PY), 'scripts/reset_test_environment.py', '--execute'], 300)\n    stack('full-')\n    run('full-sync-lint', ['uv', 'sync', '--project', 'ocor-runtime', '--frozen', '--extra', 'test', '--extra', 'lint'])\n    run('full-mypy-ready', [str(PY), '-c', 'import mypy.version; print(mypy.version.__version__)'])\n    dump(D / 'resources-before-full.json', inventory())\n    run('full-suite', [str(PY), 'scripts/run_qualifying_campaign.py', '--execute', '--repository', '.', '--expected-head', head, '--output-dir', str(D / 'full')], 4650, live=True)\n    dump(D / 'resources-after-full.json', inventory())\nprint('DONE', flush=True)\n", "sha256": "bba6a4b8c19f471c819d45cce09ad608d9fb22afbb72bd313c7d006eafd01c44"}
