s/runs/39935355012/job/120353429064\",\"name\":\"validation-closure part 1/4\",\"startedAt\":\"2026-10-23T09:55:45Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR governance and validation closure\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T09:55:57Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355018/job/120353428369\",\"name\":\"supply-chain\",\"startedAt\":\"2026-10-23T09:55:39Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR supply-chain gates\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T09:56:05Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355071/job/120353428357\",\"name\":\"type-and-lint-gate\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR tooling and bootstrap policy\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:15:18Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355020/job/120353428781\",\"name\":\"rccad-methodology part 2/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR RCCAD methodology gates\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:18:42Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355169/job/120353428757\",\"name\":\"delivery-activation part 2/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR autonomous delivery controls\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:18:39Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355012/job/120353428679\",\"name\":\"validation-closure part 2/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR governance and validation closure\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:15:37Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355020/job/120353428879\",\"name\":\"rccad-methodology part 3/4\",\"startedAt\":\"2026-10-23T09:55:37Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR RCCAD methodology gates\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:19:24Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355169/job/120353428432\",\"name\":\"delivery-activation part 3/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR autonomous delivery controls\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:19:13Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355012/job/120353429005\",\"name\":\"validation-closure part 3/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR governance and validation closure\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:21:54Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355020/job/120353428425\",\"name\":\"rccad-methodology part 4/4\",\"startedAt\":\"2026-10-23T09:55:18Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR RCCAD methodology gates\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:22:24Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed-design/actions/runs/39935355169/job/120353429014\",\"name\":\"delivery-activation part 4/4\",\"startedAt\":\"2026-10-23T09:55:39Z\",\"status\":\"COMPLETED\",\"workflowName\":\"OCOR autonomous delivery controls\"},{\"__typename\":\"CheckRun\",\"completedAt\":\"2026-10-23T10:17:48Z\",\"conclusion\":\"SUCCESS\",\"detailsUrl\":\"https://github.com/nepryoon/ocor-detailed