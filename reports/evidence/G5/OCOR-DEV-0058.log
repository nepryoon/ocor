{"command": "captured artifact: actual RED classifier: AST fixture dependency, returns nonzero on misclassification", "exit_code": 0, "label": "backend-classifier-script", "output": "import ast,json,sys\nfrom pathlib import Path\nr=Path(sys.argv[1]);d=json.loads((r/'reports/evidence/G5/OCOR-DEV-0058.json').read_text())\ntree=ast.parse((r/'ocor-runtime/tests/tasks/test_ocor_dev_0058.py').read_text())\nactual={n.name for n in tree.body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_') and any(a.arg=='backends' for a in n.args.args)}\nwrong=sorted({t for case in d['requirement_results'] for t in case['real_backend_tests'] if t not in actual})\nmissing=sorted({t for case in d['requirement_results'] for t in case['unit_fixture_tests'] if t in actual})\nprint(json.dumps({'status':'FAIL' if wrong or missing else 'PASS','wrongly_classified_as_real_backend':wrong,'wrongly_classified_as_unit_fixture':missing,'method':'AST fixture dependency; a name substring is insufficient'},indent=2,sort_keys=True))\nsys.exit(1 if wrong or missing else 0)\n", "sha256": "fe80c9c13212ec33edce6ebaf41ca4954b4de3d809bae68459af120be567a01e"}
{"command": "captured artifact: Helm, kind and kubectl executable SHA256 match qualification_tools.lock.json", "exit_code": 0, "label": "qualification-tools-lock-match", "output": "[\n  {\n    \"id\": \"helm\",\n    \"match\": true,\n    \"path\": \"/home/luca/projects/ocor-detailed-design/.ocor/tools/bin/helm\",\n    \"sha256\": \"912d3c044f46dcc43c22d073dec7eacf6ba8701dfc7f60688174b3eaa30d3698\"\n  },\n  {\n    \"id\": \"kind\",\n    \"match\": true,\n    \"path\": \"/home/luca/projects/ocor-detailed-design/.ocor/tools/bin/kind\",\n    \"sha256\": \"c72eda46430f065fb45c5f70e7c957cc9209402ef309294821978677c8fb3284\"\n  },\n  {\n    \"id\": \"kubectl\",\n    \"match\": true,\n    \"path\": \"/home/luca/projects/ocor-detailed-design/.ocor/tools/bin/kubectl\",\n    \"sha256\": \"5de4e9f2266738fd112b721265a0c1cd7f4e5208b670f811861f699474a100a3\"\n  }\n]\n", "sha256": "775af45e9a626e1b6007cac274154674d1bf41eca0aeab22e7804622ddae7afc"}
{"command": "captured artifact: exact evidence builder with explicit AST fixture classification", "exit_code": 0, "label": "evidence-builder-script", "output": "\"\"\"Build the OCOR-DEV-0058 candidate evidence from raw logs (no hand-entered counts).\n\nUsage: build_evidence.py <repo> <campaign_dir> <code_commit>\nCounts come only from JUnit XML archived with parameterized names replaced by SHA256 in the JSONL raw output.\nThe G5 manifest is updated surgically: existing entries are preserved, the\nOCOR-DEV-0058 entries are appended (or replaced on rebuild).\n\"\"\"\nimport ast, hashlib, json, re, subprocess, sys\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nrepo, q, code_commit = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]\nS = q.parent  # ~/.ocor-codex/ocor-dev-0058\nTASK = \"OCOR-DEV-0058\"\nG5 = repo / \"reports/evidence/G5\"\nINPUT_PATHS = (\"ocor-runtime/src/ocor_runtime/memory/promotion.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_0058.py\")\n\n\ndef sha(b: bytes) -> str:\n    return hashlib.sha256(b).hexdigest()\n\n\ndef git(*a: str) -> str:\n    return subprocess.check_output([\"git\", *a], cwd=repo, text=True).strip()\n\n\nSECRETS = {n: v for n, v in (l.split(\"=\", 1) for l in (repo / \".ocor/bootstrap.env\").read_text().splitlines() if \"=\" in l)\n           if n.startswith((\"OCOR_LOCAL_\", \"OCOR_SPIRE_JOIN\")) and len(v) >= 8}\nredactions: dict[str, int] = {}\nraw_lines: list[str] = []\nsource_digests: dict[str, str] = {}\nidentity_redactions: dict[str, int] = {}\n\n\ndef redact(b: bytes) -> bytes:\n    t = b.decode(\"utf-8\")\n    for n, v in SECRETS.items():\n        c = t.count(v)\n        if c:\n            redactions[n] = redactions.get(n, 0) + c\n            t = t.replace(v, f\"<redacted:{n}>\")\n    return t.encode()\n\n\ndef add_raw(label: str, command: str, exit_code: int, data: bytes) -> str:\n    source_digests[label] = sha(data)\n    if label.endswith(\"junit\"):\n        root = ET.fromstring(data)\n        total = 0\n        for case in root.iter(\"testcase\"):\n            name = case.get(\"name\", \"\")\n            if \"[\" in name:\n                case.set(\"name\", name.split(\"[\", 1)[0] + \"[sha256:\" + sha(name.encode()) + \"]\")\n                total += 1\n        data = ET.tostring(root, encoding=\"utf-8\")\n        identity_redactions[label] = total\n    data = redact(data)\n    raw_lines.append(json.dumps({\"label\": label, \"command\": command, \"exit_code\": exit_code, \"sha256\": sha(data), \"output\": data.decode()}, sort_keys=True, ensure_ascii=False))\n    return sha(data)\n\n\ndef junit_cases(text: str) -> list[tuple[str, str]]:\n    out = []\n    for case in ET.fromstring(text).iter(\"testcase\"):\n        o = \"PASS\"\n        for ch in case:\n            if ch.tag in (\"failure\", \"error\"):\n                o = \"FAIL\"\n            elif ch.tag == \"skipped\":\n                o = \"SKIPPED\"\n        out.append((case.get(\"name\", \"\"), o))\n    return out\n\n\ndef junit_counts(text: str) -> dict[str, int]:\n    root = ET.fromstring(text)\n    suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\n\ndef shown(c: list[str]) -> str:\n    return \" \".join(c).replace(str(repo), \"<worktree>\").replace(str(Path.home()), \"~\")\n\n\ncommands: list[dict] = []\nobservations: list[dict] = []\nfor row in json.loads((q / \"commands.json\").read_text()):\n    data = (q / f\"{row['label']}.log\").read_bytes()\n    cmd = shown(row[\"command\"]) if isinstance(row[\"command\"], list) else row[\"command\"]\n    if row.get(\"environment\"):\n        cmd = f\"{row['environment']} {cmd}\"\n    digest = add_raw(row[\"label\"], cmd, row[\"exit_code\"], data)\n    entry = {\"label\": row[\"label\"], \"command\": cmd, \"exit_code\": row[\"exit_code\"], \"raw_sha256\": digest, \"status\": row[\"status\"],\n             \"duration_seconds\": row[\"duration_seconds\"], \"head_sha\": row[\"head_sha\"]}\n    if \"result\" in row:\n        r = row[\"result\"]\n        entry[\"result\"] = {\"passed\": r[\"passed\"], \"failed\": r[\"failed\"] + r[\"errors\"], \"skipped\": r[\"skipped\"], \"not_executed\": 0}\n    commands.append(entry)\n\nARTIFACTS = [\n    (\"session-teardown-result\", q / \"teardown.json\", \"Final documented bootstrap teardown: fail-closed, zero owned containers/volumes/networks\"),\n    (\"existing-tests-preserved\", q / \"existing-tests-preserved.json\", \"AST comparison of all pre-existing test functions plus exact JUnit name subset: no old body, assertion, decorator or parametrized case changed/removed\"),\n    (\"preflight-main-ci\", q / \"preflight-main-ci.json\", \"Previous main integration PR319: all 13 required named checks success on exact head; not qualification of this candidate\"),\n    (\"publication-redaction-check\", q / \"publication-redaction-check.json\", \"actual publication functions checked: only parametrized names change, all counts/assertion outcomes and source SHA256 preserved\"),\n    (\"backend-classifier-script\", q / \"check_backend_classification.py\", \"actual RED classifier: AST fixture dependency, returns nonzero on misclassification\"),\n    (\"qualification-tools-lock-match\", q / \"qualification-toolchain.json\", \"Helm, kind and kubectl executable SHA256 match qualification_tools.lock.json\"),\n    (\"evidence-builder-script\", q / \"build_evidence.py\", \"exact evidence builder with explicit AST fixture classification\"),\n    (\"evidence-checker-script\", q / \"check_evidence.py\", \"recomputes final HEAD digests, AST backend labels, raw/manifest/counts\"),\n    (\"exact-union-checker-script\", q / \"check_union.py\", \"exact JUnit multiset check against collection at the frozen code HEAD\"),\n    (\"wait-contract\", q / \"wait-contract.json\", \"bounded task/mutation/full/CI waits; unchanged limits\"),\n    (\"task-junit\", q / \"task-3.xml\", \"JUnit XML captured from task-run-3 (parameterized names published as SHA256) (third of three consecutive live runs)\"),\n    (\"validation-command-junit\", q / \"task-validation-command-project.xml\", \"JUnit XML of the backlog validation command scoped to the runtime project\"),\n    (\"reports-portfolio-junit\", q / \"reports-portfolio.xml\", \"JUnit XML of the reports/tests portfolio linked in CI (after SDK npm ci/build)\"),\n    (\"full-suite-junit\", q / \"full/runtime_junit_post_approval.xml\", \"JUnit XML (parameterized names published as SHA256) of the governed full suite (scripts/run_qualifying_campaign.py)\"),\n    (\"full-suite-campaign-result\", q / \"full/campaign_result.json\", \"run_qualifying_campaign.py result (75-min limit, stack guard, required modules)\"),\n    (\"toolchain-lock-match\", q / \"toolchain.json\", \"every infra/toolchain.lock.json tool matched by version and sha256 on the campaign PATH\"),\n    (\"exact-junit-union\", q / \"exact-junit-union.json\", \"unsharded full JUnit exact multiset match with pytest --collect-only on the same HEAD: no missing/duplicate/extra/skipped test\"),\n    (\"full-kind-teardown\", q / \"full/kind-teardown-observations.json\", \"repository kind v2 guard: destroy/remover proof and rejection observations\"),\n    (\"stack-summary\", q / \"stack-summary.json\", \"11 ocor-bootstrap services running, no OOM, zero restarts after bootstrap_ci_environment.py, before the task runs\"),\n    (\"full-stack-summary\", q / \"full-stack-summary.json\", \"11 ocor-bootstrap services running, no OOM, zero restarts after the second bootstrap_ci_environment.py, before the full suite\"),\n    (\"task-resource-delta\", q / \"task-resource-delta.json\", \"containers/volumes/networks added by the task runs (must be empty)\"),\n    (\"mutation-probe-result\", q / \"mutation-probe.json\", \"mutants of memory/promotion.py on the frozen code commit; each must fail the task file unless declared equivalent with its reason\"),\n    (\"mutation-probe-script\", q / \"mutation_probe.py\", \"exact mutation harness, archived for reproduction\"),\n    (\"qualifying-local-driver\", q / \"run.py\", \"exact local campaign driver: frozen extras, bootstrap_ci_environment.py, unchanged repository full harness and limits\"),\n]\nfor label, path, note in ARTIFACTS:\n    data = path.read_bytes()\n    digest = add_raw(label, f\"captured artifact: {note}\", 0, data)\n    entry = {\"label\": label, \"command\": f\"captured artifact: {note}\", \"raw_sha256\": digest, \"status\": \"PASS\", \"exit_code\": 0}\n    if path.suffix == \".xml\":\n        entry[\"result\"] = junit_counts(data.decode())\n        if entry[\"result\"][\"failed\"] or entry[\"result\"][\"skipped\"]:\n            entry[\"status\"] = \"FAIL\"\n    if label == \"full-suite-campaign-result\":\n        res = json.loads(data)\n        if res.get(\"status\") != \"PASS\" or res.get(\"candidate_head\") != code_commit or any(res[\"counts\"][k] for k in (\"errors\", \"failures\", \"skipped\")):\n            entry[\"status\"] = \"FAIL\"\n        entry[\"result\"] = {\"passed\": res[\"counts\"][\"tests\"], \"failed\": res[\"counts\"][\"errors\"] + res[\"counts\"][\"failures\"], \"skipped\": res[\"counts\"][\"skipped\"], \"not_executed\": 0}\n        if res.get(\"po_decision_required\"):\n            observations.append({\"label\": \"full-suite-duration\", \"raw_sha256\": digest,\n                                 \"note\": f\"governed full suite PASS in {res['duration_seconds']:.2f}s, above the 3600s PO notification threshold and below the unchanged 4500s limit; recorded as an occurrence for the open decision request REM-0033-LOCAL-FULL-DURATION (non-blocking, no limit, test or timeout changed).\"})\n    if label == \"task-resource-delta\" and any(json.loads(data).values()):\n        entry[\"status\"] = \"FAIL\"\n    if label == \"mutation-probe-result\":\n        probe = json.loads(data)\n        equivalent = sorted(n for n, v in probe.items() if not v[\"killed\"] and v[\"equivalent\"])\n        survivors = sorted(n for n, v in probe.items() if not v[\"killed\"] and not v[\"equivalent\"])\n        entry[\"result\"] = {\"mutants\": len(probe), \"killed\": len(probe) - len(survivors) - len(equivalent), \"equivalent_survivors\": equivalent, \"failed\": len(survivors)}\n        if survivors:\n            entry[\"status\"] = \"FAIL\"\n    commands.append(entry)\n\nC = S / \"campaign\"\nred_digests = {\n    \"red-module-absent\": add_raw(\"tdd-red-module-absent\", \"RED on 62b3954 (tests only, Codex, before promotion.py): pytest -q ocor-runtime/tests/tasks/test_ocor_dev_0058.py -> collection ModuleNotFoundError\", 2, (C / \"red.log\").read_bytes()),\n    \"red-c6-consumer-absent\": add_raw(\"tdd-red-c6-consumer-absent\", \"RED on e7d6259 plus uncommitted consumer test (Codex): pytest -q ocor-runtime/tests/tasks/test_ocor_dev_0058.py -k c6_consumer -> ImportError C6MemoryPromotionConsumer\", 1, (C / \"red-c6.log\").read_bytes()),\n    \"red-self-vouched-delegation\": add_raw(\"tdd-red-self-vouched-delegation\", \"RED on the Codex WIP (e7d6259 plus uncommitted consumer) with the per-fault detail assertions (Claude Code): pytest -q ocor-runtime/tests/tasks/test_ocor_dev_0058.py -> authority-delegation DID NOT RAISE\", 1, (C / \"task-dev4.log\").read_bytes()),\n}\nfor label, path, note in [\n    (\"diagnostic-mutation-probe-de6aeb8\", C / \"mutants.json\", \"DIAGNOSTIC, never counted: first mutation probe on de6aeb8, three survivors (final Human Gate recheck, command GCS comparison, C3 receipt verification)\"),\n    (\"diagnostic-mutation-rerun\", C / \"mutants-2.json\", \"DIAGNOSTIC, never counted: rerun of the three survivors after the two gap tests; GCS comparison remains (equivalent)\"),\n    (\"diagnostic-mutation-preflight\", C / \"mutation-diagnostic.json\", \"DIAGNOSTIC, never counted: dry run of the archived probe harness before the campaign\"),\n]:\n    observations.append({\"label\": label, \"note\": note, \"raw_sha256\": add_raw(label, f\"diagnostic artifact: {note}\", 0, path.read_bytes())})\nfor key in (\"binding-audit\", \"evidence-classification\"):\n    data = (q / (\"red-\" + key + \".log\")).read_bytes()\n    red = json.loads((q / (\"red-\" + key + \".json\")).read_text())\n    assert sha(data) == red[\"sha256\"] and red[\"exit_code\"] == 1\n    red_digests[\"repair1-\" + key] = add_raw(\"tdd-repair1-\" + key, (\"RED before evidence rebuild: \" if key == \"evidence-classification\" else \"RED before runtime correction: \") + key, 1, data)\nverdict = Path.home() / \".ocor-codex/verdicts/OCOR-DEV-0058-e5f3729a5219-0.json\"\nobservations.append({\"label\": \"previous-external-verdict\", \"note\": \"Historical NO_GO retained; repair cycle 1 addresses VF-001 and VF-002; not a qualifying command\", \"raw_sha256\": add_raw(\"previous-external-verdict\", \"external verdict (unaltered)\", 0, verdict.read_bytes())})\nraw = (\"\\n\".join(raw_lines) + \"\\n\").encode()\n\ntask_cases = junit_cases((q / \"task-3.xml\").read_text())\n\n\ndef names(*prefixes: str) -> str:\n    return r\"^(\" + \"|\".join(prefixes) + r\")(\\[|$)\"\n\n\nLIVE_COMMIT = \"test_live_c6_approval_decision_produces_only_c3_commit_and_verified_receipt\"\nCASES = [\n    (\"PROPOSAL-IS-NON-AUTHORITATIVE-AND-RECORDED\", \"FR-118\",\n     names(\"test_proposal_binds_exact_source_gcs_target_evidence_without_mutation\", \"test_request_cannot_smuggle_authority_effect_or_content\",\n           \"test_malformed_and_unregistered_targets_fail_closed\", \"test_missing_binding_and_foreign_gcs_fail_closed\",\n           \"test_memory_port_has_no_canonical_security_or_mutative_memory_dependency\", \"test_live_proposal_is_durable_and_consumed_from_fresh_adapters\"),\n     \"proposeMemoryPromotion records a content-free MemoryPromotionProposal bound to the exact committed source version, GCS, registered target profile, evidence and provenance in the protected audit store and returns only the public OperationReceipt; no ledger, canonical or security write; requests smuggling authority, approval, decision, capability, policy, content or effect members, unregistered or security/policy targets, malformed envelopes, a missing binding or a foreign GCS are refused with an audited denial; on PostgreSQL 16, Qdrant and OpenBao the proposal is durable and revalidated by fresh adapters\"),\n    (\"PROPOSAL-REVALIDATION-FAILS-CLOSED\", \"FR-119\",\n     names(\"test_promotion_policy_is_live_and_fail_closed\", \"test_expired_deadline_is_audited\", \"test_audit_outage_returns_no_proposal\",\n           \"test_unrecorded_tampered_or_foreign_proposal_cannot_be_consumed\", \"test_consumption_revalidates_source_stop_policy_and_time\",\n           \"test_stop_change_during_policy_validation_returns_no_proposal\", \"test_live_ineligible_source_or_changed_control_leaves_only_denial\", \"test_live_proposal_policy_opa_positive_and_faults\"),\n     \"The proposal policy (unit fixture faults labelled as such; separate live cases query pinned OPA with allow/deny, a real refused TCP connection, an installed new bundle revision and an installed non-boolean result), deadline, audit availability, proposal integrity and the source eligibility are checked at proposal and again at consumption: revocation, correction, expiry, stop-epoch change (also during policy I/O), policy change, deadline, unrecorded, tampered or foreign proposals fail closed with an audited denial and no proposal; on the real backends revocation, supersession, foreign compartment, stop and policy denial leave only the denial and an unchanged ledger\"),\n    (\"CANONICAL-STATE-ONLY-VIA-C6-GATE-AND-VERIFIED-C3-RECEIPT\", \"FR-053\",\n     names(\"test_c6_consumer_requires_separate_control_authority_approval_decision_and_c3\", LIVE_COMMIT,\n           \"test_live_c3_refusal_after_dispatch_is_indeterminate_never_success\", \"test_live_c3_receipt_not_bound_to_command_is_indeterminate\"),\n     \"On PostgreSQL, Qdrant, OpenBao transit (ed25519 gate signature), the real Human Gate and live OPA, a recorded proposal reaches canonical state only through the signed C6 gate (command, Authority, Decision, approvals) and a governed C3 commit whose receipt is verified against the command; the ledger is unchanged, intent and completion are audited, the replay returns the same C3 receipt without a second revision; a C3 refusal or a receipt not bound to the command after dispatch is an audited indeterminate outcome, never success\"),\n    (\"EVERY-C6-CONTROL-REFUSAL-LEAVES-STATE-UNCHANGED\", \"FR-053\",\n     names(\"test_live_every_c6_gate_refusal_leaves_canonical_and_memory_unchanged\", \"test_commit_invalid_binding_audits_denial_before_any_control_or_c3_access\", \"test_live_commit_invalid_binding_persists_denial_without_state_change\"),\n     \"Missing/unverified bindings produce a durable denial with no C3 revision or outbox row; audit failure fails closed (local failure handling). Each live fault mutates exactly one control of the otherwise accepted gate and is refused before C3 with its own stable detail, leaving canonical state absent, the memory ledger unchanged and an audited denial: missing, unsigned or digest-forged gate; proposal, target, GCS, evidence or claim binding; Authority ref, expiry, not-yet-valid, revocation, purpose, tenant, capability, scope, domain, compartments, risk, self-vouched or unverified or revoked delegation, capability not composed for C3; Decision rejected, expired, revoked, other action or ref; approvals absent, below quorum, self-approved, wrong role, expired, missing required role, expiring during the last policy I/O; OPA deny, outage, stale bundle; stop, source revocation or Decision revocation during policy evaluation\"),\n    (\"MEMORY-PROMOTION-PATH\", \"BR-003\",\n     names(\"test_memory_port_has_no_canonical_security_or_mutative_memory_dependency\", \"test_c6_consumer_requires_separate_control_authority_approval_decision_and_c3\", LIVE_COMMIT),\n     \"End-to-end component path MemoryItem -> MemoryPromotionProposal -> C6 Policy/Authority/Approval/Decision -> GovernedCanonicalCommitCommand -> C3 on the real backends, with no direct memory write, capability grant or policy mutation at the port or integration level\"),\n]\ntest_ast = ast.parse((repo / INPUT_PATHS[1]).read_text())\n# Inspect fixture dependencies; a word in a test name cannot prove a backend.\nbackend_tests = {n.name for n in test_ast.body if isinstance(n, ast.FunctionDef)\n                 and n.name.startswith(\"test_\") and any(a.arg == \"backends\" for a in n.args.args)}\nrequirement_results, claimed = [], set()\nfor case_id, req, pattern, description in CASES:\n    matched = [(n, o) for n, o in task_cases if re.match(pattern, n)]\n    if not matched:\n        raise SystemExit(f\"no test matched {case_id}\")\n    claimed.update(n for n, _ in matched)\n    bases = sorted({re.sub(r\"\\[.*\", \"\", n) for n, _ in matched})\n    live = [b for b in bases if b in backend_tests]\n    res = {\"passed\": sum(o == \"PASS\" for _, o in matched), \"failed\": sum(o == \"FAIL\" for _, o in matched), \"skipped\": sum(o == \"SKIPPED\" for _, o in matched), \"not_executed\": 0}\n    requirement_results.append({\"case_id\": f\"{TASK}-{case_id}\", \"requirement_id\": req, \"command\": description, \"tests\": bases,\n                                \"real_backend_tests\": live, \"unit_fixture_tests\": [b for b in bases if b not in live], \"result\": res,\n                                \"status\": \"PASS\" if res[\"failed\"] == res[\"skipped\"] == 0 and live else \"FAIL\"})\nunclaimed = sorted({n for n, _ in task_cases} - claimed)\nif unclaimed:\n    raise SystemExit(f\"unmapped tests: {unclaimed}\")\n\ninputs = {\"inputs_tree\": git(\"rev-parse\", f\"{code_commit}:inputs\")}\nfor p in INPUT_PATHS:\n    inputs[p] = sha(subprocess.check_output([\"git\", \"show\", f\"{code_commit}:{p}\"], cwd=repo))\nmeta = json.loads((q / \"evidence_meta.json\").read_text())\nrecord = {\n    \"schema_version\": \"1.0\", \"task_id\": TASK, \"repair_cycle\": 1,\n    \"status\": \"CANDIDATE_AWAITING_INDEPENDENT_VERIFICATION\", \"result\": \"PASS\",\n    \"repair_dispositions\": {\n        \"VF-001\": {\"status\": \"ADDRESSED_AWAITING_INDEPENDENT_VERIFIER\", \"change\": \"Binding verificato dentro il boundary auditato; campi GCS assenti finché non verificati; diniego persistito prima di ogni accesso C6/C3; audit indisponibile fallisce chiuso\", \"tests\": [\"test_commit_invalid_binding_audits_denial_before_any_control_or_c3_access\", \"test_live_commit_invalid_binding_persists_denial_without_state_change\"]},\n        \"VF-002\": {\"status\": \"ADDRESSED_AWAITING_INDEPENDENT_VERIFIER\", \"change\": \"Classificazione AST dei fixture; i quattro fault originali restano unitari; nuova qualifica con OPA pinned, revisione Rego reale, risposta non booleana e trasporto realmente rifiutato\", \"tests\": [\"test_promotion_policy_is_live_and_fail_closed\", \"test_live_proposal_policy_opa_positive_and_faults\"]}},\n    \"repair_of\": {\"request_id\": \"OCOR-DEV-0058-e5f3729a5219-0\", \"verdict\": \"NO_GO\", \"findings\": [\"VF-001\", \"VF-002\"], \"verdict_sha256\": sha(verdict.read_bytes())},\n    \"commit\": code_commit, \"created_at\": datetime.now(UTC).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n    \"environment\": meta[\"environment\"], \"inputs\": inputs,\n    \"inputs_tree_definition\": \"git rev-parse <commit>:inputs (tree della directory inputs/ immutabile)\",\n    \"raw_output_format\": \"JSONL: una riga per comando/artefatto con label, command, exit_code, sha256 dei byte UTF-8 archiviati e output integrale; le credenziali locali generate (valori di .ocor/bootstrap.env) sono sostituite prima dell'archiviazione e dell'hash; DSN mostrato come <local generated credential>\",\n    \"raw_output_redactions\": redactions, \"raw_output_sha256\": sha(raw), \"commands\": commands,\n    \"parameterized_case_identity_publication\": {\"authority\": \"REM-0019-SEALED-SYNTHETIC-SECRET-SCANNER (2026-10-15)\", \"method\": \"All parametrized JUnit testcase names retain the test function name and replace the full parameterized identity by SHA256; only publication changes, original counts and local exact JUnit union unchanged\", \"redacted_identity_counts\": identity_redactions, \"acquired_source_sha256_before_publication_redaction\": source_digests},\n    \"requirement_results\": requirement_results, \"observations\": observations,\n    \"tdd\": dict(meta[\"tdd\"], red_raw_sha256=red_digests), \"sealed_dependencies\": meta[\"sealed_dependencies\"], \"session_teardown\": json.loads((q / \"teardown.json\").read_text()),\n    \"design\": meta[\"design\"], \"normative_interpretations\": meta[\"normative_interpretations\"],\n    \"residual_risks\": meta[\"residual_risks\"], \"requirement_coverage_note\": meta[\"requirement_coverage_note\"],\n    \"rollback_procedure_verified\": meta[\"rollback\"], \"roles\": meta[\"roles\"], \"reproducible_check\": meta[\"reproducible_check\"],\n    \"claims\": {\"E1\": 0, \"E2\": 0, \"PoC_GO\": \"NO-GO\", \"Production_readiness\": \"NO_GO\", \"runtime_conformance\": \"NOT_ESTABLISHED\"},\n}\nif any(c[\"status\"] != \"PASS\" for c in commands) or any(r[\"status\"] != \"PASS\" for r in requirement_results):\n    record[\"result\"] = \"FAIL\"\nev = (json.dumps(record, indent=2, sort_keys=True, ensure_ascii=False) + \"\\n\").encode()\n(G5 / f\"{TASK}.json\").write_bytes(ev)\n(G5 / f\"{TASK}.log\").write_bytes(raw)\nmp = G5 / \"MANIFEST.json\"\nm = json.loads(mp.read_text())\nm[\"artifacts\"] = [a for a in m[\"artifacts\"] if a[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")] + [\n    {\"path\": f\"{TASK}.json\", \"sha256\": sha(ev), \"task_id\": TASK}, {\"path\": f\"{TASK}.log\", \"sha256\": sha(raw), \"task_id\": f\"{TASK}-RAW\"}]\nm[\"requirement_results\"] = [r for r in m[\"requirement_results\"] if r[\"task_id\"] != TASK] + [\n    {\"case_id\": r[\"case_id\"], \"command\": r[\"command\"], \"evidence_path\": f\"{TASK}.json\", \"raw_output_path\": f\"{TASK}.log\",\n     \"requirement_id\": r[\"requirement_id\"], \"status\": r[\"status\"], \"task_id\": TASK} for r in requirement_results]\nmp.write_text(json.dumps(m, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({\"result\": record[\"result\"], \"cases\": len(task_cases), \"requirement_results\": len(requirement_results), \"raw_sha256\": sha(raw), \"evidence_sha256\": sha(ev)}))\n", "sha256": "b2a9829d86bf6a33778ebed0d0debefcd32f6fddacfed181da627313f0a48158"}
{"command": "captured artifact: recomputes final HEAD digests, AST backend labels, raw/manifest/counts", "exit_code": 0, "label": "evidence-checker-script", "output": "\"\"\"Recompute every derived field of the OCOR-DEV-0058 evidence from a repository HEAD.\n\nUsage: check_evidence.py <repo> <head>\nChecks: input file hashes and inputs tree at the recorded commit and at HEAD; the\ncommit is an ancestor of HEAD and the diff after it touches only evidence outputs;\nraw log hash and every JSONL entry hash; command/raw pairing; manifest hashes and\npreservation of the pre-existing G5 entries; per-case counts recomputed from the task\nJUnit stored verbatim in the raw log; full-suite counts; mutation probe all killed;\nruntime evidence validator.\n\"\"\"\n\nimport ast\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\nrepo, head = Path(sys.argv[1]), sys.argv[2]\nTASK = \"OCOR-DEV-0058\"\nBASE = \"e53d602e1e6e00c8b5d6270c7f4c059f36193bde\"  # origin/main the task branch starts from\n\n\ndef git(*args: str) -> str:\n    return subprocess.check_output([\"git\", *args], cwd=repo, text=True).strip()\n\n\ndef show(path: str, ref: str = head) -> bytes:\n    return subprocess.check_output([\"git\", \"show\", f\"{ref}:{path}\"], cwd=repo)\n\n\ndef sha(data: bytes) -> str:\n    return hashlib.sha256(data).hexdigest()\n\n\nerrors: list[str] = []\nrecord_bytes = show(f\"reports/evidence/G5/{TASK}.json\")\nrecord = json.loads(record_bytes)\nraw = show(f\"reports/evidence/G5/{TASK}.log\")\nmanifest = json.loads(show(\"reports/evidence/G5/MANIFEST.json\"))\ncommit = record[\"commit\"]\nif subprocess.run([\"git\", \"merge-base\", \"--is-ancestor\", commit, head], cwd=repo).returncode:\n    errors.append(\"commit is not an ancestor of head\")\nafter = git(\"diff\", \"--name-only\", commit, head).splitlines()\nallowed = {f\"reports/evidence/G5/{TASK}.json\", f\"reports/evidence/G5/{TASK}.log\", \"reports/evidence/G5/MANIFEST.json\"}\nif set(after) - allowed:\n    errors.append(f\"non-evidence changes after commit: {sorted(set(after) - allowed)}\")\nfor path, recorded in record[\"inputs\"].items():\n    for ref in (commit, head):\n        actual = git(\"rev-parse\", f\"{ref}:inputs\") if path == \"inputs_tree\" else sha(show(path, ref))\n        if actual != recorded:\n            errors.append(f\"input mismatch {path} at {ref}\")\nif sha(raw) != record[\"raw_output_sha256\"]:\n    errors.append(\"raw_output_sha256 mismatch\")\nentries = [json.loads(line) for line in raw.decode(\"utf-8\").splitlines()]\nfor entry in entries:\n    if sha(entry[\"output\"].encode(\"utf-8\")) != entry[\"sha256\"]:\n        errors.append(f\"raw entry self-hash mismatch {entry['label']}\")\nMARKERS = {\n    \"red-module-absent\": (\"No module named 'ocor_runtime.memory.promotion'\", 1),\n    \"red-c6-consumer-absent\": (\"cannot import name 'C6MemoryPromotionConsumer'\", 1),\n    \"red-self-vouched-delegation\": (\"DID NOT RAISE\", 1),\n}\nfor key, digest in record[\"tdd\"][\"red_raw_sha256\"].items():\n    hit = [e for e in entries if e[\"label\"] == f\"tdd-{key}\"]\n    marker, minimum = MARKERS.get(key, (\"wrongly_classified_as_real_backend\" if key == \"repair1-evidence-classification\" else \"FAILED\", 1))\n    if len(hit) != 1 or hit[0][\"sha256\"] != digest or hit[0][\"output\"].count(marker) < minimum:\n        errors.append(f\"tdd {key} raw mismatch\")\nif record.get(\"repair_cycle\") != 1 or record[\"environment\"][\"branch\"] != \"task/OCOR-DEV-0058-memory-promotion-c6-c3\":\n    errors.append(\"repair cycle or branch mismatch\")\nobserved = {o[\"label\"]: o for o in record[\"observations\"]}\nfor entry in entries:\n    if entry[\"label\"] in observed and entry[\"sha256\"] != observed[entry[\"label\"]][\"raw_sha256\"]:\n        errors.append(f\"observation raw mismatch {entry['label']}\")\nif any(o[\"raw_sha256\"] not in {e[\"sha256\"] for e in entries} for o in observed.values()):\n    errors.append(\"observation without raw entry\")\nprevious = next(e for e in entries if e['label'] == 'previous-external-verdict')\nprior_verdict = json.loads(previous['output'])\nif sha(previous['output'].encode()) != record['repair_of']['verdict_sha256'] or prior_verdict['verdict'] != 'NO_GO' or prior_verdict['request_id'] != record['repair_of']['request_id']:\n    errors.append('previous verdict provenance mismatch')\nentries = [e for e in entries if not e[\"label\"].startswith(\"tdd-\") and e[\"label\"] not in observed]\nby_label = {}\nfor entry, command in zip(entries, record[\"commands\"], strict=True):\n    if entry[\"sha256\"] != command[\"raw_sha256\"] or entry[\"label\"] != command[\"label\"] or entry[\"exit_code\"] != command[\"exit_code\"]:\n        errors.append(f\"command/raw mismatch {entry['label']}\")\n    by_label[entry[\"label\"]] = entry\nif any(c[\"status\"] != \"PASS\" for c in record[\"commands\"]):\n    errors.append(\"a command is not PASS\")\nartifacts = {a[\"task_id\"]: a for a in manifest[\"artifacts\"]}\nif artifacts[TASK][\"sha256\"] != sha(record_bytes) or artifacts[f\"{TASK}-RAW\"][\"sha256\"] != sha(raw):\n    errors.append(\"manifest artifact hash mismatch\")\nbase_manifest = json.loads(show(\"reports/evidence/G5/MANIFEST.json\", BASE))\nfor key in (\"artifacts\", \"requirement_results\"):\n    if [e for e in manifest[key] if e[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")] != [e for e in base_manifest[key] if e[\"task_id\"] not in (TASK, f\"{TASK}-RAW\")]:\n        errors.append(f\"pre-existing manifest {key} not preserved\")\n\n\ndef outcomes(xml_text: str) -> dict[str, str]:\n    out = {}\n    for case in ET.fromstring(xml_text).iter(\"testcase\"):\n        bad = [c.tag for c in case if c.tag in (\"failure\", \"error\", \"skipped\")]\n        out[case.get(\"name\")] = \"PASS\" if not bad else bad[0].upper()\n    return out\n\n\ntree = ast.parse(show(\"ocor-runtime/tests/tasks/test_ocor_dev_0058.py\").decode())\nbackend_tests = {n.name for n in tree.body if isinstance(n, ast.FunctionDef) and n.name.startswith(\"test_\") and any(a.arg == \"backends\" for a in n.args.args)}\ntask = outcomes(by_label[\"task-junit\"][\"output\"])\nif not task or set(task.values()) != {\"PASS\"}:\n    errors.append(\"task junit not all PASS\")\nclaimed = set()\nfor result in record[\"requirement_results\"]:\n    if set(result[\"real_backend_tests\"]) != set(result[\"tests\"]) & backend_tests or set(result[\"unit_fixture_tests\"]) != set(result[\"tests\"]) - backend_tests:\n        errors.append(\"AST backend classification mismatch \" + result[\"case_id\"])\n    names = [n for n in task if re.sub(r\"\\[.*\", \"\", n) in set(result[\"tests\"])]\n    claimed.update(names)\n    if sum(1 for n in names if task[n] == \"PASS\") != result[\"result\"][\"passed\"] or len(names) != result[\"result\"][\"passed\"] or not result[\"real_backend_tests\"]:\n        errors.append(f\"case count mismatch {result['case_id']}\")\nif claimed != set(task):\n    errors.append(\"task tests not fully mapped\")\nfor label in (\"task-run-1\", \"task-run-2\", \"task-run-3\", \"task-validation-command-project\"):\n    result = next(c for c in record[\"commands\"] if c[\"label\"] == label).get(\"result\")\n    if result != {\"passed\": len(task), \"failed\": 0, \"skipped\": 0, \"not_executed\": 0}:\n        errors.append(f\"{label} counts mismatch {result}\")\nfull = ET.fromstring(by_label[\"full-suite-junit\"][\"output\"])\nsuites = [full] if full.tag == \"testsuite\" else list(full)\ntotals = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\nfull_cmd = next(c for c in record[\"commands\"] if c[\"label\"] == \"full-suite-junit\")\nif full_cmd[\"result\"] != {\"passed\": totals[\"tests\"] - totals[\"failures\"] - totals[\"errors\"] - totals[\"skipped\"], \"failed\": totals[\"failures\"] + totals[\"errors\"], \"skipped\": totals[\"skipped\"], \"not_executed\": 0} or totals[\"failures\"] or totals[\"errors\"] or totals[\"skipped\"]:\n    errors.append(f\"full-suite counts mismatch {totals}\")\ncampaign = json.loads(by_label[\"full-suite-campaign-result\"][\"output\"])\nif campaign.get(\"status\") != \"PASS\" or campaign.get(\"candidate_head\") != commit or campaign[\"counts\"][\"tests\"] != totals[\"tests\"]:\n    errors.append(\"full-suite campaign not PASS on the commit\")\nprobe = json.loads(by_label[\"mutation-probe-result\"][\"output\"])\nequivalent = {n for n, v in probe.items() if v[\"equivalent\"] and v[\"equivalence_reason\"]}\nif not probe or {n for n, v in probe.items() if not v[\"killed\"]} - equivalent:\n    errors.append(\"mutation survivor\")\nvalidator = subprocess.run([sys.executable, \"-c\", \"import subprocess,sys,tempfile,pathlib;\"\n    \"d=tempfile.mkdtemp();r=sys.argv[1];h=sys.argv[2];\"\n    \"[pathlib.Path(d,p).write_bytes(subprocess.check_output(['git','show',h+':reports/evidence/G5/'+p],cwd=r)) for p in ('MANIFEST.json','OCOR-DEV-0058.json','OCOR-DEV-0058.log')];\"\n    \"sys.exit(subprocess.run([sys.executable,r+'/scripts/validate_runtime_evidence.py','--task','OCOR-DEV-0058','--non-skipped','--manifest',d+'/MANIFEST.json']).returncode)\", str(repo), head])\nif validator.returncode:\n    errors.append(\"validate_runtime_evidence failed\")\nprint(json.dumps({\"head\": head, \"status\": \"FAIL\" if errors else \"PASS\", \"errors\": errors, \"full_suite\": totals, \"task_cases\": len(task), \"mutants\": len(probe)}, indent=2))\nsys.exit(1 if errors else 0)\n", "sha256": "0c24c988b1bcdb0462a859c0adbeaede22fcb6e09535eab948878c0a790beef9"}
{"command": "captured artifact: exact JUnit multiset check against collection at the frozen code HEAD", "exit_code": 0, "label": "exact-union-checker-script", "output": "import collections,hashlib,json,sys\nfrom pathlib import Path\nr=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-0058')\nsys.path.insert(0,str(r/'scripts'))\nimport run_qualifying_campaign as campaign\nq=Path(__file__).parent\ncollected=campaign.collect_nodeids(r/'ocor-runtime',['tests/'])\nwanted=collections.Counter(campaign.junit_identity(n) for n in collected)\nexecuted=collections.Counter(campaign.junit_cases(q/'full/runtime_junit_post_approval.xml'))\nassert wanted==executed,{'missing':len(wanted-executed),'extra':len(executed-wanted)}\nassert all(v==1 for v in executed.values()),'duplicate execution'\ncounts=campaign.check_junit(q/'full/runtime_junit_post_approval.xml')\nresult={'status':'PASS','collected':len(collected),'executed':sum(executed.values()),'missing':0,'extra':0,'duplicates':0,'counts':counts,'collected_sha256':campaign.collection_digest(collected),'executed_identity_digest':hashlib.sha256(json.dumps(sorted(executed)).encode()).hexdigest()}\n(q/'exact-junit-union.json').write_text(json.dumps(result,indent=2,sort_keys=True)+'\\n');print(json.dumps(result,sort_keys=True))\n", "sha256": "64663deff5a401853b5ed14cd98711d34fce7f247fa4160217a819a54905f1fe"}
{"command": "captured artifact: bounded task/mutation/full/CI waits; unchanged limits", "exit_code": 0, "label": "wait-contract", "output": "{\n  \"full_suite\": {\n    \"abort_on\": \"first restart/OOM/service crash\",\n    \"maximum_seconds\": 4500,\n    \"notification_threshold_seconds\": 3600,\n    \"poll_seconds\": 60\n  },\n  \"iteration_limit_seconds\": 18000,\n  \"mutation\": {\n    \"maximum_seconds\": 1800,\n    \"poll_seconds\": 30\n  },\n  \"state_ci\": {\n    \"maximum_seconds\": 5400,\n    \"poll_seconds\": 60,\n    \"required_checks\": \"13 by name, exact HEAD\"\n  },\n  \"task_suite\": {\n    \"maximum_seconds\": 2700,\n    \"poll_seconds\": 30\n  }\n}\n", "sha256": "9f187b7108f2cd2ecba79adeb3c32ecce1c7305e0fb9e1f73a797cccd4a48d62"}
