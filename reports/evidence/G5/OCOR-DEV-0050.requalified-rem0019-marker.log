{"command": "captured artifact", "exit_code": 0, "label": "reserve-coordination-finish.py", "output": "\"\"\"Close the REM-0019 fresh campaign after the resumed phases (reserve implementer Claude Code).\n\nMechanically re-applies the post-phase checks of the frozen driver.py (same check_run,\nexact executed order, 119 isolated) on the archived results of the same commit, then the\nsame final teardown as driver.py's finally block, and writes driver-result.json from the\nreal results. It never runs tests. Coordination note: driver.py (pid 72060) died with the\nCodex session after the full run and the first two orders; the remaining phases ran from\nthe unchanged modules.py/campaign.py/run_nodes.py (see chain.progress).\n\"\"\"\nimport json, os, subprocess, sys, time, xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\nH = Path(__file__).parent\nD = Path('/home/luca/.ocor-codex/rem0019-resume-20261013-kind-fixed')\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nPY = str(R / 'ocor-runtime/.venv/bin/python')\nLABELS = ['order-collection', 'order-reverse', 'order-seed-190001', 'order-seed-190002', 'order-seed-190003']\nenv = os.environ.copy()\nenv.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:' + env['PATH'])\nHEAD = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\ndef dump(name, obj): (D / name).write_text(json.dumps(obj, indent=2, sort_keys=True) + '\\n')\ndef resources():\n    return {k: sorted(subprocess.check_output(['docker', *v], text=True, timeout=30).split()) for k, v in {\n        'containers': ['ps', '-aq', '--no-trunc'], 'networks': ['network', 'ls', '-q', '--no-trunc'], 'volumes': ['volume', 'ls', '-q']}.items()}\ndef identity(n):\n    path, *parts = n.removeprefix('ocor-runtime/').split('::')\n    return ('.'.join([path[:-3].replace('/', '.'), *parts[:-1]]), parts[-1])\ndef check_run(label, nodes):\n    meta = json.loads((D / (label + '.json')).read_text())\n    assert meta['head_sha'] == HEAD and not meta['watchdog_error'], label\n    assert meta['counts'] == dict(tests=len(nodes), failures=0, errors=0, skipped=0), label\n    cases = list(ET.parse(D / (label + '.xml')).getroot().iter('testcase'))\n    assert Counter(map(identity, nodes)) == Counter((c.get('classname'), c.get('name')) for c in cases), 'JUnit union ' + label\n    return meta\nprev = json.loads((D / 'driver-result.json').read_text())\nresult = {'status': 'RUNNING', 'head_sha': HEAD, 'repair_cycle': 1, 'full': prev['full'],\n          'coordination': {'driver_pid_72060': 'terminated with the Codex implementer session at 2026-10-13T18:31:50Z after full + order-collection + order-reverse',\n                           'resumed_phases': 'modules.py order-seed-190001 order-seed-190002 order-seed-190003; campaign.py isolated (unchanged primitives)',\n                           'chain_progress': (H / 'chain.progress').read_text(),\n                           'diagnostic_attempts': ['attempts/order-seed-190001/attempt-1 (orphaned by coordinator death)'],\n                           'closed_by': 'finish.py (reserve implementer Claude Code), same checks as driver.py post-phase'}}\ntry:\n    assert not subprocess.check_output(['git', 'status', '--porcelain'], cwd=R, text=True), 'dirty source'\n    assert HEAD == prev['head_sha'] and prev['full']['status'] == 'PASS'\n    assert (D / 'modules.done').read_text() == 'PASS\\n' and (D / 'isolated.done').read_text() == 'PASS\\n'\n    rows = [json.loads(l) for l in (D / 'modules.progress').read_text().splitlines()]\n    assert [r['label'] for r in rows] == LABELS and all(r['ok'] for r in rows), rows\n    for label in LABELS:\n        ordered = (D / (label + '.order')).read_text().splitlines()\n        check_run(label, ordered)\n        executed = [c.get('name') for c in ET.parse(D / (label + '.xml')).getroot().iter('testcase')]\n        assert executed == [n.split('::', 1)[1] for n in ordered], label + ' order mismatch'\n    isolated = (D / 'isolated.txt').read_text().splitlines()\n    assert len(isolated) == 119 and len(set(isolated)) == 119\n    for i, n in enumerate(isolated, 1): check_run(f'iso-{i:03d}', [n])\n    irows = [json.loads(l) for l in (D / 'isolated.progress').read_text().splitlines()]\n    assert len(irows) == 119 and all(r['ok'] for r in irows)\n    result['status'] = 'PASS'\nexcept Exception as e:\n    result.update(status='FAIL', error=str(e))\nfinally:\n    with (D / 'teardown.log').open('w') as f:\n        r = subprocess.run([PY, 'scripts/reset_test_environment.py', '--execute', '--env-file', str(R / '.ocor/bootstrap.env')], cwd=R, env=env, stdout=f, stderr=subprocess.STDOUT, timeout=600)\n    result['teardown_exit_code'] = r.returncode\n    dump('session-resources-after.json', resources())\n    after = {k: sorted(subprocess.check_output(c, text=True, timeout=30).split()) for k, c in [('containers', ['docker', 'ps', '-aq']), ('volumes', ['docker', 'volume', 'ls', '-q']), ('networks', ['docker', 'network', 'ls', '-q'])]}  # same form as prepare.py inventory\n    kind = subprocess.run(['docker', 'inspect', 'ocor-poc-control-plane'], capture_output=True, text=True)\n    owned = subprocess.check_output(['docker', 'ps', '-aq', '--filter', 'label=com.docker.compose.project=ocor-bootstrap'], text=True).split()\n    base = json.loads((D / 'preflight-1' / 'resources-before.json').read_text())\n    new = {k: sorted(set(after[k]) - set(base[k])) for k in base}\n    result['final_inventory'] = {'baseline': 'preflight-1/resources-before.json (session start, before the first stack)', 'new_resources': new,\n                                 'owned_compose_containers': owned, 'kind_node_present': kind.returncode == 0}\n    if r.returncode or owned or kind.returncode == 0 or any(new.values()): result['status'] = 'FAIL'\n    dump('driver-result.json', result)\nprint(json.dumps({k: v for k, v in result.items() if k != 'coordination'}, indent=2, sort_keys=True))\nsys.exit(0 if result['status'] == 'PASS' else 1)\n", "sha256": "db1931f37498e21d170f34f3c89e7bd8d849a0806bb63654474472488d812c2c"}
{"command": "captured artifact", "exit_code": 0, "label": "reserve-coordination-archive_components.py", "output": "\"\"\"Read-only campaign observation; --execute copies closed valid run artifacts.\nNo commands, environment, timing or test execution of the frozen harness change.\n\"\"\"\nimport argparse,hashlib,json,shutil\nfrom pathlib import Path\np=argparse.ArgumentParser();p.add_argument('--execute',action='store_true');a=p.parse_args()\nC=Path('/home/luca/.ocor-codex/rem0019-resume-20261013-kind-fixed');HEAD='6e1c4b050ac610a22673d6f559e424a01705189c';rows=[]\nfor progress in ['modules.progress','isolated.progress']:\n path=C/progress\n if not path.exists():continue\n for line in path.read_text().splitlines():\n  r=json.loads(line)\n  if not r['ok']:continue\n  label=r['label'];assert label.startswith(('order-','iso-'))\n  meta=json.loads((C/(label+'.json')).read_text());assert meta['head_sha']==HEAD and not meta['watchdog_error'] and meta['exit_code']==0\n  assert not any(meta['counts'][k] for k in ['failures','errors','skipped']);assert not any(r['residue'].values())\n  attempt='attempt-2' if label=='order-seed-190001' else 'attempt-1';dest=C/'attempts'/label/attempt\n  names=[label+s for s in ['.json','.xml','.log','.order','-residue.json']]\n  if (C/(label+'-alignment.json')).exists():names.append(label+'-alignment.json')\n  names.append('harness-identity.json')\n  if a.execute:\n   dest.mkdir(parents=True,exist_ok=True)\n   for n in names:\n    if (dest/n).exists():assert (dest/n).read_bytes()==(C/n).read_bytes(),n\n    else:shutil.copy2(C/n,dest/n)\n   out={'label':label,'status':'PASS_COMPONENT_ONLY','valid_attempt':attempt,'head_sha':HEAD,'counts':meta['counts'],'duration_seconds':meta['duration_seconds'],'raw_sha256':{n:hashlib.sha256((dest/n).read_bytes()).hexdigest() for n in names},'residue':r['residue'],'campaign_status':'Complete only when all required components and final teardown PASS.'}\n   (dest/'result.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\\n')\n  rows.append({'label':label,'counts':meta['counts'],'duration_seconds':meta['duration_seconds']})\nprint(json.dumps({'operation':'ARCHIVE' if a.execute else 'DRY_RUN','completed':rows},sort_keys=True))\n", "sha256": "9e367ed52064f2ab28f30422f6013494fd93d71144cca98654ec15807396e861"}
