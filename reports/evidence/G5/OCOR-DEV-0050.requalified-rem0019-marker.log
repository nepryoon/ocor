{"command": "captured artifact", "exit_code": 0, "label": "assurance-assertion_identity.py", "output": "\"\"\"REM-0019: the 390 collected cases and every assertion are unchanged.\nCompares, per test function, the multiset of assert statements (ast.unparse) of the\nsealed candidate and of the remediation; the only admitted rewrite is the renaming of the\nobserved carrier/vault object (stack.ops -> ops, stack.vault -> vault) in the tests that now\nobserve their own carrier or vault. Cycle 1 (verdict OCOR-DEV-REM-0019-9099f7b6a677-0, VF-001):\nthe precondition wait_for of test_concurrent_seals_each_download_their_own_index_snapshot\nno longer counts a raised POST as a snapshot name; that single rewrite is admitted explicitly\nand reported under \"admitted_precondition_rewrite\". Marker cycle (PO REM-0019-BACKUP-CIPHERTEXT-MARKER,\n2026-10-11, option 1, derogation for this check only): in test_backup_seals_an_encrypted_signed_immutable_recovery_point\nthe two lexical assertions on the ciphertext blob are replaced by the structural oracle helpers; that exact\nreplacement is admitted and reported under \"admitted_marker_replacement\". Prints a JSON report; exit 1 on any other difference.\"\"\"\nimport ast, json, subprocess, sys\nfrom collections import Counter\nrepo, old_rev, new_rev = sys.argv[1], sys.argv[2], sys.argv[3]\nPATH = \"ocor-runtime/tests/tasks/test_ocor_dev_0049.py\"\ndef source(rev):\n    return subprocess.check_output([\"git\", \"show\", f\"{rev}:{PATH}\"], cwd=repo, text=True)\ndef asserts(src):\n    out = {}\n    for node in ast.walk(ast.parse(src)):\n        if isinstance(node, ast.FunctionDef):\n            items = [ast.unparse(n) for n in ast.walk(node) if isinstance(n, ast.Assert)]\n            # pytest.raises / pytest.fail and the asserting helpers called by the test are assertions too\n            items += [ast.unparse(n) for n in ast.walk(node) if isinstance(n, ast.Call)\n                      and ast.unparse(n.func) in (\"pytest.fail\", \"pytest.raises\", \"wait_for\", \"assert_admission\",\n                                                      \"_observe_refused_receipt\", \"governed_reopen\", \"assert_sealed\",\n                                                      \"_exercise_encrypted_backup_oracle\", \"_assert_encrypted_backup_artifact\",\n                                                      \"_assert_backup_plaintext_sources\", \"_kill_plaintext_backup_mutant\")]\n            out[node.name] = Counter(items)\n    return out\nADMITTED = {\"test_concurrent_seals_each_download_their_own_index_snapshot\": (\n    \"wait_for(lambda: (n := concurrently(naive_name)) and len(set(n)) < len(n) and n, 60, 1, 'precondition: concurrent snapshots share a name')\",\n    \"wait_for(colliding_names, 60, 1, 'precondition: concurrent snapshots share a name')\")}\nMARKER_TEST = \"test_backup_seals_an_encrypted_signed_immutable_recovery_point\"\nMARKER_REMOVED = Counter([\n    \"assert b'PGDMP' not in blob and b'tenant-a' not in blob and (b'evt-del' not in blob)\",\n    \"assert all((c.startswith('vault:v1:') for c in json.loads(blob)['chunks']))\"])\nMARKER_ADDED = Counter([\n    \"_exercise_encrypted_backup_oracle(stack.env)\",\n    \"_assert_encrypted_backup_artifact(blob, artifact, stack.env)\",\n    \"_assert_backup_plaintext_sources(plaintexts)\",\n    \"_kill_plaintext_backup_mutant(stack)\"])\nRENAMES = [(\"stack.ops\", \"ops\"), (\"stack.vault\", \"vault\")]\ndef normal(counter):\n    c = Counter()\n    for k, v in counter.items():\n        for a, b in RENAMES:\n            k = k.replace(a, b)\n        c[k] += v\n    return c\nold, new = asserts(source(old_rev)), asserts(source(new_rev))\ntests = sorted(n for n in old if n.startswith(\"test_\"))\nreport = {\"tests_compared\": len(tests), \"identical\": [], \"identical_after_rename\": [], \"different\": {},\n          \"admitted_precondition_rewrite\": [], \"admitted_marker_replacement\": [], \"new_helpers_or_fixtures\": sorted(set(new) - set(old)), \"removed\": sorted(set(old) - set(new))}\nfor t in tests:\n    if t not in new:\n        report[\"different\"][t] = \"removed\"\n    elif old[t] == new[t]:\n        report[\"identical\"].append(t)\n    elif normal(old[t]) == normal(new[t]):\n        report[\"identical_after_rename\"].append(t)\n    elif t in ADMITTED and old[t] - new[t] == Counter([ADMITTED[t][0]]) and new[t] - old[t] == Counter([ADMITTED[t][1]]):\n        report[\"admitted_precondition_rewrite\"].append({\"test\": t, \"old\": ADMITTED[t][0], \"new\": ADMITTED[t][1]})\n    elif t == MARKER_TEST and old[t] - new[t] == MARKER_REMOVED and new[t] - old[t] == MARKER_ADDED:\n        report[\"admitted_marker_replacement\"].append({\"test\": t, \"removed\": sorted(MARKER_REMOVED.elements()),\n                                                      \"added\": sorted(MARKER_ADDED.elements())})\n    else:\n        report[\"different\"][t] = {\"only_old\": sorted((old[t] - new[t]).elements()), \"only_new\": sorted((new[t] - old[t]).elements())}\nreport[\"counts\"] = {k: len(report[k]) for k in (\"identical\", \"identical_after_rename\", \"admitted_precondition_rewrite\", \"admitted_marker_replacement\", \"different\")}\nprint(json.dumps(report, indent=2, sort_keys=True))\nsys.exit(1 if report[\"different\"] or report[\"removed\"] else 0)\n", "sha256": "d6a7f1e3280583c904947a83465a97d05e0d208f290981bc9721b79d2af0e239"}
