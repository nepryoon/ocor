{"command": "captured artifact", "exit_code": 0, "label": "assurance-qualification_reports.py", "output": "\"\"\"CI-linked documentary/tooling regression; no backend stack is created or used.\"\"\"\nimport hashlib\nimport json\nimport os\nimport subprocess\nimport time\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\nD = Path(__file__).parent\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')\nPY = str(R.parent / 'rem-0019/ocor-runtime/.venv/bin/python')\nenv = os.environ.copy()\nenv['PATH'] = str(Path(PY).parent) + ':/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:' + env['PATH']\nenv.update(GIT_PAGER='cat', PAGER='cat', GH_PROMPT_DISABLED='1', GIT_EDITOR='true')\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=R, text=True).strip()\nassert not subprocess.check_output(['git', 'status', '--porcelain'], cwd=R, text=True)\ntests = ['test_generate_contracts_reference_resolution.py', 'test_language_migration_benchmark_harness.py',\n         'test_backlog_generator_reality_parity.py', 'test_runtime_evidence_validator.py', 'test_evidence_input_drift.py']\ncommands = [('sdk-provision', ['timeout', '180', 'npm', '--prefix', 'ocor-runtime/sdk/typescript', 'ci', '--ignore-scripts', '--no-audit', '--no-fund']),\n            ('sdk-build', ['timeout', '180', 'npm', '--prefix', 'ocor-runtime/sdk/typescript', 'run', 'build']),\n            ('reports-pytest', [PY, '-m', 'pytest', '-q', '-ra', '-p', 'no:cacheprovider',\n            '--junitxml=' + str(D / 'qualification-reports.xml'), *['reports/tests/' + t for t in tests]])]\ncommands += [(p.removesuffix('.py'), [PY, 'reports/tests/' + p]) for p in\n             ('test_v12_candidate.py', 'test_v12_semantics.py', 'test_v12_release_gate.py',\n              'test_v12_approval_readiness.py', 'validate_openapi_governed.py')]\nresults = []\ntry:\n    for label, cmd in commands:\n        path = D / ('qualification-' + label + '.log')\n        started = time.monotonic()\n        with path.open('w') as log:\n            run = subprocess.run(cmd, cwd=R, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n        row = {'label': label, 'command': cmd, 'exit_code': run.returncode,\n               'duration_seconds': round(time.monotonic() - started, 2),\n               'raw_sha256': hashlib.sha256(path.read_bytes()).hexdigest(), 'log': path.name}\n        if label == 'reports-pytest':\n            suites = list(ET.parse(D / 'qualification-reports.xml').getroot().iter('testsuite'))\n            row['counts'] = {k: sum(int(s.get(k, 0)) for s in suites) for k in ('tests', 'failures', 'errors', 'skipped')}\n        results.append(row)\n        print(label, run.returncode, flush=True)\nfinally:\n    # Restore only generated, tracked report outputs; never alter source or evidence.\n    changed = subprocess.check_output(['git', 'diff', '--name-only'], cwd=R, text=True).splitlines()\n    assert all(p.startswith('reports/tests/') for p in changed), changed\n    for p in changed:\n        (D / ('qualification-generated-' + Path(p).name)).write_bytes((R / p).read_bytes())\n    if changed:\n        subprocess.run(['git', 'restore', '--', *changed], cwd=R, check=True)\nok = all(r['exit_code'] == 0 and not any(r.get('counts', {}).get(k, 0) for k in ('failures', 'errors', 'skipped')) for r in results)\nassert len(results) == len(commands)\n(D / 'qualification-reports.json').write_text(json.dumps({'status': 'PASS' if ok else 'FAIL',\n    'head_sha': head, 'results': results, 'generated_reports_restored': changed}, indent=2, sort_keys=True) + '\\n')\nraise SystemExit(not ok)\n", "sha256": "7a70f0e354b821e32cc30d77bb78c417a36fefdb61cb60b3d70ddbd757263f61"}
{"command": "captured artifact", "exit_code": 0, "label": "assurance-assemble.py", "output": "\"\"\"Assemble only after the entire fresh serial campaign has passed.\n\nThis is local evidence tooling, not an independent review or a repository gate.\nCounts, unions and outcomes are derived from archived JUnit, never supplied by hand.\n\"\"\"\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nD = Path(__file__).parent\nC = D.parent / 'rem0019-resume-20261013-kind-fixed'\nR = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')\nSOURCE = '6e1c4b050ac610a22673d6f559e424a01705189c'\nBASE = 'df444af855e884d7783612b302e008b90105fe13'\nTEST = 'ocor-runtime/tests/tasks/test_ocor_dev_0049.py'\nREM = 'reports/assurance/OCOR-DEV-REM-0019-RCCAD/OCOR-DEV-REM-0019.r1-marker.json'\nREQ = 'reports/evidence/G4/OCOR-DEV-0049.requalified-rem0019-r1-marker.json'\nMEM = 'reports/evidence/G5/OCOR-DEV-0050.requalified-rem0019-marker.json'\nLABELS = ['order-collection', 'order-reverse', 'order-seed-190001', 'order-seed-190002', 'order-seed-190003']\n\n\ndef sha(b):\n    return hashlib.sha256(b).hexdigest()\n\n\ndef git(*args):\n    return subprocess.check_output(['git', *args], cwd=R, text=True).strip()\n\n\ndef at(ref, path):\n    return subprocess.check_output(['git', 'show', f'{ref}:{path}'], cwd=R)\n\n\ndef dump(path, obj):\n    path.write_text(json.dumps(obj, indent=2, sort_keys=True) + '\\n')\n\n\ndef identity(node):\n    path, *parts = node.removeprefix('ocor-runtime/').split('::')\n    return ('.'.join([path[:-3].replace('/', '.'), *parts[:-1]]), parts[-1])\n\n\ndef xml_cases(path):\n    root = ET.parse(path).getroot()\n    cases = list(root.iter('testcase'))\n    assert not any(child.tag in ('failure', 'error', 'skipped') for case in cases for child in case), path\n    return cases\n\n\nresult = json.loads((C / 'driver-result.json').read_text())\nassert result['status'] == 'PASS' and result['head_sha'] == SOURCE\nassert result['teardown_exit_code'] == 0\nassert not result.get('duration_po_decision_required')\nassert not git('status', '--porcelain')\nassert subprocess.run(['git', 'merge-base', '--is-ancestor', SOURCE, 'HEAD'], cwd=R).returncode == 0\nfor root in ['deploy', 'infra', 'inputs', 'ocor-runtime/src', 'ocor-runtime/tests', 'ocor-runtime/tools', 'ocor-runtime/sdk']:\n    assert git('rev-parse', f'{SOURCE}:{root}') == git('rev-parse', f'HEAD:{root}'), root\nassert at(SOURCE, 'scripts/validate_ocor_development_plan.py') == at('HEAD', 'scripts/validate_ocor_development_plan.py')\nreport = json.loads((D / 'qualification-reports.json').read_text())\nassert report['status'] == 'PASS' and len(report['results']) == 8\nassert all(r['exit_code'] == 0 for r in report['results'])\nassert next(r['counts'] for r in report['results'] if r['label'] == 'reports-pytest') == dict(tests=48, failures=0, errors=0, skipped=0)\nassert json.loads((D / 'assertion-identity.json').read_text())['different'] == {}\n\nsecrets = {}\nfor f in [R.parent / 'rem-0019/.ocor/bootstrap.env', R.parent.parent.parent / '.ocor/bootstrap.env']:\n    if f.exists():\n        secrets.update({k: v for k, v in (l.split('=', 1) for l in f.read_text().splitlines() if '=' in l)\n                        if ('PASSWORD' in k or 'TOKEN' in k) and len(v) >= 8})\nentries = []\nattempt_ledger = []\n\n\ndef raw(label, path, command='captured artifact', exit_code=0):\n    text = path.read_text()\n    for value in secrets.values():\n        text = text.replace(value, '[REDACTED_LOCAL_CREDENTIAL]')\n    text = re.sub(r'postgresql://ocor:[REDACTED]@\\s]+@', 'postgresql://ocor:[REDACTED]@', text)\n    digest = sha(text.encode())\n    entries.append(dict(label=label, command=command, exit_code=exit_code, sha256=digest, output=text))\n    return digest\n\n\ndef acquire_run(label, nodes, limit):\n    meta = json.loads((C / (label + '.json')).read_text())\n    assert meta['head_sha'] == SOURCE and meta['exit_code'] == 0 and meta['watchdog_error'] is None\n    assert meta['counts'] == dict(tests=len(nodes), failures=0, errors=0, skipped=0)\n    assert meta['duration_seconds'] <= limit\n    cases = xml_cases(C / (label + '.xml'))\n    assert Counter(identity(n) for n in nodes) == Counter((c.get('classname'), c.get('name')) for c in cases)\n    archive = C / 'attempts' / label\n    attempt = 2 if label == 'order-seed-190001' else 1\n    valid = archive / f'attempt-{attempt}'\n    summary = json.loads((valid / 'result.json').read_text())\n    assert summary['status'] == 'PASS_COMPONENT_ONLY' and summary['head_sha'] == SOURCE\n    assert summary['valid_attempt'] == f'attempt-{attempt}' and summary['counts'] == meta['counts']\n    for name, digest in summary['raw_sha256'].items():\n        assert sha((valid / name).read_bytes()) == digest, (label, name)\n        assert (valid / name).read_bytes() == (C / name).read_bytes(), (label, name)\n    attempts = dict(label=label, valid_attempt=attempt, archive_path=str(valid), result_sha256=sha((valid / 'result.json').read_bytes()), raw_sha256=summary['raw_sha256'], diagnostic_attempts=[])\n    if attempt == 2:\n        diagnostic = archive / 'attempt-1'\n        diagnosis = json.loads((diagnostic / 'diagnosis.json').read_text())\n        assert diagnosis['qualified_attempt'] is False and diagnosis['counts_in_qualification_totals'] is False\n        assert diagnosis['head_sha'] == SOURCE and diagnosis['junit_counts_observed'] == dict(tests=390, failures=0, errors=0, skipped=0)\n        for name, digest in diagnosis['raw_sha256'].items():\n            assert sha((diagnostic / name).read_bytes()) == digest, name\n        attempts['diagnostic_attempts'].append(dict(path=str(diagnostic), diagnosis=diagnosis, diagnosis_sha256=sha((diagnostic / 'diagnosis.json').read_bytes()), qualifying=False))\n        raw('diagnostic-' + label + '-attempt-1-diagnosis', diagnostic / 'diagnosis.json', exit_code=130)\n    attempt_ledger.append(attempts)\n    raw(label + '-attempt-result', valid / 'result.json')\n    row = dict(label=label, valid_attempt=attempt, command=' '.join(meta['command']), status='PASS', exit_code=0,\n               head_sha=SOURCE, started_at=meta['started_at'], finished_at=meta['finished_at'],\n               duration_seconds=meta['duration_seconds'], result=dict(passed=len(nodes), failed=0, skipped=0, not_executed=0),\n               raw_sha256=raw(label, C / (label + '.log'), ' '.join(meta['command'])),\n               junit_sha256=raw(label + '-junit', C / (label + '.xml')),\n               metadata_sha256=raw(label + '-metadata', C / (label + '.json')))\n    return row, cases\n\n\nnodes = json.loads((C / 'full-collected.json').read_text())\nassert len(nodes) == len(set(nodes)) == 2224\nfull, full_cases = acquire_run('full', nodes, 4500)\nfull['label'] = 'full-runtime'\nassert json.loads((C / 'full-resource-audit.json').read_text())['status'] == 'PASS'\nmodule_nodes = [n for n in nodes if 'test_ocor_dev_0049.py::' in n]\nassert len(module_nodes) == 390\nfull_mem = [c for c in full_cases if c.get('classname') == 'tests.tasks.test_ocor_dev_0050']\nassert len(full_mem) == 198\nmodule_rows = []\nper_function = Counter()\nfor label in LABELS:\n    ordered = (C / (label + '.order')).read_text().splitlines()\n    assert Counter(n.removeprefix('ocor-runtime/') for n in ordered) == Counter(n.removeprefix('ocor-runtime/') for n in module_nodes)\n    row, cases = acquire_run(label, ordered, 2700)\n    assert [c.get('name') for c in cases] == [n.split('::', 1)[1] for n in ordered]\n    residue = json.loads((C / (label + '-residue.json')).read_text())\n    assert not any(residue.values())\n    row['residue'] = residue\n    row['order_sha256'] = raw(label + '-order', C / (label + '.order'))\n    row['start_alignment'] = json.loads((C / (label + '-alignment.json')).read_text())\n    row['alignment_sha256'] = raw(label + '-alignment', C / (label + '-alignment.json'))\n    module_rows.append(row)\n    per_function.update(c.get('name').split('[', 1)[0] for c in cases)\nisolated = []\niso_nodes = (C / 'isolated.txt').read_text().splitlines()\nassert len(iso_nodes) == len(set(iso_nodes)) == 119\nfor i, node in enumerate(iso_nodes, 1):\n    label = f'iso-{i:03d}'\n    row, _ = acquire_run(label, [node], 900)\n    residue = json.loads((C / (label + '-residue.json')).read_text())\n    assert not any(residue.values())\n    row.update(node=node, residue=residue)\n    isolated.append(row)\n\nartifacts = {}\nfor folder, names, prefix in [\n    (C, ['driver-result.json', 'driver.py', 'run_nodes.py', 'modules.py', 'campaign.py', 'prepare.py',\n         'driver.progress', 'modules.progress', 'isolated.progress', 'toolchain.json', 'stack-summary.json',\n         'health.json', 'resource-profile.json', 'preflight-result.json', 'preflight-commands.json',\n         'full-collected.json', 'full-resources-before.json', 'full-resources-after.json', 'full-resource-audit.json',\n         'resources-before.json', 'session-resources-after.json', 'teardown.log', 'isolated.txt',\n         'watchdog_safe.py', 'test_teardown_observation_v2.py', 'green-teardown-v2.log', 'harness-identity.json'], 'campaign-'),\n    (D, ['assertion-identity.json', 'assertion_identity.py', 'qualification-reports.json',\n         'qualification-reports.xml', 'qualification_reports.py', 'assemble.py', 'check.py',\n         'node-image-proof.json', 'containerd-go-version-m.log', 'go-tool-proof.json',\n         'test_fixture_cleanup.py', 'probe_fixture_live.py', 'fixture-red.log', 'fixture-green.log',\n         'fixture-live-red.json', 'fixture-live-green.json', 'fixture-live-green-stable.json',\n         'fixture-green-pinned312.log', 'fixture-live-proof-summary.json',\n         'task-stage-tree-equivalence.json', 'governed-stage-tree-equivalence.json',\n         'go-fix-source-proof.json', 'go1244-proc-reference.tx