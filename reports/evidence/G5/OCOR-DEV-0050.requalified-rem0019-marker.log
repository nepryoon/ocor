s_an_encrypted_signed_immutable_recovery_point\\\",\\n \\\"restore\\\": \\\"test_isolated_restore_replays_tombstones_and_passes_the_recovery_gate\\\",\\n \\\"ready\\\": \\\"test_readiness_turns_ready_only_with_a_signed_passed_restore_receipt\\\",\\n \\\"reopen\\\": \\\"test_mutative_path_reopens_only_by_a_human_bound_to_the_passed_receipt\\\",\\n \\\"replay\\\": \\\"test_restore_replay_is_deterministic\\\",\\n \\\"fault\\\": \\\"test_dependency_fault_blocks_readiness_and_degrades_posture[qdrant]\\\",\\n \\\"estop\\\": \\\"test_emergency_stop_denies_mutative_capabilities_within_10_seconds\\\",\\n \\\"publicdep\\\": \\\"test_public_network_dependency_prevents_the_process_from_starting\\\",\\n \\\"logs\\\": \\\"test_logs_and_traces_carry_governed_fields_and_no_secrets\\\",\\n \\\"coherent\\\": \\\"test_custodian_signed_coherent_receipt_is_accepted\\\",\\n}\\nGROUPS = {\\n \\\"ready-alone\\\": [\\\"ready\\\"],\\n \\\"publicdep-alone\\\": [\\\"publicdep\\\"],\\n \\\"logs-alone\\\": [\\\"logs\\\"],\\n \\\"estop-alone\\\": [\\\"estop\\\"],\\n \\\"fault-alone\\\": [\\\"fault\\\"],\\n \\\"coherent-alone\\\": [\\\"coherent\\\"],\\n \\\"untested-after-restore\\\": [\\\"backup\\\", \\\"restore\\\", \\\"untested\\\"],\\n \\\"reopen-after-replay\\\": [\\\"backup\\\", \\\"restore\\\", \\\"replay\\\", \\\"reopen\\\"],\\n}\\nif __name__ == \\\"__main__\\\":\\n    group = sys.argv[2]\\n    print(\\\"\\\\n\\\".join(f\\\"{M}::{T[k]}\\\" for k in GROUPS[group]))\\n\", \"sha256\": \"ca77e24a27131afe459ad46d1e997902a677b900bfb80a103e4d57b0241b1b61\"}\n{\"command\": \"captured artifact: gates.py\", \"exit_code\": 0, \"label\": \"artifact-gates.py\", \"output\": \"\\\"\\\"\\\"REM-0019 local gates on a clean worktree; files rewritten by validators are restored.\\nUsage: gates.py <tag>   (writes gates[-tag].json and gate-<tag>-<name>.log)\\\"\\\"\\\"\\nimport json, os, subprocess, sys\\nfrom pathlib import Path\\nout = Path(__file__).parent\\nrepo = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\\ntag = sys.argv[1]\\nBASE = 'df444af855e884d7783612b302e008b90105fe13'\\nBRANCH = 'governed/ocor-dev-rem-0019-0049-test-isolation'\\nenv = os.environ.copy()\\nenv['PATH'] = f\\\"{repo}/ocor-runtime/.venv/bin:/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:\\\" + env['PATH']\\npy = str(repo / 'ocor-runtime/.venv/bin/python')\\nGATES = [\\n    ('inputs', ['sha256sum', '-c', 'inputs/normative/SHA256SUMS'], None),\\n    ('ruff', ['ruff', 'check', '.'], 'ruff 0.13.1 of the locked environment'),\\n    ('mypy', [py, '-m', 'mypy', '--strict'], None),\\n    ('language', [py, 'scripts/validate_language_policy.py'], None),\\n    ('rccad', [py, 'scripts/validate_rccad.py', '--base-ref', BASE], 'base = sealed 0049 candidate (branch root)'),\\n    ('scope', [py, 'scripts/validate_ocor_change_scope.py', '--base', BASE, '--branch', BRANCH], None),\\n    ('plan', [py, 'scripts/validate_ocor_development_plan.py', '--authorized-extension', '--base-ref', 'HEAD'],\\n     'as on task branches (--base-ref HEAD); the governed-PR allowlist of the new assurance paths is an integration-time step (residual risk)'),\\n    ('drift', [py, 'scripts/validate_evidence_input_drift.py'], None),\\n    ('runtime-evidence', [py, 'scripts/validate_runtime_evidence.py', '--task', 'OCOR-DEV-0049', '--manifest',\\n                          'reports/evidence/G4/MANIFEST.json', '--non-skipped'], None),\\n    ('verify-harness', [py, 'scripts/verify.py', '--json'], None),\\n]\\nresults = []\\nfor name, cmd, note in GATES:\\n    log = out / f'gate-{tag}-{name}.log'\\n    r = subprocess.run(cmd, cwd=repo, env=env, capture_output=True, text=True, timeout=900)\\n    log.write_text(r.stdout + r.stderr)\\n    results.append({'label': name, 'command': ' '.join(cmd), 'exit_code': r.returncode, 'log': log.name,\\n                    **({'note': note} if note else {})})\\n    print(name, r.returncode, flush=True)\\nrestored = subprocess.run(['git', 'status', '--porcelain'], cwd=repo, capture_output=True, text=True).stdout\\nsubprocess.run(['git', 'checkout', '--', 'reports/verify_report.json', 'reports/planning/'], cwd=repo, capture_output=True)\\nfor results_file in ['reports/tests/c5_openapi_validation_results.json', 'reports/tests/openapi_31_validation_results.json',\\n                     'reports/tests/v12_approval_readiness_results.json']:\\n    subprocess.run(['git', 'checkout', '--', results_file], cwd=repo, capture_output=True)\\n(out / f'gates-{tag}.json').write_text(json.dumps({'gates': results, 'porcelain_before_restore': restored,\\n                                                    'porcelain_after_restore': subprocess.run(['git', 'status', '--porcelain'], cwd=repo, capture_output=True, text=True).stdout},\\n                                                   indent=2, sort_keys=True) + '\\\\n')\\n\", \"sha256\": \"2bf694bf47d979ea001d9acb06d70e66899c0852e742b5391cbdf156aa532fac\"}\n{\"command\": \"captured artifact: check_evidence.py\", \"exit_code\": 0, \"label\": \"artifact-check_evidence.py\", \"output\": \"\\\"\\\"\\\"Recompute the derived fields of the OCOR-DEV-REM-0019 evidence from a repository HEAD.\\n\\nUsage: check_evidence.py <repo> <head>\\nREM record and 0049 requalification: same commit (ancestor of HEAD; only evidence outputs\\nchange after it); the commit changes only the 0049 test module w.r.t. the sealed candidate;\\ninput hashes and inputs tree at commit and HEAD; identical raw bytes beside both records and\\nraw digest; every JSONL entry self-hash; every recorded raw_sha256 present in the raw log;\\nmodule runs: 390 PASS each, executed order == requested order, same node-id set as the\\ncollection; 119 isolated runs, 1 PASS each; RED groups fail; requirement counts recomputed\\nfrom the archived JUnit; sealed 0049 record byte-identical to the candidate and named by\\nsupersedes; G4 manifest digests and every other entry preserved. Mechanical integrity only:\\nnot independent verification.\\n\\\"\\\"\\\"\\n\\nimport hashlib\\nimport json\\nimport re\\nimport subprocess\\nimport sys\\nimport xml.etree.ElementTree as ET\\nfrom collections import Counter\\nfrom pathlib import Path\\n\\nrepo, head = Path(sys.argv[1]), sys.argv[2]\\nBASE = \\\"df444af855e884d7783612b302e008b90105fe13\\\"\\nTEST = \\\"ocor-runtime/tests/tasks/test_ocor_dev_0049.py\\\"\\nREM = \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD/OCOR-DEV-REM-0019.json\\\"\\nREQ = \\\"reports/evidence/G4/OCOR-DEV-0049.requalified-rem0019.json\\\"\\nSEALED = \\\"reports/evidence/G4/OCOR-DEV-0049.json\\\"\\nCLAIMS = {\\\"E1\\\": 0, \\\"E2\\\": 0, \\\"PoC_GO\\\": \\\"NO-GO\\\", \\\"Production_readiness\\\": \\\"NO_GO\\\", \\\"runtime_conformance\\\": \\\"NOT_ESTABLISHED\\\"}\\n\\n\\ndef git(*args: str) -> str:\\n    return subprocess.check_output([\\\"git\\\", *args], cwd=repo, text=True).strip()\\n\\n\\ndef show(path: str, ref: str = head) -> bytes:\\n    return subprocess.check_output([\\\"git\\\", \\\"show\\\", f\\\"{ref}:{path}\\\"], cwd=repo)\\n\\n\\ndef sha(data: bytes) -> str:\\n    return hashlib.sha256(data).hexdigest()\\n\\n\\ndef cases(xml_text: str) -> list[tuple[str, str]]:\\n    xml_text = re.sub(r\\\"<redacted:([A-Za-z0-9_.-]+)>\\\", r\\\"[redacted:\\\\1]\\\", xml_text)\\n    out = []\\n    for case in ET.fromstring(xml_text).iter(\\\"testcase\\\"):\\n        bad = [c.tag for c in case if c.tag in (\\\"failure\\\", \\\"error\\\", \\\"skipped\\\")]\\n        out.append((case.get(\\\"name\\\", \\\"\\\"), \\\"PASS\\\" if not bad else (\\\"SKIPPED\\\" if bad[0] == \\\"skipped\\\" else \\\"FAIL\\\")))\\n    return out\\n\\n\\nerrors: list[str] = []\\nrem, req = json.loads(show(REM)), json.loads(show(REQ))\\ncommit = rem[\\\"commit\\\"]\\nif req[\\\"commit\\\"] != commit:\\n    errors.append(\\\"records name different commits\\\")\\nif subprocess.run([\\\"git\\\", \\\"merge-base\\\", \\\"--is-ancestor\\\", commit, head], cwd=repo).returncode:\\n    errors.append(\\\"commit is not an ancestor of head\\\")\\nif git(\\\"diff\\\", \\\"--name-only\\\", BASE, commit).splitlines() != [TEST]:\\n    errors.append(\\\"the code commit changes more than the 0049 test module\\\")\\noutputs = {REM, REM.replace(\\\".json\\\", \\\".log\\\"), \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD/README.md\\\",\\n           REQ, REQ.replace(\\\".json\\\", \\\".log\\\"), \\\"reports/evidence/G4/MANIFEST.json\\\"}\\nafter = set(git(\\\"diff\\\", \\\"--name-only\\\", commit, head).splitlines())\\nif after - outputs:\\n    errors.append(f\\\"non-evidence changes after commit: {sorted(after - outputs)}\\\")\\n\\nraw = show(REM.replace(\\\".json\\\", \\\".log\\\"))\\nfor path, record in ((REM, rem), (REQ, req)):\\n    if show(path.replace(\\\".json\\\", \\\".log\\\")) != raw or sha(raw) != record[\\\"raw_output_sha256\\\"]:\\n        errors.append(f\\\"{path}: raw log mismatch\\\")\\n    if record[\\\"claims\\\"] != CLAIMS:\\n        errors.append(f\\\"{path}: claims changed\\\")\\n    for p, recorded in record[\\\"inputs\\\"].items():\\n        for ref in (commit, head):\\n            actual = git(\\\"rev-parse\\\", f\\\"{ref}:inputs\\\") if p == \\\"inputs_tree\\\" else sha(show(p, ref))\\n            if actual != recorded:\\n                errors.append(f\\\"{path}: input mismatch {p} at {ref}\\\")\\n    if any(c[\\\"status\\\"] != \\\"PASS\\\" for c in record[\\\"commands\\\"]) or record[\\\"result\\\"] != \\\"PASS\\\":\\n        errors.append(f\\\"{path}: not all PASS\\\")\\nentries = [json.loads(line) for line in raw.decode(\\\"utf-8\\\").splitlines()]\\ndigests = {e[\\\"sha256\\\"] for e in entries}\\nby_label = {e[\\\"label\\\"]: e for e in entries}\\nfor e in entries:\\n    if sha(e[\\\"output\\\"].encode(\\\"utf-8\\\")) != e[\\\"sha256\\\"]:\\n        errors.append(f\\\"raw entry self-hash mismatch {e['label']}\\\")\\n\\n\\ndef walk(node):\\n    if isinstance(node, dict):\\n        for k, v in node.items():\\n            if k.endswith(\\\"sha256\\\") and isinstance(v, str) and k not in (\\\"raw_output_sha256\\\", \\\"module_sha256\\\", \\\"node_ids_sha256\\\"):\\n                yield k, v\\n            yield from walk(v)\\n    elif isinstance(node, list):\\n        for v in node:\\n            yield from walk(v)\\n\\n\\nfor key, value in walk({\\\"commands\\\": rem[\\\"commands\\\"], \\\"independence\\\": rem[\\\"independence\\\"], \\\"tdd\\\": rem[\\\"tdd\\\"]}):\\n    if value not in digests:\\n        errors.append(f\\\"recorded {key} {value[:12]} not in the raw log\\\")\\n\\ncollected = sorted(line.split(\\\"::\\\", 1)[1] for line in by_label[\\\"artifact-collected.txt\\\"][\\\"output\\\"].splitlines() if line)\\nper_function: Counter[str] = Counter()\\nmodules = [c for c in rem[\\\"commands\\\"] if c[\\\"label\\\"].startswith(\\\"order-\\\")]\\nif len(modules) != 5:\\n    errors.append(\\\"five module runs expected\\\")\\nfor run in modules:\\n    got = cases(by_label[f\\\"{run['label']}-junit\\\"][\\\"output\\\"])\\n    order = [line.split(\\\"::\\\", 1)[1] for line in by_label[f\\\"{run['label']}-order\\\"][\\\"output\\\"].splitlines() if line]\\n    if [n for n, _ in got] != order or sorted(order) != collected or len(got) != 390 or {o for _, o in got} != {\\\"PASS\\\"}:\\n        errors.append(f\\\"{run['label']}: order, case set or outcomes differ\\\")\\n    if run[\\\"result\\\"] != {\\\"passed\\\": 390, \\\"failed\\\": 0, \\\"skipped\\\": 0, \\\"not_executed\\\": 0} or any(run[\\\"residue\\\"].values()):\\n        errors.append(f\\\"{run['label']}: counts or residue\\\")\\n    for n, _ in got:\\n        per_function[n.split(\\\"[\\\", 1)[0]] += 1\\niso = rem[\\\"independence\\\"][\\\"isolated_runs\\\"]\\nif len(iso) != 119 or len({i[\\\"node\\\"] for i in iso}) != 119:\\n    errors.append(\\\"119 distinct isolated runs expected\\\")\\nfor i in iso:\\n    got = cases(by_label[f\\\"{i['label']}-junit\\\"][\\\"output\\\"])\\n    if got != [(i[\\\"node\\\"].split(\\\"::\\\")[-1], \\\"PASS\\\")] or any(i[\\\"residue\\\"].values()):\\n        errors.append(f\\\"{i['label']}: isolated outcome\\\")\\nfor group in rem[\\\"tdd\\\"][\\\"RED\\\"][\\\"groups\\\"]:\\n    got = dict(cases(by_label[f\\\"tdd-red-{group['group']}-junit\\\"][\\\"output\\\"]))\\n    if not group[\\\"failing_cases\\\"] or any(got.get(n) != \\\"FAIL\\\" for n in group[\\\"failing_cases\\\"]):\\n        errors.append(f\\\"RED {group['group']} did not fail\\\")\\nfor result in req[\\\"requirement_results\\\"]:\\n    name = result[\\\"command\\\"].rsplit(\\\"(\\\", 1)[1].rstrip(\\\")\\\")\\n    if result[\\\"result\\\"][\\\"passed\\\"] != per_function[name] or result[\\\"status\\\"] != \\\"PASS\\\":\\n        errors.append(f\\\"requirement count mismatch {result['case_id']}\\\")\\nif sum(r[\\\"result\\\"][\\\"passed\\\"] for r in req[\\\"requirement_results\\\"]) != 1950:\\n    errors.append(\\\"requirement results do not cover the 5 x 390 cases\\\")\\n\\nsealed = show(SEALED, BASE)\\nif show(SEALED) != sealed or sha(sealed) not in req[\\\"supersedes\\\"]:\\n    errors.append(\\\"sealed 0049 record changed or not named by supersedes\\\")\\nmanifest, before = json.loads(show(\\\"reports/evidence/G4/MANIFEST.json\\\")), json.loads(show(\\\"reports/evidence/G4/MANIFEST.json\\\", BASE))\\nmine = {e[\\\"task_id\\\"]: e for e in manifest[\\\"artifacts\\\"] if e[\\\"task_id\\\"] in (\\\"OCOR-DEV-0049\\\", \\\"OCOR-DEV-0049-RAW\\\")}\\nif mine[\\\"OCOR-DEV-0049\\\"] != {\\\"path\\\": \\\"OCOR-DEV-0049.requalified-rem0019.json\\\", \\\"sha256\\\": sha(show(REQ)), \\\"task_id\\\": \\\"OCOR-DEV-0049\\\"}:\\n    errors.append(\\\"manifest entry of 0049\\\")\\nif mine[\\\"OCOR-DEV-0049-RAW\\\"] != {\\\"path\\\": \\\"OCOR-DEV-0049.requalified-rem0019.log\\\", \\\"sha256\\\": sha(raw), \\\"task_id\\\": \\\"OCOR-DEV-0049-RAW\\\"}:\\n    errors.append(\\\"manifest raw entry of 0049\\\")\\nothers = [e for e in manifest[\\\"artifacts\\\"] if not e[\\\"task_id\\\"].startswith(\\\"OCOR-DEV-0049\\\")]\\nif others != [e for e in before[\\\"artifacts\\\"] if not e[\\\"task_id\\\"].startswith(\\\"OCOR-DEV-0049\\\")]:\\n    errors.append(\\\"other manifest artifacts changed\\\")\\nif {k: v for k, v in manifest.items() if k not in (\\\"artifacts\\\", \\\"requirement_results\\\")} != {\\n        k: v for k, v in before.items() if k not in (\\\"artifacts\\\", \\\"requirement_results\\\")}:\\n    errors.append(\\\"manifest metadata changed\\\")\\nprint(json.dumps({\\\"head\\\": head, \\\"commit\\\": commit, \\\"errors\\\": errors, \\\"status\\\": \\\"PASS\\\" if not errors else \\\"FAIL\\\"}, indent=2))\\nsys.exit(1 if errors else 0)\\n\", \"sha256\": \"9058cd149123dc4bb20b6a21b9d8b3edfd6a3ba11dd0194e87d0c613337c6cee\"}\n{\"command\": \"captured artifact: make_readme.py\", \"exit_code\": 0, \"label\": \"artifact-make_readme.py\", \"output\": \"\\\"\\\"\\\"Write reports/assurance/OCOR-DEV-REM-0019-RCCAD/README.md from the built records.\\\"\\\"\\\"\\nimport json, sys\\nfrom pathlib import Path\\nrepo = Path(sys.argv[1])\\nrem = json.loads((repo / \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD/OCOR-DEV-REM-0019.json\\\").read_text())\\nruns = [c for c in rem[\\\"commands\\\"] if c[\\\"label\\\"].startswith(\\\"order-\\\")]\\nrows = \\\"\\\\n\\\".join(f\\\"| `{c['label']}` | {c['order']['seed'] or '-'} | {c['order']['position_of_helm_case']} | \\\"\\n                 f\\\"{c['result']['passed']}/390 | {c['duration_seconds']} s |\\\" for c in runs)\\ndeps = \\\"\\\\n\\\".join(f\\\"| `{d['test']}` | {d['cases']}{'' if d['state_dependent'] else ' (produttore)'} | {d['dependency_on_df444af']} | {d['remedy']} |\\\"\\n                 for d in rem[\\\"design\\\"][\\\"dependency_analysis\\\"])\\nred = \\\"\\\\n\\\".join(f\\\"| `{g['group']}` | {', '.join(g['order'])} | {', '.join(g['failing_cases'])} |\\\" for g in rem[\\\"tdd\\\"][\\\"RED\\\"][\\\"groups\\\"])\\niso = rem[\\\"independence\\\"][\\\"isolated_runs\\\"]\\nattempts = \\\"\\\".join(f\\\"\\\\nTentativo non qualificante registrato e rieseguito: `{a['label']}` ({a['result']['passed']}/390 PASS, \\\"\\n                   f\\\"fallito `{', '.join(a['failing_cases'])}`): {a['diagnosis']}\\\\n\\\" for a in rem[\\\"independence\\\"][\\\"non_qualifying_attempts\\\"])\\ntext = f\\\"\\\"\\\"# OCOR-DEV-REM-0019-RCCAD — OCOR-DEV-0049: ogni test eseguibile da solo e in qualsiasi ordine\\n\\n- **Status**: `{rem['status']}` (verifier dichiarato: Grok 4.7 via Cursor CLI, processo, contesto e\\n  fornitore separati; Claude Code, implementatore, non verifica questo change set).\\n- **Fonte**: presa d'atto PO del 2026-10-09 sul vincolo d'ordine di `test_ocor_dev_0049.py` e decisione\\n  PO `REM-0017-CI-0049-REMAINDER-CAP` (2026-10-10, opzione 2: nessun tetto speciale, si correggono prima i\\n  test di 0049). Identificativo verificato libero il 2026-10-09 (`git grep` su tutti i ref).\\n- **Branch**: `{rem['change_set']['branch']}`, radicato sul candidato sigillato di `OCOR-DEV-0049`\\n  (`{rem['change_set']['base']}`, GO `b14e4bf`, PR #176 aperta): il modulo non esiste su `main` e 0049 si\\n  integra dopo la chiusura verificata di `OCOR-DEV-REM-0017`, che fisserà l'HEAD verificato di questo branch\\n  al posto di `df444af`.\\n- **Commit di codice**: `{rem['commit']}` — cambia soltanto `ocor-runtime/tests/tasks/test_ocor_dev_0049.py`;\\n  il codice di produzione di 0049 (`deploy/helm/ocor-poc/`) è invariato.\\n\\n## Ambito chiuso\\n\\nSolo il codice di test di 0049 (modulo e fixture). Stessi 390 casi (corrispondenza uno a uno per node id:\\nnessun caso rimosso, unito, spezzato, rinominato o aggiunto) e stesse asserzioni: per ciascuna delle 72\\nfunzioni di test il multiset di `assert`, `pytest.fail/raises` e helper che asseriscono è identico; nei 2\\ntest che ora osservano un carrier proprio cambia solo il nome dell'oggetto osservato (`stack.ops` → `ops`).\\n\\n## Analisi delle dipendenze (sul candidato `df444af`)\\n\\n| Test | Casi | Dipendenza | Correzione |\\n|---|---|---|---|\\n{deps}\\n\\nLo stato live condiviso è ora prodotto da fixture esplicite e idempotenti richieste dal test che ne ha\\nbisogno (`tested`, `reopen_pending`, `reopened`, `fault_observed`, `untested_ops`, `fresh_tested_ops`), mai\\nda un altro test. I restanti 271 casi non avevano stato live condiviso.\\n\\n## TDD — RED sul candidato sigillato\\n\\nCopia non tracciata del modulo di `df444af` (stesso `ROOT`), un processo pytest per gruppo; rimossa dopo il RED.\\n\\n| Gruppo | Ordine | Casi falliti |\\n|---|---|---|\\n{red}\\n\\n## Prova di indipendenza (commit di codice, stack `ocor-bootstrap` reale, zero skip, nessun residuo)\\n\\n| Run | Seed | Posizione del caso Helm | Esito | Durata |\\n|---|---|---|---|---|\\n{rows}\\n\\nOrdine eseguito = ordine richiesto (verificato sul JUnit di ogni run); stesso insieme dei 390 node id\\nraccolti. Esecuzioni isolate: {len(iso)} processi pytest, uno per ciascun caso dell'analisi, tutti PASS\\nsenza residui. Partenza dei run allineata al tick `*/15` del caso Helm (ritardo soltanto, dichiarato per run).\\n{attempts}\\n\\n## Evidenza\\n\\n- `OCOR-DEV-REM-0019.json` / `.log`: record della remediation e raw JSONL dell'intera campagna (credenziali\\n  locali generate redatte).\\n- `reports/evidence/G4/OCOR-DEV-0049.requalified-rem0019.json` / `.log` (raw byte-identico): riqualifica di\\n  `OCOR-DEV-0049` con `supersedes` esplicito del record sigillato `OCOR-DEV-0049.json`, che resta storico e\\n  invariato insieme al GO `b14e4bf`; il manifest G4 punta al nuovo record.\\n- Controllo meccanico riproducibile: `reproducible_check` nel record (non è verifica indipendente).\\n\\n## Vincoli e claim\\n\\nNessun test escluso, saltato o indebolito; nessuna modifica a `inputs/`, a gate, workflow o ruleset.\\n`E1=0`, `E2=0`, nessun requisito `Verified`; runtime conformance `NOT_ESTABLISHED`, PoC-GO e Production\\nreadiness `NO-GO`.\\n\\\"\\\"\\\"\\n(repo / \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD/README.md\\\").write_text(text, encoding=\\\"utf-8\\\")\\nprint(\\\"README written\\\")\\n\", \"sha256\": \"6abaef658ad1bf0ae831640a70a44d27f84bb1eada5228ed1cedbc3b68cdfe10\"}\n{\"command\": \"captured artifact: build_evidence.py\", \"exit_code\": 0, \"label\": \"artifact-build_evidence.py\", \"output\": \"\\\"\\\"\\\"Build the OCOR-DEV-REM-0019 record and the OCOR-DEV-0049 requalification from raw logs.\\n\\nUsage: build_evidence.py <repo> <log_dir> <code_commit>\\nEvery count is derived from JUnit XML archived verbatim in the JSONL raw output. One raw\\nJSONL (the whole campaign) is written next to each record (identical bytes). The sealed\\nOCOR-DEV-0049 record is never modified: the requalification is a new record whose\\n``supersedes`` names it, and the G4 manifest entries of 0049 are redirected to it.\\n\\\"\\\"\\\"\\n\\nimport hashlib\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nimport sys\\nimport xml.etree.ElementTree as ET\\nfrom collections import Counter\\nfrom datetime import UTC, datetime\\nfrom pathlib import Path\\n\\nrepo, logs, code_commit = Path(sys.argv[1]), Path(sys.argv[2]), sys.argv[3]\\nBASE = \\\"df444af855e884d7783612b302e008b90105fe13\\\"\\nBRANCH = \\\"governed/ocor-dev-rem-0019-0049-test-isolation\\\"\\nTEST = \\\"ocor-runtime/tests/tasks/test_ocor_dev_0049.py\\\"\\nG4 = repo / \\\"reports/evidence/G4\\\"\\nREM_DIR = repo / \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD\\\"\\nSHORT = code_commit[:12]\\nMODULE_RUNS = os.environ.get(\\\"REM0019_RUNS\\\", \\\"order-collection,order-reverse,order-seed-190001,order-seed-190002,order-seed-190003\\\").split(\\\",\\\")\\nRED_GROUPS = [\\\"ready-alone\\\", \\\"publicdep-alone\\\", \\\"logs-alone\\\", \\\"estop-alone\\\", \\\"fault-alone\\\", \\\"coherent-alone\\\",\\n              \\\"untested-after-restore\\\", \\\"reopen-after-replay\\\"]\\nGATES = json.loads((logs / \\\"gates-code.json\\\").read_text())[\\\"gates\\\"]\\nNOW = datetime.now(UTC).isoformat()\\n\\n\\ndef sha(data: bytes) -> str:\\n    return hashlib.sha256(data).hexdigest()\\n\\n\\ndef git(*args: str) -> str:\\n    return subprocess.check_output([\\\"git\\\", *args], cwd=repo, text=True).strip()\\n\\n\\ndef at(rev: str, path: str) -> bytes:\\n    return subprocess.check_output([\\\"git\\\", \\\"show\\\", f\\\"{rev}:{path}\\\"], cwd=repo)\\n\\n\\ndef junit(path: Path) -> tuple[dict[str, int], list[tuple[str, str]]]:\\n    root = ET.parse(path).getroot()\\n    suites = [root] if root.tag == \\\"testsuite\\\" else list(root.iter(\\\"testsuite\\\"))\\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\\\"tests\\\", \\\"failures\\\", \\\"errors\\\", \\\"skipped\\\")}\\n    cases = []\\n    for case in root.iter(\\\"testcase\\\"):\\n        outcome = \\\"PASS\\\"\\n        for child in case:\\n            if child.tag in (\\\"failure\\\", \\\"error\\\"):\\n                outcome = \\\"FAIL\\\"\\n            elif child.tag == \\\"skipped\\\":\\n                outcome = \\\"SKIPPED\\\"\\n        cases.append((case.get(\\\"name\\\", \\\"\\\"), outcome))\\n    counts = {\\\"passed\\\": t[\\\"tests\\\"] - t[\\\"failures\\\"] - t[\\\"errors\\\"] - t[\\\"skipped\\\"],\\n              \\\"failed\\\": t[\\\"failures\\\"] + t[\\\"errors\\\"], \\\"skipped\\\": t[\\\"skipped\\\"], \\\"not_executed\\\": 0}\\n    return counts, cases\\n\\n\\nSECRETS = {name: value for name, value in (line.split(\\\"=\\\", 1) for line in\\n           (repo / \\\".ocor/bootstrap.env\\\").read_text().splitlines() if \\\"=\\\" in line)\\n           if name.startswith((\\\"OCOR_LOCAL_\\\", \\\"OCOR_SPIRE_JOIN\\\")) and len(value) >= 8}\\nredactions: dict[str, int] = {}\\nraw_lines: list[str] = []\\n\\n\\ndef redact(data: bytes) -> bytes:\\n    text = data.decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\n    for name, value in SECRETS.items():\\n        count = text.count(value)\\n        if count:\\n            redactions[name] = redactions.get(name, 0) + count\\n            text = text.replace(value, f\\\"<redacted:{name}>\\\")\\n    text = re.sub(r\\\"postgresql://ocor:[REDACTED]@\\\\s]+@\\\", \\\"postgresql://ocor:[REDACTED]@\\\", text)\\n    return text.encode(\\\"utf-8\\\")\\n\\n\\ndef add_raw(label: str, command: str, exit_code: int, data: bytes) -> str:\\n    data = redact(data)\\n    raw_lines.append(json.dumps({\\\"label\\\": label, \\\"command\\\": command, \\\"exit_code\\\": exit_code, \\\"sha256\\\": sha(data),\\n                                 \\\"output\\\": data.decode(\\\"utf-8\\\")}, sort_keys=True, ensure_ascii=False))\\n    return sha(data)\\n\\n\\ndef run_result(label: str) -> dict:\\n    return json.loads((logs / f\\\"{label}.json\\\").read_text())\\n\\n\\n# -- preparation of the stack ------------------------------------------------------------\\nprep = []\\nfor step in (\\\"presync\\\", \\\"reset\\\", \\\"bootstrap-ci\\\", \\\"sync\\\", \\\"health\\\"):\\n    meta = json.loads((logs / f\\\"prep0-{step}.json\\\").read_text())\\n    digest = add_raw(f\\\"prepare-{step}\\\", \\\" \\\".join(meta[\\\"command\\\"]), meta[\\\"exit_code\\\"],\\n                     (logs / f\\\"prep0-{step}.log\\\").read_bytes())\\n    prep.append({\\\"label\\\": f\\\"prepare-{step}\\\", \\\"command\\\": \\\" \\\".join(meta[\\\"command\\\"]), \\\"exit_code\\\": meta[\\\"exit_code\\\"],\\n                 \\\"raw_sha256\\\": digest, \\\"status\\\": \\\"PASS\\\" if meta[\\\"exit_code\\\"] == 0 else \\\"FAIL\\\",\\n                 \\\"duration_seconds\\\": round(meta[\\\"finished_epoch\\\"] - meta[\\\"started_epoch\\\"], 1)})\\nenv_raw = (logs / \\\"prep0-environment.json\\\").read_bytes()\\nadd_raw(\\\"environment\\\", \\\"captured artifact: docker inspect of the ocor-bootstrap containers after preparation\\\", 0, env_raw)\\nenvironment = json.loads(env_raw)\\n\\n# -- RED on the sealed candidate ------------------------------------------------------------\\nred = []\\nfor group in RED_GROUPS:\\n    result = run_result(f\\\"red-{group}\\\")\\n    counts, cases = junit(logs / f\\\"red-{group}.xml\\\")\\n    nodes = [line for line in (logs / f\\\"red-{group}.order\\\").read_text().splitlines() if line]\\n    log_sha = add_raw(f\\\"tdd-red-{group}\\\", \\\" \\\".join(result[\\\"command\\\"]), result[\\\"exit_code\\\"], (logs / f\\\"red-{group}.log\\\").read_bytes())\\n    xml_sha = add_raw(f\\\"tdd-red-{group}-junit\\\", \\\"captured artifact: JUnit XML\\\", 0, (logs / f\\\"red-{group}.xml\\\").read_bytes())\\n    failing = [name for name, outcome in cases if outcome == \\\"FAIL\\\"]\\n    assert result[\\\"exit_code\\\"] != 0 and failing, group\\n    red.append({\\\"group\\\": group, \\\"order\\\": [n.split(\\\"::\\\", 1)[1] for n in nodes], \\\"exit_code\\\": result[\\\"exit_code\\\"],\\n                \\\"result\\\": counts, \\\"failing_cases\\\": failing, \\\"raw_sha256\\\": log_sha, \\\"junit_sha256\\\": xml_sha})\\n\\n# -- independence campaign --------------------------------------------------------------------\\nisolated_nodes = [line for line in (logs / \\\"isolated.txt\\\").read_text().splitlines() if line]\\nprogress = [json.loads(line) for line in (logs / \\\"isolated.progress\\\").read_text().splitlines() if line]\\nassert len(progress) == len(isolated_nodes) == 119 and all(p[\\\"ok\\\"] for p in progress)\\nisolated = []\\nfor n, (node, p) in enumerate(zip(isolated_nodes, progress, strict=True), 1):\\n    label = f\\\"iso-{n:03d}\\\"\\n    assert p[\\\"label\\\"] == label\\n    counts, cases = junit(logs / f\\\"{label}.xml\\\")\\n    assert counts == {\\\"passed\\\": 1, \\\"failed\\\": 0, \\\"skipped\\\": 0, \\\"not_executed\\\": 0}, label\\n    log_sha = add_raw(label, f\\\"isolated execution of {node}\\\", 0, (logs / f\\\"{label}.log\\\").read_bytes())\\n    xml_sha = add_raw(f\\\"{label}-junit\\\", \\\"captured artifact: JUnit XML\\\", 0, (logs / f\\\"{label}.xml\\\").read_bytes())\\n    isolated.append({\\\"label\\\": label, \\\"node\\\": node.split(\\\"::\\\", 1)[1], \\\"result\\\": counts,\\n                     \\\"duration_seconds\\\": p[\\\"duration_seconds\\\"], \\\"residue\\\": p[\\\"residue\\\"],\\n                     \\\"raw_sha256\\\": log_sha, \\\"junit_sha256\\\": xml_sha})\\n\\norders_meta = json.loads((logs / \\\"orders.json\\\").read_text())\\nmodule_commands, per_function = [], Counter()\\nmodules_progress = {json.loads(line)[\\\"label\\\"]: json.loads(line)\\n                    for line in (logs / \\\"modules.progress\\\").read_text().splitlines() if line}\\ncollected = [line for line in (logs / \\\"collected.txt\\\").read_text().splitlines() if line]\\nfor label in MODULE_RUNS:\\n    result = run_result(label)\\n    counts, cases = junit(logs / f\\\"{label}.xml\\\")\\n    order = [line for line in (logs / f\\\"{label}.order\\\").read_text().splitlines() if line]\\n    executed = [name for name, _ in cases]\\n    assert counts == {\\\"passed\\\": 390, \\\"failed\\\": 0, \\\"skipped\\\": 0, \\\"not_executed\\\": 0}, label\\n    assert sorted(executed) == sorted(c.split(\\\"::\\\", 1)[1] for c in collected), label\\n    assert executed == [o.split(\\\"::\\\", 1)[1] for o in order], f\\\"{label}: execution order differs from the requested order\\\"\\n    assert modules_progress[label][\\\"ok\\\"] and not any(modules_progress[label][\\\"residue\\\"].values())\\n    for name, _ in cases:\\n        per_function[name.split(\\\"[\\\", 1)[0]] += 1\\n    log_sha = add_raw(label, \\\" \\\".join(result[\\\"command\\\"][:13]) + f\\\" <{len(order)} node ids in the order of {label}>\\\",\\n                      result[\\\"exit_code\\\"], (logs / f\\\"{label}.log\\\").read_bytes())\\n    xml_sha = add_raw(f\\\"{label}-junit\\\", \\\"captured artifact: JUnit XML\\\", 0, (logs / f\\\"{label}.xml\\\").read_bytes())\\n    order_sha = add_raw(f\\\"{label}-order\\\", \\\"captured artifact: requested execution order (node ids)\\\", 0,\\n                        (logs / f\\\"{label}.order\\\").read_bytes())\\n    alignment = json.loads((logs / f\\\"{label}-alignment.json\\\").read_text())\\n    alignment_sha = add_raw(f\\\"{label}-alignment\\\", \\\"captured artifact: start alignment of the run (delay only)\\\", 0,\\n                            (logs / f\\\"{label}-alignment.json\\\").read_bytes())\\n    health_sha = add_raw(f\\\"{label}-health\\\", \\\"scripts/verify_external_services.py --execute --typed (before the run)\\\", 0,\\n                         (logs / f\\\"{label}-health.log\\\").read_bytes())\\n    module_commands.append({\\n        \\\"label\\\": label, \\\"status\\\": \\\"PASS\\\", \\\"exit_code\\\": result[\\\"exit_code\\\"], \\\"result\\\": counts,\\n        \\\"command\\\": \\\"uv run --project ocor-runtime --frozen --extra test --extra lint pytest -v -ra -p no:cacheprovider \\\"\\n                   f\\\"<the 390 node ids of {TEST} in the order of {label}>\\\",\\n        \\\"duration_seconds\\\": round(result[\\\"duration_seconds\\\"], 1), \\\"started_at\\\": result[\\\"started_at\\\"],\\n        \\\"order\\\": {\\\"kind\\\": label.removeprefix(\\\"order-\\\"), \\\"seed\\\": int(label.rsplit(\\\"-\\\", 1)[1]) if \\\"seed\\\" in label else None,\\n                  \\\"order_sha256\\\": order_sha, \\\"position_of_helm_case\\\": orders_meta[\\\"positions_of_helm_case\\\"][label]},\\n        \\\"raw_sha256\\\": log_sha, \\\"junit_sha256\\\": xml_sha, \\\"health_raw_sha256\\\": health_sha,\\n        \\\"residue\\\": modules_progress[label][\\\"residue\\\"], \\\"watchdog_error\\\": result.get(\\\"watchdog_error\\\"),\\n        \\\"start_alignment\\\": {**alignment, \\\"alignment_sha256\\\": alignment_sha}})\\n\\n# -- non-qualifying attempts (recorded, never relabelled) -------------------------------------------\\nattempts = []\\nfor prefix, label in ((\\\"attempt1-order-reverse\\\", \\\"order-reverse\\\"),):\\n    adir = logs / \\\"attempts\\\"\\n    if not (adir / f\\\"{prefix}.json\\\").exists():\\n        continue\\n    result = json.loads((adir / f\\\"{prefix}.json\\\").read_text())\\n    counts, cases = junit(adir / f\\\"{prefix}.xml\\\")\\n    attempts.append({\\n        \\\"label\\\": prefix, \\\"order\\\": label, \\\"status\\\": \\\"FAIL_INFRASTRUCTURE\\\", \\\"exit_code\\\": result[\\\"exit_code\\\"],\\n        \\\"result\\\": counts, \\\"duration_seconds\\\": round(result[\\\"duration_seconds\\\"], 1),\\n        \\\"failing_cases\\\": [n for n, o in cases if o == \\\"FAIL\\\"],\\n        \\\"diagnosis\\\": \\\"containerd del nodo kind terminato da SIGSEGV (status=11/SEGV) alle 14:45:00Z, al tick */15 della CronJob, mentre girava il pod del backup manuale: capture-kafka exit 255, job fallito (backoffLimit 0). Difetto locale dell'host gia' registrato come REM-0017-KIND-CONTAINERD-CRASH (decisione PO REM-0017-CI-CAMPAIGN-DURATION: diagnosi nel change set REM-0017, nessun cambio di immagine o versione). Nello stesso run gli altri 389 casi in ordine inverso sono PASS. Anche nel run order-collection containerd e' crashato (14:14:57Z) senza colpire container in esecuzione. L'ordine inverso e' stato rieseguito.\\\",\\n        \\\"raw_sha256\\\": add_raw(f\\\"{prefix}\\\", \\\"non-qualifying attempt: \\\" + \\\" \\\".join(result[\\\"command\\\"][:13]), result[\\\"exit_code\\\"], (adir / f\\\"{prefix}.log\\\").read_bytes()),\\n        \\\"junit_sha256\\\": add_raw(f\\\"{prefix}-junit\\\", \\\"captured artifact: JUnit XML of the non-qualifying attempt\\\", 0, (adir / f\\\"{prefix}.xml\\\").read_bytes()),\\n        \\\"containerd_journal_sha256\\\": add_raw(f\\\"{prefix}-containerd-journal\\\", \\\"captured artifact: containerd lines of journalctl -u containerd in the kind node during the attempt\\\", 0, (adir / \\\"attempt1-containerd-journal.txt\\\").read_bytes()),\\n    })\\nif (logs / \\\"attempts/order-collection-containerd-journal.txt\\\").exists():\\n    add_raw(\\\"order-collection-containerd-journal\\\", \\\"captured artifact: containerd lines of journalctl -u containerd in the kind node during order-collection\\\", 0,\\n            (logs / \\\"attempts/order-collection-containerd-journal.txt\\\").read_bytes())\\n\\nfor name in (\\\"assertion_identity.py\\\", \\\"assertion-identity.json\\\", \\\"orders.json\\\", \\\"collected.txt\\\", \\\"isolated.txt\\\",\\n             \\\"make_orders.py\\\", \\\"campaign.py\\\", \\\"modules.py\\\", \\\"run_nodes.py\\\", \\\"prepare.py\\\", \\\"groups.py\\\", \\\"gates.py\\\",\\n             \\\"check_evidence.py\\\", \\\"make_readme.py\\\", \\\"build_evidence.py\\\"):\\n    add_raw(f\\\"artifact-{name}\\\", f\\\"captured artifact: {name}\\\", 0, (logs / name).read_bytes())\\nidentity = json.loads((logs / \\\"assertion-identity.json\\\").read_text())\\nassert not identity[\\\"different\\\"] and not identity[\\\"removed\\\"] and identity[\\\"tests_compared\\\"] == 72\\n\\ngate_commands = []\\nfor gate in GATES:\\n    digest = add_raw(f\\\"gate-{gate['label']}\\\", gate[\\\"command\\\"], gate[\\\"exit_code\\\"], (logs / gate[\\\"log\\\"]).read_bytes())\\n    gate_commands.append({\\\"label\\\": f\\\"gate-{gate['label']}\\\", \\\"command\\\": gate[\\\"command\\\"], \\\"exit_code\\\": gate[\\\"exit_code\\\"],\\n                          \\\"raw_sha256\\\": digest, \\\"status\\\": \\\"PASS\\\" if gate[\\\"exit_code\\\"] == 0 else \\\"FAIL\\\",\\n                          **({\\\"note\\\": gate[\\\"note\\\"]} if gate.get(\\\"note\\\") else {})})\\nassert all(g[\\\"status\\\"] == \\\"PASS\\\" for g in gate_commands)\\nraw = (\\\"\\\\n\\\".join(raw_lines) + \\\"\\\\n\\\").encode(\\\"utf-8\\\")\\nraw_sha = sha(raw)\\n\\n# -- facts read from git ------------------------------------------------------------------------\\nchanged = git(\\\"diff\\\", \\\"--name-only\\\", BASE, code_commit).splitlines()\\nassert changed == [TEST], changed\\nsealed_record_bytes = at(BASE, \\\"reports/evidence/G4/OCOR-DEV-0049.json\\\")\\nsealed = json.loads(sealed_record_bytes)\\ninputs = {path: sha(at(code_commit, path)) for path in sealed[\\\"inputs\\\"] if path != \\\"inputs_tree\\\"}\\ninputs[\\\"inputs_tree\\\"] = git(\\\"rev-parse\\\", f\\\"{code_commit}:inputs\\\")\\nclaims = {\\\"E1\\\": 0, \\\"E2\\\": 0, \\\"PoC_GO\\\": \\\"NO-GO\\\", \\\"Production_readiness\\\": \\\"NO_GO\\\", \\\"runtime_conformance\\\": \\\"NOT_ESTABLISHED\\\"}\\nroles = {\\n    \\\"implementer\\\": \\\"Claude Code (Anthropic), claude-opus-5-5, implementatore di riserva del loop (quota Codex esaurita), ciclo 0 di OCOR-DEV-REM-0019\\\",\\n    \\\"original_implementer_0049\\\": \\\"Riparazioni di OCOR-DEV-0049: cicli 2-6 e 8 Claude Code, ciclo 7 Codex; verifica dei cicli 7 e 8 Grok 4.7 (Cursor)\\\",\\n    \\\"verifier\\\": \\\"Grok 4.7 via Cursor CLI (verifier: cursor) -- processo, contesto e fornitore separati; Claude Code non verifica questo change set\\\",\\n    \\\"independence\\\": \\\"external loop only; separate process, context and provider\\\",\\n}\\nchange_set = {\\n    \\\"id\\\": \\\"OCOR-DEV-REM-0019\\\", \\\"branch\\\": BRANCH, \\\"base\\\": BASE, \\\"code_commit\\\": code_commit,\\n    \\\"decision\\\": \\\"Decisione PO REM-0017-CI-0049-REMAINDER-CAP (2026-10-10, opzione 2): correzione dell'isolamento dei test di OCOR-DEV-0049 prima delle run CI di REM-0017; decisione dedicata richiesta dalla presa d'atto del 2026-10-09 per modificare i test di 0049\\\",\\n    \\\"base_rationale\\\": \\\"Il modulo test_ocor_dev_0049.py esiste soltanto sul candidato sigillato di OCOR-DEV-0049 (df444af, GO b14e4bf, PR #176 aperta) e non su main; OCOR-DEV-0049 si integra dopo la chiusura verificata di OCOR-DEV-REM-0017. Il change set parte quindi dal candidato sigillato e REM-0017 ne fissera' l'HEAD verificato al posto di df444af.\\\",\\n    \\\"remediation_record\\\": \\\"reports/assurance/OCOR-DEV-REM-0019-RCCAD/OCOR-DEV-REM-0019.json\\\",\\n}\\nrequalification_path = \\\"reports/evidence/G4/OCOR-DEV-0049.requalified-rem0019.json\\\"\\n\\n# -- requirement results of the requalification ---------------------------------------------------\\nrequirement_results = []\\nfor entry in sealed[\\\"requirement_results\\\"]:\\n    name = entry[\\\"command\\\"].rsplit(\\\"(\\\", 1)[1].rstrip(\\\")\\\")\\n    assert per_function[name] > 0, name\\n    requirement_results.append({**entry, \\\"result\\\": {\\\"passed\\\": per_function[name], \\\"failed\\\": 0, \\\"skipped\\\": 0,\\n                                                     \\\"not_executed\\\": 0}, \\\"status\\\": \\\"PASS\\\"})\\nassert sum(r[\\\"result\\\"][\\\"passed\\\"] for r in requirement_results) == 390 * len(MODULE_RUNS)\\n\\nDEPENDENCIES = [\\n    (\\\"test_ops_process_serves_health_and_blocks_readiness_until_restore_is_tested\\\", 1,\\n     \\\"osservava il carrier ops condiviso prima di ogni restore: falliva se un test precedente aveva gia' prodotto una receipt\\\", \\\"fixture untested_ops: carrier Compose proprio su vault vuoto\\\"),\\n    (\\\"test_backup_seals_an_encrypted_signed_immutable_recovery_point\\\", 1,\\n     \\\"produttore, non dipendente (passa da solo su df444af): sigillava il recovery point del vault condiviso (len == 1) consumato dai test successivi\\\", \\\"sigilla in un vault proprio; il recovery point condiviso lo produce la fixture tested\\\"),\\n    (\\\"test_isolated_restore_replays_tombstones_and_passes_the_recovery_gate\\\", 1,\\n     \\\"richiedeva il recovery point del test di backup e produceva la receipt e replay_digest usati dai test successivi\\\", \\\"fixture tested; restore in una copia del vault condiviso senza receipt; replay_digest fissato da tested\\\"),\\n    (\\\"test_readiness_turns_ready_only_with_a_signed_passed_restore_receipt\\\", 1,\\n     \\\"richiedeva la receipt del test di restore e un recovery point piu' recente dell'RPO (15 min), vero solo subito dopo il backup\\\", \\\"fixture fresh_tested_ops: carrier proprio, sigillato e testato subito prima\\\"),\\n    (\\\"test_mutative_path_reopens_only_by_a_human_bound_to_the_passed_receipt\\\", 1,\\n     \\\"richiedeva il percorso mutativo ancora chiuso: falliva dopo una riapertura umana precedente\\\", \\\"fixture reopen_pending: un nuovo restore testato chiude il percorso (comportamento asserito dal test di replay)\\\"),\\n    (\\\"test_restore_replay_is_deterministic\\\", 1, \\\"richiedeva receipt e replay_digest del test di restore\\\", \\\"fixture tested\\\"),\\n    (\\\"test_tampered_recovery_point_is_rejected_before_restore\\\", 2, \\\"richiedeva il recovery point del test di backup\\\", \\\"fixture tested\\\"),\\n    (\\\"test_tampered_restore_receipt_blocks_readiness\\\", 1, \\\"richiedeva la receipt del test di restore\\\", \\\"fixture tested\\\"),\\n    (\\\"coherence_ops (fixture) e i 7 test che la usano\\\", 97, \\\"copia del vault condiviso: richiedeva la receipt del test di restore\\\", \\\"coherence_ops dipende da tested\\\"),\\n    (\\\"test_restart_under_another_release_profile_or_pins_blocks_readiness_reopen_and_admission\\\", 3, \\\"richiedeva la receipt del test di restore\\\", \\\"fixture tested\\\"),\\n    (\\\"test_restart_under_the_tested_release_is_ready_and_reopenable\\\", 1, \\\"richiedeva la receipt del test di restore\\\", \\\"fixture tested\\\"),\\n    (\\\"test_new_release_is_ready_only_after_its_own_backup_and_tested_restore\\\", 1, \\\"copia del vault condiviso con la receipt del test di restore\\\", \\\"fixture tested\\\"),\\n    (\\\"test_dependency_fault_blocks_readiness_and_degrades_posture\\\", 5, \\\"richiedeva il carrier condiviso READY e riaperto da un umano (mutative ammesso per qdrant e kafka)\\\", \\\"fixture reopened\\\"),\\n    (\\\"test_emergency_stop_denies_mutative_capabilities_within_10_seconds\\\", 1, \\\"richiedeva il carrier condiviso READY e riaperto (mutative 200 prima dello stop)\\\", \\\"fixture reopened\\\"),\\n    (\\\"test_open_public_egress_blocks_readiness\\\", 1, \\\"governed_reopen sulla receipt del vault condiviso\\\", \\\"fixture tested\\\"),\\n    (\\\"test_public_network_dependency_prevents_the_process_from_starting\\\", 1, \\\"montava stack.work/agent.py scritto dal primo agente standalone di un altro test\\\", \\\"agent.py scritto dalla fixture stack\\\"),\\n    (\\\"test_logs_and_traces_carry_governed_fields_and_no_secrets\\\", 1, \\\"richiedeva nei log del carrier condiviso un DEPENDENCY_DOWN (prodotto dai test di fault) e un READY\\\", \\\"fixture fault_observed: pausa e ripresa di qdrant, poi READY\\\"),\\n]\\nPRODUCERS = {\\\"test_backup_seals_an_encrypted_signed_immutable_recovery_point\\\"}\\nassert sum(n for t, n, _, _ in DEPENDENCIES if t not in PRODUCERS) == 119\\ndesign = {\\n    \\\"dependency_analysis\\\": [{\\\"test\\\": t, \\\"cases\\\": n, \\\"dependency_on_df444af\\\": d, \\\"remedy\\\": r,\\n                             \\\"state_dependent\\\": t not in PRODUCERS} for t, n, d, r in DEPENDENCIES],\\n    \\\"dependency_analysis_method\\\": \\\"lettura di ogni fixture e test live del modulo (stato del carrier ops condiviso, del vault condiviso, di stack.work e dei log del carrier) e conferma sperimentale con i gruppi RED su df444af\\\",\\n    \\\"independent_before_and_after\\\": \\\"271 casi senza stato live condiviso (logica dell'agente, rendering Helm, profili, receipt/checkpoint su dati, server HTTP locali, capture, snapshot Qdrant, quote, scope, journal incoerente, tied-epoch, drift/scanner sul vault tuned, default deny, pins, policy digest, Helm su kind, VF-006)\\\",\\n    \\\"fixtures\\\": {\\n        \\\"stack\\\": \\\"invariata salvo agent.py scritto all'avvio e l'avvio del carrier tramite start_ops\\\",\\n        \\\"tested\\\": \\\"modulo; backup + restore isolato nel vault condiviso, replay_digest, carrier condiviso verificato\\\",\\n        \\\"reopen_pending\\\": \\\"funzione; se il carrier condiviso e' gia' riaperto, un nuovo restore testato chiude il percorso mutativo\\\",\\n        \\\"reopened\\\": \\\"funzione; READY e riapertura umana governata se pendente\\\",\\n        \\\"fault_observed\\\": \\\"funzione; pausa/ripresa di qdrant osservate su readiness, poi READY\\\",\\n        \\\"untested_ops\\\": \\\"funzione; carrier Compose proprio su vault vuoto\\\",\\n        \\\"fresh_tested_ops\\\": \\\"funzione; carrier Compose proprio sigillato e testato subito prima (entro l'RPO)\\\",\\n    },\\n    \\\"production_unchanged\\\": {\\\"command\\\": f\\\"git diff --name-only {BASE} {code_commit}\\\", \\\"paths\\\": changed},\\n    \\\"case_mapping\\\": {\\\"rule\\\": \\\"uno a uno per node id: nessun caso rimosso, unito, spezzato, rinominato o aggiunto\\\",\\n                     \\\"collected_before\\\": 390, \\\"collected_after\\\": len(collected),\\n                     \\\"node_ids_sha256\\\": sha((\\\"\\\\n\\\".join(collected) + \\\"\\\\n\\\").encode())},\\n    \\\"assertion_identity\\\": {\\\"command\\\": f\\\"python3 assertion_identity.py <repo> {BASE} {code_commit}\\\", \\\"report\\\": identity[\\\"counts\\\"],\\n                           \\\"renamed_observed_object_only\\\": identity[\\\"identical_after_rename\\\"],\\n                           \\\"new_helpers_or_fixtures\\\": identity[\\\"new_helpers_or_fixtures\\\"]},\\n}\\nindependence = {\\n    \\\"orders\\\": {label: next(c[\\\"order\\\"] for c in module_commands if c[\\\"label\\\"] == label) for label in MODULE_RUNS},\\n    \\\"seeds\\\": orders_meta[\\\"seeds\\\"], \\\"shuffle\\\": orders_meta[\\\"python_random\\\"],\\n    \\\"order_preservation\\\": \\\"pytest esegue i node id nell'ordine degli argomenti: verificato per ogni run confrontando l'ordine JUnit con l'ordine richiesto\\\",\\n    \\\"isolated_runs\\\": isolated,\\n    \\\"non_qualifying_attempts\\\": attempts,\\n    \\\"isolated_rule\\\": \\\"un processo pytest per ciascuno dei 119 casi oggi dipendenti da stato precedente (design.dependency_analysis con state_dependent true), nessun altro test nel processo\\\",\\n}\\nresidual = [\\n    \\\"Le fixture reopen_pending e fault_observed modificano lo stato del carrier ops condiviso nel modo gia' asserito dai test (nuovo restore testato; pausa/ripresa di qdrant): nessun nuovo comportamento di prodotto e' richiesto o verificato da esse.\\\",\\n    \\\"Il modulo resta legato al tick */15 della CronJob nel caso Helm: la durata di una part