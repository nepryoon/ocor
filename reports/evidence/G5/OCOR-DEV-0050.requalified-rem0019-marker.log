{"command": "captured artifact", "exit_code": 0, "label": "assurance-check.py", "output": "\"\"\"Recompute candidate input/log hashes, counts and exact JUnit unions at HEAD.\"\"\"\nimport hashlib\nimport json\nimport subprocess\nimport sys\nimport xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom pathlib import Path\n\nrepo, head = Path(sys.argv[1]), sys.argv[2]\nSOURCE = '6e1c4b050ac610a22673d6f559e424a01705189c'\nBASE = 'df444af855e884d7783612b302e008b90105fe13'\npaths = ['reports/assurance/OCOR-DEV-REM-0019-RCCAD/OCOR-DEV-REM-0019.r1-marker.json',\n         'reports/evidence/G4/OCOR-DEV-0049.requalified-rem0019-r1-marker.json',\n         'reports/evidence/G5/OCOR-DEV-0050.requalified-rem0019-marker.json']\n\n\ndef show(path, ref=head):\n    return subprocess.check_output(['git', 'show', f'{ref}:{path}'], cwd=repo)\n\n\ndef git(*args):\n    return subprocess.check_output(['git', *args], cwd=repo, text=True).strip()\n\n\ndef sha(data):\n    return hashlib.sha256(data).hexdigest()\n\n\ndef identity(n):\n    path, *parts = n.removeprefix('ocor-runtime/').split('::')\n    return ('.'.join([path[:-3].replace('/', '.'), *parts[:-1]]), parts[-1])\n\n\nrecords = [json.loads(show(p)) for p in paths]\nraw = show(paths[0].replace('.json', '.log'))\nentries = [json.loads(line) for line in raw.decode().splitlines()]\nassert len(entries) == len({e['label'] for e in entries})\nby_label = {e['label']: e for e in entries}\nfor e in entries:\n    assert sha(e['output'].encode()) == e['sha256'], e['label']\nfor path, record in zip(paths, records, strict=True):\n    assert record['status'] == 'CANDIDATE_AWAITING_INDEPENDENT_VERIFICATION'\n    assert record['independent_verification']['status'] == 'PENDING'\n    assert record['commit'] == SOURCE and record['result'] == 'PASS'\n    assert show(path.replace('.json', '.log')) == raw\n    assert record['raw_output_sha256'] == sha(raw)\n    assert record['environment']['branch'] == git('branch', '--show-current')\n    assert record['claims'] == dict(E1=0, E2=0, Verified=0, PoC_GO='NO-GO', Production_readiness='NO-GO', runtime_conformance='NOT_ESTABLISHED')\n    for p, digest in record['inputs'].items():\n        for ref in [SOURCE, head]:\n            actual = git('rev-parse', ref + ':inputs') if p == 'inputs_tree' else sha(show(p, ref))\n            assert actual == digest, (path, ref, p)\n    assert all(c['exit_code'] == 0 and c['status'] == 'PASS' for c in record['commands'])\nfor root in ['deploy', 'infra', 'inputs', 'ocor-runtime/src', 'ocor-runtime/tests', 'ocor-runtime/tools', 'ocor-runtime/sdk']:\n    assert git('rev-parse', f'{SOURCE}:{root}') == git('rev-parse', f'{head}:{root}')\nassert show('scripts/validate_ocor_development_plan.py', SOURCE) == show('scripts/validate_ocor_development_plan.py')\nassert show('reports/evidence/G4/OCOR-DEV-0049.json', BASE) == show('reports/evidence/G4/OCOR-DEV-0049.json')\n\n\ndef cases(label):\n    data = by_label[label + '-junit']['output']\n    result = list(ET.fromstring(data).iter('testcase'))\n    assert not any(child.tag in ('failure', 'error', 'skipped') for case in result for child in case)\n    meta = json.loads(by_label[label + '-metadata']['output'])\n    assert meta['head_sha'] == SOURCE and meta['exit_code'] == 0 and meta['watchdog_error'] is None\n    assert meta['counts'] == dict(tests=len(result), failures=0, errors=0, skipped=0)\n    assert meta['duration_seconds'] <= (4500 if label == 'full' else 2700)\n    return result\n\n\nnodes = json.loads(by_label['campaign-full-collected.json']['output'])\nfull = cases('full')\nassert len(nodes) == len(full) == 2224\nassert Counter(map(identity, nodes)) == Counter((c.get('classname'), c.get('name')) for c in full)\nmodules = [n.split('::', 1)[1] for n in nodes if 'test_ocor_dev_0049.py::' in n]\nfor row in records[0]['independence']['orders']:\n    label = row['label']\n    ordered = [n.split('::', 1)[1] for n in by_label[label + '-order']['output'].splitlines()]\n    executed = [c.get('name') for c in cases(label)]\n    assert executed == ordered and Counter(ordered) == Counter(modules) and len(ordered) == 390\n    assert not any(row['residue'].values())\nisolated = records[0]['independence']['isolated_runs']\nassert len(isolated) == len({i['node'] for i in isolated}) == 119\nfor row in isolated:\n    assert [c.get('name') for c in cases(row['label'])] == [row['node'].split('::')[-1]]\n    assert not any(row['residue'].values())\nresult = json.loads(by_label['campaign-driver-result.json']['output'])\nassert result['status'] == 'PASS' and result['teardown_exit_code'] == 0\nassert result['full']['union'] == dict(collected=2224, executed=2224, missing=[], unexpected=[], duplicated=[])\nassert not any(json.loads(by_label['campaign-full-resource-audit.json']['output'])['new_resources'].values())\nledger = records[0]['qualification_campaign']['attempt_ledger']\nassert len(ledger) == 125 and len({r['label'] for r in ledger}) == 125\nfor row in ledger:\n    archived = json.loads(by_label[row['label'] + '-attempt-result']['output'])\n    assert archived['status'] == 'PASS_COMPONENT_ONLY' and archived['head_sha'] == SOURCE\n    assert archived['valid_attempt'] == f\"attempt-{row['valid_attempt']}\"\n    if row['label'] == 'order-seed-190001':\n        assert row['valid_attempt'] == 2 and len(row['diagnostic_attempts']) == 1\n        d = row['diagnostic_attempts'][0]\n        assert d['qualifying'] is False and not d['diagnosis']['counts_in_qualification_totals']\n        assert d['diagnosis']['junit_counts_observed'] == dict(tests=390, failures=0, errors=0, skipped=0)\n        assert sha(by_label['diagnostic-order-seed-190001-attempt-1-diagnosis']['output'].encode()) == d['diagnosis_sha256']\n    else:\n        assert row['valid_attempt'] == 1 and row['diagnostic_attempts'] == []\nassert not any(result['final_inventory']['new_resources'].values())\nassert not result['final_inventory']['owned_compose_containers'] and result['final_inventory']['kind_node_present'] is False\nassert records[0]['qualification_campaign']['previous_commit_runs_qualifying'] is False\nassert len(records[0]['environment']['acquisition_epochs']) == 2\nassert all('Claude Code' in r['roles']['implementer'] and 'Codex' in r['roles']['implementer'] and 'Grok 4.7' in r['roles']['verifier'] for r in records)\nsealed = json.loads(show('reports/evidence/G4/OCOR-DEV-0049.json', BASE))\nassert records[1]['supersedes'] == (sealed.get('record_id') or sealed['commit'])\nassert records[1]['superseded_record']['sha256'] == sha(show('reports/evidence/G4/OCOR-DEV-0049.json', BASE))\nassert sum(r['result']['passed'] for r in records[1]['requirement_results']) == 1950\nmem = [(c.get('classname'), c.get('name')) for c in full if c.get('classname') == 'tests.tasks.test_ocor_dev_0050']\nassert len(mem) == 198 and Counter(mem) == Counter(map(tuple, records[2]['regression_case_identity']))\nassert records[2]['review_scope'].startswith('REGRESSION_ONLY')\nmem_cases = [c for c in full if c.get('classname') == 'tests.tasks.test_ocor_dev_0050']\nfor row in records[2]['requirement_results']:\n    assert row['result'] == dict(passed=sum(c.get('name').split('[', 1)[0] in row['tests'] for c in mem_cases), failed=0, skipped=0, not_executed=0)\n    assert row['scope'].startswith('REGRESSION_ONLY') and row['fresh_junit_sha256'] == by_label['full-junit']['sha256']\nfor gate, task, record_path in [('G4', 'OCOR-DEV-0049', paths[1]), ('G5', 'OCOR-DEV-0050', paths[2])]:\n    mf = json.loads(show(f'reports/evidence/{gate}/MANIFEST.json'))\n    e = next(e for e in mf['artifacts'] if e['task_id'] == task)\n    assert e['path'] == Path(record_path).name and e['sha256'] == sha(show(record_path))\n    e = next(e for e in mf['artifacts'] if e['task_id'] == task + '-RAW')\n    assert e['path'] == Path(record_path).with_suffix('.log').name and e['sha256'] == sha(raw)\nprint(json.dumps(dict(status='PASS', head_sha=head, source_head=SOURCE, counts=dict(full=2224, modules=1950, isolated=119, regression_0050=198)), indent=2, sort_keys=True))\n", "sha256": "5767440f0cfb4ae96280419dd69d494e0bff16e1bf8f87c071fa2e14f962ec51"}
