{"command": "captured artifact", "exit_code": 0, "label": "campaign-driver.py", "output": "import json,os,subprocess,sys,time,xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom datetime import UTC,datetime\nfrom pathlib import Path\nD=Path(__file__).parent\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nPY=str(R/'ocor-runtime/.venv/bin/python')\nenv=os.environ.copy()\nenv.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')\nHEAD=subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()\ndef dump(name,obj):\n (D/name).write_text(json.dumps(obj,indent=2,sort_keys=True)+'\\n')\ndef progress(msg):\n with (D/'driver.progress').open('a') as f:f.write(datetime.now(UTC).isoformat()+' '+msg+'\\n')\ndef resources():\n return {k:sorted(subprocess.check_output(['docker',*v],text=True,timeout=30).split()) for k,v in {'containers':['ps','-aq','--no-trunc'],'networks':['network','ls','-q','--no-trunc'],'volumes':['volume','ls','-q']}.items()}\ndef run(label,cmd,timeout=700):\n progress('START '+label)\n with (D/(label+'.out')).open('w') as f:\n  r=subprocess.run(cmd,cwd=R,env=env,stdout=f,stderr=subprocess.STDOUT,timeout=timeout)\n progress('EXIT '+label+' '+str(r.returncode))\n assert r.returncode==0,'failed '+label\ndef identity(n):\n path,*parts=n.removeprefix('ocor-runtime/').split('::')\n return ('.'.join([path[:-3].replace('/','.'),*parts[:-1]]),parts[-1])\ndef check_run(label,nodes):\n meta=json.loads((D/(label+'.json')).read_text())\n assert meta['head_sha']==HEAD and not meta['watchdog_error']\n assert meta['counts']==dict(tests=len(nodes),failures=0,errors=0,skipped=0)\n cases=list(ET.parse(D/(label+'.xml')).getroot().iter('testcase'))\n assert Counter(map(identity,nodes))==Counter((c.get('classname'),c.get('name')) for c in cases),'JUnit union'\n return meta\nresult={'status':'RUNNING','head_sha':HEAD,'repair_cycle':1}\ntry:\n assert not subprocess.check_output(['git','status','--porcelain'],cwd=R,text=True),'dirty source'\n assert json.loads((D/'preflight-result.json').read_text())['status']=='PASS'\n t=time.monotonic()\n # Collection is part of this exact-head qualification, no cases dropped.\n c=subprocess.run(['uv','run','--project','ocor-runtime','--frozen','--extra','test','--extra','lint','pytest','--collect-only','-q','ocor-runtime/tests/'],cwd=R,env=env,capture_output=True,text=True,timeout=180)\n (D/'full-collection.log').write_text(c.stdout+c.stderr)\n assert c.returncode==0\n nodes=[n for n in c.stdout.splitlines() if n.startswith(('tests/','ocor-runtime/tests/')) and '::' in n]\n assert len(nodes)==len(set(nodes)) and nodes\n dump('full-collected.json',nodes)\n before=resources();dump('full-resources-before.json',before)\n run('full-driver',[sys.executable,str(D/'run_nodes.py'),'full'],4650)\n meta=check_run('full',nodes)\n after=resources();dump('full-resources-after.json',after)\n residue={k:sorted(set(after[k])-set(before[k])) for k in after}\n dump('full-resource-audit.json',{'status':'PASS' if not any(residue.values()) else 'FAIL','new_resources':residue})\n assert before==after,'full runtime resource inventory changed'\n result['full']={'status':'PASS','counts':meta['counts'],'duration_seconds':meta['duration_seconds'],'union':{'collected':len(nodes),'executed':len(nodes),'missing':[],'unexpected':[],'duplicated':[]}}\n dump('driver-result.json',result)\n if meta['duration_seconds']>3600:result['duration_po_decision_required']=True\n # Verify all five immutable module lists match current collection.\n module_nodes=[n.removeprefix('ocor-runtime/') for n in nodes if 'test_ocor_dev_0049.py::' in n]\n assert len(module_nodes)==390\n for label in ['order-collection','order-reverse','order-seed-190001','order-seed-190002','order-seed-190003']:\n  ordered=(D/(label+'.order')).read_text().splitlines()\n  assert Counter(n.removeprefix('ocor-runtime/') for n in ordered)==Counter(module_nodes)\n run('module-campaign',[sys.executable,str(D/'modules.py'),'order-collection','order-reverse','order-seed-190001','order-seed-190002','order-seed-190003'],18000)\n for label in ['order-collection','order-reverse','order-seed-190001','order-seed-190002','order-seed-190003']:\n  ordered=(D/(label+'.order')).read_text().splitlines()\n  check_run(label,ordered)\n  executed=[c.get('name') for c in ET.parse(D/(label+'.xml')).getroot().iter('testcase')]\n  assert executed==[n.split('::',1)[1] for n in ordered],label+' order mismatch'\n isolated=(D/'isolated.txt').read_text().splitlines()\n assert len(isolated)==119 and len(set(isolated))==119\n assert set(n.removeprefix('ocor-runtime/') for n in isolated)<=set(module_nodes)\n run('isolated-campaign',[sys.executable,str(D/'campaign.py'),'isolated'],9000)\n for i,n in enumerate(isolated,1):check_run(f'iso-{i:03d}',[n])\n result['status']='PASS'\n result['duration_seconds']=time.monotonic()-t\nexcept Exception as e:\n result.update(status='FAIL',error=str(e))\n progress('FAIL '+str(e))\nfinally:\n with (D/'teardown.log').open('w') as f:\n  r=subprocess.run([PY,'scripts/reset_test_environment.py','--execute','--env-file',str(R/'.ocor/bootstrap.env')],cwd=R,env=env,stdout=f,stderr=subprocess.STDOUT,timeout=600)\n result['teardown_exit_code']=r.returncode\n dump('session-resources-after.json',resources())\n if r.returncode:result['status']='FAIL'\n dump('driver-result.json',result)\n progress('DONE '+result['status'])\n\nsys.exit(0 if result[\"status\"] == \"PASS\" else 1)\n", "sha256": "57a09ab2b0b632720691c2c9533ccdefe774a18869744378cfe24335b9401e90"}
{"command": "captured artifact", "exit_code": 0, "label": "campaign-run_nodes.py", "output": "import os,sys,subprocess,time,signal,json,threading,xml.etree.ElementTree as ET\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nout=Path(__file__).parent\nrepo=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nci=repo.parent/'ocor-dev-rem-0017-ci-provision-spire'\nsys.path.insert(0,str(ci/'scripts'))\nfrom run_qualifying_campaign import inspect_stack, check_stack, inspect_kubernetes_runtimes, check_kubernetes_runtimes, collect_kubernetes_diagnostics\nfrom bootstrap_ci_environment import redact_campaign_log\nimport watchdog_safe\nfrom watchdog_safe import inspect_kubernetes_runtimes, REMOVALS\nlabel=sys.argv[1]\nenv=os.environ.copy()\nenv['PATH']='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:'+env['PATH']\nsecrets=dict(line.split('=',1) for line in (repo/'.ocor/bootstrap.env').read_text().splitlines() if '=' in line)\nenv.update(secrets)\nenv['OCOR_BOOTSTRAP_ENV']=str(repo/'.ocor/bootstrap.env')\nenv['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:[REDACTED]@127.0.0.1:55433/ocor'\ncmd=['uv','run','--project','ocor-runtime','--frozen','--extra','test','--extra','lint','pytest','-v','-ra','-p','no:cacheprovider','--basetemp='+str(out/('bt-'+label)),'--junitxml='+str(out/(label+'.xml'))]\nif label.startswith('probe-'):\n cmd[cmd.index('pytest')+1:cmd.index('pytest')+1]=['-p','inject500']\n env['PYTHONPATH']=str(out)\norder_file=out/(label+'.order') if (out/(label+'.order')).exists() else None\nif order_file:cmd+=[line for line in order_file.read_text().splitlines() if line.strip()]\nelif label=='full':cmd+=['ocor-runtime/tests/']\nelif label=='reports':cmd+=['reports/tests/test_generate_contracts_reference_resolution.py','reports/tests/test_language_migration_benchmark_harness.py','reports/tests/test_backlog_generator_reality_parity.py','reports/tests/test_runtime_evidence_validator.py','reports/tests/test_evidence_input_drift.py']\nelse:\n cmd+=['ocor-runtime/tests/tasks/test_ocor_dev_0049.py']\n if label.startswith('focused'):cmd+=['-k','tied_epoch or checkpoint or recovery_point or time_branches or backup_seals or isolated_restore or coherent or incoherent or memory_branch']\ninitial=inspect_stack()\nkind_history={}\nassert len(initial)==11, \"eleven mandatory services required\"\nvolume_provenance={}\nstop_provenance=threading.Event()\ndef observe_spike_volumes():\n while not stop_provenance.is_set():\n  ids=subprocess.check_output(['docker','ps','-aq','--filter','name=ocor-spike-'],text=True).split()\n  if ids:\n   result=subprocess.run(['docker','inspect',*ids],capture_output=True,text=True)\n   if result.returncode==0:\n    for container in json.loads(result.stdout):\n     if not container['Name'].startswith(('/ocor-spike-0019-','/ocor-spike-0023-','/ocor-c5-backbone-')):continue\n     for mount in container.get('Mounts',[]):\n      if mount['Type']=='volume':volume_provenance[mount['Name']]={'container':container['Name'],'image_id':container['Image'],'destination':mount['Destination']}\n  stop_provenance.wait(0.5)\nobserver=None\nif label=='full':\n observer=threading.Thread(target=observe_spike_volumes,daemon=True);observer.start()\ndef observe_kind():\n while not stop_provenance.wait(10):\n  result=subprocess.run(['docker','inspect','ocor-poc-control-plane'],capture_output=True,text=True,timeout=10)\n  if result.returncode==0:\n   with (out/(label+'-kind-diagnostics-private.log')).open('a') as diag:\n    diag.write(result.stdout)\n    subprocess.run(['docker','exec','ocor-poc-control-plane','journalctl','-u','containerd','--since','30 seconds ago','--no-pager'],stdout=diag,stderr=subprocess.STDOUT,timeout=10)\nkind_observer=threading.Thread(target=observe_kind,daemon=True);kind_observer.start()\nstart=time.monotonic();started=datetime.now(timezone.utc).isoformat()\nlog=out/(label+'.log');log.touch(mode=0o600)\nerror=None\nwith log.open('w') as f:\n f.write('HEAD '+subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()+'\\nCOMMAND '+json.dumps(cmd)+'\\n');f.flush()\n p=subprocess.Popen(cmd,cwd=repo,env=env,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)\n sampler=watchdog_safe.start_sampler(p.pid)\n while p.poll() is None:\n  try:\n   check_stack(initial,inspect_stack())\n   check_kubernetes_runtimes(kind_history,inspect_kubernetes_runtimes())\n   limit=4500 if label=='full' else 2700\n   if label.startswith('iso-'):limit=900\n   if time.monotonic()-start>limit:raise RuntimeError(str(limit//60)+' minute suite limit exceeded')\n  except Exception as exc:\n   error=str(exc)\n   collect_kubernetes_diagnostics(out/(label+\"-kind-watchdog.log\"))\n   os.killpg(p.pid,signal.SIGINT)\n   with (out/(label+'-diagnostics.log')).open('w') as diag:\n    subprocess.run(['docker','stats','--no-stream'],stdout=diag,stderr=subprocess.STDOUT,timeout=20)\n    for name in initial:subprocess.run(['docker','logs','--tail','100',name.lstrip('/')],stdout=diag,stderr=subprocess.STDOUT,timeout=15)\n   try:p.wait(timeout=60)\n   except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=10)\n   break\n  time.sleep(5)\n watchdog_safe.stop_sampler(sampler)\n f.write('\\nEXIT_CODE '+str(p.returncode)+'\\n')\nredact_campaign_log(repo,log)\nstop_provenance.set();kind_observer.join(timeout=20)\nif observer:\n observer.join(timeout=10)\n (out/'full-volume-provenance.json').write_text(json.dumps(volume_provenance,indent=2,sort_keys=True)+'\\n')\nresult={'command':cmd,'started_at':started,'finished_at':datetime.now(timezone.utc).isoformat(),'duration_seconds':time.monotonic()-start,'exit_code':p.returncode,'watchdog_error':error,'owned_node_observation_removals':REMOVALS,'owned_node_observation_rejections':watchdog_safe.REJECTIONS,'owned_kind_remover_observations':watchdog_safe.REMOVER_OBSERVATIONS,'head_sha':subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()}\nif (out/(label+'.xml')).exists():\n tree=ET.parse(out/(label+'.xml')).getroot();suites=[tree] if tree.tag=='testsuite' else list(tree.iter('testsuite'))\n result['counts']={k:sum(int(s.get(k,'0')) for s in suites) for k in ['tests','failures','errors','skipped']}\n(out/(label+'.json')).write_text(json.dumps(result,indent=2,sort_keys=True)+'\\n')\nprint(json.dumps(result),flush=True)\nsys.exit(1 if error else p.returncode)\n", "sha256": "68977e5c206ef99c61c639a7a38c3b9c9df0d1090f64a79ee48c47cad62873d7"}
{"command": "captured artifact", "exit_code": 0, "label": "campaign-modules.py", "output": "\"\"\"REM-0019 module runs (collection, reverse, three seeded permutations).\n\nStart alignment (declared in the evidence, as in the 0049 stability runs): the accepted Helm\ncase waits for the next real */15 CronJob tick (5..905 s) after its own setup. Each run is\nstarted so that the predicted start of the Helm case falls ~550 s after a tick; the\nprediction sums the per-case JUnit times, before the Helm case in that order, measured in the\nprevious runs (first run: 1440 s, the offset observed in the 0049 stability runs). No case is\nremoved, skipped or reordered by the alignment; it only delays the start.\n\"\"\"\nimport json, subprocess, sys, time, xml.etree.ElementTree as ET\nfrom pathlib import Path\nout = Path(__file__).parent\nrepo = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nTARGET = 550\nHELM = 'test_helm_profile_on_kubernetes_backs_up_restores_and_gates_readiness'\n\n\ndef resources():\n    return {k: subprocess.check_output(['docker', *c], text=True).split() for k, c in {\n        'containers': ['ps', '-aq', '--no-trunc'], 'networks': ['network', 'ls', '-q', '--no-trunc'],\n        'volumes': ['volume', 'ls', '-q']}.items()}\n\n\ndef case_times() -> dict[str, float]:\n    times: dict[str, list[float]] = {}\n    for xml in sorted([*out.glob('order-*.xml'), *(out.parent / 'rem-0019').glob('order-*.xml'), *(out.parent / 'rem-0019-r1').glob('order-*.xml')]):\n        for case in ET.parse(xml).getroot().iter('testcase'):\n            times.setdefault(case.get('name', ''), []).append(float(case.get('time', '0')))\n    return {k: sum(v) / len(v) for k, v in times.items()}\n\n\nfailed: list[str] = []\nfor label in sys.argv[1:]:\n    nodes = [l for l in (out / f'{label}.order').read_text().splitlines() if l]\n    names = [n.split('::', 1)[1] for n in nodes]\n    times = case_times()\n    position = names.index(HELM)\n    predicted = sum(times[n] for n in names[:position]) + 8 if times else 1440.0\n    delay = (TARGET - (time.time() + 20 + predicted)) % 900\n    (out / f'{label}-alignment.json').write_text(json.dumps({\n        'target_seconds_after_tick': TARGET, 'predicted_helm_case_start_offset_seconds': round(predicted, 1),\n        'delay_seconds': round(delay, 1), 'helm_case_position': position,\n        'prediction_source': 'mean per-case JUnit time of previous module runs (cycle 0 and cycle 1)' if times else 'first run: 1440 s observed in the 0049 stability runs'},\n        indent=2, sort_keys=True) + '\\n')\n    time.sleep(delay)\n    health = subprocess.run([str(repo / 'ocor-runtime/.venv/bin/python'), 'scripts/verify_external_services.py', '--execute', '--typed'],\n                            cwd=repo, capture_output=True, text=True)\n    (out / f'{label}-health.log').write_text(health.stdout + health.stderr)\n    if health.returncode:\n        raise SystemExit(f'stack not healthy before {label}')\n    before = resources()\n    with (out / f'{label}.out').open('w') as f:\n        r = subprocess.run([sys.executable, str(out / 'run_nodes.py'), label], cwd=repo, stdout=f, stderr=subprocess.STDOUT)\n    after = resources()\n    residue = {k: sorted(set(after[k]) - set(before[k])) for k in after}\n    (out / f'{label}-residue.json').write_text(json.dumps(residue, indent=2, sort_keys=True) + '\\n')\n    result = json.loads((out / f'{label}.json').read_text())\n    counts = result.get('counts', {})\n    ok = (r.returncode == 0 and counts.get('tests') == 390 and not any(counts.get(k) for k in ('failures', 'errors', 'skipped'))\n          and not any(residue.values()))\n    with (out / 'modules.progress').open('a') as p:\n        p.write(json.dumps({'label': label, 'ok': ok, 'exit': r.returncode, 'counts': counts,\n                            'duration_seconds': round(result.get('duration_seconds', 0), 1), 'residue': residue}, sort_keys=True) + '\\n')\n    if not ok:\n        raise SystemExit('non-qualifying run '+label)\n(out / 'modules.done').write_text('PASS\\n' if not failed else 'FAILED ' + ' '.join(failed) + '\\n')\n", "sha256": "db2b698aa012d4228dcceb62b3f2316b8a5c6b31be7642b01eb1403c327371b1"}
{"command": "captured artifact", "exit_code": 0, "label": "campaign-campaign.py", "output": "\"\"\"REM-0019 independence campaign: isolated runs of every state-dependent case, then the\nmodule in collection order, reverse order and three seeded permutations. Stops at the first\nnon-qualifying run (failure, error, skip, missing case or residue).\"\"\"\nimport json, subprocess, sys, time\nfrom pathlib import Path\nout = Path(__file__).parent\nrepo = Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nphase = sys.argv[1]\ndef resources():\n    return {k: subprocess.check_output(['docker', *c], text=True).split() for k, c in {\n        'containers': ['ps', '-aq', '--no-trunc'], 'networks': ['network', 'ls', '-q', '--no-trunc'],\n        'volumes': ['volume', 'ls', '-q']}.items()}\ndef run(label, nodes, expected):\n    (out / f'{label}.order').write_text('\\n'.join(nodes) + '\\n')\n    before = resources()\n    with (out / f'{label}.out').open('w') as f:\n        r = subprocess.run([sys.executable, str(out / 'run_nodes.py'), label], cwd=repo, stdout=f, stderr=subprocess.STDOUT)\n    after = resources()\n    residue = {k: sorted(set(after[k]) - set(before[k])) for k in after}\n    (out / f'{label}-residue.json').write_text(json.dumps(residue, indent=2, sort_keys=True) + '\\n')\n    result = json.loads((out / f'{label}.json').read_text())\n    counts = result.get('counts', {})\n    ok = (r.returncode == 0 and counts.get('tests') == expected and not any(counts.get(k) for k in ('failures', 'errors', 'skipped'))\n          and not any(residue.values()))\n    with (out / f'{phase}.progress').open('a') as p:\n        p.write(json.dumps({'label': label, 'ok': ok, 'exit': r.returncode, 'counts': counts,\n                            'duration_seconds': round(result.get('duration_seconds', 0), 1), 'residue': residue}, sort_keys=True) + '\\n')\n    if not ok:\n        raise SystemExit(f'non-qualifying run {label}')\nif phase == 'isolated':\n    nodes = [l for l in (out / 'isolated.txt').read_text().splitlines() if l]\n    for n, node in enumerate(nodes, 1):\n        run(f'iso-{n:03d}', [node], 1)\nelse:\n    for label in sys.argv[2:]:\n        nodes = [l for l in (out / f'{label}.order').read_text().splitlines() if l]\n        health = subprocess.run([str(repo / 'ocor-runtime/.venv/bin/python'), 'scripts/verify_external_services.py', '--execute', '--typed'],\n                                cwd=repo, capture_output=True, text=True)\n        (out / f'{label}-health.log').write_text(health.stdout + health.stderr)\n        if health.returncode:\n            raise SystemExit(f'stack not healthy before {label}')\n        run(label, nodes, 390)\n(out / f'{phase}.done').write_text('PASS\\n')\n", "sha256": "f80aaab421e8b888c7a5a75573e6356e37e8e0ff3974568214fe4fdaa59e3a9c"}
{"command": "captured artifact", "exit_code": 0, "label": "campaign-prepare.py", "output": "import sys\nimport hashlib,json,os,re,shutil,subprocess,time\nfrom pathlib import Path\nD=Path(__file__).parent\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019')\nPY=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0019/ocor-runtime/.venv/bin/python')\nenv=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')\nrows=[]\ndef dump(p,d):p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\\n')\ndef inventory():\n return {k:sorted(subprocess.check_output(c,text=True,timeout=30,env=env).splitlines()) for k,c in [('containers',['docker','ps','-aq']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','-q'])]}\ndef run(label,c,limit=600):\n t=time.monotonic();r=subprocess.run(c,cwd=R,env=env,capture_output=True,text=True,timeout=limit)\n out=r.stdout+r.stderr\n for k,v in values.items():\n  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:out=out.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n p=D/(label+'.log');p.write_text(out);p.chmod(0o600)\n row={'label':label,'command':c,'exit_code':r.returncode,'duration_seconds':round(time.monotonic()-t,3),'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest()};rows.append(row);dump(D/'preflight-commands.json',rows);print(label,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(label+' failed; inspect redacted log')\n return out\nvalues=dict(l.split('=',1) for l in Path('/home/luca/projects/ocor-detailed-design/.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\nfor k in values:env.pop(k,None)\nsecret=R/'.ocor/bootstrap.env';spire=R/'.ocor/spire';spire.mkdir(parents=True,exist_ok=True)\nsubprocess.run(['openssl','req','-x509','-newkey','rsa:3072','-nodes','-keyout',str(spire/'ca.key'),'-out',str(spire/'ca.crt'),'-days','2','-subj','/C=IT/O=OCOR Test/CN=OCOR SPIRE Test CA'],capture_output=True,check=True,timeout=30)\n(spire/'ca.key').chmod(0o600)\nvalues['OCOR_SPIRE_BOOTSTRAP_DIR']=str(spire);values['OCOR_SPIRE_JOIN_TOKEN']='bootstrap-pending'\nsecret.write_text(''.join(k+'='+v+'\\n' for k,v in sorted(values.items())));secret.chmod(0o600)\ndump(D/'resources-before.json',inventory())\nlock=json.loads((R/'infra/toolchain.lock.json').read_text());tools=[]\nfor x in lock['tools']:\n if x['provider']=='container':\n  props=json.loads(subprocess.check_output(['docker','image','inspect',x['container_image']],text=True,env=env,timeout=30))[0]\n  java=next(v.split('=',1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env']+'='))\n  assert java.removeprefix('jdk-')==x['version'];tools.append({'id':x['id'],'version':java,'expected_version':x['version'],'version_match':True,'digest_match':x['container_image'] in props['RepoDigests']});continue\n p=PY if x['id']=='python' else Path(shutil.which(x['command'],path=env['PATH']))\n v=subprocess.check_output([str(p),*x['version_args']],text=True,env=env,stderr=subprocess.STDOUT,timeout=30).strip()\n digest=hashlib.sha256(p.read_bytes()).hexdigest(); row={'id':x['id'],'path':str(p),'version':v,'version_match':bool(re.search(x['version_pattern'],v)),'sha256':digest,'digest_match':digest==x['integrity']};tools.append(row);assert row['version_match'] and row['digest_match'],x['id']\ndump(D/'toolchain.json',{'tools':tools})\ntry:\n run('inputs',['sha256sum','-c','inputs/normative/SHA256SUMS'])\n run('verify',[str(PY),'scripts/verify.py','--json'])\n pass  # Drift separately recorded FAIL for 0050; fresh requalification required, never waived.\n run('reset',[str(PY),'scripts/reset_test_environment.py','--execute'])\n run('bootstrap',[str(PY),'scripts/bootstrap_development_environment.py','--execute','--timeout','600'],700)\n values=dict(l.split('=',1) for l in secret.read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(secret)\n sys.path.insert(0,'/home/luca/projects/ocor-detailed-design/.ocor/worktrees/ocor-dev-rem-0017-ci-provision-spire/scripts')\n from bootstrap_ci_environment import ci_resources\n profile=ci_resources(R)\n run('bounded-fuseki-profile',['docker','compose','--env-file',str(secret),'-f','deploy/bootstrap/compose.yaml','-f',str(profile),'up','--detach','--no-build','--wait','--wait-timeout','120','fuseki'],180)\n actual=run('bounded-fuseki-process',['docker','top','ocor-bootstrap-fuseki-1','-eo','pid,args'])\n assert '-Xms128m -Xmx1G' in actual and '-Xmx4G' not in actual\n dump(D/'resource-profile.json',{'source_commit':'7d8e0fde9386ffc38a857eef50028a444155b9ed','recipe':'ci_resources','profile_sha256':hashlib.sha256(profile.read_bytes()).hexdigest(),'jvm_args':'-Xms128m -Xmx1G','cgroup_bytes':2147483648,'images_unchanged':True})\n run('sync-lint',['uv','sync','--project','ocor-runtime','--frozen','--extra','test','--extra','lint'])\n run('initialize',[str(PY),'deploy/bootstrap/init/initialize_services.py','--env-file',str(secret)])\n run('fixtures',[str(PY),'deploy/bootstrap/fixtures/load_fixtures.py','--env-file',str(secret)])\n run('svid',[str(PY),'/home/luca/.ocor-codex/rem0022-ci-evidence/register_control_plane.py'])\n health=json.loads(run('typed-health',[str(PY),'scripts/verify_external_services.py','--execute','--typed']))\n dump(D/'health.json',health)\n ids=subprocess.check_output(['docker','ps','-aq','--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True,env=env,timeout=30).split();assert len(ids)==11\n props=json.loads(subprocess.check_output(['docker','inspect',*ids],text=True,env=env,timeout=30))\n summary=[{'name':c['Name'],'image_id':c['Image'],'running':c['State']['Running'],'oom':c['State']['OOMKilled'],'restarts':c['RestartCount']} for c in props]\n assert all(c['running'] and not c['oom'] and c['restarts']==0 for c in summary);dump(D/'stack-summary.json',summary)\n dump(D/'preflight-result.json',{'status':'PASS','services':11,'toolchain_entries':len(tools)})\nexcept Exception as e:\n dump(D/'preflight-result.json',{'status':'FAIL','error':str(e)});raise\nfinally:\n run('restore-verify-report',['git','restore','reports/verify_report.json'])\n", "sha256": "2dda0baa6e9a00e6e9c4eb4d13794481de705637381f448c0e020aa95210577c"}
