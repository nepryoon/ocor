          self.assertIn('namespace', ctx)\\n                gen.close()\\n            self.assertEqual(resources['cluster'], preexisting)\\n            self.assertEqual(resources['volume'], preexisting)\\n            if not preexisting:\\n                self.assertFalse(resources['attachment'])\\n                self.assertIn(['kind', 'delete', 'cluster', '--name', 'ocor-poc'], calls)\\n            else:\\n                self.assertNotIn(['kind', 'delete', 'cluster', '--name', 'ocor-poc'], calls)\\n\\n    def test_failure_after_node_creation(self): self.exercise('create')\\n    def test_interrupt_during_creation(self): self.exercise('create', interrupt=True)\\n    def test_interrupt_after_network_attachment(self): self.exercise('attach', interrupt=True)\\n    def test_failure_loading_image(self): self.exercise('image')\\n    def test_failure_creating_namespace(self): self.exercise('namespace')\\n    def test_failure_before_helm_yield(self): self.exercise('helm')\\n    def test_success_yield_then_close(self): self.exercise()\\n    def test_preexisting_cluster_preserved(self): self.exercise(preexisting=True)\\n\\n\\nif __name__ == '__main__':\\n    unittest.main()\\n\"\n    },\n    \"verifier\": \"Grok 4.7 via Cursor CLI, external loop only; task touched by reserve Claude Code\"\n  },\n  \"local_gates\": {\n    \"HEAD_precheck\": \"10 commands exit 0 (plan --base-ref HEAD); dynamic assurance CI_REQUIRED\",\n    \"origin_main_plan\": \"FAIL; not counted as PASS\",\n    \"reports_pytest\": {\n      \"failed\": 0,\n      \"passed\": 48,\n      \"skipped\": 0\n    },\n    \"standalone_harnesses\": {\n      \"executed\": 5,\n      \"exit_codes\": [\n        0,\n        0,\n        0,\n        0,\n        0\n      ]\n    }\n  },\n  \"local_targeted_result\": {\n    \"command\": [\n      \"uv\",\n      \"run\",\n      \"--project\",\n      \"ocor-runtime\",\n      \"--frozen\",\n      \"--extra\",\n      \"test\",\n      \"--extra\",\n      \"lint\",\n      \"pytest\",\n  