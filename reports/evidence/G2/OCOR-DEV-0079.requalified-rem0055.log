{"command": "captured artifact: ~/.ocor-codex/rem-0055/redgreen_ci.sh", "exit_code": 0, "label": "script-redgreen_ci.sh", "output": "#!/bin/bash\n# RED/GREEN of OCOR-DEV-REM-0055 on the real backends (postgresql, terminusdb, typedb up; Kafka self-provisioned).\n# Fingerprint = sha256 of the sorted \"classname::name outcome\" lines of the JUnit XML,\n# outcome in {passed, failed, error, skipped}, newline-joined, trailing newline from print().\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT/ocor-runtime\"\nexport OCOR_LIVE_POSTGRES_DSN=$(cat ~/.ocor-codex/rem-0055/dsn_ci) OCOR_BOOTSTRAP_ENV=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0055/.ocor/bootstrap.env\necho \"head=$(git rev-parse HEAD) docker=$(docker ps --format '{{.Names}}' | sort | tr '\\n' ' ')\" > \"$OUT.log\"\n.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "23146efd02c2e8cb26ebb7351d8ec25a7cfb62f7de7ac1456a0e18a6bf79a8c8"}
{"command": "captured artifact: ~/.ocor-codex/rem-0055/iter2/rg.sh", "exit_code": 0, "label": "script-iter2-rg.sh", "output": "#!/bin/bash\n# Backend-free RED/GREEN of the preventive-review dispositions (live cases deselected); same fingerprint as redgreen_ci.sh.\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT/ocor-runtime\"\necho \"head=$(git rev-parse HEAD) tree=$(git write-tree 2>/dev/null)\" > \"$OUT.log\"\n.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "d40f14723a899fd28b59eb85d49ba7be0082a7dfcdc4431aca3123b862b3908c"}
