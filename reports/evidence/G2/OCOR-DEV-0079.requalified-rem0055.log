{"command": "captured artifact: ~/.ocor-codex/rem-0055-q/run.sh", "exit_code": 0, "label": "script-run.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0055 (B1 remediation of NCP-U08-LANE-TEMPORAL-READINESS): qualification campaign at the candidate head\n# (phases A, A3, B on the host stack, then phase C: the two-lane full suite, memory admission at start).\nset -u\nD=$HOME/.ocor-codex/rem-0055-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0055\nPY=$R/ocor-runtime/.venv/bin/python\nEXP=$1\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\nMP=\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nstep \"start head=$(git rev-parse HEAD)\"\ntest \"$(git rev-parse HEAD)\" = $EXP || { step \"FAIL head\"; exit 5; }\ntest -z \"$(git status --porcelain --untracked-files=no)\" || { step \"FAIL tracked changes\"; exit 6; }\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL stale credentials in worktree\"; exit 3; }\ntest ! -e $D/q || { step \"FAIL q exists\"; exit 4; }\nmkdir -p $D/q\nstep \"phase A\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py A >> $D/run.out 2>&1 || { step \"FAIL phase A\"; exit 1; }\ndocker ps --filter label=com.docker.compose.project=ocor-bootstrap -q | xargs docker inspect | python3 -c '\nimport json,sys\nout={c[\"Name\"].lstrip(\"/\"):{\"image_id\":c[\"Image\"],\"image_ref\":c[\"Config\"][\"Image\"],\"oom_killed\":c[\"State\"][\"OOMKilled\"],\"restart_count\":c[\"RestartCount\"],\"status\":c[\"State\"][\"Status\"]} for c in json.load(sys.stdin)}\nprint(json.dumps(out,indent=2,sort_keys=True))' > $D/backend_images.json && step \"backend images snapshot $(python3 -c \"import json;print(len(json.load(open('$D/backend_images.json'))))\") containers\"\nfor ph in A3 B; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\nmkdir $D/old-credentials-A || { step \"FAIL archive target exists\"; exit 4; }\nfor f in .ocor/bootstrap.env .ocor/spire .ocor/ci-resources.yaml; do test -e $f && mv $f $D/old-credentials-A/; done\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials not archived\"; exit 3; }\nstep \"credentials of phase A archived in old-credentials-A\"\nstep \"phase C power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\n( while true; do echo \"$(date -u +%s) $(awk '/^MemTotal|^MemAvailable/{printf \"%s \", $2}' /proc/meminfo)\" >> $D/mem-lanes.log; sleep 5; done ) &\nMP=$!\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\nkill $MP 2>/dev/null\nstep \"C rc=$rc power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity)\"\nexit $rc\n", "sha256": "992d0c52f97198dedbb1af5f62b63743f568a8ed862abad8dc3fbc8985a5d866"}
{"command": "captured artifact: ~/.ocor-codex/rem-0055-q/qualify_run.py", "exit_code": 0, "label": "script-qualify_run.py", "output": "\"\"\"OCOR-DEV-REM-0055 (B1 Temporal start-up wait) campaign (adapted from the REM-0054 campaign) from a clean shell.\n\nUsage: qualify_run.py <phase>. Each command's combined output goes to q/<label>.log;\nq/commands.jsonl gets label, command, cwd, exit code, duration, raw sha256, junit counts.\nStops at the first failure (fail-closed); tracked files are never edited.\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0055\")\nD = Path.home() / \".ocor-codex/rem-0055-q\"; Q = D / \"q\"; Q.mkdir(exist_ok=True)\nPATH = (D / \"locked-path\").read_text().strip()\nPY = \"ocor-runtime/.venv/bin/python\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\n\ndef live_env():\n    env_file = R / \".ocor/bootstrap.env\"\n    vals = dict(l.split(\"=\", 1) for l in env_file.read_text().splitlines() if \"=\" in l)\n    return {**ENV, \"OCOR_BOOTSTRAP_ENV\": str(env_file),\n            \"OCOR_LIVE_POSTGRES_DSN\": f\"postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor\"}\n\ndef junit(path):\n    root = ET.parse(path).getroot(); suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\ndef pytest(label, *targets, cwd=\".\"):\n    x = Q / f\"{label}.xml\"\n    return (label, [str(R / PY), \"-m\", \"pytest\", *targets, \"-p\", \"no:cacheprovider\", \"-q\", \"-rfEs\", \"--tb=short\", f\"--junitxml={x}\"], cwd, x)\n\nSVC_TESTS = [f\"deploy/bootstrap/services/{s}/{n}\" for s, n in ((\"typedb\", \"test_qualify.py\"), (\"openbao\", \"test_qualify.py\"), (\"spire\", \"test_qualify.py\"), (\"policy-identity\", \"test_security_services.py\"), (\"temporal\", \"test_qualify.py\"), (\"seaweedfs\", \"test_qualify.py\"))]\n# the unit module (backend-free and live cases) and the register/REM-0046/runtime evidence validator suites\nTASK = [\"ocor-runtime/tests/tasks/test_ocor_dev_rem_0055.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_runtime_evidence_validator.py\"]\n# regression-only requalifications, tests unchanged: 0005, 0050, 0082 (plan validator allowlist), 0073, 0075, 0079 (verify_external_services.py;\n# 0073 and 0075 are backed by the service qualification labels of phase A and the typed checks), REM-0038 (qualify.py and verify_external_services.py)\nREGRESSION = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0005\", \"0050\", \"0079\", \"0082\", \"rem_0038\")]\nREPORTS = [\"reports/tests/test_bootstrap_lock_validation.py\", \"reports/tests/test_autonomous_tooling_policy.py\", \"reports/tests/test_reset_teardown_residue.py\", \"reports/tests/test_evidence_input_drift.py\", \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_qualifying_campaign_guard.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_rem0034_secret_registry.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_backlog_generator_reality_parity.py\"]\n\nPHASES = {\n \"A\": [\n  (\"stack-absent-initial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"bootstrap\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"verify-manifest-only\", [PY, \"scripts/verify_external_services.py\", \"--manifest-only\"], \".\", None),\n  (\"verify-legacy-scan\", [PY, \"scripts/verify_external_services.py\"], \".\", None),\n  (\"verify-typed-execute\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"qualify-temporal-fault\", [PY, \"deploy/bootstrap/services/temporal/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-seaweedfs-fault\", [PY, \"deploy/bootstrap/services/seaweedfs/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-typedb-fault\", [PY, \"deploy/bootstrap/services/typedb/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-openbao-fault\", [PY, \"deploy/bootstrap/services/openbao/qualify.py\", \"--execute\", \"--fault-recovery\"], \".\", None),\n  (\"qualify-spire\", [PY, \"deploy/bootstrap/services/spire/qualify.py\"], \".\", None),\n  (\"qualify-policy-identity\", [PY, \"deploy/bootstrap/services/policy-identity/qualify_security_services.py\", \"--check\"], \".\", None),\n  *[(f\"fault-inject-{s}\", [PY, \"scripts/fault_inject_test_environment.py\", s, \"pause\", \"--bounded\", \"--execute\", \"--timeout\", \"60\"], \".\", None)\n    for s in (\"terminusdb\", \"typedb\", \"fuseki\", \"opa\", \"keycloak\", \"openbao\", \"spire-agent\")],\n  (\"verify-typed-after-faults\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"reset\", [PY, \"scripts/reset_test