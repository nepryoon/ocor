{"label": "artifact:build_evidence.py", "note": "captured artifact, not an additional executed check", "output": "\"\"\"Reconstruct candidate records from actual command/JUnit/inventory artifacts.\"\"\"\nimport hashlib,json,re,subprocess,xml.etree.ElementTree as ET\nfrom datetime import datetime,UTC\nfrom pathlib import Path\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0022');D=Path(__file__).parent\nBASE='63184cb250c5b385b06c98c69a227937b8ae8fb4'\nCODE='085d3fddbed03b4fe23c0ea4edf4ba37d441d505'\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\ndef dump(p,d):p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\\n')\ndef git(*args):return subprocess.check_output(['git',*args],cwd=R,text=True).strip()\nassert json.loads((D/'campaign-result.json').read_text())['status']=='PASS'\nassert json.loads((D/'union.json').read_text())['status']=='PASS'\nfor prefix in ['task','full']:\n assert (D/(prefix+'-resources-before.json')).read_bytes()==(D/(prefix+'-resources-after.json')).read_bytes()\nrows=json.loads((D/'commands.json').read_text())+json.loads((D/'reports-results.json').read_text())\nraw=[]\n# Only approved local secrets are redacted; raw files already sanitized by supervisor.\nsecrets=dict(l.split('=',1) for l in (R/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\ndef clean(t):\n for k,v in secrets.items():\n  if v and ('PASSWORD' in k or 'TOKEN' in k):t=t.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n return t\n\ndef archive(label,p,note):\n data=clean(p.read_text(errors='replace'));digest=hashlib.sha256(data.encode()).hexdigest()\n raw.append({'label':label,'note':note,'sha256':digest,'output':data});return digest\ncommands=[]\nfor row in rows:\n assert row['exit_code']==0 and row['watchdog_error'] is None and row['head_sha']==CODE\n digest=archive(row['label'],D/(row['label']+'.log'),'executed command output')\n assert digest==row['raw_sha256']\n c={**row,'raw_sha256':digest,'status':'PASS'}\n if 'counts' in row:\n  n=row['counts'];assert n['failures']==n['errors']==n['skipped']==0\n  c['result']={'passed':n['tests'],'failed':0,'skipped':0,'not_executed':0}\n commands.append(c)\nartifacts=['task.xml','reports.xml','reports-results.json','normalize_commands.py','full.xml','collected.json','union.json','campaign-result.json','toolchain.json','semantic-scope.json','full-environment.json','task-resources-before.json','task-resources-after.json','full-resources-before.json','full-resources-after.json','gates.py','state_update.py','reports_regression.py','campaign.py','campaign-full-resume.py','campaign-full-cleanenv.py','campaign-full-final.py','campaign-final-scope.py','register_control_plane.py','build_evidence.py','check_evidence.py']\nfor n in artifacts:archive('artifact:'+n,D/n,'captured artifact, not an additional executed check')\nredsha=archive('RED',D/'red-behavior.log','expected FAIL on unchanged source; 4 defects reproduced; never a qualifying PASS')\narchive('RED-junit',D/'red-behavior.xml','expected RED cases')\narchive('diagnostic-spire-registration-race',D/'full-register.log','failed attempt; full suite not started; bounded attestation wait added locally')\narchive('diagnostic-spire-stale-token',D/'full2-register.log','second preparatory failure: stale inherited join token overrides generated env file; final clean-env acquisition changes the condition')\narchive('diagnostic-second-campaign-result',D/'campaign-second-result.json','full suite NOT_EXECUTED in this attempt')\narchive('diagnostic-third-campaign-result',D/'campaign-third-result.json','SVID succeeded with clean env; local command-definition error before pytest; full suite NOT_EXECUTED')\narchive('diagnostic-preparatory-collection',D/'collect-preparation.log','collection succeeded before local NameError; not a full test run')\narchive('diagnostic-first-campaign-result',D/'campaign-first-result.json','first campaign did not qualify full regression')\narchive('scope-settled-plan',D/'scope-settled-plan.log','37 PASS and 2 optional NOT_EXECUTED after consistent generated report/self-hash restoration')\narchive('diagnostic-plan-failure',D/'precommit-plan.log','prior real-base planning gate FAIL; corrected by exact authorized path entry; not relabeled PASS')\narchive('diagnostic-first-qualified-full',Path('/home/luca/.ocor-codex/rem-0022-first-qualified/full.json'),'prior PASS before final validator disposition, retained as actual historical run')\narchive('diagnostic-first-qualified-task',Path('/home/luca/.ocor-codex/rem-0022-first-qualified/task.json'),'prior PASS before final validator disposition')\narchive('diagnostic-collection-error',D/'red.log','initial import error; corrected PYTHONPATH once; not a behavioral RED')\n# Preserve event ownership while withholding exec arguments and incidental credentials.\nevents=[]\nfor line in (D/'docker-events.jsonl').read_text().splitlines():\n e=json.loads(line);a=e.get('Actor',{});events.append({'Type':e.get('Type'),'Action':(e.get('Action') or '').split(':',1)[0],'timeNano':e.get('timeNano'),'Actor':{'ID':a.get('ID'),'Attributes':{k:v for k,v in a.get('Attributes',{}).items() if k in ('name','image','container','ocor.kafka.lifecycle.owner','com.docker.compose.project')}}})\np=D/'docker-events-sanitized.json';dump(p,events);archive('docker-events',p,'structural event record; private exec arguments withheld')\nrawbytes=('\\n'.join(json.dumps(r,sort_keys=True,ensure_ascii=False) for r in raw)+'\\n').encode();rawdigest=hashlib.sha256(rawbytes).hexdigest()\ntaskcases=list(ET.parse(D/'task.xml').getroot().iter('testcase'))\nfullcases=list(ET.parse(D/'full.xml').getroot().iter('testcase'))\nassert not any(c.find(tag) is not None for c in taskcases+fullcases for tag in ('failure','error','skipped'))\ndef cases(module):return [c.get('name') for c in taskcases if c.get('classname','').endswith(module)]\ndef counts(names):return {'passed':len(names),'failed':0,'skipped':0,'not_executed':0}\nnow=datetime.n