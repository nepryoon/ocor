{"label": "artifact:check_evidence.py", "note": "captured artifact, not an additional executed check", "output": "\"\"\"Mechanical evidence reconstruction; never independent verification.\"\"\"\nimport hashlib,json,subprocess,sys,xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom pathlib import Path\nR=Path(sys.argv[1]).resolve();sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nBASE='63184cb250c5b385b06c98c69a227937b8ae8fb4'\npaths=['reports/evidence/G2/OCOR-DEV-REM-0022.json','reports/evidence/G2/OCOR-DEV-0019.requalified-rem0022.json','reports/evidence/G4/OCOR-DEV-0040.requalified-rem0022.json','reports/evidence/G5/OCOR-DEV-0050.requalified-rem0022.json']\nrecords=[json.loads((R/p).read_text()) for p in paths];rem=records[0]\nrawpath=R/paths[0].replace('.json','.log');raw=rawpath.read_bytes();entries=[json.loads(l) for l in raw.decode().splitlines()];labels={e['label']:e for e in entries};assert len(labels)==len(entries)\nfor e in entries:assert hashlib.sha256(e['output'].encode()).hexdigest()==e['sha256']\nfor p,r in zip(paths,records,strict=True):\n assert r['raw_output_sha256']==sha(rawpath) and (R/p.replace('.json','.log')).read_bytes()==raw\n assert r['result']=='PASS' and r['claims']['E1']==r['claims']['E2']==r['claims']['Verified']==0\n for key,value in r['inputs'].items():\n  if key=='inputs_tree':\n   assert value==subprocess.check_output(['git','rev-parse','HEAD:inputs'],cwd=R,text=True).strip()\n  else:\n   assert sha(R/key)==value,key\n   assert hashlib.sha256(subprocess.check_output(['git','show',r['commit']+':'+key],cwd=R)).hexdigest()==value\n for command in r['commands']:\n  assert command['exit_code']==0 and command['status']=='PASS' and command['raw_sha256']==labels[command['label']]['sha256']\n  if 'counts' in command:assert all(command['counts'][k]==0 for k in ['failures','errors','skipped'])\n if 'superseded_record' in r:\n  oldpath=r['superseded_record']['path'];b=(R/oldpath).read_bytes();old=json.loads(b)\n  assert sha(R/oldpath)==r['superseded_record']['sha256']\n  assert b==subprocess.check_output(['git','show',BASE+':'+oldpath],cwd=R)\n  assert r['supersedes']==(old.get('record_id') or old['commit'])\n gate=p.split('/')[2];manifest=json.loads((R/'reports/evidence'/gate/'MANIFEST.json').read_text())\n for task,path in [(r['task_id'],p),(r['task_id']+'-RAW',p.replace('.json','.log'))]:\n  entry=next(e for e in manifest['artifacts'] if e['task_id']==task)\n  assert entry['path']==Path(path).name and entry['sha256']==sha(R/path)\nfull=list(ET.fromstring(labels['artifact:full.xml']['output']).iter('testcase'))\ntask=list(ET.fromstring(labels['artifact:task.xml']['output']).iter('testcase'))\nassert all(c.find(t) is None for c in full+task for t in ['failure','error','skipped'])\nnodes=json.loads(labels['artifact:collected.json']['output'])\ndef identity(n):\n path,*parts=n.removeprefix('ocor-runtime/').split('::');return ('.'.join([path[:-3].replace('/','.'),*parts[:-1]]),parts[-1])\nassert Counter(identity(n) for n in nodes)==Counter((c.get('classname'),c.get('name')) for c in full)\nassert rem['full_regression']['counts']['tests']==len(full)\nassert len([c for c in task if c.get('classname','').endswith('test_ocor_dev_rem_0022')])==22\nred=list(ET.fromstring(labels['RED-junit']['output']).iter('testcase'));assert len(red)==4 and all(c.find('failure') is not None for c in red)\nfor prefix in ['task','full']:\n assert labels['artifact:'+prefix+'-resources-before.json']['output']==labels['artifact:'+prefix+'-resources-after.json']['output']\nfor r in records[1:]:\n module='test_ocor_dev_'+r['task_id'][-4:];expected={c.get('name') for c in task if c.get('classname','').endswith(module)}\n covered={n for rr in r['requirement_results'] for n in rr['tests']}\n assert expected<=covered and expected\n# Every unrelated manifest entry and original sealed artifact remains byte-identical.\nchanged={r['task_id'] for r in records}|{r['task_id']+'-RAW' for r in records}\nfor g in ['G2','G4','G5']:\n path='reports/evidence/'+g+'/MANIFEST.json';old=json.loads(subprocess.check_output(['git','show',BASE+':'+path],cwd=R));new=json.loads((R/path).read_text())\n assert [e for e in old['artifacts'] if e['task_id'] not in changed]==[e for e in new['artifacts'] if e['task_id'] not in changed]\nfor p in ['inputs','infra','deploy','ocor-runtime/sdk','ocor-runtime/tools']:\n assert subprocess.check_output(['git','diff',BASE,'HEAD','--',p],cwd=R)==b''\nprint(json.dumps({'status':'PASS','records':len(records),'full_tests':len(full),'task_tests':len(task),'red_expected_failures':4,'sealed_history_unchanged':True},sort_keys=True))\n", "sha256": "07af7b2cfa4d8147229817b07e8d39026880c15435ccfd582e559798f2117279"}
