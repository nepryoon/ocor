{"label": "artifact:normalize_commands.py", "note": "captured artifact, not an additional executed check", "output": "import json\nfrom pathlib import Path\nD=Path(__file__).parent\nrows=json.loads((D/'commands.json').read_text())\n# Repeated successful preparatory teardown/collection attempts retain their logs.\ncount=0\nfor r in rows:\n if r['label']=='session-teardown':\n  count+=1\n  if count<=3:r['label']='session-teardown-'+['first','second','third'][count-1]\ncollect_rows=[r for r in rows if r['label']=='collect']\nif len(collect_rows)>1:\n collect_rows[0]['label']='collect-preparation'\nassert len({r['label'] for r in rows})==len(rows)\nfor r in rows:\n import hashlib\n assert hashlib.sha256((D/(r['label']+'.log')).read_bytes()).hexdigest()==r['raw_sha256'],r['label']\n(D/'commands.json').write_text(json.dumps(rows,indent=2,sort_keys=True)+'\\n')\n", "sha256": "8e932b0c48cb9c959b913baa7b41fc227b338fb2b2e03410934295a67592e2cb"}
