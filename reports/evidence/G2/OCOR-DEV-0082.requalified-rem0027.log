{"command": "captured artifact: mutation_probe.py (mutant table)", "exit_code": 0, "label": "mutation-probe-repair2-script", "output": "\"\"\"OCOR-DEV-REM-0027 repair 2 mutation probe: each mutant of the repair-2 code in\nc8/tool_runtime.py must be killed by test_ocor_dev_rem_0027.py. Runs in a separate\ndetached worktree; restores the file after each mutant and checks the blob equals HEAD.\nUsage: mutation_probe.py <worktree> <log_dir>\"\"\"\nimport hashlib, json, subprocess, sys, time\nfrom pathlib import Path\n\nW = Path(sys.argv[1]); L = Path(sys.argv[2]); L.mkdir(parents=True, exist_ok=True)\nF = W / \"ocor-runtime/src/ocor_runtime/c8/tool_runtime.py\"\nMUTANTS = {\n    \"M23-R2-unknown-outcome-not-reconciled\": (\"        def unknown(reason_code: str, message: str) -> ToolRuntimeError:\\n            return self._reconcile(\\n\",\n        \"        def unknown(reason_code: str, message: str) -> ToolRuntimeError:\\n            return ToolRuntimeError(reason_code, message, execution_unknown=True)\\n            return self._reconcile(\\n\"),\n    \"M24-R2-reconciler-failure-not-fail-closed\": (\"            raise ToolRuntimeError(\\n                \\\"RECONCILIATION_UNAVAILABLE\\\",\\n                f\\\"{message}\",\n        \"            return ToolRuntimeError(\\n                reason_code,\\n                f\\\"{message}\"),\n    \"M25-R2-outcome-marked-idempotent\": (\"mark_ambiguous(command_id, idempotent_effect_proven=False,\", \"mark_ambiguous(command_id, idempotent_effect_proven=True,\"),\n    \"M26-R2-record-without-lease\": ('                \"lease_id\": lease_id,\\n', \"\"),\n    \"M27-R2-record-without-correlation\": ('                \"correlation_id\": correlation_id,\\n', \"\"),\n    \"M28-R2-outcome-not-journalled\": (\"            self._unknown_outcomes.append(outcome)\\n\", \"            pass\\n\"),\n    \"M29-R2-refusal-without-record\": (\"        return ToolRuntimeError(reason_code, message, execution_unknown=True, reconciliation=outcome)\\n\",\n        \"        return ToolRuntimeError(reason_code, message, execution_unknown=True)\\n\"),\n    \"M30-R2-effect-channel-stop-not-mapped\": (\"        except StopEpochDenied as error:\\n            raise ToolRuntimeError(\\\"STOP_BOUND_DENIED\\\", f\\\"effect of tool\",\n        \"        except KeyError as error:\\n            raise ToolRuntimeError(\\\"STOP_BOUND_DENIED\\\", f\\\"effect of tool\"),\n    \"M31-R2-effect-channel-unauthorized\": (\"            return self._authority.authorize(lease, f\\\"tool:{tool_name}\\\", tool_name, at=instant, subject=subject)\\n\",\n        \"            return self._authority.get(lease if isinstance(lease, str) else lease.lease_id)  # type: ignore[return-value]\\n\"),\n}\nORIG = F.read_text()\nresults = []\nfor name, (old, new) in MUTANTS.items():\n    assert ORIG.count(old) == 1, name\n    F.write_text(ORIG.replace(old, new, 1))\n    started = time.time()\n    try:\n        p = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-x\",\n                            \"tests/tasks/test_ocor_dev_rem_0027.py\"], cwd=W / \"ocor-runtime\", capture_output=True, text=True, timeout=900)\n        rc, out = p.returncode, p.stdout + p.stderr\n    finally:\n        F.write_text(ORIG)\n    (L / f\"mutant-{name}.log\").write_text(out)\n    results.append({\"mutant\": name, \"file\": \"ocor-runtime/src/ocor_runtime/c8/tool_runtime.py\", \"replacement\": {\"from\": old, \"to\": new},\n                    \"pytest_exit\": rc, \"killed\": rc != 0, \"log\": f\"mutant-{name}.log\",\n                    \"log_sha256\": hashlib.sha256(out.encode()).hexdigest(), \"duration_seconds\": round(time.time() - started, 1)})\n    print(name, \"KILLED\" if rc != 0 else \"SURVIVED\", flush=True)\nblob = subprocess.check_output([\"git\", \"hash-object\", str(F)], text=True).strip()\nhead_blob = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD:ocor-runtime/src/ocor_runtime/c8/tool_runtime.py\"], cwd=W, text=True).strip()\nstatus = subprocess.check_output([\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\"], cwd=W, text=True)\nsummary = {\"head\": subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=W, text=True).strip(), \"results\": results,\n           \"killed\": sum(r[\"killed\"] for r in results), \"total\": len(results), \"restored_blob_equals_head\": blob == head_blob,\n           \"worktree_clean_after\": status == \"\"}\n(L / \"mutation-probe.json\").write_text(json.dumps(summary, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps({k: summary[k] for k in (\"killed\", \"total\", \"restored_blob_equals_head\", \"worktree_clean_after\")}))\n", "sha256": "fc4f5cd1dd71cb08bb91ecbcdc765f2cc2400262c722ac74bd1d2a7e54bf0525"}
