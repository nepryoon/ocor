{"label": "artifact:register_control_plane.py", "output": "import subprocess,json,time\nserver=['docker','exec','ocor-bootstrap-spire-server-1','/opt/spire/bin/spire-server']\nagent=['docker','exec','ocor-bootstrap-spire-agent-1','/opt/spire/bin/spire-agent']\ndef call(cmd):\n r=subprocess.run(cmd,capture_output=True,text=True,timeout=30);r.check_returncode();return r.stdout\nfor attempt in range(5):\n agents=json.loads(call(server+['agent','list','-socketPath','/run/spire/sockets/server.sock','-output','json']))['agents']\n if len(agents)==1 and agents[0]['id']['trust_domain']=='ocor.test':break\n if attempt==4:raise RuntimeError('expected exactly one attested agent in ocor.test after bounded wait')\n time.sleep(2**attempt)\ni=agents[0]['id']; parent='spiffe://'+i['trust_domain']+i['path']\ncall(server+['entry','create','-socketPath','/run/spire/sockets/server.sock','-parentID',parent,'-spiffeID','spiffe://ocor.test/ocor/control-plane','-selector','unix:uid:0'])\nfor attempt in range(5):\n r=subprocess.run(agent+['api','fetch','x509','-socketPath','/run/spire/sockets/agent.sock','-output','json'],capture_output=True,text=True,timeout=15)\n if r.returncode==0 and any(x.get('spiffe_id')=='spiffe://ocor.test/ocor/control-plane' for x in json.loads(r.stdout).get('svids',[])):\n  print(json.dumps({'status':'PASS','parent':parent,'spiffe_id':'spiffe://ocor.test/ocor/control-plane','selector':'unix:uid:0','svid_fetched':True,'private_material':'NOT_LOGGED'}));break\n if attempt==4:raise RuntimeError('control-plane SVID unavailable')\n time.sleep(2**attempt)\n", "sha256": "f9889b5945abede8ff28d3a396ede168df7f6a9269bea64f76b974943b886669"}
{"label": "artifact:scanner.py", "output": "from __future__ import annotations\n\nimport ast\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport tomllib\nfrom pathlib import Path\n\nroot = Path(os.environ[\"OCOR_SCAN_ROOT\"]).resolve()\noutput = Path(os.environ[\"OCOR_SCAN_OUTPUT\"]).resolve()\nversion = os.environ[\"OCOR_SCANNER_VERSION\"]\noutput.mkdir(parents=True, exist_ok=True)\nexcluded = {\".git\", \".ocor\", \".venv\", \"__pycache__\"}\ntext_suffixes = {\".json\", \".md\", \".proto\", \".py\", \".toml\", \".ttl\", \".txt\", \".yaml\", \".yml\"}\n\ndef candidates(suffixes: set[str]):\n    for path in sorted(root.rglob(\"*\")):\n        if not path.is_file() or path.suffix.lower() not in suffixes:\n            continue\n        relative = path.relative_to(root)\n        if excluded & set(relative.parts) or output == path or output in path.parents:\n            continue\n        if path.stat().st_size <= 2_000_000:\n            yield path, relative.as_posix()\n\ndef write(name: str, findings: list[dict[str, object]]) -> None:\n    payload = {\n        \"blocking_findings\": len(findings),\n        \"findings\": sorted(findings, key=lambda item: (str(item[\"path\"]), str(item[\"rule_id\"]))),\n        \"result\": \"FAIL\" if findings else \"PASS\",\n        \"scanner\": f\"ocor-{name}-scanner\",\n        \"scanner_version\": version,\n    }\n    (output / f\"{name}.json\").write_text(\n        json.dumps(payload, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n    )\n\nstatic_findings: list[dict[str, object]] = []\nfor path, relative in candidates({\".py\"}):\n    source = path.read_text(encoding=\"utf-8\")\n    try:\n        tree = ast.parse(source, filename=relative)\n    except SyntaxError as exc:\n        static_findings.append(\n            {\"line\": exc.lineno or 0, \"path\": relative, \"rule_id\": \"PYTHON_SYNTAX_ERROR\", \"severity\": \"CRITICAL\"}\n        )\n        continue\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in {\"eval\", \"exec\"}:\n            static_findings.append(\n                {\"line\": node.lineno, \"path\": relative, \"rule_id\": \"DYNAMIC_CODE_EXECUTION\", \"severity\": \"HIGH\"}\n            )\n        if isinstance(node, ast.Call) and any(\n            keyword.arg == \"shell\" and isinstance(keyword.value, ast.Constant) and keyword.value.value is True\n            for keyword in node.keywords\n        ):\n            static_findings.append(\n                {\"line\": node.lineno, \"path\": relative, \"rule_id\": \"SUBPROCESS_SHELL_TRUE\", \"severity\": \"CRITICAL\"}\n            )\nwrite(\"static\", static_findings)\n\nsecret_patterns = {\n    \"AWS_ACCESS_KEY\": re.compile(r\"AKIA[0-9A-Z]{16}\"),\n    \"GITHUB_TOKEN\": re.compile(r\"gh[pousr]_[A-Za-z0-9]{36,}\"),\n    \"PRIVATE_KEY\": re.compile(r\"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----\"),\n}\nsecret_findings: list[dict[str, object]] = []\nfor path, relative in candidates(text_suffixes):\n    try:\n        source = path.read_text(encoding=\"utf-8\")\n    except UnicodeDecodeError:\n        continue\n    for rule_id, pattern in secret_patterns.items():\n        for match in pattern.finditer(source):\n            secret_findings.append(\n                {\n                    \"line\": source.count(\"\\n\", 0, match.start()) + 1,\n                    \"path\": relative,\n                    \"rule_id\": rule_id,\n                    \"severity\": \"CRITICAL\",\n                }\n            )\nwrite(\"secrets\", secret_findings)\n\nlock_path = root / \"ocor-runtime/uv.lock\"\ndependency_findings: list[dict[str, object]] = []\ncomponents: list[dict[str, object]] = []\ndenied_licenses = {\"AGPL-3.0\", \"AGPL-3.0-only\", \"GPL-3.0\", \"GPL-3.0-only\", \"SSPL-1.0\"}\ntry:\n    lock = tomllib.loads(lock_path.read_text(encoding=\"utf-8\"))\nexcept (OSError, tomllib.TOMLDecodeError) as exc:\n    dependency_findings.append(\n        {\"path\": \"ocor-runtime/uv.lock\", \"rule_id\": \"LOCK_UNREADABLE\", \"severity\": \"CRITICAL\", \"detail\": str(exc)}\n    )\n    lock = {\"package\": []}\nfor package in sorted(lock.get(\"package\", []), key=lambda item: (item.get(\"name\", \"\"), item.get(\"version\", \"\"))):\n    name = str(package.get(\"name\", \"\"))\n    package_version = str(package.get(\"version\", \"\"))\n    license_name = package.get(\"license\")\n    if not name or not package_version:\n        dependency_findings.append(\n            {\"path\": \"ocor-runtime/uv.lock\", \"rule_id\": \"UNVERSIONED_DEPENDENCY\", \"severity\": \"CRITICAL\"}\n        )\n        continue\n    if license_name in denied_licenses:\n        dependency_findings.append(\n            {\n                \"detail\": str(license_name),\n                \"path\": f\"pkg:pypi/{name}@{package_version}\",\n                \"rule_id\": \"DISALLOWED_LICENSE\",\n                \"severity\": \"HIGH\",\n            }\n        )\n    artifacts: list[dict[str, object]] = []\n    if isinstance(package.get(\"sdist\"), dict):\n        artifacts.append(package[\"sdist\"])\n    artifacts.extend(item for item in package.get(\"wheels\", []) if isinstance(item, dict))\n    source = package.get(\"source\", {})\n    registry_package = isinstance(source, dict) and \"registry\" in source\n    hashes = sorted({str(item.get(\"hash\", \"\")) for item in artifacts if item.get(\"hash\")})\n    if registry_package and (not hashes or any(re.fullmatch(r\"sha256:[0-9a-f]{64}\", value) is None for value in hashes)):\n        dependency_findings.append(\n            {\n                \"path\": f\"pkg:pypi/{name}@{package_version}\",\n                \"rule_id\": \"MISSING_OR_INVALID_ARTIFACT_HASH\",\n                \"severity\": \"CRITICAL\",\n            }\n        )\n    component: dict[str, object] = {\n        \"name\": name,\n        \"purl\": f\"pkg:pypi/{name}@{package_version}\",\n        \"type\": \"library\",\n        \"version\": package_version,\n    }\n    if hashes:\n        component[\"hashes\"] = [\n            {\"alg\": \"SHA-256\", \"content\": value.removeprefix(\"sha256:\")} for value in hashes\n        ]\n    if license_name:\n        component[\"licenses\"] = [{\"license\": {\"id\": str(license_name)}}]\n    components.append(component)\nwrite(\"dependencies\", dependency_findings)\n\nlock_digest = hashlib.sha256(lock_path.read_bytes()).hexdigest() if lock_path.is_file() else \"\"\nsbom = {\n    \"bomFormat\": \"CycloneDX\",\n    \"components\": components,\n    \"metadata\": {\n        \"component\": {\"name\": \"ocor-runtime\", \"type\": \"application\"},\n        \"properties\": [\n            {\"name\": \"ocor:lock:sha256\", \"value\": lock_digest},\n            {\"name\": \"ocor:scanner:version\", \"value\": version},\n        ],\n    },\n    \"serialNumber\": f\"urn:uuid:{lock_digest[:8]}-{lock_digest[8:12]}-{lock_digest[12:16]}-{lock_digest[16:20]}-{lock_digest[20:32]}\",\n    \"specVersion\": \"1.5\",\n    \"version\": 1,\n}\n(output / \"sbom.cdx.json\").write_text(\n    json.dumps(sbom, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n)\nblockers = len(static_findings) + len(secret_findings) + len(dependency_findings)\nsummary = {\n    \"blocking_findings\": blockers,\n    \"result\": \"FAIL\" if blockers else \"PASS\",\n    \"scanner\": \"ocor-supply-chain\",\n    \"scanner_version\": version,\n}\n(output / \"summary.json\").write_text(\n    json.dumps(summary, indent=2, sort_keys=True) + \"\\n\", encoding=\"utf-8\"\n)\nprint(json.dumps(summary, sort_keys=True))\nraise SystemExit(1 if blockers else 0)", "sha256": "ed7f8bd6391794e237deb1cfcd6582755f16ad7ac89b8a8b7a08903dd8a337f0"}
{"label": "artifact:build_evidence.py", "output": "\"\"\"Build distinct candidate metadata from the fresh bounded campaign.\"\"\"\nimport copy,hashlib,json,subprocess,sys,xml.etree.ElementTree as ET\nfrom datetime import datetime,UTC\nfrom pathlib import Path\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0022-ci-evidence');D=Path(__file__).parent\nBASE='355490ecd5fc28db999b1374c9adeddf95c64e23';SEALED='e8449a91e7f1bb918905d81992db81e447e36e8a'\nsys.path.insert(0,str(R/'reports/tests'))\nfrom test_rem0022_case_identity import case_index,junit_identity\nsha=lambda b:hashlib.sha256(b).hexdigest()\ndef dump(p,d):p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\\n')\ndef git(*args):return subprocess.check_output(['git',*args],cwd=R).decode().strip()\nCODE=git('rev-parse','HEAD');assert json.loads((D/'campaign-result.json').read_text())['status']=='PASS'\nrows=json.loads((D/'commands.json').read_text())+json.loads((D/'reports-results.json').read_text())\nraw=[]\ndef archive(label,p):\n data=p.read_text();raw.append({'label':label,'sha256':sha(data.encode()),'output':data})\ncommands=[]\nfor row in rows:\n assert row['exit_code']==0 and row['watchdog_error'] is None and row['head_sha']==CODE\n archive(row['label'],D/(row['label']+'.log'));assert raw[-1]['sha256']==row['raw_sha256']\n c={**row,'status':'PASS'}\n if 'counts' in row:\n  n=row['counts'];assert n['failures']==n['errors']==n['skipped']==0\n  c['result']={'passed':n['tests'],'failed':0,'skipped':0,'not_executed':0}\n commands.append(c)\nfor n in ['task.xml','full.xml','reports.xml','collected.json','union.json','toolchain.json','campaign-result.json','full-environment.json','task-resources-before.json','task-resources-after.json','full-resources-before.json','full-resources-after.json','resources-before.json','resources-final.json','session-resource-union.json','scanner-red.log','scanner-red/summary.json','identity-tests.log','identity.xml','preflight-result.json','latest-integration-ci.json','ruleset.json','orchestration-diagnostic.json','qualified-before-checker-relocation/campaign-result.json','qualified-before-checker-relocation/full.json','qualified-before-checker-relocation/candidate-language.log','plan-settle-first.log','plan-settle-second.log','diagnostic-orchestration-interruption/task.log','diagnostic-initial-duplicate-registration/task-register.log','campaign.py','reports_regression.py','preflight.py','register_control_plane.py','scanner.py','build_evidence.py']:\n archive('artifact:'+n,D/n)\n# Inherit the actual historical behavior RED for unchanged Kafka code, never rerun or relabel it.\narchive('historical-kafka-RED',Path('/home/luca/.ocor-codex/rem-0022/red-behavior.log'))\narchive('historical-kafka-RED-junit',Path('/home/luca/.ocor-codex/rem-0022/red-behavior.xml'))\nrawbytes=('\\n'.join(json.dumps(e,sort_keys=True,ensure_ascii=False) for e in raw)+'\\n').encode();rawdigest=sha(rawbytes)\nnodes=json.loads((D/'collected.json').read_text());fullindex=case_index(nodes,(D/'full.xml').read_bytes())\ntaskcases=list(ET.parse(D/'task.xml').getroot().iter('testcase'))\nidentities={(c.get('classname'),c.get('name')) for c in taskcases};tasknodes=[n for n in nodes if junit_identity(n) in identities]\ntaskindex=case_index(tasknodes,(D/'task.xml').read_bytes())\nassert len(taskindex)==len(taskcases)==243\nlookup={junit_identity(n):row for n,row in zip(tasknodes,taskindex,strict=True)}\ndef entries(module):return [lookup[(c.get('classname'),c.get('name'))] for c in taskcases if c.get('classname','').endswith(module)]\ndef counts(n):return {'passed':n,'failed':0,'skipped':0,'not_executed':0}\nclaims={'E1':0,'E2':0,'Verified':0,'PoC_GO':'NO-GO','runtime_conformance':'NOT_ESTABLISHED','Production_readiness':'NO-GO'}\ncommon={'schema_version':'1.0','commit':CODE,'created_at':datetime.now(UTC).isoformat(),'commands':commands,'raw_output_sha256':rawdigest,'result':'PASS','claims':claims,'status':'CANDIDATE_P