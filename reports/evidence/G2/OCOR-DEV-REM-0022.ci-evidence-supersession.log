{"label": "artifact:campaign.py", "output": "\"\"\"Bounded qualification worker. Never invokes independent verification.\"\"\"\nimport hashlib,json,os,signal,subprocess,sys,time,xml.etree.ElementTree as ET\nfrom collections import Counter\nfrom datetime import datetime,UTC\nfrom pathlib import Path\nR=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0022-ci-evidence');D=Path(__file__).parent\nPY=str(R/'ocor-runtime/.venv/bin/python')\nenv=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],PYTHONPATH=f'{R}:{R}/ocor-runtime/src',GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true',OCOR_BOOTSTRAP_ENV=str(R/'.ocor/bootstrap.env'))\nHEAD=subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()\nrows=[]\ndef progress(s):\n with (D/'campaign.progress').open('a') as f:f.write(datetime.now(UTC).isoformat()+' '+s+'\\n')\ndef secrets():\n values=dict(l.split('=',1) for l in (R/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l)\n env.update(values);env['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:'+values['OCOR_LOCAL_POSTGRES_PASSWORD']+'@127.0.0.1:55433/ocor'\n return values\ndef redact(p):\n data=p.read_text(errors='replace')\n for k,v in secrets().items():\n  if v and ('PASSWORD' in k or 'TOKEN' in k):data=data.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')\n p.write_text(data)\ndef snapshot():\n return {k:sorted(subprocess.check_output(cmd,text=True,timeout=20).splitlines()) for k,cmd in [('containers',['docker','ps','-aq']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','-q'])]}\ndef stack():\n ids=subprocess.check_output(['docker','ps','-aq','--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True,timeout=15).split()\n assert len(ids)==11, 'eleven bootstrap services required'\n entries=json.loads(subprocess.check_output(['docker','inspect',*ids],text=True,timeout=15))\n return {e['Name']:{'restart_count':e['RestartCount'],'oom':e['State']['OOMKilled'],'started_at':e['State']['StartedAt'],'running':e['State']['Running'],'image_id':e['Image']} for e in entries}\ndef dump(p,d):p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\\n')\ndef run(label,command,limit=600,guard=False):\n assert subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()==HEAD\n progress('RUN '+label);start=time.monotonic();initial=stack() if guard else None;problem=None\n log=D/(label+'.log');log.touch(mode=0o600)\n with log.open('w') as f:\n  f.write('HEAD '+HEAD+'\\nCOMMAND '+json.dumps(command)+'\\n');f.flush()\n  child_env=env.copy()\n  if 'scripts/bootstrap_development_environment.py' in command:\n   # Compose gives process environment precedence over --env-file. The bootstrap\n   # generates a new join token; never override it with the prior session value.\n   for key in secrets():child_env.pop(key,None)\n   assert 'OCOR_SPIRE_JOIN_TOKEN' not in child_env\n  p=subprocess.Popen(command,cwd=R,env=child_env,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)\n  while p.poll() is None:\n   try:\n    if time.monotonic()-start>limit:raise RuntimeError('campaign time limit exceeded')\n    if guard and stack()!=initial:raise RuntimeError('bootstrap service restart/OOM/exit detected')\n   except Exception as e:\n    problem=str(e)\n    with (D/(label+'-diagnostics.log')).open('w') as diag:\n     subprocess.run(['docker','stats','--no-stream'],stdout=diag,stderr=subprocess.STDOUT,timeout=30)\n     for name in (initial or {}):subprocess.run(['docker','logs','--tail','100',name.lstrip('/')],stdout=diag,stderr=subprocess.STDOUT,timeout=20)\n    os.killpg(p.pid,signal.SIGINT)\n    try:p.wait(timeout=30)\n    except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=10)\n    break\n   time.sleep(2)\n  f.write('\\nEXIT_CODE '+str(p.returncode)+'\\n')\n redact(log)\n row={'label':label,'command':command,'exit_code':p.returncode,'head_sha':HEAD,'duration_seconds':round(time.monotonic()-start,3),'watchdog_error':problem,'raw_sha256':hashlib.sha256(log.read_bytes()).hexdigest()}\n xml=D/(label+'.xml')\n if xml.exists():\n  cases=list(ET.parse(xml).getroot().iter('testcase'))\n  row['counts']={'tests':len(cases),**{key:sum(c.find(tag) is not None for c in cases) for key,tag in [('failures','failure'),('errors','error'),('skipped','skipped')]}}\n rows.append(row);dump(D/(label+'.json'),row);dump(D/'commands.json',rows);progress(label+' '+str(row))\n assert row['exit_code']==0 and problem is None, label+' failed'\n if 'counts' in row:assert all(row['counts'][k]==0 for k in ('failures','errors','skipped')),label+' not qualifying'\n return row\n\ndef initialize(prefix):\n run(prefix+'-initialize',[PY,'deploy/bootstrap/init/initialize_services.py','--env-file',str(R/'.ocor/bootstrap.env')])\n run(prefix+'-fixtures',[PY,'deploy/bootstrap/fixtures/load_fixtures.py','--env-file',str(R/'.ocor/bootstrap.env')])\n run(prefix+'-register',[PY,str(D/'register_control_plane.py')])\n run(prefix+'-sync',['uv','sync','--project','ocor-runtime','--frozen','--extra','test','--extra','lint'])\n run(prefix+'-health',[PY,'scripts/verify_external_services.py','--execute','--typed'])\n\ntestbase=[PY,'-m','pytest','-v','-s','-ra','-p','no:cacheprovider']\nresult={'head_sha':HEAD,'status':'RUNNING'}\ntry:\n run('task-reset',[PY,'scripts/reset_test_environment.py','--execute'])\n run('task-bootstrap',[PY,'scripts/bootstrap_development_environment.py','--execute','--timeout','600'],700)\n secrets();initialize('task')\n run('sdk-provision',['npm','--prefix','ocor-runtime/sdk/typescript','ci','--ignore-scripts','--no-audit','--no-fund'],180)\n run('sdk-build',['npm','--prefix','ocor-runtime/sdk/typescript','run','build'],180)\n before=snapshot();dump(D/'task-resources-before.json',before)\n run('task',testbase+['--junitxml='+str(D/'task.xml'),'ocor-runtime/tests/tasks/test_ocor_dev_rem_0022.py','ocor-runtime/tests/tasks/test_ocor_dev_0019.py','ocor-runtime/tests/tasks/test_ocor_dev_0040.py','ocor-runtime/tests/tasks/test_ocor_dev_0041.py','ocor-runtime/tests/tasks/test_ocor_dev_0050.py'],2700,True)\n after=snapshot();dump(D/'task-resources-after.json',after);assert before==after,'task resource delta'\n run('full4-reset',[PY,'scripts/reset_test_environment.py','--execute'])\n run('full4-bootstrap',[PY,'scripts/bootstrap_development_environment.py','--execute','--timeout','600'],700)\n secrets();initialize('full4')\n before=snapshot();dump(D/'full-resources-before.json',before);dump(D/'full-environment.json',stack())\n events_log=(D/'docker-events.jsonl').open('w');events=subprocess.Popen(['docker','events','--format','{{json .}}'],stdout=events_log,stderr=subprocess.DEVNULL)\n try:\n  run('collect',[PY,'-m','pytest','--collect-only','-q','ocor-runtime/tests/'],180)\n  nodes=[l for l in (D/'collect.log').read_text().splitlines() if l.startswith(('ocor-runtime/tests/','tests/')) and '::' in l]\n  assert nodes and len(set(nodes))==len(nodes);dump(D/'collected.json',nodes)\n  full=run('full',testbase+['--junitxml='+str(D/'full.xml'),'ocor-runtime/tests/'],4500,True)\n  def identity(node):\n   path,*parts=node.removeprefix('ocor-runtime/').split('::');return ('.'.join([path[:-3].replace('/','.'),*parts[:-1]]),parts[-1])\n  expected=Counter(identity(n) for n in nodes);actual=Counter((c.get('classname'),c.get('name')) for c in ET.parse(D/'full.xml').getroot().iter('testcase'))\n  assert expected==actual,'collect/JUnit mismatch'\n  dump(D/'union.json',{'collected':len(nodes),'executed':sum(actual.values()),'missing':[],'duplicated':[],'unexpected':[],'status':'PASS'})\n  if full['duration_seconds']>3600:result['decision_request_required']='FULL_CAMPAIGN_DURATION_OVER_60_MINUTES'\n finally:\n  events.terminate();events.wait(timeout=20);events_log.close()\n after=snapshot();dump(D/'full-resources-after.json',after);assert before==after,'full suite resource delta'\n result['status']='PASS'\nexcept Exception as e:\n result.upda