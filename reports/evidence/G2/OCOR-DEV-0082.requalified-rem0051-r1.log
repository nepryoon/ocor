{"command": "captured script: ~/.ocor-codex/rem-0051-r1-q/run.sh", "exit_code": 0, "label": "script-run.sh", "output": "#!/bin/bash\n# OCOR-DEV-REM-0051 (NCP-U06) repair cycle 1: qualification campaign (two lanes, memory admission at start) at the candidate head.\nset -u\nD=$HOME/.ocor-codex/rem-0051-r1-q\nR=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0051-r1\nPY=$R/ocor-runtime/.venv/bin/python\ncd $R\nstep(){ echo \"$(date -u +%FT%TZ) $*\" >> $D/run.progress; }\n( while true; do echo \"$(date -u +%FT%TZ) ac=$(cat /sys/class/power_supply/ADP*/online 2>/dev/null) bat=$(cat /sys/class/power_supply/BAT*/capacity)\" >> $D/power.log; sleep 60; done ) &\nPW=$!\ntrap 'kill $PW $MP 2>/dev/null' EXIT\nMP=\nstep \"start head=$(git rev-parse HEAD)\"\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL stale credentials in worktree\"; exit 3; }\nmkdir -p $D/q\nfor ph in A; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\ndocker ps --filter label=com.docker.compose.project=ocor-bootstrap -q | xargs docker inspect | python3 -c '\nimport json,sys\nout={c[\"Name\"].lstrip(\"/\"):{\"image_id\":c[\"Image\"],\"image_ref\":c[\"Config\"][\"Image\"],\"oom_killed\":c[\"State\"][\"OOMKilled\"],\"restart_count\":c[\"RestartCount\"],\"status\":c[\"State\"][\"Status\"]} for c in json.load(sys.stdin)}\nprint(json.dumps(out,indent=2,sort_keys=True))' > $D/backend_images.json && step \"backend images snapshot $(python3 -c \"import json;print(len(json.load(open('$D/backend_images.json'))))\") containers\"\nfor ph in A3 B; do step \"phase $ph\"; env -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py $ph >> $D/run.out 2>&1 || { step \"FAIL phase $ph\"; exit 1; }; done\ntest ! -e $D/old-credentials-A || { step \"FAIL archive target exists\"; exit 4; }\nmkdir -p $D/old-credentials-A\nfor f in .ocor/bootstrap.env .ocor/spire; do test -e $f && mv $f $D/old-credentials-A/; done\ntest ! -e .ocor/bootstrap.env && test ! -e .ocor/spire || { step \"FAIL credentials not archived\"; exit 3; }\nstep \"credentials of phase A archived in old-credentials-A\"\nstep \"phase C power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity) $(awk '/^MemTotal|^MemAvailable/{printf \"%s=%s \", $1, $2}' /proc/meminfo)\"\n( while true; do echo \"$(date -u +%s) $(awk '/^MemTotal|^MemAvailable/{printf \"%s \", $2}' /proc/meminfo)\" >> $D/mem-lanes.log; sleep 5; done ) &\nMP=$!\nenv -i HOME=$HOME PATH=$(cat $D/locked-path) $PY $D/qualify_run.py C >> $D/run.out 2>&1; rc=$?\nkill $MP 2>/dev/null\nstep \"C rc=$rc power=$(cat /sys/class/power_supply/ADP*/online) bat=$(cat /sys/class/power_supply/BAT*/capacity)\"\nexit $rc\n", "sha256": "e5cc507f1ccfc3b0fa1524e1ad7e2db935fb417f48aa0711470883096b3ef46b"}
{"command": "captured script: ~/.ocor-codex/rem-0051-r1-q/qualify_run.py", "exit_code": 0, "label": "script-qualify_run.py", "output": "\"\"\"OCOR-DEV-REM-0051 (NCP-U06) repair cycle 1 campaign (adapted from the unit campaign) from a clean shell.\n\nUsage: qualify_run.py <phase>. Each command's combined output goes to q/<label>.log;\nq/commands.jsonl gets label, command, cwd, exit code, duration, raw sha256, junit counts.\nStops at the first failure (fail-closed); tracked files are never edited.\n\"\"\"\nimport hashlib, json, subprocess, sys, time\nimport xml.etree.ElementTree as ET\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nR = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0051-r1\")\nD = Path.home() / \".ocor-codex/rem-0051-r1-q\"; Q = D / \"q\"; Q.mkdir(exist_ok=True)\nPATH = (D / \"locked-path\").read_text().strip()\nPY = \"ocor-runtime/.venv/bin/python\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\n\ndef live_env():\n    env_file = R / \".ocor/bootstrap.env\"\n    vals = dict(l.split(\"=\", 1) for l in env_file.read_text().splitlines() if \"=\" in l)\n    return {**ENV, \"OCOR_BOOTSTRAP_ENV\": str(env_file),\n            \"OCOR_LIVE_POSTGRES_DSN\": f\"postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor\"}\n\ndef junit(path):\n    root = ET.parse(path).getroot(); suites = [root] if root.tag == \"testsuite\" else list(root)\n    t = {k: sum(int(s.get(k, 0)) for s in suites) for k in (\"tests\", \"failures\", \"errors\", \"skipped\")}\n    return {\"passed\": t[\"tests\"] - t[\"failures\"] - t[\"errors\"] - t[\"skipped\"], \"failed\": t[\"failures\"] + t[\"errors\"], \"skipped\": t[\"skipped\"], \"not_executed\": 0}\n\ndef pytest(label, *targets, cwd=\".\"):\n    x = Q / f\"{label}.xml\"\n    return (label, [str(R / PY), \"-m\", \"pytest\", *targets, \"-p\", \"no:cacheprovider\", \"-q\", \"-rfEs\", \"--tb=short\", f\"--junitxml={x}\"], cwd, x)\n\nSVC_TESTS = []\n# regression-only requalifications of repair 1: 0004 (evidence_manifest.py), 0005, 0050, 0082 (scripts/validate_ocor_development_plan.py)\nREGRESSION = [f\"ocor-runtime/tests/tasks/test_ocor_dev_{n}.py\" for n in (\"0004\", \"0005\", \"0050\", \"0082\")]\n# repair 1 module (NCP-U06-0004-REGRESSION-MANIFEST-VALIDATION option 1) with the unit module and the register/REM-0046/runtime evidence validator suites\nTASK = [\"reports/tests/test_evidence_manifest_regression_class.py\", \"ocor-runtime/tests/tasks/test_ocor_dev_rem_0051.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_runtime_evidence_validator.py\"]\nREPORTS = [\"reports/tests/test_bootstrap_lock_validation.py\", \"reports/tests/test_autonomous_tooling_policy.py\", \"reports/tests/test_reset_teardown_residue.py\", \"reports/tests/test_evidence_input_drift.py\", \"reports/tests/test_runtime_evidence_validator.py\", \"reports/tests/test_ci_fuseki_archive.py\", \"reports/tests/test_qualifying_campaign_guard.py\", \"reports/tests/test_kind_teardown_observation.py\", \"reports/tests/test_generate_contracts_reference_resolution.py\", \"reports/tests/test_language_migration_benchmark_harness.py\", \"reports/tests/test_fuseki_archive_acquisition.py\", \"reports/tests/test_local_lane_campaign.py\", \"reports/tests/test_rem0037_0006_teardown_scope.py\", \"reports/tests/test_rem0034_secret_registry.py\", \"reports/tests/test_ocor_dev_rem_0046.py\", \"reports/tests/test_normative_conformance_register.py\", \"reports/tests/test_backlog_generator_reality_parity.py\"]\n\nPHASES = {\n \"A\": [\n  (\"stack-absent-initial\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"bootstrap\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"verify-manifest-only\", [PY, \"scripts/verify_external_services.py\", \"--manifest-only\"], \".\", None),\n  (\"verify-legacy-scan\", [PY, \"scripts/verify_external_services.py\"], \".\", None),\n  (\"verify-typed-execute\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"reset\", [PY, \"scripts/reset_test_environment.py\", \"--reset\", \"--env-file\", \".ocor/bootstrap.env\", \"--execute\"], \".\", None),\n  (\"reset-idempotent\", [PY, \"scripts/reset_test_environment.py\", \"--reset\", \"--env-file\", \".ocor/bootstrap.env\", \"--execute\"], \".\", None),\n  (\"reinitialize\", [PY, \"deploy/bootstrap/init/initialize_services.py\", \"--env-file\", \".ocor/bootstrap.env\"], \".\", None),\n  (\"refixtures\", [PY, \"deploy/bootstrap/fixtures/load_fixtures.py\", \"--env-file\", \".ocor/bootstrap.env\"], \".\", None),\n  (\"verify-typed-after-reset\", [PY, \"scripts/verify_external_services.py\", \"--execute\", \"--typed\"], \".\", None),\n  (\"bootstrap-check\", [PY, \"scripts/bootstrap_development_environment.py\", \"--check\"], \".\", None),\n],\n \"A3\": [\n  (\"preflight\", [PY, \"scripts/preflight_environment.py\"], \".\", None),\n  *[pytest(f\"task-rem0051-r1-run{i}\", \"-rP\", *TASK) for i in (1, 2, 3)],\n  pytest(\"regression\", \"-rP\", *REGRESSION),\n  (\"evidence-job-g0\", [PY, \"ocor-runtime/tools/evidence_manifest.py\", \"validate\", \"--task\", \"OCOR-DEV-0004\", \"--non-skipped\", \"--manifest\", \"reports/evidence/G0/MANIFEST.json\"], \".\", None),\n  pytest(\"reports-portfolio\", *REPORTS),\n ],\n \"B\": [\n  (\"teardown-before-full\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  ],\n \"B2\": [\n  (\"credentials-fresh\", [\"sh\", \"-c\", \"test ! -e .ocor/bootstrap.env && test ! -e .ocor/spire && echo no worktree-local credential file\"], \".\", None),\n  (\"bootstrap-full\", [PY, \"scripts/bootstrap_ci_environment.py\", \"--execute\", \"--timeout\", \"600\"], \".\", None),\n  (\"full\", [PY, \"scripts/run_qualifying_campaign.py\", \"--execute\", \"--repository\", \".\", \"--expected-head\", \"HEADSHA\", \"--output-dir\", str(Q / \"full\")], \".\", None),\n  (\"teardown-final\", [PY, \"scripts/reset_test_environment.py\", \"--execute\"], \".\", None),\n  (\"stack-absent-final\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker volume ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && test -z \\\"$(docker network ls -q --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n \"C\": [\n  (\"host-stack-absent-before-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n  (\"two-lane-full\", [PY, \"scripts/run_local_lane_campaign.py\", \"--execute\", str(D / \"lanes\"), \"--expected-head\", \"HEADSHA\", \"--tool-bin\", str(Path.home() / \".ocor-codex/impl-env/rem-0051/bin\")], \".\", None),\n  (\"host-stack-absent-after-lanes\", [\"sh\", \"-c\", \"test -z \\\"$(docker ps -aq --filter label=com.docker.compose.project=ocor-bootstrap)\\\" && echo ocor-bootstrap absent\"], \".\", None),\n ],\n}\n\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=R, text=True).strip()\nfor label, cmd, cwd, xml in PHASES[sys.argv[1]]:\n    if cmd[0] == PY: cmd = [str(R / PY), *cmd[1:]]\n    cmd = [head if c == \"HEADSHA\" else c for c in cmd]\n    env = live_env() if (R / \".ocor/bootstrap.env\").exists() else ENV\n    t0 = time.monotonic(); started = datetime.now(UTC).isoformat()\n    with open(Q / f\"{label}.log\", \"w\") as log:\n        rc = subprocess.run(cmd, cwd=R / cwd, env=env, stdout=log, stderr=subprocess.STDOUT, timeout=6000).returncode\n    rec = {\"label\": label, \"command\": \" \".join(c.replace(str(R) + \"/\", \"\") for c in cmd), \"cwd\": cwd, \"exit_code\": rc,\n           \"duration_seconds\": round(time.monotonic() - t0, 3), \"started_at\": started, \"head_sha\": head,\n           \"raw_sha256\": hashlib.sha256((Q / f\"{label}.log\").read_bytes()).hexdigest(), \"status\": \"PASS\" if rc == 0 else \"FAIL\"}\n    if xml and Path(xml).exists():\n        rec[\"result\"] = junit(xml); rec[\"junit_raw_sha256\"] = hashlib.sha256(Path(xml).read_bytes()).hexdigest()\n        if rec[\"result\"][\"skipped\"] or rec[\"result\"][\"failed\"]: rec[\"status\"] = \"FAIL\"\n    with open(Q / \"commands.jsonl\", \"a\") as f: f.write(json.dumps(rec, sort_keys=True) + \"\\n\")\n    print(label, rec[\"status\"], rec[\"duration_seconds\"], rec.get(\"result\", \"\"), flush=True)\n    if rec[\"status\"] != \"PASS\": sys.exit(1)\n    if subprocess.run([\"git\", \"status\", \"--porcelain\", \"--untracked-files=no\"], cwd=R, capture_output=True, text=True).stdout.strip():\n        print(\"TRACKED TREE CHANGED after\", label); sys.exit(2)\n", "sha256": "cda8ab2790fd46239e8a8bde55f51808f9de84940537ae35e9dc86123c440b21"}
