_unit_restore_with_intact_historical_audit_refs_opens_and_serves\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_one_altered_audit_ref_is_projection_drift_with_denial_audit[1]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_one_altered_audit_ref_is_projection_drift_with_denial_audit[2]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_audit_ref_altered_after_opening_discards_the_response\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_signed_manifest_refs_must_match_the_restored_store[extra-ref]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_signed_manifest_refs_must_match_the_restored_store[historical-ref]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_signed_manifest_refs_must_match_the_restored_store[missing-ref]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_unit_signed_manifest_refs_must_match_the_restored_store[swapped-refs]\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_live_intact_historical_audit_refs_reopen_the_restore\",\n    \"tests/tasks/test_ocor_dev_rem_0036.py::test_live_one_altered_historical_audit_ref_blocks_materialisation\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_the_port_is_the_declared_seal_subset_of_scenario_overlay_store\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_c7_runtime_and_causal_outcome_are_unchanged\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_the_application_path_has_no_delete_and_no_retention_bypass\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_direct_backend_access_is_confined_to_the_adapters_subtree_and_uses_only_the_standard_library\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_configuration_is_fail_closed\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_malformed_digest_is_rejected_before_any_request\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_the_sealed_bytes_are_the_canonical_preimage_of_the_reproducibility_digest\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_outcome_whose_digest_does_not_match_its_content_is_never_written\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_seal_and_read_round_trip_an_identified_and_an_abstained_outcome\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_the_sealed_version_carries_a_compliance_retention_in_a_versioned_object_lock_bucket\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_second_seal_of_the_same_result_is_idempotent_and_writes_no_new_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_concurrent_seals_of_the_same_result_write_exactly_one_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_deleting_the_sealed_version_is_denied_with_and_without_the_bypass_header\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_delete_marker_does_not_hide_the_sealed_result\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_overwrite_never_replaces_the_sealed_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_tampered_object_under_a_digest_key_is_rejected_on_read_and_on_seal\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_unknown_digest_is_not_found\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_bucket_without_object_lock_is_refused_at_startup\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_wrong_secret_and_a_wrong_access_key_are_rejected_by_the_server_without_leaking_credentials\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_corrupted_signature_is_rejected_by_the_server\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_unreachable_store_fails_closed_without_fallback\",\n    \"tests/tasks/test_ocor_dev_rem_0041.py::test_direct_backend_access_is_confined_to_the_adapters_subtree\",\n    \"tests/tasks/test_ocor_dev_rem_0041.py::test_postgresql_is_never_an_implicit_fallback_of_the_terminusdb_service\",\n    \"tests/tasks/test_ocor_dev_rem_0041.py::test_service_satisfies_every_sealed_c3_port_without_changing_them\",\n    \"tests/tasks/test_ocor_dev_rem_0041.py::test_configuration_is_fail_closed\",\n    \"tests/tasks/t