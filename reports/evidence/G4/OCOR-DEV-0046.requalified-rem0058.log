_and_read_round_trip_an_identified_and_an_abstained_outcome\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_the_sealed_version_carries_a_compliance_retention_in_a_versioned_object_lock_bucket\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_second_seal_of_the_same_result_is_idempotent_and_writes_no_new_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_concurrent_seals_of_the_same_result_write_exactly_one_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_deleting_the_sealed_version_is_denied_with_and_without_the_bypass_header\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_delete_marker_does_not_hide_the_sealed_result\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_overwrite_never_replaces_the_sealed_version\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_tampered_object_under_a_digest_key_is_rejected_on_read_and_on_seal\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_unknown_digest_is_not_found\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_bucket_without_object_lock_is_refused_at_startup\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_wrong_secret_and_a_wrong_access_key_are_rejected_by_the_server_without_leaking_credentials\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_a_corrupted_signature_is_rejected_by_the_server\",\n    \"tests/tasks/test_ocor_dev_rem_0040.py::test_an_unreachable_store_fails_closed_without_fallback\",\n    \"tests/tasks/test_ocor_dev_rem_0041_overlay.py::test_the_port_composes_the_seal_subset_without_renaming_or_changing_signatures\",\n    \"tests/tasks/test_ocor_dev_rem_0041_overlay.py::test_the_composed_and_sealed_modules_are_unchanged\",\n    \"tests/tasks/test_ocor_dev_rem_0041_overlay.py::test_direct_backend_access_is_confined_to_the_adapter_and_never_reaches_the_c3_writer\",\n    \"tests/tasks/test_ocor_dev_rem_0041_overlay.py::test_no_write_path_of_the_adapter_can_name_main\",\n    \"tests/tasks/test_ocor_dev_rem_0041_overlay.py::test_a_forged