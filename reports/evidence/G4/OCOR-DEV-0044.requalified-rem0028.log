 p.write_text(text);rows.append({'label':label,'command':command,'exit_code':result.returncode,'duration_seconds':time.monotonic()-start,'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest()});(D/'posttests-results.json').write_text(json.dumps(rows,indent=2,sort_keys=True)+'\n');print(label,result.returncode,flush=True)
 assert result.returncode==0,label
