RAW_FILE invariants.py SHA256 b09b26e4144525106f579096c47088938ecf5b4da43f693ae8890535d7a446b0
from pathlib import Path
import ast,hashlib,json,subprocess
D=Path(__file__).parent;R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0028')
def git(*a):return subprocess.check_output(['git',*a],cwd=R,text=True).strip()
base=git('rev-parse','origin/main');head=git('rev-parse','HEAD');source=json.loads((D/'emission.json').read_text())['source_head']
historical=[]
for p in git('ls-tree','-r','--name-only',base,'reports/evidence').splitlines():
 if Path(p).name=='MANIFEST.json':continue
 assert git('rev-parse',base+':'+p)==git('hash-object',p),p
 historical.append(p)
execution={p:git('rev-parse',source+':'+p) for p in ['ocor-runtime','scripts','infra','deploy','.github','inputs','reports/tests']}
for p,blob in execution.items():assert blob==git('rev-parse',head+':'+p)
for p in ['reports/development/EXECUTION_STATE.json','reports/development/MODEL_HANDOFF.json','reports/development/ITERATION_LOG.md','ocor-runtime/src/ocor_runtime/c2_identity.py']:
 assert git('rev-parse',base+':'+p)==git('hash-object',p),p
p='scripts/validate_ocor_development_plan.py';old=ast.parse(git('show',base+':'+p));new=ast.parse((R/p).read_text())
def extension(tree):
 return next(n.value for n in ast.walk(tree) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='extension_paths' for t in n.targets))
left=extension(old);right=extension(new);added={n.value for n in right.elts}-{n.value for n in left.elts}
expected={'ocor-runtime/tests/tasks/test_ocor_dev_rem_0028.py','reports/assurance/OCOR-DEV-REM-0028-RCCAD/README.md','reports/assurance/OCOR-DEV-REM-0028-RCCAD/audit.json',*[f'reports/evidence/G4/OCOR-DEV-{x}.{e}' for x in ['REM-0028'] for e in ['json','log']],*[f'reports/evidence/{"G5" if x=="0050" else "G4"}/OCOR-DEV-{x}.requalified-rem0028.{e}' for x in ['0043','0044','0050'] for e in ['json','log']]}
assert added==expected
right.elts=[n for n in right.elts if n.value not in added];assert ast.dump(old)==ast.dump(new)
for g,changed in [('G4',{'OCOR-DEV-0043','OCOR-DEV-0044'}),('G5',{'OCOR-DEV-0050'})]:
 p='reports/evidence/'+g+'/MANIFEST.json';before=json.loads(git('show',base+':'+p));after=json.loads((R/p).read_text())
 for row in before['artifacts']:assert row in after['artifacts']
 if g=='G5':assert before['requirement_results']==after['requirement_results']
 b=[r for r in before['requirement_results'] if r.get('task_id') not in changed];a=[r for r in after['requirement_results'] if r.get('task_id') not in changed];assert b==a
 assert [(r['task_id'],r['case_id']) for r in before['requirement_results']]==[(r['task_id'],r['case_id']) for r in after['requirement_results']]
record={'status':'PASS','main':base,'head_at_check':head,'source_head':source,'execution_trees':execution,'historical_artifacts_preserved':len(historical),'historical_artifact_paths_sha256':hashlib.sha256(('\n'.join(historical)+'\n').encode()).hexdigest(),'planning_validator_ast':'Identical except11 exact authorised allowlist paths','allowlist_additions':sorted(added),'candidate_state_files':'byte-identical to main','manifest_resolution':'Historical artifacts retained; only0043/0044 requirement evidence pointers/descriptive commands updated. All historical0050 normative rows unchanged; new0050 artifact/RAW supersede latest-input regression only.'}
(D/'invariants.json').write_text(json.dumps(record,indent=2,sort_keys=True)+'\n');print('PASS: historical records, exact allowlist AST, state freeze, execution trees and manifests')

END_RAW_FILE invariants.py
