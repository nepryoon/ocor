RAW_FILE teardown.py ORIGINAL_SHA256 f55317effc5d03f474b474aa71c6b0155dbfa0baadbf27e40961330b60623102 PUBLISHED_SHA256 f55317effc5d03f474b474aa71c6b0155dbfa0baadbf27e40961330b60623102
import hashlib,json,subprocess
from pathlib import Path
D=Path(__file__).parent;R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0028')
def inv():
 return {k:sorted(subprocess.check_output(c,text=True,timeout=30).splitlines()) for k,c in [('containers',['docker','ps','-aq']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','-q'])]}
prior=json.loads((D/'resources-before.json').read_text());before=inv()
r=subprocess.run([str(R/'ocor-runtime/.venv/bin/python'),'scripts/reset_test_environment.py','--execute'],cwd=R,capture_output=True,text=True,timeout=300)
p=D/'session-teardown.log';p.write_text(r.stdout+r.stderr)
after=inv();new={k:sorted(set(after[k])-set(prior[k])) for k in after}
owned={k:subprocess.check_output(['docker',*args,'--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True,timeout=30).splitlines() for k,args in [('containers',['ps','-aq']),('volumes',['volume','ls','-q']),('networks',['network','ls','-q'])]}
status='PASS' if r.returncode==0 and not any(new.values()) and not any(owned.values()) else 'FAIL'
o={'status':status,'exit_code':r.returncode,'before_counts':{k:len(v) for k,v in before.items()},'after_counts':{k:len(v) for k,v in after.items()},'new_resources_remaining':new,'owned_bootstrap_resources_remaining':owned,'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'scope':'session-owned OCOR resources only; no non-OCOR resources touched'}
(D/'session-teardown.json').write_text(json.dumps(o,indent=2,sort_keys=True)+'\n');print(json.dumps(o));assert status=='PASS'

END_RAW_FILE teardown.py
