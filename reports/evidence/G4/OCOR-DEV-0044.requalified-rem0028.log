values=dict(l.split('=',1) for l in (R/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(R/'.ocor/bootstrap.env');env['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:'+values['OCOR_LOCAL_POSTGRES_PASSWORD']+'@127.0.0.1:55433/ocor'
rows=[]
