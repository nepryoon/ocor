{"command": "captured script: ~/.ocor-codex/rem-0049-r1/redgreen.sh", "exit_code": 0, "label": "script-redgreen.sh", "output": "#!/bin/bash\n# RED/GREEN of repair cycle 1 with every backend down (docker ps empty).\n# Fingerprint = sha256 of the sorted \"classname::name outcome\" lines of the JUnit XML,\n# outcome in {passed, failed, error, skipped}, newline-joined, trailing newline from print().\nset -u\nWT=$1; OUT=$2; PY=/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0049-r1/ocor-runtime/.venv/bin/python\ncd \"$WT/ocor-runtime\"\necho \"docker_ps=$(docker ps -q | wc -l) head=$(git rev-parse HEAD) src_typedb_adapter_sha256=$(sha256sum src/ocor_runtime/c4/typedb_adapter.py | cut -d' ' -f1)\" > \"$OUT.log\"\n$PY -m pytest -p no:cacheprovider -q -rfE tests/tasks/test_ocor_dev_rem_0010.py \\\n  \"tests/tasks/test_ocor_dev_rem_0049.py::test_repair_1_every_adapter_read_goes_through_the_one_read_seam\" \\\n  --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "047433fbe260543519f0f7692892222e8f3ea145684d8163cb0dd75dd9ed029e"}
