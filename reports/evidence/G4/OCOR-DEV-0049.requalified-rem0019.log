{"command": "captured artifact: assertion_identity.py", "exit_code": 0, "label": "artifact-assertion_identity.py", "output": "\"\"\"REM-0019: the 390 collected cases and every assertion are unchanged.\nCompares, per test function, the multiset of assert statements (ast.unparse) of the\nsealed candidate and of the remediation; the only admitted rewrite is the renaming of the\nobserved carrier/vault object (stack.ops -> ops, stack.vault -> vault) in the tests that now\nobserve their own carrier or vault. Prints a JSON report; exit 1 on any other difference.\"\"\"\nimport ast, json, subprocess, sys\nfrom collections import Counter\nrepo, old_rev, new_rev = sys.argv[1], sys.argv[2], sys.argv[3]\nPATH = \"ocor-runtime/tests/tasks/test_ocor_dev_0049.py\"\ndef source(rev):\n    return subprocess.check_output([\"git\", \"show\", f\"{rev}:{PATH}\"], cwd=repo, text=True)\ndef asserts(src):\n    out = {}\n    for node in ast.walk(ast.parse(src)):\n        if isinstance(node, ast.FunctionDef):\n            items = [ast.unparse(n) for n in ast.walk(node) if isinstance(n, ast.Assert)]\n            # pytest.raises / pytest.fail and the asserting helpers called by the test are assertions too\n            items += [ast.unparse(n) for n in ast.walk(node) if isinstance(n, ast.Call)\n                      and ast.unparse(n.func) in (\"pytest.fail\", \"pytest.raises\", \"wait_for\", \"assert_admission\",\n                                                      \"_observe_refused_receipt\", \"governed_reopen\", \"assert_sealed\")]\n            out[node.name] = Counter(items)\n    return out\nRENAMES = [(\"stack.ops\", \"ops\"), (\"stack.vault\", \"vault\")]\ndef normal(counter):\n    c = Counter()\n    for k, v in counter.items():\n        for a, b in RENAMES:\n            k = k.replace(a, b)\n        c[k] += v\n    return c\nold, new = asserts(source(old_rev)), asserts(source(new_rev))\ntests = sorted(n for n in old if n.startswith(\"test_\"))\nreport = {\"tests_compared\": len(tests), \"identical\": [], \"identical_after_rename\": [], \"different\": {},\n          \"new_helpers_or_fixtures\": sorted(set(new) - set(old)), \"removed\": sorted(set(old) - set(new))}\nfor t in tests:\n    if t not in new:\n        report[\"different\"][t] = \"removed\"\n    elif old[t] == new[t]:\n        report[\"identical\"].append(t)\n    elif normal(old[t]) == normal(new[t]):\n        report[\"identical_after_rename\"].append(t)\n    else:\n        report[\"different\"][t] = {\"only_old\": sorted((old[t] - new[t]).elements()), \"only_new\": sorted((new[t] - old[t]).elements())}\nreport[\"counts\"] = {k: len(report[k]) for k in (\"identical\", \"identical_after_rename\", \"different\")}\nprint(json.dumps(report, indent=2, sort_keys=True))\nsys.exit(1 if report[\"different\"] or report[\"removed\"] else 0)\n", "sha256": "b37a65fee7b7b84cba90661c637a4bd34a4701355f9c0013cf2af63176c3c6bb"}
