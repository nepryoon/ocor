{"command": "captured script: ~/.ocor-codex/rem-0050/redgreen.sh", "exit_code": 0, "label": "script-redgreen.sh", "output": "#!/bin/bash\n# RED/GREEN of OCOR-DEV-REM-0050 on the real backends (postgresql, terminusdb, typedb up; Kafka self-provisioned).\n# Fingerprint = sha256 of the sorted \"classname::name outcome\" lines of the JUnit XML,\n# outcome in {passed, failed, error, skipped}, newline-joined, trailing newline from print().\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT/ocor-runtime\"\nexport OCOR_LIVE_POSTGRES_DSN=$(cat ~/.ocor-codex/rem-0050/dsn) OCOR_BOOTSTRAP_ENV=~/.ocor-codex/rem-0050/dev.env\necho \"head=$(git rev-parse HEAD) docker=$(docker ps --format '{{.Names}}' | sort | tr '\\n' ' ')\" > \"$OUT.log\"\n.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "01f853bcefa93aa788d99b9a750c96d051316c0966b085025626e81bffc2345c"}
