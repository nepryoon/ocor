{"command": "captured artifact: NCR-C3-007 mutation probe probe.sh at the code head", "exit_code": 0, "label": "ncr-c3-007-probe-probe.sh", "output": "#!/bin/bash\n# NCR-C3-007 mutation probe of OCOR-DEV-REM-0050 at the final code head, after (outside) the campaign.\n# Scratch detached worktree with the unit .venv symlinked; dev services postgresql + terminusdb of the kit.\n# M0 = unmutated baseline (must pass); mutant = epoch check removed in TerminusDBC3Adapter.acknowledge_outbox (must fail).\nset -u\nHEAD=$1\nP=$HOME/.ocor-codex/rem-0050-q/probe\nR=/home/luca/projects/ocor-detailed-design\nS=$R/.ocor/worktrees/rem-0050-probe7\nSEL=\"tests/tasks/test_ocor_dev_rem_0050.py::test_ncr_c3_007_conforms\"\ngit -C $R worktree add --detach $S $HEAD >/dev/null 2>&1 || exit 10\nln -s $R/.ocor/worktrees/rem-0050/ocor-runtime/.venv $S/ocor-runtime/.venv\ncd $S/ocor-runtime\nexport OCOR_LIVE_POSTGRES_DSN=$(cat ~/.ocor-codex/rem-0050/dsn) OCOR_BOOTSTRAP_ENV=~/.ocor-codex/rem-0050/dev.env PYTHONPATH=..\nrun(){ echo \"head=$(git rev-parse HEAD) mutation=$2 docker=$(docker ps --format '{{.Names}}' | sort | tr '\\n' ' ')\" > $P/$1.log\n       .venv/bin/python -m pytest -p no:cacheprovider -q -rfE $SEL >> $P/$1.log 2>&1; rc=$?; echo \"exit=$rc\" >> $P/$1.log; return $rc; }\nrun baseline none; b=$?\npython3 - <<'PY'\nfrom pathlib import Path\np = Path(\"src/ocor_runtime/c3/adapters/terminusdb.py\"); s = p.read_text()\ni = s.index(\"    def acknowledge_outbox(\")\nj = s.index(\"\\n    def \", i + 10)\nbody = s[i:j]\na = '            epoch = self._check_fence(fence)\\n'\nb = '                _holds(\"C3WriterFence\", _key(FENCE_BOUNDARY), \"writer_epoch\", epoch),\\n'\nassert body.count(a) == 1 and body.count(b) == 1\nbody = body.replace(a, '            epoch = _integer(fence, \"writer_epoch\", minimum=1) if fence is not None else 0  # MUTATION: epoch check removed\\n').replace(b, \"\")\np.write_text(s[:i] + body + s[j:])\nPY\ngit diff > $P/mutation.patch\nrun mutant mutation.patch; m=$?\ngit checkout -q -- .\ncd $R; rm $S/ocor-runtime/.venv; git worktree remove --force $S; git worktree prune\npython3 - $HEAD $b $m <<'PY'\nimport hashlib, json, sys\nfrom pathlib import Path\nP = Path.home() / \".ocor-codex/rem-0050-q/probe\"\nhead, b, m = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])\ndef tail(name): return [l for l in (P / name).read_text().splitlines() if l.startswith((\"FAILED\", \"E \", \"exit=\")) or \" passed\" in l or \" failed\" in l]\nout = {\"head\": head, \"selection\": [\"ocor-runtime/tests/tasks/test_ocor_dev_rem_0050.py::test_ncr_c3_007_conforms\"],\n       \"mutation\": \"TerminusDBC3Adapter.acknowledge_outbox: writer epoch read without the fence check and the C3WriterFence condition removed (mutation.patch)\",\n       \"baseline\": {\"exit_code\": b, \"summary\": tail(\"baseline.log\")}, \"mutant\": {\"exit_code\": m, \"summary\": tail(\"mutant.log\"), \"killed\": m == 1 and \"DID NOT RAISE\" in (P / \"mutant.log\").read_text()}}\n(P / \"probe.json\").write_text(json.dumps(out, indent=2, sort_keys=True) + \"\\n\")\nprint(json.dumps(out, indent=1))\nPY\n", "sha256": "15b9333496209a9a5c661a613ce5ab7a3a40b4e943611194144c92f809c8a420"}
