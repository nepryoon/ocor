{"command": "captured script: ~/.ocor-codex/rem-0051-r2/redgreen.sh", "exit_code": 0, "label": "script-redgreen-repair-2.sh", "output": "#!/bin/bash\n# RED/GREEN of OCOR-DEV-REM-0051 repair 2 (backend-free: evidence_manifest.py regression class).\n# Fingerprint = sha256 of the sorted \"classname::name outcome\" lines of the JUnit XML.\nset -u\nWT=$1; OUT=$2; shift 2\ncd \"$WT\"\necho \"head=$(git rev-parse HEAD)\" > \"$OUT.log\"\nocor-runtime/.venv/bin/python -m pytest -p no:cacheprovider -q -rfE \"$@\" --junitxml=\"$OUT.xml\" >> \"$OUT.log\" 2>&1\necho \"exit=$?\" >> \"$OUT.log\"\npython3 - \"$OUT.xml\" <<'PY' > \"$OUT.lines\"\nimport sys, xml.etree.ElementTree as ET\nrows=[]\nfor tc in ET.parse(sys.argv[1]).iter(\"testcase\"):\n    kind=\"passed\"\n    for k in (\"failure\",\"error\",\"skipped\"):\n        if tc.find(k) is not None: kind={\"failure\":\"failed\"}.get(k,k)\n    rows.append(f\"{tc.get('classname')}::{tc.get('name')} {kind}\")\nprint(\"\\n\".join(sorted(rows)))\nPY\nsha256sum < \"$OUT.lines\" | cut -d' ' -f1 > \"$OUT.fingerprint\"\n", "sha256": "6a3def0490e852ab7bc285e81863149852d666a4eedf04cb64731bc483731049"}
