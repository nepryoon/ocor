{"command": "captured script: ~/.ocor-codex/rem-0051-r2/pregate.py", "exit_code": 0, "label": "script-pregate.py", "output": "\"\"\"PRE-CAMPAIGN-GATE (2026-10-26) for OCOR-DEV-REM-0051 repair 2 (evidence_manifest.py regression class, VF-001): every non-suite step of the\nworkflows at HEAD, run verbatim from a clean shell in a detached scratch worktree at HEAD.\"\"\"\nimport json, os, subprocess, sys, time\nfrom pathlib import Path\nD = Path.home() / \".ocor-codex/rem-0051-r2/gate\"\nSRC = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0051-r1\")\nHEAD = subprocess.check_output([\"git\", \"-C\", str(SRC), \"rev-parse\", \"HEAD\"], text=True).strip()\nW = Path(f\"/tmp/rem0051r2-gate-{HEAD[:12]}\")\nBR = \"governed/ocor-dev-rem-0051-ncp-u06-c5-backbone-repair-1\"\nBASE = subprocess.check_output([\"git\", \"-C\", str(SRC), \"merge-base\", \"HEAD\", \"origin/main\"], text=True).strip()\nLB = Path.home() / \".ocor-codex/impl-env/rem-0051/bin\"\nPATH = f\"{LB}:{W}/.ocor/tools/bin:{W}/ocor-runtime/.venv/bin:/usr/local/bin:/usr/bin:/bin\"\nENV = {\"HOME\": str(Path.home()), \"PATH\": PATH}\nif W.exists():\n    subprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"remove\", \"--force\", str(W)])\nsubprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"add\", \"-q\", \"--detach\", str(W), HEAD], check=True)\n(W / \".ocor\").mkdir(exist_ok=True)\nsubprocess.run([\"cp\", \"-a\", str(SRC / \".ocor/tools\"), str(W / \".ocor/\")], check=True)\nPY = \"ocor-runtime/.venv/bin/python\"\narchive = Path(f\"/tmp/rem0051r2-archive-{HEAD[:12]}\")\nSTEPS = [\n    (\"restore-env\", \"uv sync --project ocor-runtime --frozen --extra test --extra lint\", None),\n    (\"prove-head\", f'test \"$(git rev-parse HEAD)\" = \"{HEAD}\"', None),\n    (\"inputs-checksum\", \"sha256sum -c inputs/normative/SHA256SUMS\", None),\n    (\"report-checksum\", \"sha256sum -c reports/OCOR_ADD_v1.2_SHA256SUMS\", None),\n    (\"inputs-immutable\", f\"git diff --exit-code {BASE} -- inputs/