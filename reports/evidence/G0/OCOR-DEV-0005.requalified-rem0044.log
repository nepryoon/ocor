{"command": "negative-control probe tamper_probe.py (outside Git)", "exit_code": 0, "label": "tamper-probe-script", "output": "\"\"\"Negative controls for the REM-0044 integrity test: each tampering of the register, applied in a\nscratch detached worktree at the code commit (never in the candidate worktree), must make\nreports/tests/test_normative_conformance_register.py fail; the untouched register must pass.\nUsage: tamper_probe.py <code_commit> <python>\"\"\"\nimport copy, json, re, subprocess, sys\nfrom pathlib import Path\nSRC = Path(\"/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0044\")\nHEAD, PY = sys.argv[1], sys.argv[2]\nW = Path(f\"/tmp/rem0044-tamper-{HEAD[:12]}\")\nif W.exists():\n    subprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"remove\", \"--force\", str(W)], check=True)\nsubprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"add\", \"-q\", \"--detach\", str(W), HEAD], check=True)\nREG = W / \"reports/development/NORMATIVE_CONFORMANCE_REGISTER.json\"\nORIG = json.loads(REG.read_text())\ndef high_open(r):\n    return next(e for e in r[\"entries\"] if e[\"severity\"] == \"HIGH\" and e[\"status\"] == \"OPEN\")\ndef t_dup_id(r): r[\"entries\"][1][\"id\"] = r[\"entries\"][0][\"id\"]\ndef t_bad_severity(r): r[\"entries\"][0][\"severity\"] = \"CRITICAL\"\ndef t_bad_status(r): r[\"entries\"][0][\"status\"] = \"CLOSED\"\ndef t_bad_type(r): r[\"entries\"][0][\"type\"] = \"WRONG\"\ndef t_seed_missing(r): r[\"seed_coverage\"].pop(sorted(r[\"seed_coverage\"])[0])\ndef t_seed_dangling(r): r[\"seed_coverage\"][sorted(r[\"seed_coverage\"])[0]][\"entry_id\"] = \"NCR-NOPE-999\"\ndef t_supp_missing(r): r[\"supplement_coverage\"].pop(sorted(r[\"supplement_coverage\"])[0])\ndef t_high_no_plan_unit(r): high_open(r)[\"plan_unit\"] = \"\"\ndef t_high_no_blocks(r): e = high_open(r); e[\"blocks\"] = []; e.pop(\"blocks_none_reason\", None)\ndef t_refuted_blocks(r): e = next(x for x in r[\"entries\"] if x[\"status\"] == \"REFUTED\"); e[\"blocks\"] = [\"OCOR-DEV-0062\"]\ndef t_in_remediation_no_record(r): e = high_open(r); e[\"status\"] = \"IN_REMEDIATION\"; e[\"remediation_unit\"] = \"\"; e[\"remediation_record\"] = \"\"\ndef t_deferred_no_ref(r): e = high_open(r); e[\"status\"] = \"DEFERRED_BY_PO\"; e[\"po_decision_ref\"] = None\ndef t_anchor_beyond_eof(r):\n    e = r[\"entries\"][0]; ref = e[\"norm_refs\"][0]\n    if isinstance(ref, dict): ref[\"lines\"] = \"999999\"\n    else: raise SystemExit(\"unexpected norm_refs shape\")\ndef t_requirement_generic(r): r[\"entries\"][0][\"requirement_ids\"] = [\"BR-3\"]\ndef t_noncanonical(r): pass\nCASES = [t_dup_id, t_bad_severity, t_bad_status, t_bad_type, t_seed_missing, t_seed_dangling, t_supp_missing, t_high_no_plan_unit,\n         t_high_no_blocks, t_refuted_blocks, t_in_remediation_no_record, t_deferred_no_ref, t_anchor_beyond_eof, t_requirement_generic, t_noncanonical]\ndef run():\n    p = subprocess.run([PY, \"-m\", \"pytest\", \"-q\", \"-rfE\", \"-p\", \"no:cacheprovider\", \"reports/tests/test_normative_conformance_register.py\"], cwd=W, capture_output=True, text=True)\n    tail = [l for l in p.stdout.splitlines() if l.startswith((\"FAILED\", \"ERROR\", \"SUBFAIL\")) or \" passed\" in l or \" failed\" in l]\n    return p.returncode, tail\nout = {}\nrc, tail = run(); out[\"untouched\"] = {\"exit_code\": rc, \"expected\": \"PASS\", \"ok\": rc == 0, \"summary\": tail[-1:]}\nfor fn in CASES:\n    r = copy.deepcopy(ORIG); fn(r)\n    text = json.dumps(r, indent=2, sort_keys=True) + \"\\n\"\n    if fn is t_noncanonical: text = json.dumps(r, sort_keys=True) + \"\\n\"\n    REG.write_text(text)\n    rc, tail = run()\n    out[fn.__name__] = {\"exit_code\": rc, \"expected\": \"FAIL\", \"ok\": rc != 0, \"failed_tests\": sorted({re.split(r\"[ \\[]\", l.split(None, 1)[1].split(\"::\", 2)[-1])[0] for l in tail if l.startswith((\"FAILED\", \"SUBFAIL\"))})}\nREG.write_text(json.dumps(ORIG, indent=2, sort_keys=True) + \"\\n\")\nrc, tail = run(); out[\"restored\"] = {\"exit_code\": rc, \"expected\": \"PASS\", \"ok\": rc == 0}\nsubprocess.run([\"git\", \"-C\", str(SRC), \"worktree\", \"remove\", \"--force\", str(W)], check=True)\nout[\"all_ok\"] = all(v[\"ok\"] for v in out.values() if isinstance(v, dict))\nprint(json.dumps(out, indent=1, sort_keys=True))\n", "sha256": "eda5165f61e942cad1aabab77cb11ec06911c63e53913353bffa208d34c1a4ad"}
