t_noncanonical\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_canonical_json\"\n  ],\n  \"ok\": true\n },\n \"t_refuted_blocks\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_refuted_entries_block_nothing\"\n  ],\n  \"ok\": true\n },\n \"t_requirement_generic\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_entry_schema_and_allowed_values\"\n  ],\n  \"ok\": true\n },\n \"t_seed_dangling\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_seed_coverage\"\n  ],\n  \"ok\": true\n },\n \"t_seed_missing\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_seed_coverage\"\n  ],\n  \"ok\": true\n },\n \"t_supp_missing\": {\n  \"exit_code\": 1,\n  \"expected\": \"FAIL\",\n  \"failed_tests\": [\n   \"test_supplement_coverage\"\n  ],\n  \"ok\": true\n },\n \"untouched\": {\n  \"exit_code\": 0,\n  \"expected\": \"PASS\",\n  \"ok\": true,\n  \"summary\": [\n   \"15 passed, 861 subtests passed in 0.49s\"\n  ]\n }\n}\n", "sha256": "00fa3330225626f903dc286c7bfce87715497796fb0441eec7b7cb6c3d0b7927"}
