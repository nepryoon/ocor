 \"id\": \"sha256:11fd73a2102cda9c55d5d881a8c3210303146a7ec1e8ac76f526e175c6d24641\",\n      \"image_ref\": \"quay.io/openbao/openbao@sha256:11fd73a2102cda9c55d5d881a8c3210303146a7ec1e8ac76f526e175c6d24641\",\n      \"memory_limit\": 0,\n      \"oom_killed\": false,\n      \"restart_count\": 0,\n      \"running\": true,\n      \"started_at\": \"2026-10-14T19:39:17.445370036Z\"\n    },\n    \"/ocor-bootstrap-postgresql-1\": {\n      \"health\": \"healthy\",\n      \"id\": \"sha256:33f923b05f64ca54ac4401c01126a6b92afe839a0aa0a52bc5aeb5cc958e5f20\",\n      \"image_ref\": \"postgres@sha256:33f923b05f64ca54ac4401c01126a6b92afe839a0aa0a52bc5aeb5cc958e5f20\",\n      \"memory_limit\": 0,\n      \"oom_killed\": false,\n      \"restart_count\": 0,\n      \"running\": true,\n      \"started_at\": \"2026-10-14T19:39:17.239929271Z\"\n    },\n    \"/ocor-bootstrap-qdrant-1\": {\n      \"health\": \"healthy\",\n      \"id\": \"sha256:d122138f76868edba68d36cb0833139c1d1761f00f09e48e61f8314196e6a4c6\",\n      \"image_ref\": \"qdrant/qdrant@sha256:d122138f76868edba68d36cb0833139c1d1761f00f09e48e61f8314196e6a4c6\",\n      \"memory_limit\": 0,\n      \"oom_killed\": false,\n      \"restart_count\": 0,\n      \"running\": true,\n      \"started_at\": \"2026-10-14T19:39:17.808797094Z\"\n    },\n    \"/ocor-bootstrap-spire-agent-1\": {\n      \"health\": null,\n      \"id\": \"sha256:41b0dcd8b258a69db9e2768292a060766fb76fd866e4bc925849981ea1b825ff\",\n      \"image_ref\": \"ghcr.io/spiffe/spire-agent@sha256:41b0dcd8b258a69db9e2768292a060766fb76fd866e4bc925849981ea1b825ff\",\n      \"memory_limit\": 0,\n      \"oom_killed\": false,\n      \"restart_count\": 0,\n      \"running\": true,\n      \"started_at\": \"2026-10-14T19:39:17.956104854Z\"\n    },\n    \"/ocor-bootstrap-spire-server-1\": {\n      \"health\": \"healthy\",\n      \"id\": \"sha256:4082f30d3e0ddc4000a171392c4ea174345ee44d161ee917c70b97b2ecfba141\",\n      \"image_ref\": \"ghcr.io/spiffe/spire-server@sha256:4082f30d3e0ddc400