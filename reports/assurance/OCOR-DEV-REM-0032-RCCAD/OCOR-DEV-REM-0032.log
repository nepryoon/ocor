{"command": "captured artifact", "exit_code": 0, "label": "repair1-runtime-campaign-harness", "output": "import os,sys,subprocess,time,signal,json,threading,xml.etree.ElementTree as ET\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nout=Path(__file__).parent\nrepo=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0032')\nci=repo.parent/'ocor-dev-rem-0017-ci-provision-spire'\nsys.path.insert(0,str(ci/'scripts'))\nfrom run_qualifying_campaign import inspect_stack,check_stack\nfrom bootstrap_ci_environment import redact_campaign_log\nlabel=sys.argv[1]\nenv=os.environ.copy()\nenv['PATH']='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/projects/ocor-detailed-design/.ocor/tools/bin:'+env['PATH']\nsecrets=dict(line.split('=',1) for line in (repo/'.ocor/bootstrap.env').read_text().splitlines() if '=' in line)\nenv.update(secrets)\nenv['OCOR_BOOTSTRAP_ENV']=str(repo/'.ocor/bootstrap.env')\nenv['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:<redacted:dsn-password>@127.0.0.1:55433/ocor'\ncmd=['uv','run','--project','ocor-runtime','--frozen','--extra','test','--extra','lint','pytest','-v','-ra','-p','no:cacheprovider','--basetemp='+str(out/('bt-'+label)),'--junitxml='+str(out/(label+'.xml'))]\nif label=='full':cmd+=['ocor-runtime/tests/']\nelif label=='rem':cmd+=['-s','reports/tests/test_rem0032_relay_probe.py']\nelif label=='reports':cmd+=['reports/tests/test_generate_contracts_reference_resolution.py','reports/tests/test_language_migration_benchmark_harness.py','reports/tests/test_backlog_generator_reality_parity.py','reports/tests/test_runtime_evidence_validator.py','reports/tests/test_evidence_input_drift.py']\nelse:\n cmd+=['ocor-runtime/tests/tasks/test_ocor_dev_0049.py']\n if label.startswith('focused'):cmd+=['-k','tied_epoch or checkpoint or recovery_point or time_branches or backup_seals or isolated_restore or coherent or incoherent or memory_branch']\ninitial=inspect_stack()\nvolume_provenance={}\nstop_provenance=threading.Event()\ndef observe_spike_volumes():\n while not stop_provenance.is_set():\n  ids=subprocess.check_output(['docker','ps','-aq','--filter','name=ocor-spike-'],text=True).split()\n  if ids:\n   result=subprocess.run(['docker','inspect',*ids],capture_output=True,text=True)\n   if result.returncode==0:\n    for container in json.loads(result.stdout):\n     if not container['Name'].startswith(('/ocor-spike-0019-','/ocor-spike-0023-')):continue\n     for mount in container.get('Mounts',[]):\n      if mount['Type']=='volume':volume_provenance[mount['Name']]={'container':container['Name'],'image_id':container['Image'],'destination':mount['Destination']}\n  stop_provenance.wait(0.5)\nobserver=None\nif label=='full':\n observer=threading.Thread(target=observe_spike_volumes,daemon=True);observer.start()\ndef observe_kind():\n while not stop_provenance.wait(10):\n  result=subprocess.run(['docker','inspect','ocor-poc-control-plane'],capture_output=True,text=True,timeout=10)\n  if result.returncode==0:\n   with (out/(label+'-kind-diagnostics-private.log')).open('a') as diag:\n    diag.write(result.stdout)\n    subprocess.run(['docker','exec','ocor-poc-control-plane','journalctl','-u','containerd','--since','30 seconds ago','--no-pager'],stdout=diag,stderr=subprocess.STDOUT,timeout=10)\nkind_observer=threading.Thread(target=observe_kind,daemon=True);kind_observer.start()\nstart=time.monotonic();started=datetime.now(timezone.utc).isoformat()\nlog=out/(label+'.log');log.touch(mode=0o600)\nerror=None\nwith log.open('w') as f:\n f.write('HEAD '+subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()+'\\nCOMMAND '+json.dumps(cmd)+'\\n');f.flush()\n p=subprocess.Popen(cmd,cwd=repo,env=env,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)\n while p.poll() is None:\n  try:\n   check_stack(initial,inspect_stack())\n   limit=4500 if label=='full' else 2700\n   if time.monotonic()-start>limit:raise RuntimeError(str(limit//60)+' minute suite limit exceeded')\n  except Exception as exc:\n   error=str(exc)\n   os.killpg(p.pid,signal.SIGINT)\n   with (out/(label+'-diagnostics.log')).open('w') as diag:\n    subprocess.run(['docker','stats','--no-stream'],stdout=diag,stderr=subprocess.STDOUT,timeout=20)\n    for name in initial:subprocess.run(['docker','logs','--tail','100',name.lstrip('/')],stdout=diag,stderr=subprocess.STDOUT,timeout=15)\n   try:p.wait(timeout=60)\n   except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=10)\n   break\n  time.sleep(5)\n f.write('\\nEXIT_CODE '+str(p.returncode)+'\\n')\nredact_campaign_log(repo,log)\nstop_provenance.set();kind_observer.join(timeout=20)\nif observer:\n observer.join(timeout=10)\n (out/'full-volume-provenance.json').write_text(json.dumps(volume_provenance,indent=2,sort_keys=True)+'\\n')\nresult={'command':cmd,'started_at':started,'finished_at':datetime.now(timezone.utc).isoformat(),'duration_seconds':time.monotonic()-start,'exit_code':p.returncode,'watchdog_error':error,'head_sha':subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()}\nif (out/(label+'.xml')).exists():\n tree=ET.parse(out/(label+'.xml')).getroot();suites=[tree] if tree.tag=='testsuite' else list(tree.iter('testsuite'))\n result['counts']={k:sum(int(s.get(k,'0')) for s in suites) for k in ['tests','failures','errors','skipped']}\n(out/(label+'.json')).write_text(json.dumps(result,indent=2,sort_keys=True)+'\\n')\nprint(json.dumps(result),flush=True)\nsys.exit(1 if error else p.returncode)\n", "sha256": "f6d1459d55456f52e706d9d84440a62a83ad7920faa389a6a152d292bcf9801a"}
{"command": "captured artifact", "exit_code": 0, "label": "repair1-runtime-campaign-orchestration", "output": "import subprocess,sys,json,time,os\nfrom pathlib import Path\nout=Path(__file__).parent\nrepo=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem-0032')\nresults=[]\ndef resources():\n return {key:subprocess.check_output(['docker',*cmd],text=True).split() for key,cmd in {'containers':['ps','-aq','--no-trunc'],'networks':['network','ls','-q','--no-trunc'],'volumes':['volume','ls','-q']}.items()}\nfor label in ['full','task1','task2','task3','rem']:\n with (out/('prepare-'+label+'.out')).open('w') as f:r=subprocess.run([sys.executable,str(out/'prepare.py'),label],cwd=repo,stdout=f,stderr=subprocess.STDOUT)\n if r.returncode:raise SystemExit('preparation failed '+label)\n before=resources();(out/(label+'-resources-before.json')).write_text(json.dumps(before,indent=2,sort_keys=True)+'\\n')\n # Start alignment (declared in the evidence): the accepted Helm test waits for the next */15\n # CronJob tick ~24 min into the task suite; start ~100 s after a tick so that wait stays short.\n if label.startswith('task'):\n  delay=(100-time.time()%900)%900\n  (out/(label+'-alignment.json')).write_text(json.dumps({'aligned_start_offset_seconds':100,'delay_seconds':round(delay,1),'reason':'Helm test waits for the next */15 tick (5..905 s); alignment keeps the 45 minute task-suite cap without removing or skipping any case'},indent=2,sort_keys=True)+'\\n')\n  time.sleep(delay)\n with (out/(label+'.out')).open('w') as f:r=subprocess.run([sys.executable,str(out/'run_suite.py'),label],cwd=repo,stdout=f,stderr=subprocess.STDOUT)\n after=resources();delta={k:sorted(set(after[k])-set(before[k])) for k in after}\n residue={'observed':delta,'removed_volumes':[]}\n for name in delta['volumes']:\n  d=json.loads(subprocess.check_output(['docker','volume','inspect',name],text=True))[0]\n  owners=subprocess.check_output(['docker','ps','-aq','--filter','volume='+name],text=True).split()\n  if not owners and 'com.docker.volume.anonymous' in (d.get('Labels') or {}) and label=='full':\n   subprocess.run(['docker','volume','rm',name],capture_output=True,check=True,timeout=15);residue['removed_volumes'].append(name)\n residue['final_delta']={k:sorted(set(v)-set(before[k])) for k,v in resources().items()}\n (out/(label+'-residue.json')).write_text(json.dumps(residue,indent=2,sort_keys=True)+'\\n')\n results.append(json.loads((out/(label+'.json')).read_text()))\n (out/'stability-progress.json').write_text(json.dumps(results,indent=2,sort_keys=True)+'\\n')\n counts=results[-1].get('counts',{})\n if r.returncode or not counts.get('tests') or any(counts.get(k) for k in ['failures','errors','skipped']) or any(residue['final_delta'].values()):raise SystemExit('nonqualifying run '+label)\n print(label,'PASS',counts,flush=True)\n(out/'stability.done').write_text('PASS\\n')\n", "sha256": "7c13142d10d4f4ed8e14b6e094e90db64eef70362c82896b8774b7e868214fbe"}
{"command": "captured artifact", "exit_code": 0, "label": "repair1-instrument", "output": "#!/usr/bin/env python3\n\"\"\"OCOR-DEV-REM-0032 — CPU-limited relay health scenario (RED/GREEN instrument).\n\nReproduces the setup of the 0049 case that failed in CI (run 38548656297, part 3):\nseveral PoC Compose projects start their ten `ocor-relay-*` services at the same time\non a runner with 4 vCPU. The CPU limit is declared and repeatable: every container of\nthe scenario (relays and the optional synthetic load) is pinned with `cpuset` to the\nsame four host cores (`--cpuset`, default `0-3`); healthcheck execs run inside the\nrelay cgroup and inherit the pin. The synthetic load (`--load N`) is N single-thread\nbusy loops, each in its own container (own CFS group, like the separate processes of\nthe CI runner), pinned to the same cores. `--load-shares` declares their relative CPU\nweight (Docker default 1024). The qualifying scenario fixes eight competitors at\n8192 shares, keeping the old CPU-heavy probes over\ntheir timeout throughout the observation window instead of occasional startup\nspikes. This is a synthetic sustained-contention boundary, not an estimate of the\nrunner's exact background workload. The relay weights and healthchecks are untouched.\nActual CPU settings are read back from Docker for every load and every relay,\nincluding the kernel's cgroup-v2 weight rather than assuming Docker's conversion.\n\nThe scenario only reads the Compose file under test; it adds an override that sets\n`cpuset` on the relays and nothing else, so healthcheck, command, image, networks and\nenvironment are exactly those of the file under test.\n\nOutput (JSON): per-project `up --wait` result, every `health_status` Docker event of\nthe scenario containers, the Health.Log of each container that became unhealthy\n(captured before teardown), the measured CPU cost per probe and the teardown residue.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\nIMAGE = \"python:3.11@sha256:c7220863385ee39fb6d822da81f4469d0cd33ff893d92ce94105e5c3f4b95fe2\"\nLABEL = \"ocor.rem0032.scenario\"\n\n\ndef relay_services(compose: dict[str, Any]) -> list[str]:\n    return sorted(name for name in compose[\"services\"] if name.startswith(\"ocor-relay-\"))\n\n\ndef compose_env(env_file: Path, vault: Path) -> dict[str, str]:\n    values = dict(line.strip().split(\"=\", 1) for line in env_file.read_text().splitlines() if \"=\" in line)\n    return {**os.environ, **values, \"OCOR_OPS_OPERATOR_TOKEN\": \"rem0032-scenario-not-a-secret\",\n            \"OCOR_BACKUP_VAULT_DIR\": str(vault), \"OCOR_OPS_UID\": str(os.getuid()), \"OCOR_OPS_GID\": str(os.getgid())}\n\n\ndef docker(*args: str, timeout: int = 120, check: bool = False) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([\"docker\", *args], capture_output=True, text=True, timeout=timeout, check=check)\n\n\ndef cgroup_usage_usec(container_id: str) -> int | None:\n    path = Path(f\"/sys/fs/cgroup/system.slice/docker-{container_id}.scope/cpu.stat\")\n    try:\n        for line in path.read_text().splitlines():\n            if line.startswith(\"usage_usec \"):\n                return int(line.split()[1])\n    except OSError:\n        return None\n    return None\n\n\ndef run(args: argparse.Namespace) -> dict[str, Any]:\n    compose_path = Path(args.compose).resolve()\n    compose = yaml.safe_load(compose_path.read_text(encoding=\"utf-8\"))\n    relays = relay_services(compose)\n    work = Path(tempfile.mkdtemp(prefix=\"rem0032-scenario-\"))\n    vault = work / \"vault\"\n    vault.mkdir()\n    override = work / \"cpuset.override.yaml\"\n    override.write_text(yaml.safe_dump({\"services\": {r: {\"cpuset\": args.cpuset} for r in relays}}))\n    env = compose_env(Path(args.env_file), vault)\n    projects = [f\"rem0032-{args.label}-{i}\" for i in range(1, args.projects + 1)]\n    result: dict[str, Any] = {\n        \"compose\": str(compose_path), \"cpuset\": args.cpuset, \"label\": args.label, \"load_processes\": args.load,\n        \"load_shares\": args.load_shares,\n        \"observe_seconds\": args.observe, \"projects\": projects, \"relays_per_project\": len(relays),\n        \"relay_healthcheck\": compose.get(\"x-relay\", {}).get(\"healthcheck\"),\n        \"started_at\": time.time(),\n    }\n\n    events_proc = subprocess.Popen(\n        [\"docker\", \"events\", \"--format\", \"{{json .}}\", \"--filter\", \"type=container\",\n         \"--filter\", \"event=health_status\", \"--filter\", \"event=die\", \"--filter\", \"event=start\"],\n        stdout=subprocess.PIPE, text=True)\n    events: list[dict[str, Any]] = []\n\n    def collect() -> None:\n        assert events_proc.stdout is not None\n        for line in events_proc.stdout:\n            try:\n                ev = json.loads(line)\n            except ValueError:\n                continue\n            attrs = ev.get(\"Actor\", {}).get(\"Attributes\", {})\n            name = attrs.get(\"name\", \"\")\n            if any(name.startswith(p + \"-\") for p in projects):\n                events.append({\"time\": ev.get(\"timeNano\", 0) / 1e9, \"action\": ev.get(\"Action\") or ev.get(\"status\"),\n                               \"name\": name, \"exitCode\": attrs.get(\"exitCode\")})\n\n    collector = threading.Thread(target=collect, daemon=True)\n    collector.start()\n\n    load_names = [f\"rem0032-load-{args.label}-{i}\" for i in range(args.load)]\n    try:\n        for name in load_names:\n            docker(\"run\", \"-d\", \"--rm\", \"--name\", name, \"--label\", f\"{LABEL}={args.label}\", \"--cpuset-cpus\",\n                   args.cpuset, \"--cpu-shares\", str(args.load_shares), \"--network\", \"none\", \"--entrypoint\", \"python3\", IMAGE, \"-c\", \"while True: pass\",\n                   check=True)\n        time.sleep(2 if load_names else 0)\n\n        ups: dict[str, dict[str, Any]] = {}\n\n        def up(project: str) -> None:\n            start = time.time()\n            proc = subprocess.run(\n                [\"docker\", \"compose\", \"-p\", project, \"-f\", str(compose_path), \"-f\", str(override), \"--profile\",\n                 \"observability\", \"up\", \"-d\", \"--wait\", \"--wait-timeout\", str(args.wait_timeout), *relays],\n                capture_output=True, text=True, env=env, timeout=args.wait_timeout + 120, check=False)\n            ups[project] = {\"exit_code\": proc.returncode, \"seconds\": round(time.time() - start, 3),\n                            \"output_tail\": (proc.stdout + proc.stderr)[-1500:]}\n\n        threads = [threading.Thread(target=up, args=(p,)) for p in projects]\n        for t in threads:\n            t.start()\n        for t in threads:\n            t.join()\n        result[\"up\"] = ups\n\n        ids: dict[str, str] = {}\n        for p in projects:\n            for cid in docker(\"ps\", \"-q\", \"--no-trunc\", \"--filter\", f\"label=com.docker.compose.project={p}\").stdout.split():\n                name = docker(\"inspect\", \"-f\", \"{{.Name}}\", cid).stdout.strip().lstrip(\"/\")\n                ids[name] = cid\n        def cpu_resources(names: list[str]) -> dict[str, Any]:\n            entries = json.loads(docker(\"inspect\", *names, check=True).stdout)\n            return {e[\"Name\"].lstrip(\"/\"): {\"cpuset\": e[\"HostConfig\"][\"CpusetCpus\"],\n                    \"shares\": e[\"HostConfig\"][\"CpuShares\"], \"quota\": e[\"HostConfig\"][\"CpuQuota\"],\n                    \"nano_cpus\": e[\"HostConfig\"][\"NanoCpus\"],\n                    \"cgroup_weight\": int(Path(f\"/sys/fs/cgroup/system.slice/docker-{e['Id']}.scope/cpu.weight\").read_text())}\n                    for e in entries}\n\n        result[\"cpu_resources\"] = {\"loads\": cpu_resources(load_names) if load_names else {},\n                                   \"relays\": cpu_resources(list(ids))}\n        usage0 = {n: cgroup_usage_usec(c) for n, c in ids.items()}\n        t0 = time.time()\n        time.sleep(args.observe)\n        elapsed = time.time() - t0\n        usage1 = {n: cgroup_usage_usec(c) for n, c in ids.items()}\n        result[\"steady_window_seconds\"] = round(elapsed, 3)\n        cpu = {n: (usage1[n] - usage0[n]) / 1e6 for n in ids if usage0.get(n) is not None and usage1.get(n) is not None}\n        result[\"relay_cpu_seconds_in_window\"] = round(sum(cpu.values()), 3)\n        result[\"relay_cpu_cores_in_window\"] = round(sum(cpu.values()) / elapsed, 3) if elapsed else None\n\n        states = {}\n        for n, c in ids.items():\n            st = json.loads(docker(\"inspect\", \"-f\", \"{{json .State}}\", c).stdout or \"{}\")\n            health = st.get(\"Health\") or {}\n            states[n] = {\"status\": st.get(\"Status\"), \"health\": health.get(\"Status\"),\n                         \"failing_streak\": health.get(\"FailingStreak\"), \"oom_killed\": st.get(\"OOMKilled\"),\n                         \"log\": health.get(\"Log\", []) if health.get(\"Status\") != \"healthy\" else health.get(\"Log\", [])[-2:]}\n        result[\"final_states\"] = states\n    finally:\n        downs = {}\n        for p in projects:\n            proc = subprocess.run([\"docker\", \"compose\", \"-p\", p, \"-f\", str(compose_path), \"-f\", str(override),\n                                   \"--profile\", \"observability\", \"down\", \"-v\", \"--remove-orphans\", \"-t\", \"5\"],\n                                  capture_output=True, text=True, env=env, timeout=300, check=False)\n            downs[p] = proc.returncode\n        for name in load_names:\n            docker(\"rm\", \"-f\", name)\n        time.sleep(1)\n        events_proc.terminate()\n        result[\"down\"] = downs\n        residue = []\n        for p in projects:\n            for kind, cmd in ((\"container\", [\"ps\", \"-aq\"]), (\"volume\", [\"volume\", \"ls\", \"-q\"]),\n                              (\"network\", [\"network\", \"ls\", \"-q\"])):\n                residue += [f\"{kind} {i}\" for i in docker(*cmd, \"--filter\", f\"label=com.docker.compose.project={p}\").stdout.split()]\n        residue += [f\"container {i}\" for i in docker(\"ps\", \"-aq\", \"--filter\", f\"label={LABEL}={args.label}\").stdout.split()]\n        result[\"residue\"] = residue\n\n    unhealthy = [e for e in events if e[\"action\"] == \"health_status: unhealthy\"]\n    result[\"health_events\"] = events\n    result[\"unhealthy_events\"] = unhealthy\n    result[\"unhealthy_containers\"] = sorted({e[\"name\"] for e in unhealthy})\n    result[\"finished_at\"] = time.time()\n    return result\n\n\ndef probe_cost(args: argparse.Namespace) -> dict[str, Any]:\n    \"\"\"CPU cost of one probe of the file under test, on one idle relay without cpuset/load:\n    cgroup CPU of N back-to-back execs of the exact healthcheck command, minus the idle\n    rate of the same container (its own scheduled healthchecks) over an equal window.\"\"\"\n    compose_path = Path(args.compose).resolve()\n    doc = yaml.safe_load(compose_path.read_text(encoding=\"utf-8\"))\n    test = doc[\"x-relay\"][\"healthcheck\"][\"test\"]\n    argv = test[1:] if test[0] == \"CMD\" else [\"/bin/sh\", \"-c\", test[1]]\n    argv = [a.replace(\"$$\", \"$\") for a in argv]\n    work = Path(tempfile.mkdtemp(prefix=\"rem0032-cost-\"))\n    (work / \"vault\").mkdir()\n    env = compose_env(Path(args.env_file), work / \"vault\")\n    project = f\"rem0032-cost-{args.label}\"\n    files = [\"-f\", str(compose_path)]\n    try:\n        up = subprocess.run([\"docker\", \"compose\", \"-p\", project, *files, \"--profile\", \"observability\", \"up\", \"-d\",\n                             \"--wait\", \"ocor-relay-opa\"], capture_output=True, text=True, env=env, timeout=300)\n        assert up.returncode == 0, up.stdout + up.stderr\n        name = f\"{project}-ocor-relay-opa-1\"\n        cid = docker(\"inspect\", \"-f\", \"{{.Id}}\", name, check=True).stdout.strip()\n        u0, t0 = cgroup_usage_usec(cid), time.time()\n        for _ in range(args.probe_cost):\n            docker(\"exec\", name, *argv, check=True)\n        u1, t1 = cgroup_usage_usec(cid), time.time()\n        time.sleep(t1 - t0)\n        u2, t2 = cgroup_usage_usec(cid), time.time()\n        assert None not in (u0, u1, u2)\n        idle_rate = (u2 - u1) / (t2 - t1)\n        per_probe = ((u1 - u0) - idle_rate * (t1 - t0)) / args.probe_cost / 1000\n        return {\"compose\": str(compose_path), \"label\": args.label, \"probe_argv\": argv, \"execs\": args.probe_cost,\n                \"exec_window_seconds\": round(t1 - t0, 3), \"cpu_ms_per_probe\": round(per_probe, 2),\n                \"wall_ms_per_probe\": round((t1 - t0) / args.probe_cost * 1000, 2),\n                \"idle_cpu_ms_per_second\": round(idle_rate / 1000, 2),\n                \"method\": \"container cgroup usage_usec; exec CPU minus idle-rate x window; no cpuset, no load\"}\n    finally:\n        subprocess.run([\"docker\", \"compose\", \"-p\", project, *files, \"--profile\", \"observability\", \"down\", \"-v\",\n                        \"--remove-orphans\", \"-t\", \"2\"], capture_output=True, env=env, timeout=300, check=False)\n\n\ndef main(argv: list[str] | None = None) -> int:\n    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n    parser.add_argument(\"--compose\", required=True)\n    parser.add_argument(\"--env-file\", required=True)\n    parser.add_argument(\"--label\", required=True)\n    parser.add_argument(\"--projects\", type=int, default=3)\n    parser.add_argument(\"--cpuset\", default=\"0-3\")\n    parser.add_argument(\"--load\", type=int, default=0)\n    parser.add_argument(\"--load-shares\", type=int, default=1024,\n                        help=\"relative CPU weight of each load container, relay weight unchanged\")\n    parser.add_argument(\"--observe\", type=int, default=90)\n    parser.add_argument(\"--wait-timeout\", type=int, default=240)\n    parser.add_argument(\"--probe-cost\", type=int, default=0, help=\"measure CPU per probe over N execs instead\")\n    parser.add_argument(\"--out\", required=True)\n    args = parser.parse_args(argv)\n    if not 2 <= args.load_shares <= 262144:\n        parser.error(\"--load-shares must be within Docker's CPU shares range 2..262144\")\n    if args.probe_cost:\n        cost = probe_cost(args)\n        Path(args.out).write_text(json.dumps(cost, indent=2, sort_keys=True) + \"\\n\")\n        print(json.dumps(cost))\n        return 0\n    result = run(args)\n    Path(args.out).write_text(json.dumps(result, indent=2, sort_keys=True) + \"\\n\")\n    print(json.dumps({k: result[k] for k in (\"label\", \"unhealthy_containers\", \"relay_cpu_cores_in_window\", \"residue\")}\n                     | {\"up\": {p: u[\"exit_code\"] for p, u in result.get(\"up\", {}).items()}}))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "sha256": "95fe5527d692c8af1c84c410bd58c7624a6783a258c67ed6ee56e91e9a8c7ad3"}
{"command": "captured artifact", "exit_code": 0, "label": "repair1-test", "output": "\"\"\"OCOR-DEV-REM-0032 — 0049 relay healthcheck load budget.\n\nPO decision REM-0017-CI-0049-RELAY-PROBE-REMEDIATION (2026-10-14). The relay healthcheck\nof `deploy/helm/ocor-poc/compose.profiles.yaml` started, every 2 s, an interpreter that\ncompiled the whole ops agent and re-validated the profile before opening a socket; with\nthree PoC projects (30 relays) on 4 vCPU the probes saturate the runner and relays go\nunhealthy in the setup of 0049 cases.\n\nStatic cases (no Docker): the probe is a TCP connect to the relay's own allowed-flow port,\nthe port matches `isolation.allowedFlows`, the dead-relay bound is <= 30 s, and nothing in\nthe file other than the relay healthcheck and the per-relay port variable differs from the\n0049 task stage `a0ee43d`.\n\nLive cases (real Docker, the digest-pinned image, the Compose file under test):\n* negative controls: a relay whose listener dies after `start_period` becomes unhealthy\n  within 30 s; a relay probed on a port it does not serve never becomes healthy;\n* RED/GREEN: the CPU-limited scenario of `rem0032_relay_scenario.py` (three projects, 4\n  pinned cores, 8 single-thread loads with CPU shares 8192 each) drives relays unhealthy with the a0ee43d probe and\n  keeps every relay healthy with the probe under test.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nimport yaml\n\nROOT = Path(__file__).resolve().parents[2]\nCOMPOSE = ROOT / \"deploy/helm/ocor-poc/compose.profiles.yaml\"\nTASK_STAGE = \"a0ee43d4e502f3589cd857cfec4238eab13fe8e7\"\nSCENARIO = ROOT / \"reports/tests/rem0032_relay_scenario.py\"\nIMAGE = \"python:3.11@sha256:c7220863385ee39fb6d822da81f4469d0cd33ff893d92ce94105e5c3f4b95fe2\"\nDEAD_RELAY_BOUND_SECONDS = 30\n# sha256 of the canonical JSON of the a0ee43d Compose file without the relay healthcheck\n# and without OCOR_RELAY_FLOW_PORT (computed once from `git show a0ee43d:<file>`).\nINVARIANT_SHA256 = \"2fa3d100995c0cd9f11d84726bfd89e3920991ee0e1f6e159057414bd55c9978\"\n\n\ndef load(text: str) -> dict[str, Any]:\n    return yaml.safe_load(text)\n\n\ndef compose() -> dict[str, Any]:\n    return load(COMPOSE.read_text(encoding=\"utf-8\"))\n\n\ndef relays(doc: dict[str, Any]) -> dict[str, dict[str, Any]]:\n    return {n: s for n, s in doc[\"services\"].items() if n.startswith(\"ocor-relay-\")}\n\n\ndef profile(doc: dict[str, Any]) -> dict[str, Any]:\n    return json.loads(doc[\"configs\"][\"ocor-poc-profile\"][\"content\"])\n\n\ndef seconds(value: str) -> float:\n    total, number = 0.0, \"\"\n    for ch in value:\n        if ch.isdigit() or ch == \".\":\n            number += ch\n        else:\n            total += float(number) * {\"h\": 3600, \"m\": 60, \"s\": 1}[ch]\n            number = \"\"\n    return total\n\n\ndef invariant_digest(doc: dict[str, Any]) -> str:\n    doc = copy.deepcopy(doc)\n    doc[\"x-relay\"].pop(\"healthcheck\", None)\n    for name, svc in doc[\"services\"].items():\n        if name.startswith(\"ocor-relay-\"):\n            svc.pop(\"healthcheck\", None)\n            svc.get(\"environment\", {}).pop(\"OCOR_RELAY_FLOW_PORT\", None)\n    return hashlib.sha256(json.dumps(doc, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n\n\n# --------------------------------------------------------------------------- static\n\n\ndef test_probe_is_a_tcp_connect_to_the_own_flow_port_without_the_ops_agent():\n    check = compose()[\"x-relay\"][\"healthcheck\"]\n    test = check[\"test\"]\n    assert test[:3] == [\"CMD\", \"bash\", \"-c\"], test\n    assert \"ocor_ops_agent\" not in \" \".join(test) and \"python\" not in \" \".join(test)\n    # Compose turns `$$` into `$`: bash expands the per-relay variable, failing if unset.\n    assert test[3] == 'exec 3<>\"/dev/tcp/127.0.0.1/$${OCOR_RELAY_FLOW_PORT:?}\"'\n    for name, svc in relays(compose()).items():  # `<<: *relay` merges the anchor into each relay\n        assert svc[\"healthcheck\"] == check, f\"{name} must use the x-relay healthcheck\"\n\n\ndef test_each_relay_probes_exactly_the_port_of_its_allowed_flow():\n    doc = compose()\n    flows = {f[\"host\"]: f[\"port\"] for f in profile(doc)[\"isolation\"][\"allowedFlows\"]}\n    seen = {}\n    for name, svc in relays(doc).items():\n        env = svc[\"environment\"]\n        assert set(env) == {\"OCOR_RELAY_FLOW_HOST\", \"OCOR_RELAY_FLOW_PORT\"}, name\n        assert isinstance(env[\"OCOR_RELAY_FLOW_PORT\"], str), name\n        seen[env[\"OCOR_RELAY_FLOW_HOST\"]] = int(env[\"OCOR_RELAY_FLOW_PORT\"])\n    assert seen == flows\n\n\ndef test_dead_relay_bound_and_startup_grace():\n    check = compose()[\"x-relay\"][\"healthcheck\"]\n    interval, timeout, retries = seconds(check[\"interval\"]), seconds(check[\"timeout\"]), int(check[\"retries\"])\n    assert seconds(check[\"start_period\"]) > 0\n    # Refused connect (dead listener): one failure per interval.\n    assert interval * retries <= DEAD_RELAY_BOUND_SECONDS\n    # Hung probe: each failing probe lasts up to `timeout` before the next interval.\n    assert (interval + timeout) * retries <= DEAD_RELAY_BOUND_SECONDS\n\n\ndef test_everything_else_is_identical_to_the_0049_task_stage():\n    assert invariant_digest(compose()) == INVARIANT_SHA256\n    staged = subprocess.run([\"git\", \"show\", f\"{TASK_STAGE}:deploy/helm/ocor-poc/compose.profiles.yaml\"],\n                            cwd=ROOT, capture_output=True, text=True, check=False)\n    if staged.returncode == 0:  # the pinned digest above is authoritative without git history\n        old = load(staged.stdout)\n        assert invariant_digest(old) == INVARIANT_SHA256\n        assert old[\"configs\"] == compose()[\"configs\"], \"ops agent and profile must be unchanged\"\n        assert old[\"x-relay\"][\"healthcheck\"][\"test\"][2:4] == [\"/opt/ocor/ocor_ops_agent.py\", \"relay-probe\"]\n\n\n# --------------------------------------------------------------------------- live\n\n\ndef _env_file() -> Path:\n    for candidate in (ROOT / \".ocor/bootstrap.env\", Path.home() / \".ocor-bootstrap-secrets/ocor-bootstrap.env\"):\n        if candidate.exists():\n            return candidate\n    pytest.fail(\"ocor-bootstrap env file not found: the real stack is mandatory qualifying evidence\")\n\n\ndef _require_docker() -> None:\n    if subprocess.run([\"docker\", \"info\"], capture_output=True, check=False).returncode != 0:\n        pytest.fail(\"docker is unavailable: the live cases are mandatory\")\n    net = os.environ.get(\"OCOR_BOOTSTRAP_NETWORK\", \"ocor-bootstrap_ocor-bootstrap\")\n    if subprocess.run([\"docker\", \"network\", \"inspect\", net], capture_output=True, check=False).returncode != 0:\n        pytest.fail(f\"bootstrap network {net} is missing: start the ocor-bootstrap stack\")\n\n\ndef _compose_env(vault: Path) -> dict[str, str]:\n    values = dict(line.strip().split(\"=\", 1) for line in _env_file().read_text().splitlines() if \"=\" in line)\n    return {**os.environ, **values, \"OCOR_OPS_OPERATOR_TOKEN\": \"rem0032-test-not-a-secret\",\n            \"OCOR_BACKUP_VAULT_DIR\": str(vault), \"OCOR_OPS_UID\": str(os.getuid()), \"OCOR_OPS_GID\": str(os.getgid())}\n\n\ndef _health(container: str) -> dict[str, Any]:\n    out = subprocess.run([\"docker\", \"inspect\", \"-f\", \"{{json .State}}\", container], capture_output=True, text=True,\n                         check=True).stdout\n    return json.loads(out)\n\n\ndef test_dead_relay_after_start_period_turns_unhealthy_within_bound(tmp_path):\n    \"\"\"Listener killed after start_period -> unhealthy <= 30 s; a wrong flow port never turns\n    healthy (the probe checks the relay's own flow, not any open port); an untouched relay\n    stays healthy. Healthcheck, image and environment are those of the file under test;\n    the override only wraps the relay command so the container outlives its listener.\"\"\"\n    _require_docker()\n    vault = tmp_path / \"vault\"\n    vault.mkdir()\n    project = f\"rem0032-neg-{os.getpid()}\"\n    wrapped = (\"python3 /opt/ocor/ocor_ops_agent.py relay --profile /etc/ocor/profile.json \"\n               \"--upstream-template x-{host} & echo $! > /tmp/relay.pid; wait; sleep infinity\")\n    override = tmp_path / \"override.yaml\"\n    override.write_text(yaml.safe_dump({\"services\": {\n        \"ocor-relay-opa\": {\"command\": [\"bash\", \"-c\", wrapped]},\n        \"ocor-relay-typedb\": {\"environment\": {\"OCOR_RELAY_FLOW_PORT\": \"18000\"}},\n    }}))\n    files = [\"-f\", str(COMPOSE), \"-f\", str(override)]\n    env = _compose_env(vault)\n    services = [\"ocor-relay-opa\", \"ocor-relay-typedb\", \"ocor-relay-qdrant\"]\n    try:\n        up = subprocess.run([\"docker\", \"compose\", \"-p\", project, *files, \"--profile\", \"observability\", \"up\", \"-d\",\n                             *services], capture_output=True, text=True, env=env, check=False, timeout=300)\n        assert up.returncode == 0, up.stdout + up.stderr\n        opa, typedb, qdrant = (f\"{project}-{s}-1\" for s in services)\n        start_period = seconds(compose()[\"x-relay\"][\"healthcheck\"][\"start_period\"])\n        started = _health(opa)[\"StartedAt\"]\n        deadline = time.time() + 120\n        while _health(opa).get(\"Health\", {}).get(\"Status\") != \"healthy\":\n            assert time.time() < deadline, _health(opa)\n            time.sleep(1)\n        # Kill the listener once the start period is over, so failures count.\n        while True:\n            age = float(subprocess.run([\"docker\", \"exec\", opa, \"bash\", \"-c\",\n                                        \"echo $(( $(date +%s) - $(stat -c %Y /tmp/relay.pid) ))\"],\n                                       capture_output=True, text=True, check=True).stdout)\n            if age > start_period + 2:\n                break\n            time.sleep(1)\n        subprocess.run([\"docker\", \"exec\", opa, \"bash\", \"-c\", \"kill $(cat /tmp/relay.pid)\"], check=True)\n        killed = time.time()\n        while _health(opa)[\"Health\"][\"Status\"] != \"unhealthy\":\n            assert time.time() - killed <= DEAD_RELAY_BOUND_SECONDS + 2, _health(opa)[\"Health\"]\n            time.sleep(0.5)\n        detected = time.time() - killed\n        assert detected <= DEAD_RELAY_BOUND_SECONDS, detected\n        assert _health(opa)[\"Running\"] is True and _health(opa)[\"StartedAt\"] == started\n        refused = [entry for entry in _health(opa)[\"Health\"][\"Log\"] if entry[\"ExitCode\"] != 0]\n        assert refused and all(\"Connection refused\" in entry[\"Output\"] for entry in refused[-3:]), refused\n        wrong = _health(typedb)[\"Health\"]\n        assert wrong[\"Status\"] != \"healthy\" and all(e[\"ExitCode\"] != 0 for e in wrong[\"Log\"]), wrong\n        assert _health(qdrant)[\"Health\"][\"Status\"] == \"healthy\"\n        print(json.dumps({\"dead_relay_detected_seconds\": round(detected, 3), \"start_period\": start_period}))\n    finally:\n        subprocess.run([\"docker\", \"compose\", \"-p\", project, *files, \"--profile\", \"observability\", \"down\", \"-v\",\n                        \"--remove-orphans\", \"-t\", \"2\"], capture_output=True, env=env, check=False, timeout=300)\n        left = subprocess.run([\"docker\", \"ps\", \"-aq\", \"--filter\", f\"label=com.docker.compose.project={project}\"],\n                              capture_output=True, text=True, check=False).stdout.split()\n        assert not left, left\n\n\ndef _scenario(compose_path: Path, label: str, out: Path) -> dict[str, Any]:\n    proc = subprocess.run([sys.executable, str(SCENARIO), \"--compose\", str(compose_path), \"--env-file\",\n                           str(_env_file()), \"--label\", label, \"--projects\", \"3\", \"--cpuset\", \"0-3\", \"--load\", \"8\",\n                           \"--load-shares\", \"8192\", \"--observe\", \"120\", \"--out\", str(out)], capture_output=True, text=True, check=False,\n                          timeout=900)\n    assert proc.returncode == 0, proc.stdout + proc.stderr\n    result = json.loads(out.read_text())\n    assert result[\"residue\"] == [], result[\"residue\"]\n    # Fix the offered contention instead of depending on the host scheduler's spare CPU.\n    # Docker maps shares to cgroup-v2 weights: read both back rather than assuming a ratio.\n    # Neither relay shares nor probe timers are changed. Both probes face this same load.\n    resources = result[\"cpu_resources\"]\n    assert len(resources[\"loads\"]) == 8 and len(resources[\"relays\"]) == 30\n    assert all(r[\"cpuset\"] == \"0-3\" and r[\"shares\"] == 8192 for r in resources[\"loads\"].values())\n    assert all(r[\"cpuset\"] == \"0-3\" and r[\"shares\"] == 0 for r in resources[\"relays\"].values())\n    assert all(r[\"quota\"] == 0 and r[\"nano_cpus\"] == 0\n               for group in resources.values() for r in group.values())\n    assert min(r[\"cgroup_weight\"] for r in resources[\"loads\"].values()) > max(\n        r[\"cgroup_weight\"] for r in resources[\"relays\"].values())\n    assert set(result[\"up\"]) == set(result[\"projects\"])\n    return result\n\n\ndef test_red_task_stage_probe_turns_relays_unhealthy_under_cpu_limit(tmp_path):\n    _require_docker()\n    staged = subprocess.run([\"git\", \"show\", f\"{TASK_STAGE}:deploy/helm/ocor-poc/compose.profiles.yaml\"],\n                            cwd=ROOT, capture_output=True, text=True, check=True).stdout\n    path = tmp_path / \"compose.task-stage.yaml\"\n    path.write_text(staged)\n    out = Path(os.environ.get(\"REM0032_SCENARIO_OUT\", tmp_path)) / \"red.json\"\n    result = _scenario(path, f\"red{os.getpid()}\", out)\n    assert result[\"unhealthy_containers\"], \"RED must show at least one unhealthy relay with the old probe\"\n    assert any(u[\"exit_code\"] != 0 for u in result[\"up\"].values())\n\n\ndef test_green_probe_keeps_every_relay_healthy_under_cpu_limit(tmp_path):\n    _require_docker()\n    out = Path(os.environ.get(\"REM0032_SCENARIO_OUT\", tmp_path)) / \"green.json\"\n    result = _scenario(COMPOSE, f\"green{os.getpid()}\", out)\n    assert result[\"unhealthy_containers\"] == [], result[\"unhealthy_events\"]\n    assert all(u[\"exit_code\"] == 0 for u in result[\"up\"].values()), result[\"up\"]\n    assert all(s[\"health\"] == \"healthy\" for s in result[\"final_states\"].values()), result[\"final_states\"]\n", "sha256": "d6e4baab5109444bf55775494f4065c7c05ecbc2885e0dab7b1e6419e3405b0a"}
