{"command": "captured artifact: source of the mutation probe (mutant table)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"OCOR-DEV-REM-0024 mutation probe: each mutant is applied to a scratch copy of\nocor-runtime/src (never in place) and the REM-0024 + 0044 suites must fail.\nUsage: mutation_probe.py <worktree> <log_dir>\"\"\"\nimport hashlib, json, shutil, subprocess, sys, tempfile\nfrom pathlib import Path\n\nW = Path(sys.argv[1]); L = Path(sys.argv[2])\nSRC = W / \"ocor-runtime/src\"; TARGET = \"ocor_runtime/c6/safety.py\"\nMUTANTS = {\n    \"M01-authorize-skips-issued-check\": (\"        if self._issued.get(grant.grant_id) != grant:\\n\", \"        if False:\\n\"),\n    \"M02-expiry-ignored\": (\"                if instant >= grant.expires_at:\\n\", \"                if False:\\n\"),\n    \"M03-no-use-time-revalidation\": (\"                self._validate_principals(grant.requester, grant.approvers, grant.domain)\\n\", \"                pass\\n\"),\n    \"M04-requester-may-approve\": (\"        if requester in approvers:\\n\", \"        if False:\\n\"),\n    \"M05-no-role-quorum\": (\"        if not (\\n            (SECURITY_DUTY_OFFICER_ROLE in first.roles\", \"        if False and not (\\n            (SECURITY_DUTY_OFFICER_ROLE in first.roles\"),\n    \"M06-workload-may-approve\": ('            if principal.kind != \"HUMAN\":\\n', \"            if False:\\n\"),\n    \"M07-inactive-may-approve\": (\"            if not principal.active:\\n\", \"            if False:\\n\"),\n    \"M08-unnamed-capability-allowed\": (\"                if capability not in grant.capabilities:\\n\", \"                if False:\\n\"),\n    \"M09-audit-failure-swallowed\": (\"            raise SafetyError(\\\"BREAK_GLASS_AUDIT_UNAVAILABLE\\\"\", \"            return\\n            raise SafetyError(\\\"BREAK_GLASS_AUDIT_UNAVAILABLE\\\"\"),\n    \"M10-alert-failure-swallowed\": (\"                self._alerts.alert(authorized)\\n            except Exception as exc:\\n\", \"                self._alerts.alert(authorized)\\n            except Exception as exc:\\n                return BreakGlassUse(grant_id=grant.grant_id, capability=capability, review_ref=review_ref, used_at=instant)\\n\"),\n    \"M11-no-automatic-revocation-at-expiry\": (\"                    self._revoked_grant_ids.add(grant.grant_id)\\n                    self._append(_event(\\\"BREAK_GLASS_EXPIRED_REVOKED\\\"\", \"                    self._append(_event(\\\"BREAK_GLASS_EXPIRED_REVOKED\\\"\"),\n    \"M12-not-yet-valid-ignored\": (\"                if instant < grant.granted_at:\\n\", \"                if False:\\n\"),\n    \"M13-unsorted-roles-accepted\": (\"        or tokens != sorted(tokens)\\n\", \"\"),\n    \"M14-grant-id-reissue-allowed\": (\"                if grant_id in self._issued:\\n\", \"                if False:\\n\"),\n    \"M15-revocation-after-audit\": (\"            self._revoked_grant_ids.add(grant.grant_id)\\n            self._append(_event(\\\"BREAK_GLASS_REVOKED\\\", grant, instant))\\n\", \"            self._append(_event(\\\"BREAK_GLASS_REVOKED\\\", grant, instant))\\n            self._revoked_grant_ids.add(grant.grant_id)\\n\"),\n}\noriginal = (SRC / TARGET).read_text()\nresults = []\nfor name, (old, new) in MUTANTS.items():\n    count = original.count(old)\n    if count < 1:\n        results.append({\"mutant\": name, \"status\": \"NOT_APPLICABLE\", \"occurrences\": count}); continue\n    with tempfile.TemporaryDirectory(prefix=\"ocor-rem0024-mut-\") as tmp:\n        root = Path(tmp) / \"ocor-runtime\"\n        shutil.copytree(W / \"ocor-runtime\", root, ignore=shutil.ignore_patterns(\".venv\", \"node_modules\", \"__pycache__\", \".pytest_cache\"))\n        (root / \"src\" / TARGET).write_text(original.replace(old, new, 1))\n        env = {\"PYTHONPATH\": str(root / \"src\"), \"PATH\": \"/usr/bin:/bin\"}\n        p = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-x\",\n                            \"tests/tasks/test_ocor_dev_rem_0024.py\", \"tests/tasks/test_ocor_dev_0044.py\"],\n                           cwd=root, env=env, capture_output=True, text=True, timeout=600)\n        imported = subprocess.run([str(W / \"ocor-runtime/.venv/bin/python\"), \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"--co\", \"-q\",\n                                   \"-p\", \"ocor_rem0024_probe_where\"], cwd=root, env={**env, \"PYTHONPATH\": str(root / \"src\") + \":\" + str(L)},\n                                  capture_output=True, text=True).stdout\n        imported = next((line.split(\"=\", 1)[1] for line in imported.splitlines() if line.startswith(\"SAFETY_FILE=\")), \"\")\n        log = L / f\"mutant-{name}.log\"; log.write_text(p.stdout + p.stderr)\n        results.append({\"mutant\": name, \"status\": \"KILLED\" if p.returncode != 0 else \"SURVIVED\", \"pytest_exit\": p.returncode,\n                        \"mutated_module_imported_from_scratch\": imported.startswith(tmp), \"last_line\": (p.stdout.strip().splitlines() or [\"\"])[-1],\n                        \"log\": log.name, \"log_sha256\": hashlib.sha256(log.read_bytes()).hexdigest()})\nrestored = (SRC / TARGET).read_text() == original\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=W, text=True).strip()\nhead_blob = subprocess.check_output([\"git\", \"show\", f\"HEAD:ocor-runtime/src/{TARGET}\"], cwd=W, text=True)\nclean = subprocess.check_output([\"git\", \"status\", \"--porcelain\"], cwd=W, text=True) == \"\"\nout = {\"head\": head, \"restored_blob_equals_head\": restored and original == head_blob, \"worktree_clean_after\": clean,\n       \"method\": \"each mutant is written into a scratch copy of ocor-runtime (src, tests, pyproject; venv excluded) and the REM-0024 and 0044 suites run from that copy with -x; the worktree source is never modified\",\n       \"source_sha256\": hashlib.sha256(original.encode()).hexdigest(), \"source_unchanged_in_