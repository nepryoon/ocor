                  "command": [
                    "sh",
                    "-ec",
                    "out=/staging/postgresql; rm -rf \"$out\"; mkdir -p \"$out\"\n# Bounded wait for the database path (the network policy of a new pod can be\n# programmed asynchronously); an unreachable database fails the capture explicitly.\nattempts=${OCOR_CAPTURE_WAIT_ATTEMPTS:-30}; n=0\nuntil pg_isready -d ocor -t 2 >/dev/null; do\n  n=$((n + 1))\n  [ \"$n\" -lt \"$attempts\" ] || { echo \"CAPTURE_SOURCE_UNREACHABLE: postgresql after $n attempts\" >&2; exit 1; }\n  sleep 2\ndone\n# Plain assignments, not a for-list or a pipeline: a failed query aborts under sh -e\n# instead of yielding an empty capture or a silently skipped memory store.\ndbs=$(psql -d ocor -Atc \"select datname from pg_database where not datistemplate and datallowconn order by 1\")\n[ -n \"$dbs\" ] || { echo \"CAPTURE_EMPTY: no database listed\" >&2; exit 1; }\nfor db in $dbs; do\n  pg_dump -d \"$db\" -Fc -f \"$out/$db.dump\"\n  psql -d \"$db\" -At -f /opt/ocor/table-digest.sql > \"$out/$db.digest\"\ndone\nmemory=$(psql -d ocor -Atc \"select count(*) from pg_database where datname='$MEMORY_DB'\")\nif [ \"$memory\" = 1 ]; then\n  psql -d \"$MEMORY_DB\" -c \"\\copy (select item_id, tenant_id, compartments, representation_version, lifecycle_epoch, lifecycle_state, coalesce(deletion_epoch::text, '') as deletion_epoch, content_ref, classification_marking_ref, governed_context_digest from memory_item order by item_id) to '$out/memory-items.csv' csv header\"\n  psql -d \"$MEMORY_DB\" -c \"\\copy (select event_id, item_id, deletion_epoch from memory_deletion_journal order by deletion_epoch, event_id collate \\\"C\\\") to '$out/memory-deletion-journal.csv' csv header\"\nfi\nls -l \"$out\"\n"
                  ],
                  "env": [
                    {
                      "name": "PGHOST",
                      "value": "postgresql"
                    },
                    {
                      "name": "PGUSER",
                      "value": "ocor"
                    },
                    {
                      "name": "MEMORY_DB",
                      "value": "ocor_poc_drill"
                    },
