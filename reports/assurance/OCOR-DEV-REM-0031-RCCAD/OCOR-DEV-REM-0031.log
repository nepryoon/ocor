{"command": "captured artifact: mutation_probe.py (mutant table)", "exit_code": 0, "label": "mutation-probe-script", "output": "\"\"\"REM-0031 mutation probe of the register() closure. argv: <detached worktree at the code commit> <python> <log dir>.\"\"\"\nimport json, subprocess, sys\nfrom pathlib import Path\nwt, python, logs = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3]); logs.mkdir(parents=True, exist_ok=True)\ntarget = wt / 'ocor-runtime/src/ocor_runtime/c2_identity.py'\noriginal = target.read_bytes()\nhead = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=wt, text=True).strip()\nCHECK = '''            if self._records.get(record.canonical_id) is None and (\n                RESERVED_PRINCIPAL_ATTRIBUTES & set(record.attributes)\n            ):'''\nMUTANTS = {\n    'M1-no-q1-check': (CHECK, '            if False:'),\n    'M2-q1-before-immutability': (CHECK, '            if RESERVED_PRINCIPAL_ATTRIBUTES & set(record.attributes):'),\n    'M3-only-roles-reserved': ('RESERVED_PRINCIPAL_ATTRIBUTES & set(record.attributes)', '{\"roles\"} & set(record.attributes)'),\n    'M4-all-keys-required': ('RESERVED_PRINCIPAL_ATTRIBUTES & set(record.attributes)', 'RESERVED_PRINCIPAL_ATTRIBUTES <= set(record.attributes)'),\n    'M5-seeding-through-register': ('        for record in records:\\n            self._store(record)', '        for record in records:\\n            self.register(record)'),\n    'M6-boundary-uses-register': None,\n}\nresults = []\ntests = ['tests/tasks/test_ocor_dev_rem_0031.py', 'tests/tasks/test_ocor_dev_rem_0024.py', 'tests/tasks/test_ocor_dev_0043.py', 'tests/tasks/test_ocor_dev_0044.py', 'tests/tasks/test_ocor_dev_rem_0028.py']\nenv = {'HOME': '/home/luca', 'PATH': '/usr/bin:/bin', 'PYTHONPATH': str(wt / 'ocor-runtime/src'), 'PYTHONHASHSEED': '0', 'TZ': 'UTC'}\nprov = wt / 'ocor-runtime/src/ocor_runtime/c2/provisioning.py'; prov_original = prov.read_bytes()\nfor name, spec in MUTANTS.items():\n    if spec is None:\n        text = prov_original.decode(); a = 'self._registry._admit_provisioned(record)'\n        assert text.count(a) == 1; prov.write_text(text.replace(a, 'self._registry.register(record)'))\n    else:\n        text = original.decode(); a, b = spec\n        assert text.count(a) == 1, name; target.write_text(text.replace(a, b))\n    log = logs / f'{name}.log'\n    with log.open('w') as f:\n        r = subprocess.run([python, '-m', 'pytest', *tests, '-p', 'no:cacheprovider', '-q', '-rf', '--tb=no', '-k', 'not real and not paused and not unreachable and not installed and not governed_pin and not unauthenticated and not world'], cwd=wt / 'ocor-runtime', env=env, stdout=f, stderr=subprocess.STDOUT, timeout=600)\n    target.write_bytes(original); prov.write_bytes(prov_original)\n    tail = log.read_text().strip().splitlines()[-1]\n    results.append({'mutant': name, 'exit_code': r.returncode, 'killed': r.returncode == 1 and 'failed' in tail, 'summary': tail})\nclean = subprocess.check_output(['git', 'status', '--porcelain'], cwd=wt, text=True) == ''\nout = {'head': head, 'mutants': results, 'total': len(results), 'killed': sum(m['killed'] for m in results), 'restored_blob_equals_head': target.read_bytes() == original and prov.read_bytes() == prov_original, 'worktree_clean_after': clean}\n(logs / 'mutation-probe.json').write_text(json.dumps(out, indent=2, sort_keys=True) + '\\n'); print(json.dumps(out, indent=1))\n", "sha256": "c998002ebf76abbfdaefa915ba58fbfa789e3da4be0d3cd6328d78d0a8441075"}
