RAW_FILE preflight.py SHA256 6e754b81af714109e936376c61dc3aa0e3d8b3470b43c1063ec9db3800ca4ef9
import sys
import hashlib,json,os,re,shutil,subprocess,time
from pathlib import Path
D=Path(__file__).parent
R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
PY=R/'ocor-runtime/.venv/bin/python'
env=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')
rows=[]
def dump(p,d):p.write_text(json.dumps(d,indent=2,sort_keys=True)+'\n')
def inventory():
 return {k:sorted(subprocess.check_output(c,text=True,timeout=30,env=env).splitlines()) for k,c in [('containers',['docker','ps','-aq']),('volumes',['docker','volume','ls','-q']),('networks',['docker','network','ls','-q'])]}
def run(label,c,limit=600):
 t=time.monotonic();r=subprocess.run(c,cwd=R,env=env,capture_output=True,text=True,timeout=limit)
 out=r.stdout+r.stderr
 for k,v in values.items():
  if ('PASSWORD' in k or 'TOKEN' in k) and len(v)>7:out=out.replace(v,'<REDACTED_LOCAL_CREDENTIAL>')
 p=D/(label+'.log');p.write_text(out);p.chmod(0o600)
 row={'label':label,'command':c,'exit_code':r.returncode,'duration_seconds':round(time.monotonic()-t,3),'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest()};rows.append(row);dump(D/'preflight-commands.json',rows);print(label,r.returncode,flush=True)
 if r.returncode:raise RuntimeError(label+' failed; inspect redacted log')
 return out
for k in list(env):
 if k.startswith('OCOR_'):env.pop(k,None)
secret=R/'.ocor/bootstrap.env'
values=dict(l.split('=',1) for l in secret.read_text().splitlines() if '=' in l)
dump(D/'resources-before.json',inventory())
lock=json.loads((R/'infra/toolchain.lock.json').read_text());tools=[]
for x in lock['tools']:
 if x['provider']=='container':
  props=json.loads(subprocess.check_output(['docker','image','inspect',x['container_image']],text=True,env=env,timeout=30))[0]
  java=next(v.split('=',1)[1] for v in props['Config']['Env'] if v.startswith(x['version_env']+'='))
  assert java.removeprefix('jdk-')==x['version'];assert x['container_image'] in props['RepoDigests'];tools.append({'id':x['id'],'version':java,'expected_version':x['version'],'version_match':True,'digest_match':x['container_image'] in props['RepoDigests']});continue
 p=PY if x['id']=='python' else Path(shutil.which(x['command'],path=env['PATH']))
 v=subprocess.check_output([str(p),*x['version_args']],text=True,env=env,stderr=subprocess.STDOUT,timeout=30).strip()
 digest=hashlib.sha256(p.read_bytes()).hexdigest(); row={'id':x['id'],'path':str(p),'version':v,'version_match':bool(re.search(x['version_pattern'],v)),'sha256':digest,'digest_match':digest==x['integrity']};tools.append(row);assert row['version_match'] and row['digest_match'],x['id']
dump(D/'toolchain.json',{'tools':tools})
try:
 run('inputs',['sha256sum','-c','inputs/normative/SHA256SUMS'])
 run('verify',[str(PY),'scripts/verify.py','--json'])
 # Merged allowlist drift is captured in drift-before.log and requires a new 0050 regression record.
 pass
 run('reset',[str(PY),'scripts/reset_test_environment.py','--execute'])
 run('bootstrap',[str(PY),'scripts/bootstrap_development_environment.py','--execute','--timeout','600'],700)
 values=dict(l.split('=',1) for l in secret.read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(secret)
 sys.path.insert(0,str(R/'scripts'))
 from bootstrap_ci_environment import ci_resources
 profile=ci_resources(R)
 run('bounded-fuseki-profile',['docker','compose','--env-file',str(secret),'-f','deploy/bootstrap/compose.yaml','-f',str(profile),'up','--detach','--no-build','--wait','--wait-timeout','120','fuseki'],180)
 actual=run('bounded-fuseki-process',['docker','top','ocor-bootstrap-fuseki-1','-eo','pid,args'])
 assert '-Xms128m -Xmx1G' in actual and '-Xmx4G' not in actual
 dump(D/'resource-profile.json',{'source_commit':subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip(),'recipe':'ci_resources','profile_sha256':hashlib.sha256(profile.read_bytes()).hexdigest(),'jvm_args':'-Xms128m -Xmx1G','cgroup_bytes':2147483648,'images_unchanged':True})
 run('sync-lint',['uv','sync','--project','ocor-runtime','--frozen','--extra','test','--extra','lint'])
 run('initialize',[str(PY),'deploy/bootstrap/init/initialize_services.py','--env-file',str(secret)])
 run('fixtures',[str(PY),'deploy/bootstrap/fixtures/load_fixtures.py','--env-file',str(secret)])
 run('svid',[str(PY),'/home/luca/.ocor-codex/rem0022-ci-evidence/register_control_plane.py'])
 health=json.loads(run('typed-health',[str(PY),'scripts/verify_external_services.py','--execute','--typed']))
 dump(D/'health.json',health)
 ids=subprocess.check_output(['docker','ps','-aq','--filter','label=com.docker.compose.project=ocor-bootstrap'],text=True,env=env,timeout=30).split();assert len(ids)==11
 props=json.loads(subprocess.check_output(['docker','inspect',*ids],text=True,env=env,timeout=30))
 summary=[{'name':c['Name'],'image_id':c['Image'],'running':c['State']['Running'],'oom':c['State']['OOMKilled'],'restarts':c['RestartCount']} for c in props]
 assert all(c['running'] and not c['oom'] and c['restarts']==0 for c in summary);dump(D/'stack-summary.json',summary)
 dump(D/'preflight-result.json',{'status':'PASS','services':11,'toolchain_entries':len(tools)})
except Exception as e:
 dump(D/'preflight-result.json',{'status':'FAIL','error':str(e)});raise
finally:
 run('restore-verify-report',['git','restore','reports/verify_report.json'])

END_RAW_FILE preflight.py
