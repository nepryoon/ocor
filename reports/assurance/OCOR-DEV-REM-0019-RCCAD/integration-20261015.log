RAW_FILE gates.py SHA256 e3621b41a0802921cbaccb5db5926fbec906235c4f0bd0d140a9b53f8ae1fa9a
import hashlib,json,os,subprocess,time
from pathlib import Path
D=Path(__file__).parent;R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage');PY=str(R/'ocor-runtime/.venv/bin/python')
env=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],GIT_PAGER='cat',PAGER='cat',GH_PROMPT_DISABLED='1',GIT_EDITOR='true')
rows=[]
def run(label,args):
 t=time.monotonic();r=subprocess.run(args,cwd=R,env=env,capture_output=True,text=True,timeout=300);p=D/(label+'.log');p.write_text(r.stdout+r.stderr);rows.append({'label':label,'command':args,'exit_code':r.returncode,'duration_seconds':time.monotonic()-t,'raw_sha256':hashlib.sha256(p.read_bytes()).hexdigest()});(D/'gates.json').write_text(json.dumps(rows,indent=2,sort_keys=True)+'\n');print(label,r.returncode,flush=True)
 if r.returncode:raise RuntimeError(label+' failed')
run('inputs',['sha256sum','-c','inputs/normative/SHA256SUMS'])
run('verify',[PY,'scripts/verify.py','--json'])
run('ruff',['ruff','check','.'])
run('mypy',[PY,'-m','mypy','--strict'])
run('rccad',[PY,'scripts/validate_rccad.py','--base-ref','origin/main'])
run('language',[PY,'scripts/validate_language_policy.py'])
run('scope',[PY,'scripts/validate_ocor_change_scope.py','--base','origin/main','--head','HEAD','--branch','governed/ocor-dev-rem-0019-evidence-stage'])
run('plan',[PY,'scripts/validate_ocor_development_plan.py','--authorized-extension','--base-ref','origin/main'])
run('runtime0049',[PY,'scripts/validate_runtime_evidence.py','--task','OCOR-DEV-0049','--non-skipped','--manifest','reports/evidence/G4/MANIFEST.json'])
run('runtime0050',[PY,'scripts/validate_runtime_evidence.py','--task','OCOR-DEV-0050','--non-skipped','--manifest','reports/evidence/G5/MANIFEST.json'])
run('restore-verify',['git','restore','reports/verify_report.json'])
raise SystemExit(any(x['exit_code'] for x in rows))

END_RAW_FILE gates.py
