RAW_FILE regress0050.py SHA256 4af4d35d673c4bc72cc20ded03bf342d09afc2253510716290e4705fdddf5f09
import hashlib,json,os,subprocess,time
from pathlib import Path
D=Path(__file__).parent
R=Path('/home/luca/projects/ocor-detailed-design/.ocor/worktrees/rem0019-governed-stage')
env=os.environ.copy();env.update(PATH='/home/luca/.ocor-codex/c5resume/toolchain/bin:/home/luca/.local/bin:'+env['PATH'],PYTHONHASHSEED='0',TZ='UTC')
values=dict(l.split('=',1) for l in (R/'.ocor/bootstrap.env').read_text().splitlines() if '=' in l);env.update(values);env['OCOR_BOOTSTRAP_ENV']=str(R/'.ocor/bootstrap.env')
env['OCOR_LIVE_POSTGRES_DSN']='postgresql://ocor:'+values['OCOR_LOCAL_POSTGRES_PASSWORD']+'@127.0.0.1:55433/ocor'
source_head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=R,text=True).strip()
cmd=[str(R/'ocor-runtime/.venv/bin/python'),'-m','pytest','-q','ocor-runtime/tests/tasks/test_ocor_dev_0050.py','--junitxml='+str(D/'regression0050.xml')]
with (D/'regression0050.log').open('w') as f:
 r=subprocess.run(cmd,cwd=R,env=env,stdout=f,stderr=subprocess.STDOUT,timeout=2700)
(D/'regression0050-exit.json').write_text(json.dumps({'command':cmd,'exit_code':r.returncode,'source_head_at_launch':source_head},indent=2,sort_keys=True)+'\n')
raise SystemExit(r.returncode)

END_RAW_FILE regress0050.py
