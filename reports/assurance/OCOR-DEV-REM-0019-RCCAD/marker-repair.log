etwork attach.\nThe interruption tests orchestration cleanup, not an OCOR backend replacement.\n\"\"\"\nimport ast\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport types\nfrom pathlib import Path\nfrom datetime import UTC, datetime\nimport yaml\n\nD=Path(__file__).parent\nsource=Path(sys.argv[1]); label=sys.argv[2]\ncluster='ocor-poc-cleanup-proof'\nimage=json.loads((D/'node-image-proof.json').read_text())['image_ref']\nkind='/home/luca/projects/ocor-detailed-design/.ocor/tools/bin/kind'\nreal_run=subprocess.run\n\ndef inventory():\n    return {k:sorted(subprocess.check_output(['docker',*cmd],text=True,timeout=30).split()) for k,cmd in {\n        'containers':['ps','-aq','--no-trunc'], 'volumes':['volume','ls','-q'],\n        'networks':['network','ls','-q','--no-trunc']}.items()}\n\nbefore=inventory(); calls=[]; result={'label':label,'started_at':datetime.now(UTC).isoformat(),'image_ref':image}\ntry:\n    with tempfile.TemporaryDirectory(prefix='ocor-cleanup-proof-') as root:\n        def run(cmd, **kw):\n            if cmd[:2]==['docker','network'] and cmd[2]=='connect':\n                r=real_run(cmd,**kw)\n                assert r.returncode==0, r.stderr\n                state=inventory()\n                result['resources_at_interruption']=state\n                result['owned_resources_at_interruption']={k:sorted(set(state[k])-set(before[k])) for k in before}\n                result['node_inspect_at_interruption']=json.loads(subprocess.check_output(['docker','inspect',cluster+'-control-plane'],text=True))\n                raise KeyboardInterrupt('injected setup interruption after real attach')\n            r=real_run(cmd,**kw)\n            calls.append({'command':cmd,'exit_code':r.returncode})\n            return r\n        tree=ast.parse(source.read_text());fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='kind');fn.decorator_list=[]\n        ns=dict(subprocess=types.SimpleNamespace(run=run), KIND_CLUSTER=cluster, KIND_NODE_IMAGE=image,\n                KIND_VAULT_ROOT=Path(root)/'vault', BOOTSTRAP_NETWORK='ocor-bootstrap_ocor-bootstrap',\n                tool=lambda name:kind if name=='kind' else name, yaml=yaml, shutil=shutil, os=os)\n        exec(compile(ast.Module(body=[fn],type_ignores=[]),str(source),'exec'),ns)\n        gen=ns['kind'](types.SimpleNamespace(work=Path(root)))\n        try:next(gen)\n        except KeyboardInterrupt:result['interruption_observed']=True\n        else:raise AssertionError('injection did not execute')\n        after=inventory();result['resources_after_fixture']=after\n        result['owned_resources_after_fixture']={k:sorted(set(after[k])-set(before[k])) for k in before}\n        result['fixture_cleanup_pass']=before==after\nfinally:\n    cleanup=real_run([kind,'delete','cluster','--name',cluster],capture_output=True,text=True,timeout=300)\n    result['emergency_cleanup_exit']=cleanup.returncode\n    result['resources_after_emergency_cleanup']=inventory()\n    result['emergency_cleanup_pass']=result['resources_after_emergency_cleanup']==before\n    result['commands']=calls;result['finished_at']=datetime.now(UTC).isoformat()\n    # Inspect may contain host paths but no generated service secrets.\n    (D/(label+'.json')).write_text(json.dumps(result,indent=2,sort_keys=True)+'\\n')\n    print(json.dumps({k:v for k,v in result.items() if k not in ['commands','node_inspect_at_interruption']},indent=2))\nassert result['fixture_cleanup_pass'], 'owned node/volume left by interrupted fixture'\nassert result['emergency_cleanup_pass']\n", "test_fixture_cleanup.py": "\"\"\"Local fixture lifecycle proofs; mocks model orchestration failures only.\nNo backend conformance is claimed by these deterministic checks.\n\"\"\"\nimport ast\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport types\nimport unittest\nimport uuid\nfrom pathlib import Path\n\nSOURCE = Path(sys.argv.pop(1))\n\n\nclass InterruptedSetup(BaseException):\n    pass\n\n\nclass Lifecycle(unittest.TestCase):\n    def exercise(self, fail_at=None, interrupt=False, preexisting=False):\n        tree = ast.parse(SOURCE.read_text())\n        fixture = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'kind')\n        fixture.decorator_list = []\n        resources = {'cluster': preexisting, 'volume': preexisting, 'attachment': False}\n        calls = []\n        with tempfile.TemporaryDirectory() as root:\n            def fault(stage):\n                if fail_at == stage:\n                    if interrupt:\n                        raise InterruptedSetup(stage)\n                    raise RuntimeError(stage)\n\n            def run(cmd, **kw):\n                calls.append(cmd)\n                stdout = ''\n                if cmd[:3] == ['kind', 'get', 'clusters']:\n                    stdout = 'ocor-poc\\n' if resources['cluster'] else ''\n                elif cmd[:3] == ['kind', 'create', 'cluster']:\n                    resources.update(cluster=True, volume=True)\n                    fault('create')\n                elif cmd[:3] == ['kind', 'delete', 'cluster']:\n                    resources.update(cluster=False, volume=False, attachment=False)\n                elif cmd[:3] == ['docker', 'network', 'connect']:\n                    resources['attachment'] = True\n                    fault('attach')\n                elif cmd[:3] == ['docker', 'network', 'inspect']:\n                    stdout = json.dumps([{'Containers': {}}])\n                elif cmd[:2] == ['docker', 'exec']:\n                    fault('image')\n                elif cmd[:2] == ['docker', 'inspect']:\n                    return subprocess.CompletedProcess(cmd, 0 if resources['cluster'] else 1,\n                                                       '{}', '' if resources['cluster'] else 'Error: No such object')\n                elif cmd[:2] == ['helm', '--kube-context']:\n                    fault('helm')\n                return subprocess.CompletedProcess(cmd, 0, stdout, '')\n\n            def kubectl(*args, **kwargs):\n                calls.append(['kubectl', *args])\n                if args[:2] == ('create', 'namespace'):\n                    fault('namespace')\n                return subprocess.CompletedProcess(args, 0, '', '')\n\n            ns = dict(subprocess=types.SimpleNamespace(run=run), KIND_CLUSTER='ocor-poc',\n                      KIND_NODE_IMAGE='verified:pin', KIND_VAULT_ROOT=Path(root)/'vault',\n                      BOOTSTRAP_NETWORK='ocor-bootstrap_ocor-bootstrap', BOOTSTRAP_SERVICES=[],\n                      OTHER_OPS_IMAGE='other:pin', CHART_DIR=Path(root),\n                      tool=lambda name: name, helm_profile=lambda: {'images': {'pins': {'ops': 'ops:pin'}}},\n                      kubectl=kubectl, yaml=types.SimpleNamespace(safe_dump=json.dumps,\n                                                                safe_dump_all=lambda rows: json.dumps(list(rows))),\n                      time=types.SimpleNamespace(sleep=lambda _: None), os=types.SimpleNamespace(getuid=lambda: 1000,\n                                                                                                   environ={}),\n                      uuid=uuid, json=json, re=re, shutil=shutil, make_writable=lambda p: None)\n            exec(compile(ast.Module(body=[fixture], type_ignores=[]), str(SOURCE), 'exec'), ns)\n            stack = types.SimpleNamespace(work=Path(root), env={'OCOR_LOCAL_OPENBAO_TOKEN': 'local',\n                                                                'OCOR_LOCAL_POSTGRES_PASSWORD': 'local'},\n                                          operator_token='local')\n            gen = ns['kind'](stack)\n            if fail_at:\n                with self.assertRaises(InterruptedSetup if interrupt else RuntimeError):\n                    next(gen)\n            else:\n                ctx = next(gen)\n                self.assertIn('namespace', ctx)\n                gen.close()\n            self.assertEqual(resources['cluster'], preexisting)\n            self.assertEqual(resources['volume'], preexisting)\n            if not preexisting:\n                self.assertFalse(resources['attachment'])\n                self.assertIn(['kind', 'delete', 'cluster', '--name', 'ocor-poc'], calls)\n            else:\n                self.assertNotIn(['kind', 'delete', 'cluster', '--name', 'ocor-poc'], calls)\n\n    def test_failure_after_node_creation(self): self.exercise('create')\n    def test_interrupt_during_creation(self): self.exercise('create', interrupt=True)\n    def test_interrupt_after_network_attachment(self): self.exercise('attach', interrupt=True)\n    def test_failure_loading_image(self): self.exercise('image')\n    def test_failure_creating_namespace(self): self.exercise('namespace')\n    def test_failure_before_helm_yield(self): self.exercise('helm')\n    def test_success_yield_then_close(self): self.exercise()\n    def test_preexisting_cluster_preserved(self): self.exercise(preexisting=True)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"}, "verifier": "Grok 4.7 via Cursor CLI, external loop only; task touched by reserve Claude Code"}
