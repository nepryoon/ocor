RAW_FILE invariants.py SHA256 3ff49e0bd98aefc0a51387142239fe47de40d49dbf3fcb60e90f408fecb4e6f6
import ast, hashlib, json, subprocess
from pathlib import Path
MAIN='9a89ea88d935855a696b3790dae91115fea25ec7'
SEALED='5453075bb8407db88f687a0137f54d1bc7cedb18'
def git(*a):return subprocess.check_output(['git',*a],text=True).strip()
def blob(ref,p):return subprocess.check_output(['git','show',ref+':'+p])
def sha(b):return hashlib.sha256(b).hexdigest()
paths=['ocor-runtime','deploy','infra','.github','inputs','reports/tests']
trees={p:{'main':git('rev-parse',MAIN+':'+p),'integration':git('rev-parse','HEAD:'+p)} for p in paths}
assert all(v['main']==v['integration'] for v in trees.values())
checked={}
for ref in [MAIN,SEALED,'0addbaa99c3f13d39cb64c1e9aee73ca45eed3cd']:
 rows={}
 for line in git('ls-tree','-r',ref).splitlines():
  info,p=line.split('\t',1)
  if p.startswith(('reports/evidence/','reports/assurance/')) and not p.endswith(('MANIFEST.json','README.md')):
   assert git('rev-parse','HEAD:'+p)==info.split()[2],p
   rows[p]=info.split()[2]
 checked[ref]={'count':len(rows),'git_blob_inventory_sha256':sha(json.dumps(rows,sort_keys=True).encode())}
for p in ['reports/development/EXECUTION_STATE.json','reports/development/MODEL_HANDOFF.json','reports/development/ITERATION_LOG.md']:
 assert Path(p).read_bytes()==blob(MAIN,p),p
p='scripts/validate_ocor_development_plan.py';old=ast.parse(blob(MAIN,p));new=ast.parse(Path(p).read_text())
def strip(t):
 found=[]
 for n in ast.walk(t):
  if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='extension_paths' for x in n.targets):
   assert isinstance(n.value,ast.Set);found.extend(ast.literal_eval(n.value));n.value=ast.Set(elts=[])
 assert found
 return set(found)
a=strip(old);b=strip(new);assert a<=b
assert ast.dump(old,include_attributes=False)==ast.dump(new,include_attributes=False)
scripts_changed=git('diff','--name-only',MAIN,'HEAD','--','scripts').splitlines();assert scripts_changed==[p]
for gate in ['G4','G5']:
 p='reports/evidence/'+gate+'/MANIFEST.json';old=json.loads(blob(MAIN,p));new=json.loads(Path(p).read_text());assert old['requirement_results']==new['requirement_results']
 prior={a['path']:a for a in old['artifacts']};now={a['path']:a for a in new['artifacts']};assert len(now)==len(new['artifacts'])
 assert all(now[k]==v for k,v in prior.items())
 for row in new['artifacts']:assert sha(Path('reports/evidence',gate,row['path']).read_bytes())==row['sha256'],row['path']
print(json.dumps({'status':'PASS','head':git('rev-parse','HEAD'),'main':MAIN,'sealed_candidate':SEALED,'trees':trees,'sealed_record_preservation':checked,'validator_ast_except_extension_paths':'IDENTICAL','allowlist_additions':sorted(b-a),'main_manifest_authorities_preserved':True,'candidate_state_byte_identical_to_main':True},indent=2,sort_keys=True))

END_RAW_FILE invariants.py
